<fo:block id="W0039-00-0023-it-09ab" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:block id="W0039-00-0023-li-0584">
<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline> </fo:inline><fo:inline font-size="18pt" space-before="0.1mm" space-after="0.1mm">Rubrice</fo:inline> codicis continentis. xij. libros partiales representatos per numerum positum a latere si
<fo:inline> </fo:inline>nistro. Et vltimi tres libri longe post
<fo:inline> </fo:inline>primos nouem compositi sunt et rubrice eorũ seorsum ponuntur in sequen
<fo:inline> </fo:inline>tibus.</fo:block>
<fo:block id="W0039-00-0023-it-0ad7" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:block id="W0039-00-0023-li-06b0"><fo:block id="W0039-00-0023-it-0c03" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>1 <fo:inline font-size="18pt" space-before="0.1mm" space-after="0.1mm">A</fo:inline>Postatis.</fo:block>
<fo:block id="W0039-00-0023-it-0c04" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>1 Accessoribus <fo:inline font-weight="normal">et</fo:inline> domesticis.</fo:block>
<fo:block id="W0039-00-0023-it-0c05" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>1 Annonis.</fo:block>
