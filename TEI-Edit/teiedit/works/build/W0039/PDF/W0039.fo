<fo:block id="W0039-00-0023-it-0bfe" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>12 Vacatione <fo:inline font-weight="normal">et</fo:inline> excusatione munerum.</fo:block>
