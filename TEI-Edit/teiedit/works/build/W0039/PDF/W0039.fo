<fo:inline> </fo:inline>missis liber.</fo:block></fo:block>
<fo:block id="W0039-00-0156-d3-06d3">
<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline> </fo:inline><fo:inline font-size="18pt" space-before="0.1mm" space-after="0.1mm">Cōmissio</fo:inline></fo:block> <fo:block id="W0039-00-0156-pa-0719" text-align="justify" font-size="12pt" text-indent="0em">facta per papā alicui expresso noie dignitatis fa
