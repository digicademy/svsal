<fo:inline> </fo:inline>casu. j. <fo:inline font-weight="normal">et</fo:inline>. vj. <fo:inline font-weight="normal">et</fo:inline>. ix. <fo:inline font-weight="normal">et</fo:inline>. xiij. <fo:inline font-weight="normal">et</fo:inline>. xxviij. <fo:inline font-weight="normal">et</fo:inline> excommunicatio. vij. in multis casibus.</fo:block></fo:block>
