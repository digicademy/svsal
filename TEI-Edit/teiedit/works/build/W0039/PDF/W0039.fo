<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline font-style="normal" id="W0039-00-0583-pb-062d"/><fo:inline role="W0039-00-0583-pb-062d" font-style="normal" font-weight="bold" font-size="12pt">[[Fo.cclxxj.]v]</fo:inline>
<fo:inline> </fo:inline><fo:inline font-size="18pt" space-before="0.1mm" space-after="0.1mm">Lectoris</fo:inline></fo:block> <fo:block id="W0039-00-0583-pa-1460" text-align="justify" font-size="12pt" text-indent="0em">officium est lectiones pronunciare <fo:inline font-weight="normal">et</fo:inline> ea que prophe
