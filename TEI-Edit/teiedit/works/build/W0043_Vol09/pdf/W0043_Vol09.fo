<fo:block id="W0043-09-0199-it-07f2" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Excommunicatio Cap. hanc con<fo:inline font-weight="normal">s</fo:inline>uetudinem. 10.<fo:inline> </fo:inline>q. 1. aduer<fo:inline font-weight="normal">s</fo:inline>us v<fo:inline font-weight="normal">s</fo:inline>urpantes obligationes intra<fo:inline> </fo:inline>Eccle<fo:inline font-weight="normal">s</fo:inline>iam factas e<fo:inline font-weight="normal">s</fo:inline>tne ip<fo:inline font-weight="normal">s</fo:inline>o iure lata. p. 257.<fo:inline> </fo:inline>num. 596.</fo:block></fo:block></fo:block></fo:block></fo:block>
<fo:block id="W0043-09-0199-it-059d" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:block id="W0043-09-0199-li-0545">
<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline> </fo:inline>F</fo:block>
