<fo:block id="W0043-09-0192-it-068e" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Circa Bonorum publicationem ob hære<fo:inline font-weight="normal">s</fo:inline>is<fo:inline> </fo:inline>crimen quid. p. 69. n. 494</fo:block>
<fo:block id="W0043-09-0192-it-068f" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>An Bona ca<fo:inline font-weight="normal">s</fo:inline>tren<fo:inline font-weight="normal">s</fo:inline>ia, vel qua<fo:inline font-weight="normal">s</fo:inline>i ca<fo:inline font-weight="normal">s</fo:inline>tren<fo:inline font-weight="normal">s</fo:inline>ia publicentur ob hære<fo:inline font-weight="normal">s</fo:inline>im filij. p. 72.<fo:inline> </fo:inline>num. 511</fo:block>
<fo:block id="W0043-09-0192-it-0690" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>An re<fo:inline font-weight="normal">s</fo:inline>eruanda <fo:inline font-weight="normal">s</fo:inline>int Bona filiis perpetrantis<fo:inline> </fo:inline>crimen læ<fo:inline font-weight="normal">s</fo:inline>æ maie<fo:inline font-weight="normal">s</fo:inline>tatis diuinæ, vel humanæ.<fo:inline> </fo:inline>ibid. n. 514</fo:block>
<fo:block id="W0043-09-0192-it-0691" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Filiis parentum, quorum Bona publicata <fo:inline font-weight="normal">s</fo:inline>unt<fo:inline> </fo:inline>ob hære<fo:inline font-weight="normal">s</fo:inline>is crimen, po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>untne in foro con<fo:inline font-weight="normal">s</fo:inline>cientiæ ab<fo:inline font-weight="normal">s</fo:inline>condere ad <fo:inline font-weight="normal">s</fo:inline>ui <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>tentationem<fo:inline> </fo:inline>alimenta, <fo:inline font-weight="normal">s</fo:inline>i illis non re<fo:inline font-weight="normal">s</fo:inline>eruentur, &amp; graui nece<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>itate <fo:inline font-weight="normal">s</fo:inline>int afficiendi. ibid.<fo:inline> </fo:inline>num. 517</fo:block>
<fo:block id="W0043-09-0192-it-0692" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>An quando delictum confi<fo:inline font-weight="normal">s</fo:inline>cationem habet<fo:inline> </fo:inline>annexum delinquens ip<fo:inline font-weight="normal">s</fo:inline>o facto priuetur<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>uorum Bonorum dominio. pag 75.<fo:inline> </fo:inline>num. 532</fo:block>
<fo:block id="W0043-09-0192-it-0693" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>An confi<fo:inline font-weight="normal">s</fo:inline>catio obliget delinquentem cui Bona <fo:inline font-weight="normal">s</fo:inline>unt ip<fo:inline font-weight="normal">s</fo:inline>o iure confi<fo:inline font-weight="normal">s</fo:inline>caa, ca fi<fo:inline font-weight="normal">s</fo:inline>co antet<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>ententiam tradere. ibidem numero 535</fo:block>
<fo:block id="W0043-09-0192-it-0694" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Confi<fo:inline font-weight="normal">s</fo:inline>catio ip<fo:inline font-weight="normal">s</fo:inline>o iure ob delictum hære<fo:inline font-weight="normal">s</fo:inline>is<fo:inline> </fo:inline>impo<fo:inline font-weight="normal">s</fo:inline>ita impeditne, vt delinquens valide<fo:inline> </fo:inline>po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>it <fo:inline font-weight="normal">s</fo:inline>ua Bona alienare. ibidem<fo:inline> </fo:inline>numero 538</fo:block>
<fo:block id="W0043-09-0192-it-0695" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Bonorum confi<fo:inline font-weight="normal">s</fo:inline>catio delinquenti in contumaciam ob cau<fo:inline font-weight="normal">s</fo:inline>am fidei, quo tempore <fo:inline font-weight="normal">s</fo:inline>it<fo:inline> </fo:inline>facienda. pagina 77. numero 553</fo:block>
