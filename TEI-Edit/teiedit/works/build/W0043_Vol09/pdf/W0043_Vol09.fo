ght="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Baptizatus<fo:inline> </fo:inline>ab hæreticis<fo:inline> </fo:inline>irregularis<fo:inline> </fo:inline>fit.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0149-nm-08ec" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0149-nm-08ec">1284 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Et baptizatus in periculo mortis.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0149-nm-08ed" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0149-nm-08ed">1285 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Et furtiue<fo:inline> </fo:inline>ordinatus.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0149-nm-08ee" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0149-nm-08ee">1286 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Et coniugatus illegitime ordinatus.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0149-nm-08ef" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0149-nm-08ef">1287 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Exercens<fo:inline> </fo:inline>Ordinem,<fo:inline> </fo:inline>quem non<fo:inline> </fo:inline>habet, irregularis fit.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0149-nm-08f0" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0149-nm-08f0">1288 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Excipio facientem id<fo:inline> </fo:inline>eo modo,<fo:inline> </fo:inline>quo à laicis<fo:inline> </fo:inline>licite fit.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0149-nm-08f1" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0149-nm-08f1">1289 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Violans cẽ<fo:inline font-weight="normal">s</fo:inline>uram per<fo:inline> </fo:inline>actum Ordinis Sacriirregularis<fo:inline> </fo:inline>e<fo:inline font-weight="normal">s</fo:inline>t.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0149-nm-08f2" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0149-nm-08f2">1290 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Hæretici<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>unt irregulares.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0149-nm-08f3" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0149-nm-08f3">1291 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Et eorum<fo:inline> </fo:inline>fautores, ac<fo:inline> </fo:inline>filij.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0149-nm-08f4" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0149-nm-08f4">1292 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Et qui iure<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>unt infames.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0150-nm-08f5" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0150-nm-08f5">1293 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Non omnis<fo:inline> </fo:inline>infamia irregularitatẽ inducit.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0150-nm-08f6" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0150-nm-08f6">1294 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Non e<fo:inline font-weight="normal">s</fo:inline>t irregularis,<fo:inline> </fo:inline>qui conatur<fo:inline> </fo:inline>occidere,<fo:inline> </fo:inline>aut mutilare.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0150-nm-08f7" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0150-nm-08f7">1295 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Voluntarie<fo:inline> </fo:inline><fo:inline font-weight="normal">aliquem</fo:inline> occidens, aut<fo:inline> </fo:inline>mutilans,<fo:inline> </fo:inline>irregularis<fo:inline> </fo:inline>est.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0150-nm-08f8" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0150-nm-08f8">1296 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Quid dicatur proprie<fo:inline> </fo:inline>membrum,<fo:inline> </fo:inline>cuius mutilatio irregularitatẽ<fo:inline> </fo:inline>inducat.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0150-nm-08f9" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0150-nm-08f9">1297 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">regularis<fo:inline> </fo:inline>Ie<fo:inline font-weight="normal">s</fo:inline>t, <fo:inline font-weight="normal">s</fo:inline>ponte<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>ibi partem<fo:inline> </fo:inline>digiti amputans.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0150-nm-08fa" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0150-nm-08fa">1298 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Et procurãs<fo:inline> </fo:inline>abortum.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0150-nm-08fb" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0150-nm-08fb">1299 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Et apponẽs<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>ionte cau<fo:inline font-weight="normal">s</fo:inline>am, ex qua<fo:inline> </fo:inline>videt, mortem alteri<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>ecuturam.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0150-nm-08fc" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0150-nm-08fc">1300 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Et mandans, con<fo:inline font-weight="normal">s</fo:inline>ulens, &amp;c.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0150-nm-08fd" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0150-nm-08fd">1301 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Non vero<fo:inline> </fo:inline>qui mandat<fo:inline> </fo:inline>Antonio<fo:inline> </fo:inline><fo:inline font-weight="normal">Petrum</fo:inline> occidere. <fo:inline font-weight="normal">s</fo:inline>i Antonius occidatur.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0150-nm-08fe" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0150-nm-08fe">1302 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Nec leniorẽ<fo:inline> </fo:inline>mortem reo<fo:inline> </fo:inline>impetrans,<fo:inline> </fo:inline>aut mutila,<fo:inline> </fo:inline>tionem loco<fo:inline> </fo:inline>necis <fo:inline font-weight="normal">s</fo:inline>uadet.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0150-nm-08ff" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0150-nm-08ff">1303 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Multi vnũ<fo:inline> </fo:inline>occidentes,<fo:inline> </fo:inline>irregulares<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>unt.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0150-nm-0900" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0150-nm-0900">1304 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Et qui de<fo:inline font-weight="normal">s</fo:inline>init impedire occi<fo:inline font-weight="normal">s</fo:inline>ionem eius,<fo:inline> </fo:inline>cui ad id<fo:inline> </fo:inline>gerendum<fo:inline> </fo:inline>ex iu<fo:inline font-weight="normal">s</fo:inline>titia<fo:inline> </fo:inline>obligatur.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0151-nm-0901" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0151-nm-0901">1305 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Vt homicidii ca<fo:inline font-weight="normal">s</fo:inline>uale<fo:inline> </fo:inline>irregularitem inducat<fo:inline> </fo:inline>culpam lethalem requirit.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0151-nm-0902" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0151-nm-0902">1306 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic"><fo:inline font-weight="normal">Non</fo:inline> fit irregularis qui<fo:inline> </fo:inline>dans operã<fo:inline> </fo:inline>rei licitæ, <fo:inline font-weight="normal">s</fo:inline>ine lata culpa occidit.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0151-nm-0903" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0151-nm-0903">1307 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Nec dans<fo:inline> </fo:inline>operam rei<fo:inline> </fo:inline>illicitæ, ni<fo:inline font-weight="normal">s</fo:inline>i<fo:inline> </fo:inline>res ita <fo:inline font-weight="normal">s</fo:inline>it<fo:inline> </fo:inline>periculo<fo:inline font-weight="normal">s</fo:inline>a.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0151-nm-0904" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0151-nm-0904">1308 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Debet culpa e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e lethalis præci<fo:inline font-weight="normal">s</fo:inline>e ratione<fo:inline> </fo:inline>periculi.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0151-nm-0905" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0151-nm-0905">1309 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Irregularis<fo:inline> </fo:inline>non e<fo:inline font-weight="normal">s</fo:inline>t, qui<fo:inline> </fo:inline>occidit in<fo:inline> </fo:inline>defen<fo:inline font-weight="normal">s</fo:inline>ionem<fo:inline> </fo:inline>innocentis.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0151-nm-0906" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0151-nm-0906">1310 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Nec occidẽs<fo:inline> </fo:inline>conantẽ <fo:inline font-weight="normal">s</fo:inline>ibi pudicitiã<fo:inline> </fo:inline>honoremve,<fo:inline> </fo:inline>&amp;c. eripere.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0151-nm-0907" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0151-nm-0907">1311 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Alium ad<fo:inline> </fo:inline>mortem condemnans fit<fo:inline> </fo:inline>irregularis.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0151-nm-0908" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0151-nm-0908">1312 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Qui in reimortẽ directe influunt<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>unt irregulares.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0151-nm-0909" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0151-nm-0909">1313 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Non vero,<fo:inline> </fo:inline>qui indirecte <fo:inline font-weight="normal">sunt</fo:inline> cau<fo:inline font-weight="normal">s</fo:inline>a mortis.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0152-nm-090a" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0152-nm-090a">1314 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Nec qui<fo:inline> </fo:inline>hortantur<fo:inline> </fo:inline>generatim<fo:inline> </fo:inline>in bello iu<fo:inline font-weight="normal">s</fo:inline>to ad pugnãdum, imo<fo:inline> </fo:inline>ad occidendum in genere.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0152-nm-090b" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0152-nm-090b">1315 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Secus ad<fo:inline> </fo:inline>hortantes,<fo:inline> </fo:inline>vel pugnantes in bello<fo:inline> </fo:inline>iniu<fo:inline font-weight="normal">s</fo:inline>to.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0152-nm-090c" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0152-nm-090c">1316 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Bigamus<fo:inline> </fo:inline>vnde irregul