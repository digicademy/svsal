line> Et colligo ex Tridentin. <fo:inline font-style="italic"><fo:inline font-weight="normal">s</fo:inline>e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>. 14.<fo:inline> </fo:inline>cap. 7.</fo:inline></fo:block>
