weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Nunquam<fo:inline> </fo:inline>incurritur<fo:inline> </fo:inline>irregularitas ni<fo:inline font-weight="normal">s</fo:inline>i in<fo:inline> </fo:inline>ca<fo:inline font-weight="normal">s</fo:inline>ib. à iure<fo:inline> </fo:inline>expre<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>is.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0148-nm-08e2" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0148-nm-08e2">1274 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Ad digno<fo:inline font-weight="normal">s</fo:inline>cendum<fo:inline> </fo:inline>quandonam<fo:inline> </fo:inline>iure hanc<fo:inline> </fo:inline>pœnam imponant. Regual prima.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0148-nm-08e3" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0148-nm-08e3">1275 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Regula <fo:inline font-weight="normal">s</fo:inline>ecunda.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0148-nm-08e4" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-09-0148-nm-08e4">1276 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Regula tertia.</fo:inline></fo:inline></fo:block><fo:block id="W0043-09-0148-nm-08e5" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight=