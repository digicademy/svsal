lock>
<fo:block id="W0043-09-0158-pa-1002" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline baseline-shift="super" font-size="9pt" font-weight="bold" id="#W0043-09-0158-nm-094b"><fo:basic-link color="#0a0c75" internal-destination="W0043-09-0158-nm-094b">1379</fo:basic-link></fo:inline><fo:inline> </fo:inline>Hanc <fo:inline font-weight="normal">s</fo:inline>ententiam non minus probabiliem<fo:inline font-style="normal" id="W0043-09-0159-pb-048d"/><fo:inline role="W0043-09-0159-pb-048d" font-style="normal" font-weight="bold" font-size="12pt">[339]</fo:inline><fo:inline> </fo:inline>eligo. Nam pœnalis irregularitas plerumque<fo:inline> </fo:inline>ab Eccle<fo:inline font-weight="normal">s</fo:inline>ia indicitur in pœnam inobedientiæ, &amp; contumaciæ aduer<fo:inline font-weight="normal">s</fo:inline>us Eccle<fo:inline font-weight="normal">s</fo:inline>iam: <fo:inline font-weight="normal">s</fo:inline>iquidem <fo:inline font-weight="normal">s</fo:inline>uperadditur violationi Cen<fo:inline font-weight="normal">s</fo:inline>urarum,<fo:inline> </fo:inline>quæ inobedientiam, &amp; contumaciam requirunt. At inobedientia, &amp; contumacia in Eccle<fo:inline font-weight="normal">s</fo:inline>iam <fo:inline font-weight="normal">s</fo:inline>tare nequit po<fo:inline font-weight="normal">s</fo:inline>ita Eccle<fo:inline font-weight="normal">s</fo:inline>ia<fo:inline font-weight="normal">s</fo:inline>ticæ legis ignorantia: ergo. E<fo:inline font-weight="normal">s</fo:inline>to autem ob decentiam<fo:inline> </fo:inline>Eccle<fo:inline font-weight="normal">s</fo:inline>ia<fo:inline font-weight="normal">s</fo:inline>tici <fo:inline font-weight="normal">s</fo:inline>tatus irregularitas inducatur: at<fo:inline> </fo:inline>quia <fo:inline font-weight="normal">s</fo:inline>imul inducitur in pœnam obedientiæ<fo:inline> </fo:inline>violatæ, locum habere non pote<fo:inline font-weight="normal">s</fo:inline>t, ce<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ante<fo:inline> </fo:inline>inobedientia, quæ proculdubio ce<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>at, po<fo:inline font-weight="normal">s</fo:inline>ita<fo:inline> </fo:inline>legis Eccle<fo:inline font-weight="normal">s</fo:inline>ia<fo:inline font-weight="normal">s</fo:inline>ticæ ignorantia.</fo:block>
