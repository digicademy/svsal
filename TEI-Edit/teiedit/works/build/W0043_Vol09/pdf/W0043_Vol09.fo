<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline> </fo:inline><fo:inline font-style="italic">Fides</fo:inline></fo:block>
<fo:block id="W0043-09-0199-it-07f5" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline font-family="serif" font-size="18pt" space-before="0.1mm" space-after="0.1mm">F</fo:inline>Ides quæ? p. 1. n. 1.</fo:block>
<fo:block id="W0043-09-0199-it-07f6" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Fides no<fo:inline font-weight="normal">s</fo:inline>træ iu<fo:inline font-weight="normal">s</fo:inline>tificationis initium. ibid.</fo:block>
