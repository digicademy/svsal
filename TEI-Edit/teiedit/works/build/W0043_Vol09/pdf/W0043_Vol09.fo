. 4. cap. 5. num.<fo:inline> </fo:inline>3.</fo:inline> Bonacin. <fo:inline font-style="italic">tom. 1. di<fo:inline font-weight="normal">s</fo:inline>putation. 5. puncto vltimo, numer. 6.</fo:inline> Filliucius <fo:inline font-style="italic">tractat. 18. capti. 5.<fo:inline> </fo:inline>quæ<fo:inline font-weight="normal">s</fo:inline>t. 8.</fo:inline></fo:block>
<fo:block id="W0043-09-0140-pa-0e79" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline baseline-shift="super" font-size="9pt" font-weight="bold" id="#W0043-09-0140-nm-089f"><fo:basic-link color="#0a0c75" internal-destination="W0043-09-0140-nm-089f">1207</fo:basic-link></fo:inline><fo:inline> </fo:inline>Idem cen<fo:inline font-weight="normal">s</fo:inline>eo. Ideo enim Glo<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline> <fo:inline font-style="italic">ad cap. Præ<fo:inline font-weight="normal">s</fo:inline>enti, de <fo:inline font-weight="normal">s</fo:inline>ertentia excommunicationis, in 6. verbo<fo:inline> </fo:inline>Generaliter,</fo:inline> æquiparat Cen<fo:inline font-weight="normal">s</fo:inline>uras excommunicationis, &amp; interdicti per<fo:inline font-weight="normal">s</fo:inline>onalis <fo:inline font-weight="normal">s</fo:inline>pecialis quoad ab<fo:inline font-weight="normal">s</fo:inline>olutionem. Dixi verò <fo:inline font-style="italic">Non re<fo:inline font-weight="normal">s</fo:inline>eruatum:</fo:inline><fo:inline> </fo:inline>nam ab interdicto per<fo:inline font-weight="normal">s</fo:inline>onali <fo:inline font-weight="normal">s</fo:inline>peciali re<fo:inline font-weight="normal">s</fo:inline>eruato nullus alius præter ip<fo:inline font-weight="normal">s</fo:inline>um, cui e<fo:inline font-weight="normal">s</fo:inline>t facta<fo:inline> </fo:inline>re<fo:inline font-weight="normal">s</fo:inline>eruatio, vel illius Superiorem ab<fo:inline font-weight="normal">s</fo:inline>oluere<fo:inline> </fo:inline>poterit.</fo:block>
