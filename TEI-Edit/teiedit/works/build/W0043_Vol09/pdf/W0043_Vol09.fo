rregularis ca<fo:inline font-weight="normal">s</fo:inline>u, quo per<fo:inline font-weight="normal">s</fo:inline>ententiam<fo:inline> </fo:inline>priuetur, po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>it irregularis con<fo:inline font-weight="normal">s</fo:inline>cius huius impetrationis, beneficium in fauorem alterius, vel<fo:inline> </fo:inline>ab<fo:inline font-weight="normal">s</fo:inline>olute, antequam per <fo:inline font-weight="normal">s</fo:inline>ententiam condemnetur, renunciare?</fo:block>
