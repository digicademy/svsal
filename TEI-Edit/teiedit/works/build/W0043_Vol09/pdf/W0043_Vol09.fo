nt-weight="normal">s</fo:inline>o Eccle<fo:inline font-weight="normal">s</fo:inline>ię contemptu, violentia, fraude, alii<fo:inline font-weight="normal">s</fo:inline>que circum<fo:inline font-weight="normal">s</fo:inline>tantiis<fo:inline> </fo:inline>extrin<fo:inline font-weight="normal">s</fo:inline>ecis peccatum mortale laici committant, <fo:inline font-weight="normal">s</fo:inline>i in loco interdicto diuinis a<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>i<fo:inline font-weight="normal">s</fo:inline>tant.</fo:block>
