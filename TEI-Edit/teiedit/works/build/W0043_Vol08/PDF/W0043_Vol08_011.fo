<fo:block id="W0043-08-0009-it-064a" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-08-0053-d3-0651" color="#0a0c75"><fo:inline font-style="italic">Cap. 11.</fo:inline> De Hæreticorum Pœnis.<fo:inline> </fo:inline>p. 13</fo:basic-link> </fo:inline></fo:block>
