e <fo:inline font-weight="normal">s</fo:inline>ermonem de di<fo:inline font-weight="normal">s</fo:inline>po<fo:inline font-weight="normal">s</fo:inline>itione <fo:inline font-weight="normal">s</fo:inline>impliciter nece<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>aria adhuc ex præcepto ad iu<fo:inline font-weight="normal">s</fo:inline>tificationem medio Bapti<fo:inline font-weight="normal">s</fo:inline>mo faciendam: <fo:inline font-weight="normal">s</fo:inline>ed<fo:inline> </fo:inline>de di<fo:inline font-weight="normal">s</fo:inline>po<fo:inline font-weight="normal">s</fo:inline>itione, qua adulti baptizandi ad<fo:inline> </fo:inline>eam iu<fo:inline font-weight="normal">s</fo:inline>tificationem regulariter di<fo:inline font-weight="normal">s</fo:inline>ponuntur.</fo:block>
