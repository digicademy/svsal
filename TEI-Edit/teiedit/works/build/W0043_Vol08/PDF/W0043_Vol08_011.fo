<fo:block id="W0043-08-0016-it-0831" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>171. Tibi <fo:inline font-weight="normal">s</fo:inline>ecreto naturali, commi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>um<fo:inline> </fo:inline>e<fo:inline font-weight="normal">s</fo:inline>t, fœminam fui<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e ab aliquo Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ario <fo:inline font-weight="normal">s</fo:inline>olicitatam, excu<fo:inline font-weight="normal">s</fo:inline>ari<fo:inline font-weight="normal">s</fo:inline>ne à denunciatione gerenda.<fo:inline> </fo:inline>ibid.</fo:block>
