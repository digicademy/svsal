ternal-destination="#W0043-08-0047-nm-0413">43 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Quadruplici ex capite<fo:inline> </fo:inline>pote<fo:inline font-weight="normal">s</fo:inline>t e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e illicita di<fo:inline font-weight="normal">s</fo:inline>putatio de<fo:inline> </fo:inline>fidei rebus,<fo:inline> </fo:inline>Primo ex fine.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0047-nm-0414" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0047-nm-0414">44 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Secundo, ex<fo:inline> </fo:inline>parte di<fo:inline font-weight="normal">s</fo:inline>putantis.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0047-nm-0415" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0047-nm-0415">45 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Tertio, ex<fo:inline> </fo:inline>parte auditorum.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0047-nm-0416" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0047-nm-0416">46 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Quarto ex<fo:inline> </fo:inline>di<fo:inline font-weight="normal">s</fo:inline>putandi<fo:inline> </fo:inline>modo.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0047-nm-0417" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0047-nm-0417">47 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Fides duo<fo:inline> </fo:inline>vitia contraria habet, leuitatem credendi, &amp; Infidelitatem.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0047-nm-0418" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0047-nm-0418">48 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Triplex est<fo:inline> </fo:inline>Infidelitas,<fo:inline> </fo:inline>negatiua<fo:inline> </fo:inline>priuatiua,<fo:inline> </fo:inline>&amp; po<fo:inline font-weight="normal">s</fo:inline>itiua.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0047-nm-0419" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0047-nm-0419">49 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Infidelitas<fo:inline> </fo:inline>negatiua<fo:inline> </fo:inline>peccatum<fo:inline> </fo:inline>non est.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0047-nm-041a" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0047-nm-041a">50 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Priuatiua<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>emper e<fo:inline font-weight="nor