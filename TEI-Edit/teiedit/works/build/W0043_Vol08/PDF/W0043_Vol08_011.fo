ine> primam <fo:inline font-weight="normal">s</fo:inline>ententiam docui<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e, <fo:inline font-weight="normal">s</fo:inline>ed<fo:inline> </fo:inline>tanti Diui venia, rigidè exi<fo:inline font-weight="normal">s</fo:inline>timo <fo:inline font-weight="normal">s</fo:inline>en<fo:inline font-weight="normal">s</fo:inline>i<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e,<fo:inline> </fo:inline>&amp; non <fo:inline font-weight="normal">s</fo:inline>olido omnino fundamento.</fo:block>
