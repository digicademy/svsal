<fo:block text-align="center" font-size="30pt" font-weight="bold" space-before="10mm"><fo:inline font-style="normal" id="W0043-08-0001-pb-03e8"/><fo:inline role="W0043-08-0001-pb-03e8" font-style="normal" font-weight="bold" font-size="12pt">[[i]]</fo:inline><fo:inline> </fo:inline>R.P. ANTONII<fo:inline> </fo:inline>DE ESCOBAR<fo:inline> </fo:inline>ET MENDOZA,<fo:inline> </fo:inline>VALLISOLETANI,<fo:inline> </fo:inline>Societatis Iesv Theologi,
<fo:inline> </fo:inline>VNIVERSÆ THEOLOGIÆ<fo:inline> </fo:inline>MORALIS, RECEPTIORES ABSQVE<fo:inline> </fo:inline>Lite Sententiæ nec-non Controuer<fo:inline font-weight="bold">s</fo:inline>æ Di<fo:inline font-weight="bold">s</fo:inline>qui<fo:inline font-weight="bold">s</fo:inline>itiones,</fo:block>
<fo:block text-align="center" font-size="30pt" font-weight="bold" space-before="10mm"><fo:inline> </fo:inline>TOMI SEXTI PARS PRIMA:<fo:inline> </fo:inline>VIRTVTES THEOLOGICÆ.</fo:block>
<fo:block text-align="center" font-size="30pt" font-weight="bold" space-before="10mm"><fo:inline> </fo:inline><fo:inline font-style="italic">LIBRO TRIPLICI FIDEI, SEPEI,<fo:inline> </fo:inline>&amp; Charitatis materias expono.</fo:inline></fo:block>
<fo:block text-align="center" font-size="30pt" font-weight="bold" space-before="10mm"><fo:inline> </fo:inline>NVNC PRIMVM IN LVCEM PRODIT.</fo:block>

<fo:block text-align="center" font-size="20pt" font-weight="normal" space-before="5mm"><fo:inline> </fo:inline>LVGDVNI,<fo:inline> </fo:inline>Sumptib. PHILIPPI BORDE, LAVRENTII ARNAVD,<fo:inline> </fo:inline>PETRI BORDE, ET GVILL. BARBIER.
<fo:inline> </fo:inline><fo:block><fo:inline font-style="italic">M. DC. LXIII.</fo:inline></fo:block>
<fo:inline> </fo:inline>CVM APPROB. ET PERMISSV.</fo:block>
<fo:inline font-style="normal" id="W0043-08-0002-pb-03e9"/><fo:inline role="W0043-08-0002-pb-03e9" font-style="normal" font-weight="bold" font-size="12pt">[[ii]]</fo:inline>
</fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="body_matter" initial-page-number="1"><fo:static-content flow-name="body_matter_odd-region-before"><fo:block text-align="center">
                     
                        Antonio
                        de
                        Escobar y Mendoza
                    
                </fo:block></fo:static-content><fo:static-content flow-name="body_matter_even-region-before"><fo:block text-align="center">Universae Theologiae Moralis receptiores</fo:block></fo:static-content><fo:static-content flow-name="body_matter_odd-region-after"><fo:block text-align="right"><fo:page-number font-style="normal"/></fo:block></fo:static-content><fo:static-content flow-name="body_matter_even-region-after"><fo:block text-align="left"><fo:page-number font-style="normal"/></fo:block></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block><fo:table><fo:table-body><fo:table-row><fo:table-cell padding-top="5mm" padding-bottom="5mm"><fo:block text-align="center" font-size="12pt" text-indent="0pt" font-weight="bold" keep-with-next="always"><fo:marker marker-class-name="chapNum"/></fo:block></fo:table-cell></fo:table-row><fo:table-row><fo:table-cell><fo:block id="W0043-08-0003-d1-03e8">

<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline font-style="normal" id="W0043-08-0003-pb-03ea"/><fo:inline role="W0043-08-0003-pb-03ea" font-style="normal" font-weight="bold" font-size="12pt">[[iii]]</fo:inline><fo:inline> </fo:inline>EXCELLENT.<fo:inline baseline-shift="super" font-size="8pt">MO</fo:inline> D.D. CAROLO<fo:inline> </fo:inline>BARONI DE BATIBILE,<fo:inline> </fo:inline><fo:inline font-style="italic">COMITI DE CORBIERS,<fo:inline> </fo:inline>Marchioni de Hu<fo:inline font-weight="bold">s</fo:inline>ia, Regis Catholici à Con<fo:inline font-weight="bold">s</fo:inline>iliis in Supremo de GVERRA, Flandriæ<fo:inline> </fo:inline>&amp; Burgundiæ <fo:inline font-weight="bold">s</fo:inline>tatu, Guipuzcoanæ Prouinciæ<fo:inline> </fo:inline>Generali Duci, Hi<fo:inline font-weight="bold">s</fo:inline>panus apud Angliam pacis<fo:inline> </fo:inline>ac belli curatori.</fo:inline></fo:block>
<fo:block id="W0043-08-0003-pa-03ea" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline> </fo:inline><fo:inline font-family="serif" font-size="18pt" space-before="0.1mm" space-after="0.1mm">H</fo:inline>AVD tempus, Princeps Excellentissime, in longa atauorum tuorum <fo:inline font-weight="normal">s</fo:inline>erie recen<fo:inline font-weight="normal">s</fo:inline>enda, <fo:inline font-weight="normal">s</fo:inline>temmatibu<fo:inline font-weight="normal">s</fo:inline>que o<fo:inline font-weight="normal">s</fo:inline>tentandis inutiliter teram, <fo:inline font-weight="normal">s</fo:inline>ciens, ex tua magnitudine, &amp;<fo:inline font-style="normal" id="W0043-08-0004-pb-03eb"/><fo:inline role="W0043-08-0004-pb-03eb" font-style="normal" font-weight="bold" font-size="12pt">[[iv]]</fo:inline><fo:inline> </fo:inline>decore non <fo:inline font-weight="normal">s</fo:inline>olum Tibi abundare gloriam, <fo:inline font-weight="normal">s</fo:inline>ed<fo:inline> </fo:inline>ad po<fo:inline font-weight="normal">s</fo:inline>teritatis incrementum, &amp; ornatum nobilitatem exundare, cuius clari<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>imæ pro<fo:inline font-weight="normal">s</fo:inline>apiæ<fo:inline> </fo:inline>hæreditarium decus progenitoribus tuis ita per<fo:inline font-weight="normal">s</fo:inline>oluis, vicémque generosè rependis, vt non minus illis de po<fo:inline font-weight="normal">s</fo:inline>tero, quàm tibi de parentibus liceat gloriari. Vt enim cecinit Græcus Periander,<fo:inline> </fo:inline><fo:inline font-style="italic"><fo:inline font-weight="normal">s</fo:inline>uprema nobilitas e<fo:inline font-weight="normal">s</fo:inline>t, cum tanta in viro fortitudo,<fo:inline> </fo:inline>tanta <fo:inline font-weight="normal">s</fo:inline>apienta, virtus tanta nitet, vt ad eius encomia nihil nobilitas addere videatur.</fo:inline> Tanta fortitudine Te præditum video, tam <fo:inline font-weight="normal">s</fo:inline>apientem Te annoto, adeo virtutibus fulgentem Te contemplor: vt Tuæ egregiæ nobilitatis mihi iubar obnubiletur.</fo:block>
<fo:block id="W0043-08-0004-pa-03eb" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline> </fo:inline>Attamen tuum illu<fo:inline font-weight="normal">s</fo:inline>tri<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>imum auitum <fo:inline font-weight="normal">s</fo:inline>temma video e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e tuæ fortitudinis, <fo:inline font-weight="normal">s</fo:inline>apientiæ, ac virtutis hieroglyphicum. In his enim clari<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>imis <fo:inline font-weight="normal">s</fo:inline>temmatibus tres volitantes <fo:inline font-style="italic">Alas</fo:inline> A<fo:inline font-weight="normal">s</fo:inline>picio. Quas quidem non aquilæ voluerum Reginæ e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e voluerim, <fo:inline font-weight="normal">s</fo:inline>ed <fo:inline font-style="italic">Cherubini,</fo:inline> qui per<fo:inline font-weight="normal">s</fo:inline>picuum e<fo:inline font-weight="normal">s</fo:inline>t triplicis<fo:inline> </fo:inline>præfati elogij documentum. Theodoretus enim<fo:inline> </fo:inline>quæ<fo:inline font-weight="normal">s</fo:inline>t. 40. in Gen. a<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>erit, nomen <fo:inline font-style="italic">Cherub</fo:inline> <fo:inline font-weight="normal">s</fo:inline>emper<fo:inline> </fo:inline><fo:inline font-style="italic">potentiam</fo:inline> <fo:inline font-weight="normal">s</fo:inline>ignificare, nam <fo:inline font-style="italic">Che</fo:inline> idem e<fo:inline font-weight="normal">s</fo:inline>t Hebræis,<fo:inline> </fo:inline>quod, <fo:inline font-style="italic">Qua<fo:inline font-weight="normal">s</fo:inline>i,</fo:inline> &amp; <fo:inline font-style="italic">Rub fortem</fo:inline> <fo:inline font-weight="normal">s</fo:inline>ignificat, <fo:inline font-style="italic">Qua<fo:inline font-weight="normal">s</fo:inline>i fortis,</fo:inline> Ideo Cherubino flammea armato machæra<fo:inline> </fo:inline>paradi<fo:inline font-weight="normal">s</fo:inline>i cu<fo:inline font-weight="normal">s</fo:inline>todia traditur.</fo:block>
<fo:block id="W0043-08-0004-pa-03ec" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline> </fo:inline>Te profectò, Princeps Excellentissime,<fo:inline baseline-shift="super" font-size="9pt" font-weight="bold" id="#W0043-08-0004-nm-03e9"><fo:basic-link color="#0a0c75" internal-destination="W0043-08-0004-nm-03e9">1</fo:basic-link></fo:inline><fo:inline> </fo:inline>Cherubinum merito vocitarim, cuius fortitudo<fo:inline> </fo:inline>terra marique ho<fo:inline font-weight="normal">s</fo:inline>tium fuit horror. Te Hi<fo:inline font-weight="normal">s</fo:inline>pania,<fo:inline font-style="normal" id="W0043-08-0005-pb-03ec"/><fo:inline role="W0043-08-0005-pb-03ec" font-style="normal" font-weight="bold" font-size="12pt">[[v]]</fo:inline><fo:inline> </fo:inline>Te Italia, Te cuncta orbis Regna Martem forti<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>imum agno<fo:inline font-weight="normal">s</fo:inline>cunt. O quantam in acie admirationem compara<fo:inline font-weight="normal">s</fo:inline>ti, nihil à cæteris militibus, ni<fo:inline font-weight="normal">s</fo:inline>i robore ac præ<fo:inline font-weight="normal">s</fo:inline>tantia differens! cum eminus libero Marte tela vibrares, nunc vibrata <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>piceres,<fo:inline> </fo:inline>alacer virtute militum, &amp; lætus, quoties aut ca<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>idi tuæ, aut clypeo grauior ictus incideret. Laudabas quippe ip<fo:inline font-weight="normal">s</fo:inline>e ferientes, hortabari<fo:inline font-weight="normal">s</fo:inline>que, vt auderent; <fo:inline font-weight="normal">s</fo:inline>ed, non audebant, cum <fo:inline font-weight="normal">s</fo:inline>pectator, moderatórque ineuntium certamina virorum arma<fo:inline> </fo:inline>componeres, tela tentares, &amp; ad robur o<fo:inline font-weight="normal">s</fo:inline>tendendum vehementer vrgeres. Hæc fortitudo Te ad<fo:inline> </fo:inline>præclara bellica munia omnium præconio euexit. Ait Nazianzenus Po<fo:inline font-weight="normal">s</fo:inline>thumio forti<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>imo<fo:inline> </fo:inline>Duci, &amp; Tibi vniuer<fo:inline font-weight="normal">s</fo:inline>us orbis: <fo:inline font-style="italic">In <fo:inline font-weight="normal">s</fo:inline>ublime euectus<fo:inline> </fo:inline>es haud ita mediocri Principatus gloria, nam acceptos à Te Principatus <fo:inline font-weight="normal">s</fo:inline>ublimes reddidi<fo:inline font-weight="normal">s</fo:inline>ti. Non e<fo:inline font-weight="normal">s</fo:inline>t<fo:inline> </fo:inline>hoc fortunæ munus, <fo:inline font-weight="normal">s</fo:inline>ed hanc pote<fo:inline font-weight="normal">s</fo:inline>tatem tanquam<fo:inline> </fo:inline>fortitudinis premium adeptus es: vt &amp; ip<fo:inline font-weight="normal">s</fo:inline>a redderetur glorio<fo:inline font-weight="normal">s</fo:inline>ior, &amp; Rex propter iudicij <fo:inline font-weight="normal">s</fo:inline>ui de te <fo:inline font-weight="normal">s</fo:inline>ententiam, laudem acquireret.</fo:inline></fo:block>
<fo:block id="W0043-08-0005-pa-03ee" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline> </fo:inline>Philo verò lib. 3. de vita Mo<fo:inline font-weight="normal">s</fo:inline>is affirmat, nomen<fo:inline baseline-shift="super" font-size="9pt" font-weight="bold" id="#W0043-08-0005-nm-03ea"><fo:basic-link color="#0a0c75" internal-destination="W0043-08-0005-nm-03ea">2</fo:basic-link></fo:inline><fo:inline> </fo:inline><fo:inline font-style="italic">Cherub</fo:inline> <fo:inline font-weight="normal">s</fo:inline>cientiæ plenitudinem in <fo:inline font-weight="normal">s</fo:inline>e includere.<fo:inline> </fo:inline>Vnde Propheta Ezechiel cap. 28. v. 17. alloquens<fo:inline> </fo:inline>Regem Tyri, eumque Cherub appellans, fatur:<fo:inline> </fo:inline><fo:inline font-style="italic">Perdidi<fo:inline font-weight="normal">s</fo:inline>ti <fo:inline font-weight="normal">s</fo:inline>apientiam tuam.</fo:inline> Fui<fo:inline font-weight="normal">s</fo:inline>ti profectò ô<fo:inline> </fo:inline>Princeps, regalium negotiorum lex præfulgens, munia tibi credita eximia prudentia tracta<fo:inline font-weight="normal">s</fo:inline>ti: &amp; ni<fo:inline font-weight="normal">s</fo:inline>us es tuis con<fo:inline font-weight="normal">s</fo:inline>iliis tempora facere, quę<fo:inline font-style="normal" id="W0043-08-0006-pb-03ed"/><fo:inline role="W0043-08-0006-pb-03ed" font-style="normal" font-weight="bold" font-size="12pt">[[vi]]</fo:inline><fo:inline> </fo:inline>meritò laudarentur in Principe. Te<fo:inline font-weight="normal">s</fo:inline>tor regias<fo:inline> </fo:inline>Christianissimi Regis Potentissimi;<fo:inline> </fo:inline>cum Serenissima Theresia Avstriaca<fo:inline> </fo:inline>nuptias, &amp; initam inter Hi<fo:inline font-weight="normal">s</fo:inline>paniæ, ac. Galliæ Reges optati<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>imam; pacem. Quid tunc non ge<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>eris, quod tuum per<fo:inline font-weight="normal">s</fo:inline>picax ingenium, tuam<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>ublimem prudentiam, non o<fo:inline font-weight="normal">s</fo:inline>tentaret? Mitto<fo:inline> </fo:inline>circa humaniores litteras eruditionem, cognitionem linguarum, quarum Tu intelligentiæ, &amp; loquelæ non qua<fo:inline font-weight="normal">s</fo:inline>i aduena, <fo:inline font-weight="normal">s</fo:inline>ed indigena.</fo:block>
<fo:block id="W0043-08-0006-pa-03f0" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline> </fo:inline>Profectò in Vaticanis Bibliis <fo:inline font-style="italic">Cherub Qua<fo:inline font-weight="normal">s</fo:inline>i</fo:inline><fo:inline baseline-shift="super" font-size="9pt" font-weight="bold" id="#W0043-08-0006-nm-03eb"><fo:basic-link color="#0a0c75" internal-destination="W0043-08-0006-nm-03eb">3</fo:basic-link></fo:inline>
<fo:inline> </fo:inline><fo:inline font-style="italic">Magi<fo:inline font-weight="normal">s</fo:inline>ter</fo:inline> appellatur. Ideo Anonymus apud <fo:inline font-weight="normal">s</fo:inline>apienti<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>imum no<fo:inline font-weight="normal">s</fo:inline>trum Alca<fo:inline font-weight="normal">s</fo:inline>ar ad cap. 4. Apoc.<fo:inline> </fo:inline>annotat in Mo<fo:inline font-weight="normal">s</fo:inline>is Cherubinis figurari eos, qui<fo:inline> </fo:inline>à Deo edocti, eumque amantes, alios virtutum<fo:inline> </fo:inline>exercitamenta docent. Te quidem hoc ex capite, præcipuo plane, e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e quis non videat egregium virtutum, quæ virum <fo:inline font-weight="normal">s</fo:inline>æcularem exornant,<fo:inline> </fo:inline>magi<fo:inline font-weight="normal">s</fo:inline>terium? Te humani<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>imum cuncti Hi<fo:inline font-weight="normal">s</fo:inline>pani proclamant. Suaui<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>imum Itali viderunt, cum<fo:inline> </fo:inline>Neapolitanorum animos non ferro, <fo:inline font-weight="normal">s</fo:inline>ed prudenti<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ima <fo:inline font-weight="normal">s</fo:inline>uauitate deuinxi<fo:inline font-weight="normal">s</fo:inline>ti, diuinam fortitudinem æmulatus. Religio<fo:inline font-weight="normal">s</fo:inline>i<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>imum Te efferunt<fo:inline> </fo:inline>Templa, Religionumque Conuentus. Munificenti<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>imum quilibet indigentes experiuntur.<fo:inline> </fo:inline>Morum compo<fo:inline font-weight="normal">s</fo:inline>itione egregium omnes Te<fo:inline> </fo:inline>profitentur; quem nec aurum cæcat, nec alea<fo:inline> </fo:inline>maculat, nec voluptas infamat. Po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>em <fo:inline font-weight="normal">s</fo:inline>imul<fo:inline> </fo:inline>omnia merita virtutum, &amp; cognonima attexere: &amp;<fo:inline font-style="normal" id="W0043-08-0007-pb-03ee"/><fo:inline role="W0043-08-0007-pb-03ee" font-style="normal" font-weight="bold" font-size="12pt">[[vii]]</fo:inline><fo:inline> </fo:inline>&amp; quidem vt Au<fo:inline font-weight="normal">s</fo:inline>onius <fo:inline font-weight="normal">s</fo:inline>uo Gratiano ait, <fo:inline font-style="italic">Tanquam qui terrarum orbem vnius tabulæ ambitu<fo:inline> </fo:inline>circum <fo:inline font-weight="normal">s</fo:inline>cribunt, aliquanto detrimento magnitudinis, nullo di<fo:inline font-weight="normal">s</fo:inline>pendio veritatis.</fo:inline> Parco tamen tuarum virtutum magnitudini, ne illarum fulgenti<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>imo iubare patiantur meæ de virtutibus<fo:inline> </fo:inline>Theologicis lucubrationes, quod <fo:inline font-weight="normal">s</fo:inline>tellæ <fo:inline font-weight="normal">s</fo:inline>ub <fo:inline font-weight="normal">s</fo:inline>olis<fo:inline> </fo:inline>luce patiuntur. Recedunt igitur à luce tanta, &amp;<fo:inline> </fo:inline>ad vmbram Tuæ protectionis <fo:inline font-weight="normal">s</fo:inline>e recipiunt, vt <fo:inline font-weight="normal">s</fo:inline>ub<fo:inline> </fo:inline>nominis Tui Cherubici <fo:inline font-style="italic">potentia</fo:inline> defendantur,<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>ub <fo:inline font-style="italic"><fo:inline font-weight="normal">s</fo:inline>apientia</fo:inline> corrigant errores: <fo:inline font-weight="normal">s</fo:inline>ub <fo:inline font-style="italic">virtutum</fo:inline><fo:inline> </fo:inline>magi<fo:inline font-weight="normal">s</fo:inline>terio edi<fo:inline font-weight="normal">s</fo:inline>cant <fo:inline font-weight="normal">s</fo:inline>altem prudentiam, vt <fo:inline font-weight="normal">s</fo:inline>ciant<fo:inline> </fo:inline>inter oblatrantium voces <fo:inline font-weight="normal">s</fo:inline>ilere, <fo:inline font-weight="normal">s</fo:inline>i aliquis extiterit adeo ferox, vt audeat eas <fo:inline font-weight="normal">s</fo:inline>ub tanti Mecænatis protectione ferire.</fo:block>
<fo:block id="W0043-08-0007-pa-03f2" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline> </fo:inline><fo:inline font-style="italic">TVI HVMILLIMVS SERVVS.</fo:inline></fo:block>
<fo:block font-style="italic" text-align="right"><fo:inline> </fo:inline>Ant. de Escobar et Mendoza.</fo:block>
</fo:block></fo:table-cell></fo:table-row><fo:table-row><fo:table-cell padding-top="5mm" padding-bottom="5mm"><fo:block text-align="center" font-size="12pt" text-indent="0pt" font-weight="bold" keep-with-next="always"><fo:marker marker-class-name="chapNum"/></fo:block></fo:table-cell></fo:table-row><fo:table-row><fo:table-cell><fo:block id="W0043-08-0008-d1-03e9">
<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline font-style="normal" id="W0043-08-0008-pb-03ef"/><fo:inline role="W0043-08-0008-pb-03ef" font-style="normal" font-weight="bold" font-size="12pt">[[viii]]</fo:inline><fo:inline> </fo:inline><fo:inline font-style="italic">Facultas P. Prouincialis Societatis IESV Prouiniciæ Ca<fo:inline font-weight="bold">s</fo:inline>tellanæ.</fo:inline></fo:block>
<fo:block id="W0043-08-0008-pa-03f3" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline> </fo:inline><fo:inline font-family="serif" font-size="18pt" space-before="0.1mm" space-after="0.1mm">P</fo:inline>Etrvs Pimentel in Prouincia Ca<fo:inline font-weight="normal">s</fo:inline>tellana Societatis Iesv Præpo<fo:inline font-weight="normal">s</fo:inline>itus Prouincialis, pote<fo:inline font-weight="normal">s</fo:inline>tate ad id mihi facta à R. admodum P. No<fo:inline font-weight="normal">s</fo:inline>tro Go<fo:inline font-weight="normal">s</fo:inline>uinio Nichel<fo:inline> </fo:inline>Generali Præpo<fo:inline font-weight="normal">s</fo:inline>ito, facultatem facio vt <fo:inline font-style="italic">Tomi 4. 5. 6. &amp; 7. Theologiæ Moralis à<fo:inline> </fo:inline>P. Antonio de E<fo:inline font-weight="normal">s</fo:inline>cobar Theologo eiu<fo:inline font-weight="normal">s</fo:inline>dem Societatis</fo:inline> compo<fo:inline font-weight="normal">s</fo:inline>iti, grauium Doctorumque hominum iudicio approbati typis mandentur. In quorum fidem has litteras manu no<fo:inline font-weight="normal">s</fo:inline>tra <fo:inline font-weight="normal">s</fo:inline>ub<fo:inline font-weight="normal">s</fo:inline>criptas &amp; <fo:inline font-weight="normal">s</fo:inline>igillo munitas dedimus Valli<fo:inline font-weight="normal">s</fo:inline>oleti die 1. Octobris anno 1653.</fo:block>
<fo:block font-style="italic" text-align="right"><fo:inline> </fo:inline>PETRVS PIMENTEL.</fo:block>
</fo:block></fo:table-cell></fo:table-row><fo:table-row><fo:table-cell padding-top="5mm" padding-bottom="5mm"><fo:block text-align="center" font-size="12pt" text-indent="0pt" font-weight="bold" keep-with-next="always"><fo:marker marker-class-name="chapNum"/></fo:block></fo:table-cell></fo:table-row><fo:table-row><fo:table-cell><fo:block id="W0043-08-0008-d1-03ea">
<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline> </fo:inline><fo:inline font-style="italic">APPROBATIO.</fo:inline></fo:block>
<fo:block id="W0043-08-0008-pa-03f4" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline> </fo:inline><fo:inline font-family="serif" font-size="18pt" space-before="0.1mm" space-after="0.1mm">R.</fo:inline> <fo:inline font-style="italic">P. Antonij de E<fo:inline font-weight="normal">s</fo:inline>cobar Societatis IESV Tomos Tertium, Quartum, Quintum, Sextum, &amp; Septimum<fo:inline> </fo:inline>vniuer<fo:inline font-weight="normal">s</fo:inline>æ Theologiæ Moralis</fo:inline> attente perlegimus nos infra <fo:inline font-weight="normal">s</fo:inline>cripti facultatis Pari<fo:inline font-weight="normal">s</fo:inline>ien<fo:inline font-weight="normal">s</fo:inline>is Doctores Theologi<fo:inline> </fo:inline>nihilque in illis occurrit, quod non <fo:inline font-weight="normal">s</fo:inline>it planè con<fo:inline font-weight="normal">s</fo:inline>entaneum tum fidei Catholicæ, tum probis moribus; adeoque luce publica dignos. Actum Lugduni die 9. Februarij 1663.</fo:block>
<fo:block font-style="italic" text-align="right"><fo:inline> </fo:inline>Fr. Cyrillvs Morel <fo:inline font-style="italic">Carmeli Lugd. Prior.</fo:inline></fo:block>
<fo:block font-style="italic" text-align="right"><fo:inline> </fo:inline>Fr. Steph. Molin <fo:inline font-style="italic">Carmelita.</fo:inline></fo:block>
</fo:block></fo:table-cell></fo:table-row><fo:table-row><fo:table-cell padding-top="5mm" padding-bottom="5mm"><fo:block text-align="center" font-size="12pt" text-indent="0pt" font-weight="bold" keep-with-next="always"><fo:marker marker-class-name="chapNum"/></fo:block></fo:table-cell></fo:table-row><fo:table-row><fo:table-cell><fo:block id="W0043-08-0008-d1-03eb">
<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline> </fo:inline><fo:inline font-style="italic">Approbatio Ordinarij.</fo:inline></fo:block>
<fo:block id="W0043-08-0008-pa-03f5" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline> </fo:inline><fo:inline font-family="serif" font-size="18pt" space-before="0.1mm" space-after="0.1mm">C</fo:inline>Vm hos quinque Tomos, nempe <fo:inline font-style="italic">Tertium, Quartum, Quintum, Sextum &amp; Septimum Vniuer<fo:inline font-weight="normal">s</fo:inline>æ Theologiæ<fo:inline> </fo:inline>Moralis,</fo:inline> quorum Author e<fo:inline font-weight="normal">s</fo:inline>t <fo:inline font-style="italic">R.P. Antonius de E<fo:inline font-weight="normal">s</fo:inline>cobar Societatis IESV,</fo:inline> <fo:inline font-weight="normal">s</fo:inline>e attentè perlegi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e <fo:inline font-weight="normal">s</fo:inline>uprà<fo:inline> </fo:inline>nominati Facultatis Pari<fo:inline font-weight="normal">s</fo:inline>ien<fo:inline font-weight="normal">s</fo:inline>is Doctores Theologi te<fo:inline font-weight="normal">s</fo:inline>tentur, nihilque in illis deprehendi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e, quod non <fo:inline font-weight="normal">s</fo:inline>it<fo:inline> </fo:inline>planè con<fo:inline font-weight="normal">s</fo:inline>entaneum tum fidei Catholicæ tum probis moribus. Idcircò quinque præfatos Tomos typis mandari &amp; in lucem prodire non abnuimus Lugduni die 15. Februarij 1663.</fo:block>
<fo:block id="W0043-08-0008-pa-03f6" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline> </fo:inline>DE-NEVF-VILLE <fo:inline font-style="italic">Abbas S. Iu<fo:inline font-weight="normal">s</fo:inline>ti Vic. Gen.</fo:inline></fo:block>
</fo:block></fo:table-cell></fo:table-row><fo:table-row><fo:table-cell padding-top="5mm" padding-bottom="5mm"><fo:block text-align="center" font-size="12pt" text-indent="0pt" font-weight="bold" keep-with-next="always"><fo:marker marker-class-name="chapNum"/></fo:block></fo:table-cell></fo:table-row><fo:table-row><fo:table-cell><fo:block id="W0043-08-0008-d1-03ec">
