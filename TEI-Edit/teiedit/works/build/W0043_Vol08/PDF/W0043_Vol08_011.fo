<fo:block text-align="center" font-size="20pt" font-weight="normal" space-before="5mm"><fo:inline padding-left="0.2cm" padding-right="0.2cm" font-size="20pt" font-weight="normal"><fo:inline> </fo:inline><fo:inline font-style="italic">Circa <fo:inline font-weight="normal">s</fo:inline>pirituales hæreticorum<fo:inline> </fo:inline>pœnas.</fo:inline></fo:inline></fo:block>
