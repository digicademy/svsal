<fo:block id="W0043-08-0203-d3-0792"><fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline> </fo:inline>CAPVT XVIII.</fo:block>
<fo:block text-align="center" font-size="20pt" font-weight="normal" space-before="5mm"><fo:inline padding-left="0.2cm" padding-right="0.2cm" font-size="20pt" font-weight="normal"><fo:inline> </fo:inline><fo:inline font-style="italic">Circa Odium, Inuidiam, Chi<fo:inline font-weight="normal">s</fo:inline>ma, Vitia Charitati contraria.</fo:inline></fo:inline></fo:block>
