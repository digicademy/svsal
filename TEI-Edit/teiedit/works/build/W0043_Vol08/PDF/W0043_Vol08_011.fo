<fo:block text-align="center" font-size="20pt" font-weight="normal" space-before="5mm"><fo:inline padding-left="0.2cm" padding-right="0.2cm" font-size="20pt" font-weight="normal"><fo:inline> </fo:inline><fo:inline font-style="italic">An ad rationem <fo:inline font-weight="normal">s</fo:inline>candali <fo:inline font-weight="normal">s</fo:inline>it nece<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>arium e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e proximo ruinæ <fo:inline font-weight="normal">s</fo:inline>piritualis, <fo:inline font-weight="normal">s</fo:inline>eu peccatiocca<fo:inline font-weight="normal">s</fo:inline>ionem?</fo:inline></fo:inline></fo:block>
