ck id="W0043-08-0048-nm-0422" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0048-nm-0422">58 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Quãdonam<fo:inline> </fo:inline>liceat cum<fo:inline> </fo:inline>infideli non<fo:inline> </fo:inline>baptizato<fo:inline> </fo:inline>communicare?</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0048-nm-0423" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0048-nm-0423">59 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">In nouem<fo:inline> </fo:inline>ca<fo:inline font-weight="normal">s</fo:inline>ibus communicatio<fo:inline> </fo:inline>cum Iudæis<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>peciatim<fo:inline> </fo:inline>prohibetur.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0049-nm-0424" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0049-nm-0424">60 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Hære<fo:inline font-weight="normal">s</fo:inline>is definitio.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0049-nm-0425" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0049-nm-0425">61 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Tria <fo:inline font-weight="normal">s</fo:inline>unt<fo:inline> </fo:inline>nece<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>aria,<fo:inline> </fo:inline>vt quis hæreticus dicatur.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0049-nm-0426" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0049-nm-0426">62 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Hinc paruuli hæreticorum excu<fo:inline font-weight="normal">s</fo:inline>antur.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0049-nm-0427" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0049-nm-0427">63 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Et qui in<fo:inline> </fo:inline>ebrietate<fo:inline> </fo:inline>hære<fo:inline font-weight="normal">s</fo:inline>es profert, licet <fo:inline font-weight="normal">s</fo:inline>e<fo:inline> </fo:inline>inebiarit ea<fo:inline> </fo:inline>intentione.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0049-nm-0428" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0049-nm-0428">64 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Inuoluntarie dubitans<fo:inline> </fo:inline>de fide non<fo:inline> </fo:inline>e<fo:inline font-weight="normal">s</fo:inline>t hæreticus.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0049-nm-0429" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="