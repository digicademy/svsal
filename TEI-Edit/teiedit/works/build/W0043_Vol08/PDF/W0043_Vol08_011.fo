<fo:block id="W0043-08-0009-it-0645" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-08-0047-d3-064c" color="#0a0c75"><fo:inline font-style="italic">Caput 6.</fo:inline> De Di<fo:inline font-weight="normal">s</fo:inline>putatione circa Fidei<fo:inline> </fo:inline>My<fo:inline font-weight="normal">s</fo:inline>teria.<fo:inline> </fo:inline>p. 7</fo:basic-link> </fo:inline></fo:block>
