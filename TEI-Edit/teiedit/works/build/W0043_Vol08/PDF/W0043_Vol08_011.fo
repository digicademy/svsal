<fo:block id="W0043-08-0030-it-09b2" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>17. Sub nomine fructus beneficij,<fo:inline> </fo:inline>quo <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>pen<fo:inline font-weight="normal">s</fo:inline>us à beneficio priuatur, comprehenditurne collatio,<fo:inline> </fo:inline>&amp; electio ad beneficium titulo beneficij competens? pagina<fo:inline> </fo:inline>276.</fo:block>
<fo:block id="W0043-08-0030-it-09b3" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>18. Si <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>pen<fo:inline font-weight="normal">s</fo:inline>io alternatiua ab officio, vel beneficio feratur, producitne effectum ip<fo:inline font-weight="normal">s</fo:inline>o iure. ibidem.</fo:block>
<fo:block id="W0043-08-0030-it-09b4" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>19. Pro violatione <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>pen<fo:inline font-weight="normal">s</fo:inline>ionis ab<fo:inline> </fo:inline>Ordine Sacro pro determinato tempore appo<fo:inline font-weight="normal">s</fo:inline>itæ incurritne irregularitas.<fo:inline> </fo:inline>ibid.</fo:block>
</fo:block>
</fo:block>
<fo:block id="W0043-08-0030-it-088a" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline font-style="italic">Caput 11.</fo:inline> Circa <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>pen<fo:inline font-weight="normal">s</fo:inline>ionis <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>pen<fo:inline font-weight="normal">s</fo:inline>ionem, &amp; ab<fo:inline font-weight="normal">s</fo:inline>olutionem. pag.<fo:inline> </fo:inline>277.
<fo:block id="W0043-08-0030-li-07a0">
<fo:block id="W0043-08-0030-it-09b6" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>20. Su<fo:inline font-weight="normal">s</fo:inline>pen<fo:inline font-weight="normal">s</fo:inline>io ab officio, &amp; ab ingre<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>u Eccle<fo:inline font-weight="normal">s</fo:inline>iæ ab<fo:inline font-weight="normal">s</fo:inline>olutè lata, &amp;<fo:inline> </fo:inline>incur<fo:inline font-weight="normal">s</fo:inline>a, <fo:inline font-weight="normal">s</fo:inline>i po<fo:inline font-weight="normal">s</fo:inline>tmodum à Iudice<fo:inline> </fo:inline>pro aliquo tempore <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>pendatur<fo:inline> </fo:inline>per appellationem interpo<fo:inline font-weight="normal">s</fo:inline>itam<fo:inline> </fo:inline>illo medio tempore, habetne effectum.<fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-08-0030-it-09b7" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>21. Su<fo:inline font-weight="normal">s</fo:inline>pen<fo:inline font-weight="normal">s</fo:inline>io ab officio vel ab ingre<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>u Eccle<fo:inline font-weight="normal">s</fo:inline>iæ, quæ non e<fo:inline font-weight="normal">s</fo:inline>t Cen<fo:inline font-weight="normal">s</fo:inline>ura, <fo:inline font-weight="normal">s</fo:inline>ed pura pœna, <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>penditurne per appellationem. ibidem.</fo:block>
<fo:block id="W0043-08-0030-it-09b8" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>22. Manente <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>pen<fo:inline font-weight="normal">s</fo:inline>ione, alij à Pontifice illam ferentes po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>untne eius<fo:inline> </fo:inline>effectum, &amp; obligationem tollere, ac <fo:inline font-weight="normal">s</fo:inline>i de facto illa <fo:inline font-weight="normal">s</fo:inline>ublata e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>et.<fo:inline> </fo:inline>p. 278</fo:block>
<fo:block id="W0043-08-0030-it-09b9" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>231. Su<fo:inline font-weight="normal">s</fo:inline>pen<fo:inline font-weight="normal">s</fo:inline>io lata à iure ab<fo:inline font-weight="normal">s</fo:inline>olutè<fo:inline> </fo:inline>ad comprimendam alicuius contumaciam, indigetne ab<fo:inline font-weight="normal">s</fo:inline>olutione, contumacia recedente. ibidem.</fo:block>
<fo:block id="W0043-08-0030-it-09ba" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>24. Si <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>pen<fo:inline font-weight="normal">s</fo:inline>io in puram pœnam<fo:inline> </fo:inline>delicti commi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>i à Iure <fo:inline font-weight="normal">s</fo:inline>it lata <fo:inline font-weight="normal">s</fo:inline>ine vlla temporis determinatione,<fo:inline> </fo:inline>pote<fo:inline font-weight="normal">s</fo:inline>tne ab Epi<fo:inline font-weight="normal">s</fo:inline>copo tolli. ibidem.</fo:block>
</fo:block>
</fo:block>
<fo:block id="W0043-08-0030-it-0890" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline font-style="italic">Caput 12.</fo:inline> Circa <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>pen<fo:inline font-weight="normal">s</fo:inline>iones in particulari.<fo:inline> </fo:inline>p. 279
<fo:block id="W0043-08-0030-li-07a1">
<fo:block id="W0043-08-0030-it-09bc" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>25. Si quis recipiat ordinem, vel<fo:inline> </fo:inline>con<fo:inline font-weight="normal">s</fo:inline>ecrationem Epi<fo:inline font-weight="normal">s</fo:inline>copalem ab<fo:inline> </fo:inline>Epi<fo:inline font-weight="normal">s</fo:inline>copo excommunicato ignorans eum defectum: <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>penditurne ab Ordinis <fo:inline font-weight="normal">s</fo:inline>ic <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>cepti executione.<fo:inline> </fo:inline>ibidem</fo:block>
<fo:block id="W0043-08-0030-it-09bd" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>26. Su<fo:inline font-weight="normal">s</fo:inline>pen<fo:inline font-weight="normal">s</fo:inline>ionem latam in <fo:inline font-style="italic">Cap. Cum<fo:inline> </fo:inline>illorum, de <fo:inline font-weight="normal">s</fo:inline>entent. excommunication.</fo:inline> contra eum qui excommunicatione maiori ligatus Eccle<fo:inline font-weight="normal">s</fo:inline>ia<fo:inline font-weight="normal">s</fo:inline>ticos Ordines <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>cipit, incurritne<fo:inline> </fo:inline>qui Ordines minores <fo:inline font-weight="normal">s</fo:inline>ic recipit.<fo:inline> </fo:inline>ibidem.</fo:block>
<fo:block id="W0043-08-0030-it-09be" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>27. Su<fo:inline font-weight="normal">s</fo:inline>cipiens Eccle<fo:inline font-weight="normal">s</fo:inline>ia<fo:inline font-weight="normal">s</fo:inline>ticos Ordines <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>pen<fo:inline font-weight="normal">s</fo:inline>ione, vel Interdicto<fo:inline> </fo:inline>innodatus <fo:inline font-weight="normal">s</fo:inline>ubijciturne huic <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>pen<fo:inline font-weight="normal">s</fo:inline>ioni, ac <fo:inline font-weight="normal">s</fo:inline>i excommunicatione<fo:inline> </fo:inline>maiori affectus <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>ciperet. ibidem.</fo:block>
