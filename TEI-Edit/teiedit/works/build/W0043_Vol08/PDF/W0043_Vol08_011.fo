ht="normal">s</fo:inline>t habendus. D. Tho. <fo:inline font-style="italic">2. 2. q. 33. a. 7. &amp;<fo:inline> </fo:inline>8.</fo:inline> Bannes &amp; Sylui <fo:inline font-style="italic">ibid.</fo:inline> Petr. Lede<fo:inline font-weight="normal">s</fo:inline>. <fo:inline font-style="italic">tr. 4. cap 4.<fo:inline> </fo:inline>concl. 20.</fo:inline> Valent. <fo:inline font-style="italic">2. 2. d. 3. q. 10. punct. 5.</fo:inline> Tanner.<fo:inline> </fo:inline><fo:inline font-style="italic">ibid. 2. q. 5. dub. 5. Becan. <fo:inline font-weight="normal">s</fo:inline>um. tr. de Charit. c. 21.<fo:inline> </fo:inline>num. 30.</fo:inline></fo:block>
<fo:block id="W0043-08-0168-pa-0c65" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline baseline-shift="super" font-size="9pt" font-weight="bold" id="#W0043-08-0168-nm-0799"><fo:basic-link color="#0a0c75" internal-destination="W0043-08-0168-nm-0799">945</fo:basic-link></fo:inline><fo:inline> </fo:inline>Qui ex omi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ione ordinis à Domino præ<fo:inline font-weight="normal">s</fo:inline>cripti fratrem notabiliter lædit in fama, aut<fo:inline> </fo:inline>aliis rebus, mortaliter delinquit. Quia Chri<fo:inline font-weight="normal">s</fo:inline>tus vt <fo:inline font-weight="normal">s</fo:inline>ummus animarum Medicus hoc <fo:inline font-weight="normal">s</fo:inline>uo<fo:inline> </fo:inline>præcepto facillimum nobis remedium expo<fo:inline font-weight="normal">s</fo:inline>uit, quo fratrem quam minimo ip<fo:inline font-weight="normal">s</fo:inline>ius detrimento <fo:inline font-weight="normal">s</fo:inline>anaremus, idque in fauorem eius,<fo:inline> </fo:inline>qui deliquit. Vnde cum ille ordo cen<fo:inline font-weight="normal">s</fo:inline>etur<fo:inline> </fo:inline>vel nece<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>arius, vel vtilis admodum ad commodam fratris emendationem, &amp; tamen peruertitur: contra charitatem delinquitur plus,<fo:inline> </fo:inline>vel minus, pro ratione detrimenti, quo proximus afficitur. Profecto in hoc Dominico<fo:inline> </fo:inline>præcepto, <fo:inline font-weight="normal">s</fo:inline>icut &amp; in aliis pleri<fo:inline font-weight="normal">s</fo:inline>que, magis attendenda e<fo:inline font-weight="normal">s</fo:inline>t intentio, quam verba. Intentio<fo:inline> </fo:inline>autem Domini e<fo:inline font-weight="normal">s</fo:inline>t, <fo:inline font-weight="normal">s</fo:inline>tudio<fo:inline font-weight="normal">s</fo:inline>e tentandum omnibus modis, vt vel frater peccans re<fo:inline font-weight="normal">s</fo:inline>ipi<fo:inline font-weight="normal">s</fo:inline>cat,<fo:inline> </fo:inline>vel <fo:inline font-weight="normal">s</fo:inline>i id impetrari non po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>it, alij ab illius cõtagio præ<fo:inline font-weight="normal">s</fo:inline>eruentur. Quod <fo:inline font-weight="normal">s</fo:inline>i vel pro altero, vel<fo:inline> </fo:inline>vtroque eorum aliquid <fo:inline font-weight="normal">s</fo:inline>ecus fieri conueniat,<fo:inline> </fo:inline>quam à Domino præ<fo:inline font-weight="normal">s</fo:inline>criptum ef<fo:inline font-weight="normal">s</fo:inline>, id ex mente<fo:inline> </fo:inline>Domini fieri debebit, qui duo nobis con<fo:inline font-weight="normal">s</fo:inline>eruanda propo<fo:inline font-weight="normal">s</fo:inline>uit con<fo:inline font-weight="normal">s</fo:inline>cientiam fratris, &amp; famam; <fo:inline font-weight="normal">s</fo:inline>i vtrumque pote<fo:inline font-weight="normal">s</fo:inline>t con<fo:inline font-weight="normal">s</fo:inline>eruari, optime<fo:inline> </fo:inline>agetur: <fo:inline font-weight="normal">s</fo:inline>i non <fo:inline font-weight="normal">s</fo:inline>emper, con<fo:inline font-weight="normal">s</fo:inline>cientia famæ e<fo:inline font-weight="normal">s</fo:inline>t<fo:inline> </fo:inline>præferenda. D. Tho. <fo:inline font-style="italic">2. 2. qu. 73. art. 2.</fo:inline> Sylue<fo:inline font-weight="normal">s</fo:inline>t. <fo:inline font-style="italic">v.<fo:inline> </fo:inline>Correptio, q. 5. 6. &amp; 7.</fo:inline> Filliuc. <fo:inline font-style="italic">tr. 28. n. 156.</fo:inline> Tanner. <fo:inline font-style="italic">2. 2. d. 2. q. 5. dub. 5. num. 109.</fo:inline> Sotus. <fo:inline font-style="italic">relect. de<fo:inline> </fo:inline>Secre. memb, 2. q. 4.</fo:inline> Nauar. <fo:inline font-style="italic"><fo:inline font-weight="normal">s</fo:inline>um. c. 24. nu 14.</fo:inline> Valent. <fo:inline font-style="italic">2. 2. d. 3. quæ<fo:inline font-weight="normal">s</fo:inline>t. 10. pun. 5. §. 1.</fo:inline> Bannes <fo:inline font-style="italic">2. 2. q.<fo:inline> </fo:inline>33. a. 8.</fo:inline></fo:block>
