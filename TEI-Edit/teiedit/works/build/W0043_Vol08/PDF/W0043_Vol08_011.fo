                </fo:block></fo:static-content><fo:static-content flow-name="body_matter_even-region-before"><fo:block text-align="center">Universae Theologiae Moralis receptiores</fo:block></fo:static-content><fo:static-content flow-name="body_matter_odd-region-after"><fo:block text-align="right"><fo:page-number font-style="normal"/></fo:block></fo:static-content><fo:static-content flow-name="body_matter_even-region-after"><fo:block text-align="left"><fo:page-number font-style="normal"/></fo:block></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block><fo:table><fo:table-body><fo:table-row><fo:table-cell padding-top="5mm" padding-bottom="5mm"><fo:block text-align="center" font-size="12pt" text-indent="0pt" font-weight="bold" keep-with-next="always"><fo:inline>NOTAE</fo:inline></fo:block></fo:table-cell></fo:table-row><fo:table-row><fo:table-cell padding-top="5mm" padding-bottom="5mm"><fo:block text-align="center" font-size="12pt" text-indent="0pt" font-weight="bold" keep-with-next="always"/></fo:table-cell></fo:table-row><fo:table-row><fo:table-cell><fo:block id="W0043-08-0004-nm-03e9" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0004-nm-03e9">1 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Stemmatis<fo:inline> </fo:inline>ALA<fo:inline> </fo:inline>prima.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0005-nm-03ea" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0005-nm-03ea">2 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">ALA<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>ecunda.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0006-nm-03eb" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0006-nm-03eb">3 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">ALA<fo:inline> </fo:inline>tertia.</fo:inline></fo:inline></fo:block></fo:table-cell></fo:table-row><fo:table-row><fo:table-cell padding-top="5mm" padding-bottom="5mm"><fo:block text-align="center" font-size="12pt" text-indent="0pt" font-weight="bold" keep-with-next="always">47</fo:block></fo:table-cell></fo:table-row><fo:table-row><fo:table-cell><fo:block id="W0043-08-0041-nm-03ec" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0041-nm-03ec">4 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Fidei definitio.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0042-nm-03ed" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0042-nm-03ed">5 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Alia fidei<fo:inline> </fo:inline>vulgarior<fo:inline> </fo:inline>definitio.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0042-nm-03ee" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0042-nm-03ee">6 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Obiectum<fo:inline> </fo:inline>formale Fidei.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0042-nm-03ef" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0042-nm-03ef">7 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Materiale<fo:inline> </fo:inline>obiectum.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0042-nm-03f0" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0042-nm-03f0">8 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Quamuis<fo:inline> </fo:inline>fides ob<fo:inline font-weight="normal">s</fo:inline>cura <fo:inline font-weight="normal">s</fo:inline>it, certior e<fo:inline font-weight="normal">s</fo:inline>t quauis naturali<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>cientia.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0042-nm-03f1" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-08-0042-nm-03f1">9 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Actus Fidei<fo:inline> </fo:inline>&amp; <fo:inline font-weight="normal">s</fo:inline>cientiæ<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>imul non<fo:inline> </fo:inline>po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>unt con<fo:inline font-weight="normal">s</fo:inline>i<fo:inline font-weight="normal">s</fo:inline>tere.</fo:inline></fo:inline></fo:block><fo:block id="W0043-08-0042-nm-03f2" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" fon