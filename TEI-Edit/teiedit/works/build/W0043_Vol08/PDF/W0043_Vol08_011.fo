o nobi<fo:inline font-weight="normal">s</fo:inline>cum putamus futuros, quam tantum in hoc <fo:inline font-weight="normal">s</fo:inline>æculo:</fo:inline> exponi pote<fo:inline font-weight="normal">s</fo:inline>t<fo:inline> </fo:inline>Diuns loquutus vel de amore complacentiæ,<fo:inline> </fo:inline>vel cerce extra ca<fo:inline font-weight="normal">s</fo:inline>um nece<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>itatis: vel non<fo:inline> </fo:inline>compara<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e <fo:inline font-weight="normal">s</fo:inline>piritualiter coniunctos cum iunctis carnaliter: <fo:inline font-weight="normal">s</fo:inline>ed ab<fo:inline font-weight="normal">s</fo:inline>olutè <fo:inline font-weight="normal">s</fo:inline>anctos cum peccatoribus, &amp; tunc certum e<fo:inline font-weight="normal">s</fo:inline>t, <fo:inline font-weight="normal">s</fo:inline>anctos e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e magis diligendos.</fo:block>
</fo:block>
