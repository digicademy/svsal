<fo:block id="W0043-08-0017-it-0718" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-08-0143-d3-0722" color="#0a0c75"><fo:inline font-style="italic">Caput 1.</fo:inline> <fo:inline font-family="serif" font-size="18pt" space-before="0.1mm" space-after="0.1mm">D</fo:inline>E Spei e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>entia, obiecto, ac <fo:inline font-weight="normal">s</fo:inline>ubiecto.<fo:inline> </fo:inline>ibid.</fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0043-08-0017-it-0719" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-08-0144-d3-0723" color="#0a0c75"><fo:inline font-style="italic">Cap. 2.</fo:inline> De Præcepti Spei obligatione.<fo:inline> </fo:inline>p. 104</fo:basic-link> </fo:inline></fo:block>
