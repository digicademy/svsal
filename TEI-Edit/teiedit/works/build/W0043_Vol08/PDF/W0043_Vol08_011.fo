iones religio<fo:inline font-weight="normal">s</fo:inline>as facit<fo:inline> </fo:inline>fal<fo:inline font-weight="normal">s</fo:inline>æ Religionis ex <fo:inline font-weight="normal">s</fo:inline>ua cau<fo:inline font-weight="normal">s</fo:inline>a prote<fo:inline font-weight="normal">s</fo:inline>tatiuas. Reginal. <fo:inline font-style="italic">l. 17. n. 23.</fo:inline> Malder. <fo:inline font-style="italic">2. 2. q. 3. a. 2. memb. 2.</fo:inline><fo:inline> </fo:inline>Valent. <fo:inline font-style="italic">2. 2. d. 1. q. 3. pun. 2. dub. 4.</fo:inline> Sylui. <fo:inline font-style="italic">2. 2. q. 3.<fo:inline> </fo:inline>a. 2. concl. 3.</fo:inline></fo:block>
