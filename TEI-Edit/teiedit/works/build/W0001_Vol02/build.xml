    <target name="patch-023"> <!-- depends="xslt-022" -->
        <echo>Online version until 05.07.22.</echo>
        <patch originalfile="${xml.dir}/W0001_Vol02_023.xml" destfile="${xml.dir}/W0001_Vol02_024.xml" patchfile="${diff.dir}/W0001_Vol02_023.diff"/>
    </target>
    <target name="patch-024"> <!-- depends="xslt-023" -->
