        <delete file="${xml.dir}/W0001_Vol02_000.xml"/>
    </target>
    
    <target name="patch-000"> <!-- depends="cp-000" -->
        <echo>Structural annotation.</echo>
        <patch originalfile="${xml.dir}/W0001_Vol02_v1-0.xml" destfile="${xml.dir}/W0001_Vol02_001.xml" patchfile="${diff.dir}/W0001_Vol02_000.diff"/>
