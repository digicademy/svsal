        <patch originalfile="${xml.dir}/W0001_Vol02_024.xml" destfile="${xml.dir}/W0001_Vol02_025.xml" patchfile="${diff.dir}/W0001_Vol02_024.diff"/>
    </target>
    <target name="finalize" depends="patch-024">
