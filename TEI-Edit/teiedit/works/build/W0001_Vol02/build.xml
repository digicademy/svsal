        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0001_Vol02_001.xml" out="${xml.dir}/W0001_Vol02_002.xml" style="${xsl.dir}/W0001_Vol02_001.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    
    <target name="xslt-002" depends="xslt-001"> 
