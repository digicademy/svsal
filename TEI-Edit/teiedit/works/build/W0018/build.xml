<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0018" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/grepect/W0018/W0018.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0018.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0018_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0018_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0018_000.xml" tofile="${xml.dir}/W0018_v1-0.xml"/>
        <echo>Checkpoint: W0018_v1-0.xml (W0018_000.xml).</echo>
        <delete file="${xml.dir}/W0018_000.xml"/>
    </target>
    
    <target name="patch-000"> <!-- depends="cp-000" -->
        <echo>Structural annotation.</echo>
        <patch originalfile="${xml.dir}/W0018_v1-0.xml" destfile="${xml.dir}/W0018_001.xml" patchfile="${diff.dir}/W0018_000.diff"/>
        <delete file="${xml.dir}/W0018_000.xml"/>
        <!-- TODO: create diff between W0018_v1-0.xml and W0018_edit-000.xml (=W0018_001.xml) -->
    </target>
    <target name="xslt-001"> 
        <echo>Added @type to list, @rend to note, @unit and @xml:ids to milestone.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0018_001.xml" out="${xml.dir}/W0018_002.xml" style="${xsl.dir}/W0018_001.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="xslt-002" depends="xslt-001"> 
        <echo>Added abbreviations depending on word endings with regex (es).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0018_002.xml" out="${xml.dir}/W0018_003.xml" style="${xsl.dir}/W0018_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0018_002.xml"/>
    </target>
    <target name="xslt-003" depends="xslt-002"> 
        <echo>Transformation TEI tite to TEI P5.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0018_003.xml" out="${xml.dir}/W0018_004.xml" style="${xsl.dir}/W0018_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0018_003.xml"/>
    </target>
    
    <target name="xslt-004" depends="xslt-003"> 
        <echo>Tagged special characters.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0018_004.xml" out="${xml.dir}/W0018_005.xml" style="${xsl.dir}/W0018_004.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0018_004.xml"/>
    </target>
    <target name="xslt-005" depends="xslt-004">
        <echo>Tagged Hyphenation</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0018_005.xml" out="${xml.dir}/W0018_006.xml" style="${xsl.dir}/W0018_005.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0018_005.xml"/>
    </target>
    <target name="xslt-006" depends="xslt-005">
        <echo>Numbered lines.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0018_006.xml" out="${xml.dir}/W0018_007.xml" style="${xsl.dir}/W0018_006.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0018_006.xml"/>
    </target>
    <target name="xslt-007" depends="xslt-006">
        <echo>Added @xml:ids.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0018_007.xml" out="${xml.dir}/W0018_008.xml" style="${xsl.dir}/W0018_007.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0018_007.xml"/>
    </target>
    <target name="xslt-008" depends="xslt-007">
        <echo>Expanded abbreviations (es).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0018_008.xml" out="${xml.dir}/W0018_009.xml" style="${xsl.dir}/W0018_008.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="es" type="STRING"/>
            <param name="mode" expression="main" type="STRING"/>
            <param name="startAtLineBeginning" expression="True" type="BOOLEAN"/>
            <param name="changeId" expression="W0018_change_011" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0018_008.xml"/>
    </target>
    <target name="xslt-009" depends="xslt-008">
        <echo>Tagged unmarked hyphenations.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0018_009.xml" out="${xml.dir}/W0018_010.xml" style="${xsl.dir}/W0018_009.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/lists/W0018-es_supposed-hyphenations-from-text.html" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0018_009.xml"/>
    </target>
<!-- MANUAL CORRECTIONS -->
    
    <target name="patch-010"> <!-- depends="xslt-009" -->
        <echo>First round of corrections (CB) and Reduced excessive whitespace.</echo>
        <patch originalfile="${xml.dir}/W0018_010.xml" destfile="${xml.dir}/W0018_011.xml" patchfile="${diff.dir}/W0018_010.diff"/>
    </target>
    <target name="patch-011"> <!-- depends="patch-010" -->
        <echo>Second round of corrections (CB) and Reduced excessive whitespace.</echo>
        <patch originalfile="${xml.dir}/W0018_011.xml" destfile="${xml.dir}/W0018_012.xml" patchfile="${diff.dir}/W0018_011.diff"/>
    </target>
    <target name="patch-012"> <!-- depends="patch-010" -->
        <echo>Manual post-corrections (CR).</echo>
        <patch originalfile="${xml.dir}/W0018_012.xml" destfile="${xml.dir}/W0018_013.xml" patchfile="${diff.dir}/W0018_012.diff"/>
    </target>
    <target name="xslt-013"><!-- depends="patch-012"-->
        <echo>Post correction fixes.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0018_013.xml" out="${xml.dir}/W0018_014.xml" style="${xsl.dir}/W0018_013.xsl" classpath="${xslt.processor}">
