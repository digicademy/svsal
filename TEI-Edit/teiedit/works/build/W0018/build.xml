    </target>
    <target name="xslt-014" depends="xslt-013">
        <echo>Correct breaks.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0018_014.xml" out="${xml.dir}/W0018_015.xml" style="${xsl.dir}/W0018_014.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0018_014.xml"/>
    </target>
    <target name="xslt-015" depends="xslt-014">
        <echo>Choice correct breaks.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0018_015.xml" out="${xml.dir}/W0018_016.xml" style="${xsl.dir}/W0018_015.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0018_015.xml"/>
    </target>
    <target name="xslt-016" depends="xslt-015">
        <echo>Special characters after corrections.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0018_016.xml" out="${xml.dir}/W0018_017.xml" style="${xsl.dir}/W0018_016.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0018_016.xml"/>
    </target>
    <target name="xslt-017" depends="xslt-016">
        <echo>teiHeader update for publication.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0018_017.xml" out="${xml.dir}/W0018_018.xml" style="${xsl.dir}/W0018_017.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0018_017.xml"/>
    </target>  
    <target name="xslt-018" depends="xslt-017">
        <echo>Transformed note(s) with only digits into milestone(s).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0018_018.xml" out="${xml.dir}/W0018_019.xml" style="${xsl.dir}/W0018_018.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0018_018.xml"/>
    </target>
    <target name="xslt-019" depends="xslt-018">
        <echo>Number lines after corrections.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0018_019.xml" out="${xml.dir}/W0018_020.xml" style="${xsl.dir}/W0018_019.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0018_019.xml"/>
    </target>
    <target name="xslt-020" depends="xslt-019"> <!---->
        <echo>Added @xml:ids after corrections.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0018_020.xml" out="${xml.dir}/W0018_021.xml" style="${xsl.dir}/W0018_020.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0018_020.xml"/>
    </target>
    <target name="finalize" depends="xslt-020">
        <echo>Reached end of pipeline.</echo>
    </target>    
</project>

