<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0011" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/digicademy/W0011/W0011_v1.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0011.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0011_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0011_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0011_000.xml" tofile="${xml.dir}/W0011_v1-0.xml"/>
        <echo>Checkpoint: W0011_v1-0.xml (W0011_000.xml).</echo>
        <delete file="${xml.dir}/W0011_000.xml"/>
    </target>
    
    <target name="patch-000"> <!-- depends="cp-000" -->
        <echo>Structural annotation.</echo>
        <patch originalfile="${xml.dir}/W0011_v1-0.xml" destfile="${xml.dir}/W0011_001.xml" patchfile="${diff.dir}/W0011_000.diff"/>
        <delete file="${xml.dir}/W0011_000.xml"/>
        <!-- TODO: create diff between W0011_v1-0.xml and W0011_edit-000.xml (=W0011_001.xml) -->
    </target>
    
    <target name="xslt-001"> <!-- depends="patch-000" -->
        <echo>Added missing pagination (pb/@n).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0011_001.xml" out="${xml.dir}/W0011_002.xml" style="${xsl.dir}/W0011_001.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
