        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0006_Vol01_002.xml" out="${xml.dir}/W0006_Vol01_003.xml" style="${xsl.dir}/W0006_Vol01_002.xsl" classpath="${xslt.processor}">
