        <delete file="${xml.dir}/W0006_Vol01_000.xml"/>
    </target>
    
    <target name="patch-000"> <!-- depends="cp-000" -->
        <echo>Structural annotation.</echo>
        <patch originalfile="${xml.dir}/W0006_Vol01_v1-0.xml" destfile="${xml.dir}/W0006_Vol01_001.xml" patchfile="${diff.dir}/W0006_Vol01_000.diff"/>
        <delete file="${xml.dir}/W0006_Vol01_000.xml"/>
    </target>
    <target name="xslt-001"> <!-- depends="patch-000" -->
        <echo>Added missing pagination (pb/@n).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0006_Vol01_001.xml" out="${xml.dir}/W0006_Vol01_002.xml" style="${xsl.dir}/W0006_Vol01_001.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="xslt-002" depends="xslt-001"> 
