        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0006_Vol01_022.xml" out="${xml.dir}/W0006_Vol01_023.xml" style="${xsl.dir}/W0006_Vol01_022.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
      
