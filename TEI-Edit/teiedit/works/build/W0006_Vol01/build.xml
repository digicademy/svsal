        <xmlvalidate file="${xml.dir}/W0006_Vol01_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0006_Vol01_000.xml" tofile="${xml.dir}/W0006_Vol01_v1-0.xml"/>
