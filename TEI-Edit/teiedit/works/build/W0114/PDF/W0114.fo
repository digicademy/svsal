<fo:block id="W0114-00-0009-it-0561" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0114-00-0128-d3-06af" color="#0a0c75"><fo:inline font-style="italic">Emptio quot modis sit illicita.</fo:inline></fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0114-00-0009-it-0562" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0114-00-0129-d3-06b0" color="#0a0c75"><fo:inline font-style="italic">Emulatio.</fo:inline></fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0114-00-0009-it-0563" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0114-00-0130-d3-06b1" color="#0a0c75"><fo:inline font-style="italic">Episcopi peccata peculiaria.</fo:inline></fo:basic-link> </fo:inline></fo:block>
