<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0034" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../teiedit/works/build/W0034/W0034_001.xml"/>
    
      
    <target name="initialize">
        <patch originalfile="${xml.dir}/W0034_001.xml" destfile="${xml.dir}/W0034_001.xml" patchfile="${diff.dir}/W0034_001.diff"/>
        <echo>Structural Annotation</echo>
    </target>
    
    <target name="xslt-001"> 
        <echo>Add @xml:ids in front, div, titlePage, head, p</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0034_001.xml" out="${xml.dir}/W0034_002.xml" style="${xsl.dir}/W0034_001.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    
    <target name="xslt-002" depends="xslt-001">
        <echo>Special characters tagging </echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0034_002.xml" out="${xml.dir}/W0034_003.xml" style="${xsl.dir}/W0034_002.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0034_002.xml"/>
    </target>
    
    <target name="xslt-003" depends="xslt-002">
        <echo>Added @xml:ids in lb </echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0034_003.xml" out="${xml.dir}/W0034_004.xml" style="${xsl.dir}/W0034_003.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xsl.log}" action="stop"/>
        <delete file="${xml.dir}/W0034_003.xml"/>
    </target>
    
    <target name="patch-004">
        <echo>Extensive corrections (CB).</echo>
        <patch originalfile="${xml.dir}/W0034_004.xml" destfile="${xml.dir}/W0034_005.xml" patchfile="${diff.dir}/W0034_004.diff" failonerror="true"/>
        <xmlvalidate lenient="true" file="${xml.dir}/W0034_005.xml" failonerror="true"/>
<!--        <delete file="${xml.dir}/W0034_004.xml"/>-->
    </target>
    
    <target name="patch-005">
        <echo>Post-correction (DG).</echo>
        <patch originalfile="${xml.dir}/W0034_005.xml" destfile="${xml.dir}/W0034_006.xml" patchfile="${diff.dir}/W0034_005.diff" failonerror="true"/>
        <xmlvalidate lenient="true" file="${xml.dir}/W0034_006.xml" failonerror="true"/>
<!--        <delete file="${xml.dir}/W0034_005.xml"/>-->
    </target>
        
    <target name="xslt-006"> <!-- depends="patch-005" -->
        <echo>New xml:id and line numbering.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0034_006.xml" out="${xml.dir}/W0034_007.xml" style="${xsl.dir}/W0034_006.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xsl.log}" action="stop"/>
        <!--<delete file="${xml.dir}/W0034_006.xml"/>-->
    </target>
    
    <target name="patch-007">
        <echo>Post-correction (DG).</echo>
        <patch originalfile="${xml.dir}/W0034_007.xml" destfile="${xml.dir}/W0034_008.xml" patchfile="${diff.dir}/W0034_007.diff" failonerror="true"/>
        <xmlvalidate lenient="true" file="${xml.dir}/W0034_008.xml" failonerror="true"/>
<!--        <delete file="${xml.dir}/W0034_007.xml"/>-->
    </target>
    
    <target name="xslt-008"> <!-- depends="patch-007" -->
        <echo>New xml:id and line numbering.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0034_008.xml" out="${xml.dir}/W0034_009.xml" style="${xsl.dir}/W0034_008.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xsl.log}" action="stop"/>
        <!--<delete file="${xml.dir}/W0034_008.xml"/>-->
    </target>
    
    <target name="xslt-009" depends="xslt-008">
        <echo>New teiHeader.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0034_009.xml" out="${xml.dir}/W0034_010.xml" style="${xsl.dir}/W0034_009.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xsl.log}" action="stop"/>
        <delete file="${xml.dir}/W0034_009.xml"/>
    </target>
    <target name="xslt-010"><!-- depends="xslt-009"-->
        <echo>teiHeader update. Rearranged editor(s) sequece and @role #additional.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0034_010.xml" out="${xml.dir}/W0034_011.xml" style="${xsl.dir}/W0034_010.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xsl.log}" action="stop"/>
        <!--<delete file="${xml.dir}/W0034_010.xml"/>-->
    </target>
    
    <target name="finalize" depends="xslt-010">
        <echo>Reached end of pipeline.</echo>
    </target>
    
    
</project>
