-<item xml:id="W0002_00_0160_it_0008"><lb xml:id="W0002_00_0160_lb_0030"/><hi rendition="#it">Rancor y odio de dos maneras. numero.</hi> <ref type="summary" target="#W0002_00_0161_dm_0001" resp="#AUTO">25.</ref></item>
