-<lb xml:id="W0002_00_0147_lb_0021"/><hi rendition="#it">&amp;c. y si se puede cumplir fuera del estado de gracia, y con qual</hi>
-<lb xml:id="W0002_00_0147_lb_0022"/><hi rendition="#it">amor. nu.</hi> <ref type="summary" target="#W0002_00_0150_dm_0001" resp="#AUTO">8.</ref> <ref type="summary" target="#W0002_00_0151_dm_0001" resp="#AUTO">9.</ref> <hi rendition="#it">&amp;.</hi> <ref type="summary" target="#W0002_00_0151_dm_0002" resp="#AUTO">10.</ref></item><item xml:id="W0002_00_0147_it_0013">
