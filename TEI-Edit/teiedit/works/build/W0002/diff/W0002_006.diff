-<lb xml:id="W0002_00_0537_lb_0015"/><hi rendition="#it">o</hi> j<hi rendition="#it">usta con in</hi>j<hi rendition="#it">usto animo.</hi> O <hi rendition="#it">impiden la visitacion de mon-</hi>
-<lb xml:id="W0002_00_0537_lb_0016"/>j<hi rendition="#it">as.</hi> O <hi rendition="#it">piden pechos de cierta manera. nume.</hi> <ref type="summary" target="#W0002_00_0540_dm_0001" resp="#CR">6.</ref> O <hi rendition="#it">hazen la-</hi>
