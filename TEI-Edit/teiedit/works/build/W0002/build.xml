<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0002" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    
    <property name="orig.file" value="../../orig/digicademy/W0002/w0002_tite_1275.xml"/>
    
    <target name="initialize">
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0002_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0002_000.xml" lenient="true" failonerror="true"/> 
        <copy file="${xml.dir}/W0002_000.xml" tofile="${xml.dir}/W0002_v1-0.xml"/>
        <echo>Checkpoint: W0002_v1-0.xml (W0002_000.xml).</echo>
        <delete file="${xml.dir}/W0002_000.xml"/>
    </target>
    
    <!-- ==================================================== -->
    
    <!-- STRUCTURAL PREPARATION -->
    
    <target name="patch-000" depends="initialize">
        <echo>Basic structural editing. See edit/W0002_edit-000.txt for a list of changes.</echo>
        <patch originalfile="${xml.dir}/W0002_v1-0.xml" destfile="${xml.dir}/W0002_001.xml" patchfile="${diff.dir}/W0002_000.diff"/>
        <xmlvalidate file="${xml.dir}/W0002_001.xml" lenient="true" failonerror="true"/>
    </target>
    
    <target name="xslt-001" depends="patch-000">
        <echo>Basic TEI Tite to TEI All transformation.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt in="${xml.dir}/W0002_001.xml" out="${xml.dir}/W0002_002.xml" style="${xsl.dir}/W0002_001.xsl" classpath="${xslt.processor}">
            <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <xmlvalidate file="${xml.dir}/W0002_002.xml" lenient="true" failonerror="true"/>
        <delete file="${xml.dir}/W0002_001.xml"/>
    </target>

    <target name="patch-002" depends="xslt-001">
        <echo>Add (old) xml:id keys.</echo>
        <patch originalfile="${xml.dir}/W0002_002.xml" destfile="${xml.dir}/W0002_003.xml" patchfile="${diff.dir}/W0002_002.diff"/>
        <xmlvalidate file="${xml.dir}/W0002_003.xml" lenient="true" failonerror="true"/>
        <delete file="${xml.dir}/W0002_002.xml"/>
    </target>
    
    <target name="xslt-003" depends="patch-002">
        <echo>Automatically add cross-references in summaries.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt in="${xml.dir}/W0002_003.xml" out="${xml.dir}/W0002_004.xml" style="${xsl.dir}/W0002_003.xsl" classpath="${xslt.processor}">
            <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0002_003.xml"/>
    </target>
    
    <target name="patch-004" depends="xslt-003">
        <echo>Correct the summary cross-references tagged automatically in xslt-003 and do further editings; see edit/W0002_004.txt for
            further details.</echo>
        <patch originalfile="${xml.dir}/W0002_004.xml" destfile="${xml.dir}/W0002_005.xml" patchfile="${diff.dir}/W0002_004.diff"/>
        <xmlvalidate file="${xml.dir}/W0002_005.xml" lenient="true" failonerror="true"/>
        <delete file="${xml.dir}/W0002_004.xml"/>
    </target>
    
    <target name="xslt-005" depends="patch-004">
        <echo>Further structural transformations.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
