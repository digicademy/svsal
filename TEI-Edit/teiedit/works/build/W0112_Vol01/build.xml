        <delete file="${xml.dir}/W0112_Vol01_012a.xml"/>
    </target>
    <target name="xslt-012" depends="xslt-011">
        <echo>Expanded abbreviations (es).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0112_Vol01_012.xml" out="${xml.dir}/W0112_Vol01_013a.xml" style="${xsl.dir}/W0112_Vol01_012.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="es" type="STRING"/>
            <param name="mode" expression="main" type="STRING"/>
            <param name="startAtLineBeginning" expression="TRUE" type="BOOLEAN"/>
            <param name="changeId" expression="W0112_Vol01_change_016" type="STRING"/>
        </xslt>
        <echo>**********************</echo>
        <echo>Expanded abbreviations (la).</echo>        
        <xslt force="true" in="${xml.dir}/W0112_Vol01_013a.xml" out="${xml.dir}/W0112_Vol01_013.xml" style="${xsl.dir}/W0112_Vol01_012.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="main" type="STRING"/>
            <param name="startAtLineBeginning" expression="TRUE" type="BOOLEAN"/>
