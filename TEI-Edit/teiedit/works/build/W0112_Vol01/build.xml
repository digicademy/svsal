<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0112_Vol01" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/grepect/W0112-A/W0112-A.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0112_Vol01.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0112_Vol01_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0112_Vol01_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0112_Vol01_000.xml" tofile="${xml.dir}/W0112_Vol01_v1-0.xml"/>
