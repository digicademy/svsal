        <delete file="${xml.dir}/W0112_Vol01_000.xml"/>
    </target>
    
    <target name="patch-000"> <!-- depends="cp-000" -->
        <echo>Structural annotation.</echo>
        <patch originalfile="${xml.dir}/W0112_Vol01_v1-0.xml" destfile="${xml.dir}/W0112_Vol01_001.xml" patchfile="${diff.dir}/W0112_Vol01_000.diff"/>
        <delete file="${xml.dir}/W0112_Vol01_000.xml"/>
    </target>
    <target name="xslt-001"> <!--depends="patch-000"-->
