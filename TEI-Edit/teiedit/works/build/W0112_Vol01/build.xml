        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="xslt-002" depends="xslt-001">
        <echo>Adding @target to ref in summaries.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0112_Vol01_002.xml" out="${xml.dir}/W0112_Vol01_003.xml" style="${xsl.dir}/W0112_Vol01_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>        
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0112_Vol01_002.xml"/>
    </target>
    <target name="xslt-003" depends="xslt-002">
        <echo>Tagging foreign (la).</echo>
        <!--Check file W0112_Vol01_003.xsl for description and debugging-->
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0112_Vol01_003.xml" out="${xml.dir}/W0112_Vol01_004.xml" style="${xsl.dir}/W0112_Vol01_003.xsl" classpath="${xslt.processor}">
