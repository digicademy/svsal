<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0016_Vol01" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/textloop/W0016-A/W0016-A.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0016_Vol01.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0016_Vol01_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0016_Vol01_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0016_Vol01_000.xml" tofile="${xml.dir}/W0016_Vol01_v1-0.xml"/>
        <echo>Checkpoint: W0016_Vol01_v1-0.xml (W0016_Vol01_000.xml).</echo>
        <delete file="${xml.dir}/W0016_Vol01_000.xml"/>
    </target>
    
    <target name="patch-000" depends="cp-000"><!--, W0016_Vol01_edit.xml renamed W0016_Vol01-001.xml, --> 
        <patch originalfile="${xml.dir}/W0016_Vol01_v1-0.xml" destfile="${xml.dir}/W0016_Vol01_001.xml" patchfile="${diff.dir}/W0016_Vol01_000.diff"/>
        <echo>Structural Annotation</echo>
        <delete file="${xml.dir}/W0016_Vol01_000.xml"/>
    </target>
    <target name="xslt-001"> 
        <echo>Added @n, @type and @xml:id to div2(s), lists and @target(s) to ref in toc.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol01_001.xml" out="${xml.dir}/W0016_Vol01_002.xml" style="${xsl.dir}/W0016_Vol01_001.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    
        <target name="xslt-002" depends="xslt-001"> 
        <echo>Added abbreviations depending on word endings with regex (la)</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol01_002.xml" out="${xml.dir}/W0016_Vol01_003a.xml" style="${xsl.dir}/W0016_Vol01_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
 <echo>Added (again) abbreviations depending on word endings with regex (la)</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol01_003a.xml" out="${xml.dir}/W0016_Vol01_003.xml" style="${xsl.dir}/W0016_Vol01_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
       <delete file="${xml.dir}/W0016_Vol01_003a.xml"/>
    </target>

    <target name="xslt-003" depends="xslt-002">
        <echo>Transformation from TEI Tite to TEI P5.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol01_003.xml" out="${xml.dir}/W0016_Vol01_004.xml" style="${xsl.dir}/W0016_Vol01_003.xsl" classpath="${xslt.processor}" >
