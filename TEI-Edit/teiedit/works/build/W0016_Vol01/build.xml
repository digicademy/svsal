        </exec>
        <record name="${py.log}" action="stop"/>
    </target> -->

    <target name="xslt-014" >
        <echo>teiHeader update.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol01_013.xml" out="${xml.dir}/W0016_Vol01_014.xml" style="${xsl.dir}/W0016_Vol01_013.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
     <!--   <delete file="${xml.dir}/W0016_Vol01_020.xml"/> -->
    </target>
    
    <target name="finalize" depends="xslt-014">
        <echo>Reached end of pipeline.</echo>
    </target>
    
