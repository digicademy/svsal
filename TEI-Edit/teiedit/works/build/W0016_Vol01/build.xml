        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol01_008.xml" out="${xml.dir}/W0016_Vol01_009.xml" style="${xsl.dir}/W0016_Vol01_008.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        
    </target>
<!-- lists needed -->
    <target name="xslt-009" depends="xslt-008"> 
        <echo>Tagged unmarked breaks (main).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol01_009.xml" out="${xml.dir}/W0016_Vol01_010.xml" style="${xsl.dir}/W0016_Vol01_009.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/W0016_Vol01-la_supposed-hyphenations-from-text.html" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    
    </target>
  
 
    
   
    <target name="xslt-010" depends="xslt-009">
        <echo>Expanded abbreviations in main text.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol01_010.xml" out="${xml.dir}/W0016_Vol01_011.xml" style="${xsl.dir}/W0016_Vol01_010.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="main" type="STRING"/>
            <param name="changeId" expression="W0016_Vol01_change_010" type="STRING"/>
            <param name="startAtLineBeginning" expression="TRUE" type="BOOLEAN"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>

    <target name="xslt-011" depends="xslt-010"> 
        <echo>Expanded abbreviations in marginal text.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol01_011.xml" out="${xml.dir}/W0016_Vol01_012.xml" style="${xsl.dir}/W0016_Vol01_010.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="marginal" type="STRING"/>
            <param name="changeId" expression="W0016_Vol01_change_011" type="STRING"/>
            <param name="startAtLineBeginning" expression="TRUE" type="BOOLEAN"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
       
    </target>
  <!--<target name="py-012" input file W0016_Vol01_012.xml output W0016_Vol01_013.xml > 
