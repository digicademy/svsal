<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0027_Vol02" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/grepect/W0027-B/W0027-B.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0027_Vol02.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0027_Vol02_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0027_Vol02_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0027_Vol02_000.xml" tofile="${xml.dir}/W0027_Vol02_v1-0.xml"/>
        <echo>Checkpoint: W0027_Vol02_v1-0.xml (W0027_Vol02_000.xml).</echo>
        <delete file="${xml.dir}/W0027_Vol02_000.xml"/>
    </target>
    
    <target name="patch-000"> <!-- depends="cp-000" -->
        <echo>Structural annotation and first round of unclear.</echo>
        <patch originalfile="${xml.dir}/W0027_Vol02_v1-0.xml" destfile="${xml.dir}/W0027_Vol02_001.xml" patchfile="${diff.dir}/W0027_Vol02_000.diff"/>
        <delete file="${xml.dir}/W0027_Vol02_000.xml"/>
    </target>
    
    <target name="xslt-001"> <!--depends="patch-000"-->
        <echo>Tagged @n, @type, @xml:id(s) in div(s), list(s) and @target in TOC and summaries.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0027_Vol02_001.xml" out="${xml.dir}/W0027_Vol02_002.xml" style="${xsl.dir}/W0027_Vol02_001.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <!-- Never delete version _001.xml, since it hast the manual changes for the structural annotation. -->
    </target>
    <target name="py-002"> <!-- depends="xslt-001" - input W0027_Vol02_002.xml and output W0027_Vol02_003.xml files in python script -->
        <!--Run and edit directly from Python. ANT causes encoding/decoding problems.-->
        <echo>Automatically expanded abbreviations - dictionary from manually corrected texts using python.</echo>
        <record name="${py.log}" action="start" loglevel="verbose"/>
        <exec executable="${executable-full-path}">
            <arg file="${py.dir}/W0027_Vol02_002.py"/>
        </exec>
        <record name="${py.log}" action="stop"/>
    </target>
    <target name="xslt-003" ><!--depends="py-002"-->
        <echo>Abbr. with regex - Added (la) abbreviations depending on word endings with regex.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0027_Vol02_003.xml" out="${xml.dir}/W0027_Vol02_004a.xml" style="${xsl.dir}/W0027_Vol02_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <echo>Repeated (la) abbreviations depending on word structure with regex.</echo>
        <xslt force="true" in="${xml.dir}/W0027_Vol02_004a.xml" out="${xml.dir}/W0027_Vol02_004.xml" style="${xsl.dir}/W0027_Vol02_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0027_Vol02_004a.xml"/>
        <!--Do not delete W0027_Vol02_003.xml to avoid repeating target name="py-002"
        <delete file="${xml.dir}/W0027_Vol02_003.xml"/>-->
    </target>
    <target name="xslt-004" depends="xslt-003">
        <echo>Transformation TEI-tite to TEI-All.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0027_Vol02_004.xml" out="${xml.dir}/W0027_Vol02_005.xml" style="${xsl.dir}/W0027_Vol02_004.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>        
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0027_Vol02_004.xml"/>
    </target>
    <target name="xslt-005" depends="xslt-004"> 
        <echo>Annotate Hyphenation.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0027_Vol02_005.xml" out="${xml.dir}/W0027_Vol02_006.xml" style="${xsl.dir}/W0027_Vol02_005.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <delete file="${xml.dir}/W0027_Vol02_005.xml"/>
    </target>
    <target name="xslt-006" depends="xslt-005">
        <echo>Tagged special characters.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0027_Vol02_006.xml" out="${xml.dir}/W0027_Vol02_007.xml" style="${xsl.dir}/W0027_Vol02_006.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0027_Vol02_006.xml"/>
    </target>
    <target name="xslt-007" depends="xslt-006">
        <echo>Numbered lines.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0027_Vol02_007.xml" out="${xml.dir}/W0027_Vol02_008.xml" style="${xsl.dir}/W0027_Vol02_007.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0027_Vol02_007.xml"/>
    </target>
    <target name="xslt-008" depends="xslt-007">
        <echo>Added @xml:ids.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0027_Vol02_008.xml" out="${xml.dir}/W0027_Vol02_009.xml" style="${xsl.dir}/W0027_Vol02_008.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0027_Vol02_008.xml"/>
    </target>
    <target name="xslt-009"> <!-- depends="xslt-007"-->
        <echo>Expanded abbreviations main with xml-list (la).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0027_Vol02_009.xml" out="${xml.dir}/W0027_Vol02_010.xml" style="${xsl.dir}/W0027_Vol02_009.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="main" type="STRING"/>
            <param name="startAtLineBeginning" expression="TRUE" type="BOOLEAN"/>
            <param name="changeId" expression="W0027_Vol02_change_011" type="STRING"/>
        </xslt>
        <!--<delete file="${xml.dir}/W0027_Vol02_009.xml"/>-->
    </target>
    <target name="xslt-010" ><!--depends="xslt-009"-->
        <echo>Tag unmarked breaks (la).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0027_Vol02_010.xml" out="${xml.dir}/W0027_Vol02_011.xml" style="${xsl.dir}/W0027_Vol02_010.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/lists/W0027_Vol02-la_supposed-hyphenations-from-text.html" type="STRING"/>
            <param name="lang" expression="la" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <!--<delete file="${xml.dir}/W0027_Vol02_010.xml"/>-->
    </target>
    <target name="py-011"> <!-- depends="xslt-010" - input W0027_Vol02_011.xml and output W0027_Vol02_012.xml files in python script -->
        <!--Run and edit directly from Python. ANT causes encoding/decoding problems.-->
        <echo>Automatically expanded abbreviations with lb/@break using python.</echo>
        <record name="${py.log}" action="start" loglevel="verbose"/>
        <exec executable="${executable-full-path}">
            <arg file="${py.dir}/W0027_Vol02_011.py"/>
        </exec>
        <record name="${py.log}" action="stop"/>
    </target>
    <target name="xslt-012"><!-- depends="py-011" - W0027_Vol02_011.py-->
        <echo>teiHeader update for online publication.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0027_Vol02_012.xml" out="${xml.dir}/W0027_Vol02_013.xml" style="${xsl.dir}/W0027_Vol02_012.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="finalize" depends="xslt-012">
        <echo>Reached end of pipeline.</echo>
    </target>
    
</project>

