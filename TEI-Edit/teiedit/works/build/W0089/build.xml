<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0089" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/grepect/W0089/W0089.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0089.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0089_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0089_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0089_000.xml" tofile="${xml.dir}/W0089_v1-0.xml"/>
        <echo>Checkpoint: W0089_v1-0.xml (W0089_000.xml).</echo>
        <delete file="${xml.dir}/W0089_000.xml"/>
    </target>
    
    <target name="patch-000"> <!-- depends="cp-000" -->
        <echo>Structural annotation.</echo>
        <patch originalfile="${xml.dir}/W0089_v1-0.xml" destfile="${xml.dir}/W0089_001.xml" patchfile="${diff.dir}/W0089_000.diff"/>
    </target>
    <target name="patch-001"> <!-- patch-000 -->
        <echo>Resolution remaining 22 unclear marks (CB).</echo>
        <patch originalfile="${xml.dir}/W0089_001.xml" destfile="${xml.dir}/W0089_001_unclear.xml" patchfile="${diff.dir}/W0089_001.diff"/>
    </target>
    <target name="xslt-001"> <!--depends="patch-000"-->
        <echo>Added @type, @target, @unit and @xml:id attributes.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0089_001_unclear.xml" out="${xml.dir}/W0089_002.xml" style="${xsl.dir}/W0089_001.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="xslt-002" depends="xslt-001"> 
        <echo>Summaries, adding @target to ref using @xml:id in milestones.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0089_002.xml" out="${xml.dir}/W0089_003.xml" style="${xsl.dir}/W0089_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0089_002.xml"/>
    </target>
    <target name="xslt-003" depends="xslt-002"> <!--Updated 27.08.24 with new template expandAbbreviations_LA_regex_TEItite.xsl-->
        <echo>Added (la) abbreviations depending on word structure with regex.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0089_003.xml" out="${xml.dir}/W0089_004a.xml" style="${xsl.dir}/W0089_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <echo>Repeated (la) abbreviations depending on word structure with regex.</echo>
        <xslt force="true" in="${xml.dir}/W0089_004a.xml" out="${xml.dir}/W0089_004.xml" style="${xsl.dir}/W0089_003.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0089_003.xml"/>
        <delete file="${xml.dir}/W0089_004a.xml"/>
    </target>
    <target name="xslt-004" depends="xslt-003"> 
        <echo>Transformation TEI-tite to TEI-All.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0089_004.xml" out="${xml.dir}/W0089_005.xml" style="${xsl.dir}/W0089_004.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0089_004.xml"/>
    </target>
    <target name="xslt-005" depends="xslt-004">
        <echo>Annotated hyphenated breaks.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0089_005.xml" out="${xml.dir}/W0089_006.xml" style="${xsl.dir}/W0089_005.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0089_005.xml"/>
    </target>
    <target name="xslt-006" depends="xslt-005">
        <echo>Tagged special characters.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0089_006.xml" out="${xml.dir}/W0089_007.xml" style="${xsl.dir}/W0089_006.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0089_006.xml"/>
    </target>
    <target name="xslt-007" depends="xslt-006">
        <echo>Numbered lines.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0089_007.xml" out="${xml.dir}/W0089_008.xml" style="${xsl.dir}/W0089_007.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0089_007.xml"/>
    </target>
    <target name="xslt-008" depends="xslt-007">
        <echo>Added @xml:ids.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0089_008.xml" out="${xml.dir}/W0089_009.xml" style="${xsl.dir}/W0089_008.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0089_008.xml"/>
    </target>
    <target name="xslt-009" depends="xslt-008">
        <echo>Tagged unmarked hyphenations (la).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0089_009.xml" out="${xml.dir}/W0089_010.xml" style="${xsl.dir}/W0089_009.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/lists/W0089-la_supposed-hyphenations-from-text.html" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0089_009.xml"/>
    </target>
    <target name="xslt-010" depends="xslt-009">
        <echo>Expanded abbreviations with list (la).</echo><!--Updated 27.08.24 with new list abbr-la.xml-->
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0089_010.xml" out="${xml.dir}/W0089_011.xml" style="${xsl.dir}/W0089_010.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="main" type="STRING"/>
            <param name="startAtLineBeginning" expression="TRUE" type="BOOLEAN"/>
            <param name="changeId" expression="W0089_change_014" type="STRING"/>            
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0089_010.xml"/>
    </target>
    <target name="py-011"> <!-- depends="xslt-010" - input W0089_011.xml and output W0089_012.xml files in python script -->
    <!--Run and edit directly from Python. ANT causes encoding/decoding problems.-->
        <echo>Expanded abbreviations with breaks using python.</echo>
        <record name="${py.log}" action="start" loglevel="verbose"/>
        <exec executable="${executable-full-path}">
            <arg file="${py.dir}/W0089_011.py"/>
        </exec>
        <record name="${py.log}" action="stop"/>
    </target>
    <target name="xslt-012">  <!--depends="py-011"-->
        <echo>teiHeader update for online publication.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0089_012.xml" out="${xml.dir}/W0089_013.xml" style="${xsl.dir}/W0089_012.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="finalize" depends="xslt-012">
        <echo>Reached end of pipeline.</echo>
    </target>
    
</project>
