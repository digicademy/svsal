        </xslt>
<echo>Added (again) abbreviations depending on word endings with regex (es)</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0032_004a.xml" out="${xml.dir}/W0032_004.xml" style="${xsl.dir}/W0032_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt> 

        <record name="${xslt.log}" action="stop"/>
       <delete file="${xml.dir}/W0032_004a.xml"/>
   
    </target>

  

<target name="xslt-004" depends="xslt-003"> 
        <echo>Transformation TEI tite to TEI P5.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0032_004.xml" out="${xml.dir}/W0032_005.xml" style="${xsl.dir}/W0032_004.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
