        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0032_011.xml" out="${xml.dir}/W0032_012.xml" style="${xsl.dir}/W0032_011.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
