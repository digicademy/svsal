<fo:block text-align="center" font-size="20pt" font-weight="normal" space-before="5mm"><fo:inline padding-left="0.2cm" padding-right="0.2cm" font-size="20pt" font-weight="normal"><fo:inline> </fo:inline><fo:inline font-style="italic">Circa per<fo:inline font-weight="normal">s</fo:inline>onas, ad annuæ<fo:inline> </fo:inline>Communionis præceptum <fo:inline font-weight="normal">s</fo:inline>eruandum tenentur.</fo:inline></fo:inline></fo:block>
