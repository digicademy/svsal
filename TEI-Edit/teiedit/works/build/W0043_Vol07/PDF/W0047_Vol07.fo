fo:inline>capit. prim. numer. <fo:inline font-weight="normal">s</fo:inline>ecund.</fo:inline> Palao <fo:inline font-style="italic">tom. 2. tract. 10.<fo:inline> </fo:inline>dub. vnic. punct. prim. numer. 4.</fo:inline> Filliuc. <fo:inline font-style="italic">tract. 27.<fo:inline> </fo:inline>num. 147.</fo:inline></fo:block>
