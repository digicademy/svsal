nis<fo:inline> </fo:inline>v<fo:inline font-weight="normal">s</fo:inline>us omnibus eluce<fo:inline font-weight="normal">s</fo:inline>cat, plures tamen ante<fo:inline> </fo:inline>eam ætatem, alij po<fo:inline font-weight="normal">s</fo:inline>t eam rationis v<fo:inline font-weight="normal">s</fo:inline>um con<fo:inline font-weight="normal">s</fo:inline>equuntur. Omnes <fo:inline font-weight="normal">s</fo:inline>ic.</fo:block>
