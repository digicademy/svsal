ue Eccle<fo:inline font-weight="normal">s</fo:inline>iæ præcepta, ex quibus vnum<fo:inline> </fo:inline>e<fo:inline font-weight="normal">s</fo:inline>t Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionis. De Fide igitur, e<fo:inline font-weight="normal">s</fo:inline>t latum e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e<fo:inline> </fo:inline>ab Eccle<fo:inline font-weight="normal">s</fo:inline>ia annuæ Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionis præceptum<fo:inline> </fo:inline>obligans <fo:inline font-weight="normal">s</fo:inline>ub lethali. vnde Dubium di<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>oluitur, nec enim pote<fo:inline font-weight="normal">s</fo:inline>t prima <fo:inline font-weight="normal">s</fo:inline>ententia<fo:inline> </fo:inline>defen<fo:inline font-weight="normal">s</fo:inline>ari.</fo:block>
