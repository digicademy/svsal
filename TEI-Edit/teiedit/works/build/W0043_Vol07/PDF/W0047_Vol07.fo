<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline font-style="normal" id="W0043-07-0005-pb-03ea"/><fo:inline role="W0043-07-0005-pb-03ea" font-style="normal" font-weight="bold" font-size="12pt">[[iii]]</fo:inline><fo:inline> </fo:inline><fo:inline font-style="italic">Facultas P. Prouincialis Societatis IESV Prouinciæ Ca<fo:inline font-weight="bold">s</fo:inline>tellanæ.</fo:inline></fo:block>
<fo:block id="W0043-07-0005-pa-03ea" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline> </fo:inline><fo:inline font-family="serif" font-size="18pt" space-before="0.1mm" space-after="0.1mm">E</fo:inline>GO Antonius de Ibarra Prouincialis Societatis<fo:inline> </fo:inline>IESV in Ca<fo:inline font-weight="normal">s</fo:inline>tellana Prouincia, pote<fo:inline font-weight="normal">s</fo:inline>tate ad id mihi<fo:inline> </fo:inline>facta à R. admodum P. no<fo:inline font-weight="normal">s</fo:inline>tro Go<fo:inline font-weight="normal">s</fo:inline>uinio Nichel Generali Præpo<fo:inline font-weight="normal">s</fo:inline>ito, facultatem facio, vt <fo:inline font-style="italic">Tractatus de Præceptis<fo:inline> </fo:inline>Eccle<fo:inline font-weight="normal">s</fo:inline>iæ à P. Antonio de E<fo:inline font-weight="normal">s</fo:inline>cobar &amp; Mendoza</fo:inline> compo<fo:inline font-weight="normal">s</fo:inline>itus<fo:inline> </fo:inline>&amp; eiu<fo:inline font-weight="normal">s</fo:inline>dem Societatis grauium, doctorumque Hominum iudicio approbatus Typis mandetur. In quorum fidem has litteras manu no<fo:inline font-weight="normal">s</fo:inline>tra <fo:inline font-weight="normal">s</fo:inline>ub<fo:inline font-weight="normal">s</fo:inline>criptas, &amp; officij no<fo:inline font-weight="normal">s</fo:inline>tri <fo:inline font-weight="normal">s</fo:inline>igillo munitas dedimus Valli<fo:inline font-weight="normal">s</fo:inline>oleti<fo:inline> </fo:inline>die Augu<fo:inline font-weight="normal">s</fo:inline>ti 27. anni 1660.</fo:block>
<fo:block font-style="italic" text-align="right"><fo:inline> </fo:inline>ANTONIVS DE IBARRA.</fo:block>
</fo:block></fo:table-cell></fo:table-row><fo:table-row><fo:table-cell padding-top="5mm" padding-bottom="5mm"><fo:block text-align="center" font-size="12pt" text-indent="0pt" font-weight="bold" keep-with-next="always"><fo:marker marker-class-name="chapNum"/></fo:block></fo:table-cell></fo:table-row><fo:table-row><fo:table-cell><fo:block id="W0043-07-0005-d1-03e9">
<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline> </fo:inline><fo:inline font-style="italic">APPROBATIO.</fo:inline></fo:block>
<fo:block id="W0043-07-0005-pa-03eb" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline> </fo:inline><fo:inline font-family="serif" font-size="18pt" space-before="0.1mm" space-after="0.1mm">R.</fo:inline> <fo:inline font-style="italic">P. Antonij de E<fo:inline font-weight="normal">s</fo:inline>cobar Societatis IESV Tomos Tertium, Quartum, Quintum, <fo:inline font-weight="normal">Sextum</fo:inline> &amp; Septimum vniuer<fo:inline font-weight="normal">s</fo:inline>æ Theologiæ Moralis</fo:inline><fo:inline> </fo:inline>attente perlegimus nos infra <fo:inline font-weight="normal">s</fo:inline>cripti facultatis Pari<fo:inline font-weight="normal">s</fo:inline>ien<fo:inline font-weight="normal">s</fo:inline>is Doctores Theologi nihilque in illis occurrit, quod non <fo:inline font-weight="normal">s</fo:inline>it planè con<fo:inline font-weight="normal">s</fo:inline>entaneum tum fidei Catholicæ, tum probis moribus; adeoque luce<fo:inline> </fo:inline>publica dignos. Actum Lugduni die 9. Februarij 1663.</fo:block>
<fo:block font-style="italic" text-align="right"><fo:inline> </fo:inline>Fr. Cyrillvs Morel <fo:inline font-style="italic">Carmeli Lugd. Prior.</fo:inline></fo:block>
<fo:block font-style="italic" text-align="right"><fo:inline> </fo:inline>Fr. Steph. Molin <fo:inline font-style="italic">Carmelita.</fo:inline></fo:block>
</fo:block></fo:table-cell></fo:table-row><fo:table-row><fo:table-cell padding-top="5mm" padding-bottom="5mm"><fo:block text-align="center" font-size="12pt" text-indent="0pt" font-weight="bold" keep-with-next="always"><fo:marker marker-class-name="chapNum"/></fo:block></fo:table-cell></fo:table-row><fo:table-row><fo:table-cell><fo:block id="W0043-07-0006-d1-03ea">
