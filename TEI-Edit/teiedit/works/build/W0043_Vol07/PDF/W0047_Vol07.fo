<fo:block id="W0043-07-0045-pa-05ae" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline baseline-shift="super" font-size="9pt" font-weight="bold" id="#W0043-07-0045-nm-04ac"><fo:basic-link color="#0a0c75" internal-destination="W0043-07-0045-nm-04ac">196</fo:basic-link></fo:inline><fo:inline> </fo:inline>Longe probabilius affirmo minime e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e nece<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ariam formalem, &amp; expre<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am voluntatem<fo:inline> </fo:inline>Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am audiendi <fo:inline font-weight="normal">s</fo:inline>ub implendi præceptum<fo:inline> </fo:inline>intentione, qui nec dum virtualem nece<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ariam e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e <fo:inline font-style="italic">Dub. proximo</fo:inline> affirmabo.</fo:block>
</fo:block>
