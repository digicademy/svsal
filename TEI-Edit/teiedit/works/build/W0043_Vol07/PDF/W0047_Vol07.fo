<fo:block id="W0043-07-0193-it-086c" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>An qui culpa <fo:inline font-weight="normal">s</fo:inline>ua inualide confitetur annuæ<fo:inline> </fo:inline>Confe<fo:inline font-weight="normal">s</fo:inline>sionis in<fo:inline font-weight="normal">s</fo:inline>tantia, euadat pœnas à iure<fo:inline> </fo:inline>aut à Synodo impo<fo:inline font-weight="normal">s</fo:inline>itas. p. 53. n. 119</fo:block>
<fo:block id="W0043-07-0193-it-086d" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>An pueri non implentes Confe<fo:inline font-weight="normal">s</fo:inline>sionis annuæ<fo:inline> </fo:inline>præceptum <fo:inline font-weight="normal">incurrant</fo:inline> pœnas tran<fo:inline font-weight="normal">s</fo:inline>gre<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>oribus<fo:inline> </fo:inline>impo<fo:inline font-weight="normal">s</fo:inline>itas. ibid. n. 122</fo:block>
