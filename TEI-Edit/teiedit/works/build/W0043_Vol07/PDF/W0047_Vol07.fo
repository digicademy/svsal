pro tantilla decimarum portione, maxime quia ho<fo:inline font-weight="normal">s</fo:inline>tes<fo:inline> </fo:inline>non intendunt Eccle<fo:inline font-weight="normal">s</fo:inline>iæ in decimis damnum inferre, <fo:inline font-weight="normal">s</fo:inline>ed <fo:inline font-weight="normal">s</fo:inline>uo iure vtuntur ad ho<fo:inline font-weight="normal">s</fo:inline>tem <fo:inline font-weight="normal">s</fo:inline>ubuertendum, ac victoriam comparandam.</fo:block>
