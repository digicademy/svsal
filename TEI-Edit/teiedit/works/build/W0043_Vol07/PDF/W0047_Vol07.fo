chez <fo:inline font-style="italic">libr. 4. moral. capit. 11.<fo:inline> </fo:inline>numer. 53.</fo:inline> Sancius <fo:inline font-style="italic">in <fo:inline font-weight="normal">s</fo:inline>elect. d. 51. nu. 16.</fo:inline> Tolet.</fo:block>
