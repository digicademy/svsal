<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0024-d2-051a" color="#0a0c75">SECTIO I.<fo:inline> </fo:inline><fo:inline font-style="italic">De Præcepto audiendi Mi<fo:inline font-weight="bold">s</fo:inline><fo:inline font-weight="bold">s</fo:inline>am, Receptiores <fo:inline font-weight="bold">s</fo:inline>ine lite <fo:inline font-weight="bold">s</fo:inline>ententiæ. p. 2.</fo:inline></fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0043-07-0007-it-0640" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0024-d3-0646" color="#0a0c75"><fo:inline font-style="italic">Cap. 1.</fo:inline> <fo:inline font-family="serif" font-size="18pt" space-before="0.1mm" space-after="0.1mm">D</fo:inline>E natura huius Præcepti, ac per<fo:inline font-weight="normal">s</fo:inline>onis<fo:inline> </fo:inline>quas obligat. <fo:inline> </fo:inline>p. 2.</fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0043-07-0007-it-0641" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0025-d3-0647" color="#0a0c75">2. De Mi<fo:inline font-weight="normal">s</fo:inline>sæ exaudiendæ integritate. <fo:inline> </fo:inline>p. 3.</fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0043-07-0007-it-0642" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0025-d3-0648" color="#0a0c75">4. De loco, vbi audienda e<fo:inline font-weight="normal">s</fo:inline>t Mi<fo:inline font-weight="normal">s</fo:inline>sa. <fo:inline> </fo:inline>ibid.</fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0043-07-0007-it-0643" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0026-d3-0649" color="#0a0c75">3. De huius Præcepti materia, quæ<fo:inline> </fo:inline>e<fo:inline font-weight="normal">s</fo:inline>t præ<fo:inline font-weight="normal">s</fo:inline>entia humana, ac religio<fo:inline font-weight="normal">s</fo:inline>a. <fo:inline> </fo:inline>p. 4</fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0043-07-0007-it-0644" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0027-d3-064a" color="#0a0c75">5. De cau<fo:inline font-weight="normal">s</fo:inline>is à præcepto audiendi Sacrum excu<fo:inline font-weight="normal">s</fo:inline>antibus. <fo:inline> </fo:inline>p. 5.</fo:basic-link> </fo:inline></fo:block></fo:block></fo:block>
<fo:block id="W0043-07-0007-it-051a" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:block id="W0043-07-0007-li-0641">
<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0029-d2-0520" color="#0a0c75">SECTIO II.<fo:inline> </fo:inline><fo:inline font-style="italic">De Præcepto audiendi Mi<fo:inline font-weight="bold">s</fo:inline><fo:inline font-weight="bold">s</fo:inline>am. Quæ<fo:inline> </fo:inline><fo:inline font-weight="bold">s</fo:inline>tionis dubiæ. p. 6.</fo:inline></fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0043-07-0007-it-0646" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0029-d3-064c" color="#0a0c75"><fo:inline font-style="italic">Cap. 6.</fo:inline> <fo:inline font-family="serif" font-size="18pt" space-before="0.1mm" space-after="0.1mm">C</fo:inline>Irca huius Præcepti naturam<fo:inline> </fo:inline>de diebu<fo:inline font-weight="normal">s</fo:inline>que pro quibus<fo:inline> </fo:inline>e<fo:inline font-weight="normal">s</fo:inline>t impo<fo:inline font-weight="normal">s</fo:inline>itum <fo:inline> </fo:inline>ibidem</fo:basic-link> </fo:inline>
<fo:block id="W0043-07-0007-li-076d">
<fo:block id="W0043-07-0007-it-0772" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>D. 1. An <fo:inline font-weight="normal">s</fo:inline>it de Fide certum, dari præceptum de audiendo in Fe<fo:inline font-weight="normal">s</fo:inline>tis Sacro. <fo:inline> </fo:inline>ibidem</fo:block>
<fo:block id="W0043-07-0007-it-0773" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Quæ<fo:inline font-weight="normal">s</fo:inline>t incidens. Num in Quadrage<fo:inline font-weight="normal">s</fo:inline>imæ Feriis vi præcepti huius teneatur<fo:inline> </fo:inline>quis Sacrum exaudire. <fo:inline> </fo:inline>ibidem</fo:block>
<fo:block id="W0043-07-0007-it-0774" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Quæ<fo:inline font-weight="normal">s</fo:inline>t. inc. Num in Sanctæ Hebdomadæ tribuo vi præcepti Eccle<fo:inline font-weight="normal">s</fo:inline>ia<fo:inline font-weight="normal">s</fo:inline>tici<fo:inline> </fo:inline>Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am audire teneamur. <fo:inline> </fo:inline>pag. 8.</fo:block>
<fo:block id="W0043-07-0007-it-0775" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Quæ<fo:inline font-weight="normal">s</fo:inline>t. inc Nùm præceptum hoc <fo:inline font-weight="normal">s</fo:inline>uo ex<fo:inline> </fo:inline>genere ad lethali obliget. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0007-it-0776" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>2. An præceptum hoc <fo:inline font-weight="normal">s</fo:inline>it ex iure diuino<fo:inline> </fo:inline>ibidem.</fo:block>
<fo:block id="W0043-07-0007-it-0777" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Quæ<fo:inline font-weight="normal">s</fo:inline>t inc. Nùm ante Concilium Agathen<fo:inline font-weight="normal">s</fo:inline>e fuerit in Eccle<fo:inline font-weight="normal">s</fo:inline>ia de exaudiendo Sacro præceptum. <fo:inline> </fo:inline>p. 9.</fo:block>
<fo:block id="W0043-07-0007-it-0778" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>3. An Pontifex <fo:inline font-weight="normal">s</fo:inline>ummus po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>it in præcepto Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>æ exaudiẽdi<fo:inline font-weight="normal">s</fo:inline>pen<fo:inline font-weight="normal">s</fo:inline>are. <fo:inline> </fo:inline>ibid.</fo:block></fo:block></fo:block>
<fo:block id="W0043-07-0007-it-064e" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0031-d3-0654" color="#0a0c75"><fo:inline font-style="italic">Cap. 7.</fo:inline> Circa Per<fo:inline font-weight="normal">s</fo:inline>onas, quæ ad huius<fo:inline> </fo:inline>ob<fo:inline font-weight="normal">s</fo:inline>eruationem obligantur. <fo:inline> </fo:inline>ibid.</fo:basic-link> </fo:inline>
<fo:block id="W0043-07-0007-li-076e">
<fo:block id="W0043-07-0007-it-077a" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>4. An <fo:inline font-weight="normal">s</fo:inline>tatim ac quis annos di<fo:inline font-weight="normal">s</fo:inline>cretionis<fo:inline> </fo:inline>inierit teneatur hoc præceptum ob<fo:inline font-weight="normal">s</fo:inline>eruare. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0007-it-077b" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Quæ<fo:inline font-weight="normal">s</fo:inline>t. inc. Nùm Eccle<fo:inline font-weight="normal">s</fo:inline>ia<fo:inline font-weight="normal">s</fo:inline>ticæ per<fo:inline font-weight="normal">s</fo:inline>onæ<fo:inline> </fo:inline>nempe Epi<fo:inline font-weight="normal">s</fo:inline>copi, Sacerdotes, Religio<fo:inline font-weight="normal">s</fo:inline>i<fo:inline> </fo:inline><fo:inline font-weight="normal">præceptum</fo:inline> hoc <fo:inline font-weight="normal">teneantur</fo:inline> ob<fo:inline font-weight="normal">s</fo:inline>eruare. p. 10.</fo:block>
<fo:block id="W0043-07-0007-it-077c" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Quæ<fo:inline font-weight="normal">s</fo:inline>t. inc. Verum, qui in fe<fo:inline font-weight="normal">s</fo:inline>to non pote<fo:inline font-weight="normal">s</fo:inline>t Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am, ac Concionem audire: teneatur potius Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am audire, quam<fo:inline> </fo:inline>Concionem: vel è contra Concioni<fo:inline> </fo:inline>potiu<fo:inline font-weight="normal">s</fo:inline>quam Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>æ intere<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0007-it-077d" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>5. An Epi<fo:inline font-weight="normal">s</fo:inline>copus po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>it <fo:inline font-weight="normal">s</fo:inline>ub cen<fo:inline font-weight="normal">s</fo:inline>uris præcipere vt Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am <fo:inline font-weight="normal">s</fo:inline>ubditi in propriis<fo:inline> </fo:inline>Parochiis exaudiant. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0007-it-077e" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Quæ<fo:inline font-weight="normal">s</fo:inline>t. inc. Nùm huius præcepti vi fideles teneantur Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am maiorem exaudire, quando in propria Parochia ei<fo:inline> </fo:inline>lubet præcepto <fo:inline font-weight="normal">s</fo:inline>atisfacere. <fo:inline> </fo:inline>p. 11.</fo:block>
<fo:block id="W0043-07-0007-it-077f" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>6. An qui hora <fo:inline font-weight="normal">s</fo:inline>ecunda, vel tertia Mi<fo:inline font-weight="normal">s</fo:inline>sã<fo:inline> </fo:inline>audierit, <fo:inline font-weight="normal">s</fo:inline>atisfaciat, huic Præcepto. ibid.</fo:block>
<fo:block id="W0043-07-0007-it-0780" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>7. An cùm Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>a coram Summo Præ<fo:inline font-weight="normal">s</fo:inline>ule<fo:inline> </fo:inline>in nocte Natalis Domini celebratur<fo:inline> </fo:inline>ante mediam noctem, <fo:inline font-weight="normal">s</fo:inline>ufficiat, præcepto audiendi Mi<fo:inline font-weight="normal">s</fo:inline>sam in die Natalis,<fo:inline> </fo:inline>qui illi Sacro intere<fo:inline font-weight="normal">s</fo:inline>t. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0007-it-0781" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>8. An <fo:inline font-weight="normal">s</fo:inline>i vigilia, Natiuitatis in Dominica occurrit, po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>it quis præceptum audiendæ Mi<fo:inline font-weight="normal">s</fo:inline>sæ in Dominica<fo:inline font-style="normal" id="W0043-07-0008-pb-03ed"/><fo:inline role="W0043-07-0008-pb-03ed" font-style="normal" font-weight="bold" font-size="12pt">[[vi]]</fo:inline><fo:inline> </fo:inline>implere, <fo:inline font-weight="normal">s</fo:inline>i a<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>i<fo:inline font-weight="normal">s</fo:inline>tat mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ę, quæ oram<fo:inline> </fo:inline>Pontifice <fo:inline font-weight="normal">s</fo:inline>ummo in natalitij Domini ve<fo:inline font-weight="normal">s</fo:inline>pera ante mediam noctem<fo:inline> </fo:inline>celebratur. <fo:inline> </fo:inline>p. 12</fo:block></fo:block></fo:block>
<fo:block id="W0043-07-0008-it-0657" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0034-d3-065d" color="#0a0c75"><fo:inline font-style="italic">Cap. 8.</fo:inline> Circa Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>æ ex Præcepto audiendæ Integritatem. <fo:inline> </fo:inline>ibid.</fo:basic-link> </fo:inline>
<fo:block id="W0043-07-0008-li-076f">
<fo:block id="W0043-07-0008-it-0783" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>9. An qui v<fo:inline font-weight="normal">s</fo:inline>que ad Epi<fo:inline font-weight="normal">s</fo:inline>tolam exclu<fo:inline font-weight="normal">s</fo:inline>iue quis in Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>a omittit, adimpleat præceptum. <fo:inline> </fo:inline>ibidem</fo:block>
<fo:block id="W0043-07-0008-it-0784" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>10. An qui omittit ab Introitu v<fo:inline font-weight="normal">s</fo:inline>que<fo:inline> </fo:inline>ad Epi<fo:inline font-weight="normal">s</fo:inline>tolam inclu<fo:inline font-weight="normal">s</fo:inline>iue, <fo:inline font-weight="normal">s</fo:inline>atisfaciat<fo:inline> </fo:inline>obligationi. <fo:inline> </fo:inline>ibidem</fo:block>
<fo:block id="W0043-07-0008-it-0785" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Quæ<fo:inline font-weight="normal">s</fo:inline>t. inc. Nùm qui ab introitu v<fo:inline font-weight="normal">s</fo:inline>que<fo:inline> </fo:inline>ad offertorium exclu<fo:inline font-weight="normal">s</fo:inline>iue, &amp; po<fo:inline font-weight="normal">s</fo:inline>t<fo:inline> </fo:inline>Communionem v<fo:inline font-weight="normal">s</fo:inline>que ad Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>æ<fo:inline> </fo:inline>finem omittit præcepti <fo:inline font-weight="normal">s</fo:inline>it reus violati? <fo:inline> </fo:inline>p. 13</fo:block>
<fo:block id="W0043-07-0008-it-0786" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>11. An qui omittit ab Introitu v<fo:inline font-weight="normal">s</fo:inline>que<fo:inline> </fo:inline>ad Euangelium inclu<fo:inline font-weight="normal">s</fo:inline>iue: impleat<fo:inline> </fo:inline>præceptum. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0008-it-0787" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>12. An qui ab Introitu v<fo:inline font-weight="normal">s</fo:inline>que ad Euangelium inclu<fo:inline font-weight="normal">s</fo:inline>iue omittit, <fo:inline font-weight="normal">s</fo:inline>ed non<fo:inline> </fo:inline>mox po<fo:inline font-weight="normal">s</fo:inline>t benedictionem recedit,<fo:inline> </fo:inline>D. Ioannis Euangelium audit: præceptum impleat. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0008-it-0788" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>13. An qui ab Introitu Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>æ v<fo:inline font-weight="normal">s</fo:inline>que ad<fo:inline> </fo:inline>Euangelium inclu<fo:inline font-weight="normal">s</fo:inline>iue omi<fo:inline font-weight="normal">s</fo:inline>it, nec<fo:inline> </fo:inline>per vltimi Euangelij <fo:inline font-weight="normal">s</fo:inline>uppleuit auditionem, attamen po<fo:inline font-weight="normal">s</fo:inline>t Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am<fo:inline> </fo:inline>priuatim Euangelium omi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>um per<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>e, vel per alium legit: impleat?<fo:inline> </fo:inline>p. 14.</fo:block>
<fo:block id="W0043-07-0008-it-0789" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>14. An qui omittit Introitum v<fo:inline font-weight="normal">s</fo:inline>que ad<fo:inline> </fo:inline>Epi<fo:inline font-weight="normal">s</fo:inline>tolam inclu<fo:inline font-weight="normal">s</fo:inline>iue, &amp; omnia, quæ<fo:inline> </fo:inline>Sacerdos po<fo:inline font-weight="normal">s</fo:inline>t ab<fo:inline font-weight="normal">s</fo:inline>umptum Calicem<fo:inline> </fo:inline>dictitat: integram, ad præcepti ob<fo:inline font-weight="normal">s</fo:inline>eruationem, Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am exaudiat. ibid.</fo:block>
<fo:block id="W0043-07-0008-it-078a" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>15. An qui à principio Sacri v<fo:inline font-weight="normal">s</fo:inline>que ad Epi<fo:inline font-weight="normal">s</fo:inline>tolã exclu<fo:inline font-weight="normal">s</fo:inline>iue, &amp; po<fo:inline font-weight="normal">s</fo:inline>t communionem v<fo:inline font-weight="normal">s</fo:inline>que ad terminum prætermittit: faciat præcepto <fo:inline font-weight="normal">s</fo:inline>atis <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0008-it-078b" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>16. An qui non ade<fo:inline font-weight="normal">s</fo:inline>t dum po<fo:inline font-weight="normal">s</fo:inline>t vtriu<fo:inline font-weight="normal">s</fo:inline>que<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>peciei con<fo:inline font-weight="normal">s</fo:inline>ecrationem à Sacerdote<fo:inline> </fo:inline>fit Oblatio: impleat audiendæ integræ Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>æ pręceptum. <fo:inline> </fo:inline>ibidem.</fo:block>
<fo:block id="W0043-07-0008-it-078c" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>17. An qui non ade<fo:inline font-weight="normal">s</fo:inline>t: dùm vtriu<fo:inline font-weight="normal">s</fo:inline>que<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>peciei con<fo:inline font-weight="normal">s</fo:inline>ecratio peragitur: integra maudiat Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am? pagina<fo:inline> </fo:inline>15.</fo:block>
<fo:block id="W0043-07-0008-it-078d" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>18. An qui <fo:inline font-weight="normal">s</fo:inline>olummodo Con<fo:inline font-weight="normal">s</fo:inline>umptioni Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>æ non ade<fo:inline font-weight="normal">s</fo:inline>t: impleat Sacri<fo:inline> </fo:inline>audiendi præceptum. ibidem.</fo:block>
<fo:block id="W0043-07-0008-it-078e" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>19. An qui exit Con<fo:inline font-weight="normal">s</fo:inline>ecrationis, Communionis, vel alio tempore acturus, aut declaraturus aliquid ad<fo:inline> </fo:inline>Sacrificium nece<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>arium, verbi gratia, ho<fo:inline font-weight="normal">s</fo:inline>tiam, vinum, aquam, incen<fo:inline font-weight="normal">s</fo:inline>um: audiat integam Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am?<fo:inline> </fo:inline>ibidem.</fo:block>
<fo:block id="W0043-07-0008-it-078f" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>20. An Euangelium Ioannis aliu<fo:inline font-weight="normal">s</fo:inline>ue<fo:inline> </fo:inline>Euangeli<fo:inline font-weight="normal">s</fo:inline>tæ, quod in fine Sacri legitur, pertineat ad ip<fo:inline font-weight="normal">s</fo:inline>ius integritatem <fo:inline> </fo:inline>p. 16</fo:block>
<fo:block id="W0043-07-0008-it-0790" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>21. An Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>io præmi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>a pertineat,<fo:inline> </fo:inline>ad Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>æ integritatem: peccetque<fo:inline> </fo:inline>venialiter, qui illam omittit. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0008-it-0791" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>22. An qui audit ab vno Sacerdote à<fo:inline> </fo:inline>principio Mi<fo:inline font-weight="normal">s</fo:inline>sæ v<fo:inline font-weight="normal">s</fo:inline>que ad con<fo:inline font-weight="normal">s</fo:inline>ecrationem, (verbi gratia) ab alio autem à con<fo:inline font-weight="normal">s</fo:inline>ecratione v<fo:inline font-weight="normal">s</fo:inline>que ad finem: impleat præceptum? pagina 17.</fo:block>
<fo:block id="W0043-07-0008-it-0792" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>23. An qui audit Mi<fo:inline font-weight="normal">s</fo:inline>sam ab vno Sacerdote à con<fo:inline font-weight="normal">s</fo:inline>ecratione v<fo:inline font-weight="normal">s</fo:inline>que ad<fo:inline> </fo:inline>finem, &amp; ab alio po<fo:inline font-weight="normal">s</fo:inline>tea à principio v<fo:inline font-weight="normal">s</fo:inline>que ad con<fo:inline font-weight="normal">s</fo:inline>ecrationem: <fo:inline font-weight="normal">s</fo:inline>atisfaciat præcepto? <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0008-it-0793" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>24. An qui non <fo:inline font-weight="normal">s</fo:inline>ucce<fo:inline font-weight="normal">s</fo:inline>siuè <fo:inline font-weight="normal">s</fo:inline>ed <fo:inline font-weight="normal">s</fo:inline>imul<fo:inline> </fo:inline>audit Mi<fo:inline font-weight="normal">s</fo:inline>sam à duobus Sacerdotibus, ab vno <fo:inline font-weight="normal">s</fo:inline>cilicet ab initio v<fo:inline font-weight="normal">s</fo:inline>que ad con<fo:inline font-weight="normal">s</fo:inline>ecrationem, ab alio<fo:inline> </fo:inline>autem à con<fo:inline font-weight="normal">s</fo:inline>ecratione v<fo:inline font-weight="normal">s</fo:inline>que ad<fo:inline> </fo:inline>finem, <fo:inline font-weight="normal">s</fo:inline>atisfaciat præcepto? ibidem.</fo:block>
<fo:block id="W0043-07-0008-it-0794" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>25. An venialiter delinquat, qui ab<fo:inline font-weight="normal">s</fo:inline>que<fo:inline> </fo:inline>cau<fo:inline font-weight="normal">s</fo:inline>a mediam Mi<fo:inline font-weight="normal">s</fo:inline>sam ab vno, &amp;<fo:inline> </fo:inline>&amp; mediam ab alio Sacerdote exaudit? <fo:inline> </fo:inline>p. 18</fo:block>
<fo:block id="W0043-07-0008-it-0795" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>26. An qui obligatur ex præcepto, ex<fo:inline> </fo:inline>votoque duas Mi<fo:inline font-weight="normal">s</fo:inline>sas audire, Vtrique<fo:inline> </fo:inline>obligationi <fo:inline font-weight="normal">s</fo:inline>atisfaciat eas <fo:inline font-weight="normal">s</fo:inline>imul audiendo? <fo:inline> </fo:inline>pag. 19</fo:block>
<fo:block id="W0043-07-0008-it-0796" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>27. An qui ex pœnitentia iniuncta ad<fo:inline font-weight="normal">s</fo:inline>trictus e<fo:inline font-weight="normal">s</fo:inline>t tres Mi<fo:inline font-weight="normal">s</fo:inline>sas verbi gratia<fo:inline> </fo:inline>audire, <fo:inline font-weight="normal">s</fo:inline>atisfaciat illas <fo:inline font-weight="normal">s</fo:inline>imul eadem<fo:inline> </fo:inline>temporis in<fo:inline font-weight="normal">s</fo:inline>tantia exaudiendo?<fo:inline> </fo:inline>ibidem.</fo:block>
<fo:block id="W0043-07-0008-it-0797" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>28. An qui non pote<fo:inline font-weight="normal">s</fo:inline>t integræ Mi<fo:inline font-weight="normal">s</fo:inline>sæ a<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>i<fo:inline font-weight="normal">s</fo:inline>tere, pote<fo:inline font-weight="normal">s</fo:inline>t tamen v<fo:inline font-weight="normal">s</fo:inline>que ad con<fo:inline font-weight="normal">s</fo:inline>ecrationem exclu<fo:inline font-weight="normal">s</fo:inline>iue; debeat, &amp; hanc<fo:inline> </fo:inline>partem audire. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0008-it-0798" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>29. An qui accedit ad Sacrum audiendum tempore; quo Pręfatio dicitur<fo:inline> </fo:inline>nec alia Mi<fo:inline font-weight="normal">s</fo:inline>sa celebranda <fo:inline font-weight="normal">s</fo:inline>ube<fo:inline font-weight="normal">s</fo:inline>t, teneatur v<fo:inline font-weight="normal">s</fo:inline>que ad finem exaudire?<fo:inline> </fo:inline>pag. 20.</fo:block>
<fo:block id="W0043-07-0008-it-0799" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>30. An qui Mi<fo:inline font-weight="normal">s</fo:inline>se leuem partem<fo:inline> </fo:inline>omi<fo:inline font-weight="normal">s</fo:inline>it, teneatur <fo:inline font-weight="normal">s</fo:inline>ub veniali<fo:inline> </fo:inline>illum <fo:inline font-weight="normal">s</fo:inline>upplere defectum altero<fo:inline> </fo:inline>in Sacro partem omi<fo:inline font-weight="normal">s</fo:inline>sam audiendo?<fo:inline> </fo:inline>ibidem.</fo:block></fo:block></fo:block>
<fo:block id="W0043-07-0008-it-066f" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0042-d3-0675" color="#0a0c75"><fo:inline font-style="italic">Caput 9.</fo:inline> Circa nece<fo:inline font-weight="normal">s</fo:inline>sariam ad<fo:inline font-style="normal" id="W0043-07-0009-pb-03ee"/><fo:inline role="W0043-07-0009-pb-03ee" font-style="normal" font-weight="bold" font-size="12pt">[[vii]]</fo:inline><fo:inline> </fo:inline>Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am audiendam attentionem.<fo:inline> </fo:inline>ibidem.</fo:basic-link> </fo:inline>
<fo:block id="W0043-07-0009-li-0770">
<fo:block id="W0043-07-0009-it-079b" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>31. An qui Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am <fo:inline font-weight="normal">s</fo:inline>ine interna attentione exaudit <fo:inline font-weight="normal">s</fo:inline>atisfaciat Eccle<fo:inline font-weight="normal">s</fo:inline>iæ præcepto. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0009-it-079c" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>32. An qui dum Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am audit, Horas Canonicas, vel Ro<fo:inline font-weight="normal">s</fo:inline>arium (verbi gratia) ex voto, aut ex pœnitentia recitat: Impleat præceptum. pagina 21.</fo:block>
<fo:block id="W0043-07-0009-it-079d" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>33. An qui dum in fe<fo:inline font-weight="normal">s</fo:inline>to Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am audit, Horas legis, aut Ro<fo:inline font-weight="normal">s</fo:inline>arium recitat in pœnitentia, aut voto, delinquat venialiter. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0009-it-079e" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>34. An <fo:inline font-weight="normal">s</fo:inline>i dum Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am audis, tuæ concon<fo:inline font-weight="normal">s</fo:inline>cientiæ examen geris, impleas<fo:inline> </fo:inline>præceptum. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0009-it-079f" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>35. An <fo:inline font-weight="normal">s</fo:inline>i dum Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>æ a<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>i<fo:inline font-weight="normal">s</fo:inline>tis tua piacula<fo:inline> </fo:inline>confiteris <fo:inline font-weight="normal">s</fo:inline>atisfacias Eccle<fo:inline font-weight="normal">s</fo:inline>iæ præcepto. <fo:inline> </fo:inline>p. 22</fo:block>
<fo:block id="W0043-07-0009-it-07a0" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>36. An qui dum Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>æ a<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>i<fo:inline font-weight="normal">s</fo:inline>tit, cum aliis<fo:inline> </fo:inline>confabulatur, ridet, locatur <fo:inline font-weight="normal">s</fo:inline>ine interruptione: Impleat præceptum.<fo:inline> </fo:inline>ibidem.</fo:block></fo:block></fo:block>
<fo:block id="W0043-07-0009-it-0676" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0044-d3-067c" color="#0a0c75"><fo:inline font-style="italic">Cap. 10.</fo:inline> Cirea audiendi Sacrum Intentionem. <fo:inline> </fo:inline>ibid.</fo:basic-link> </fo:inline>
<fo:block id="W0043-07-0009-li-0771">
<fo:block id="W0043-07-0009-it-07a2" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>37. An vt huic præcepto <fo:inline font-weight="normal">s</fo:inline>atisfacias,<fo:inline> </fo:inline>vltra voluntatem audiendi Sacrum,<fo:inline> </fo:inline>nece<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>aria <fo:inline font-weight="normal">s</fo:inline>it formalis <fo:inline font-weight="normal">s</fo:inline>iue expre<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>a voluntas audiendi illud <fo:inline font-weight="normal">s</fo:inline>ub intentione præceptum implendi. ibidem.</fo:block>
<fo:block id="W0043-07-0009-it-07a3" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>38. An nece<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>aria <fo:inline font-weight="normal">s</fo:inline>it <fo:inline font-weight="normal">s</fo:inline>altem ad <fo:inline font-weight="normal">s</fo:inline>atisfaciendum huic præcepto voluntas implicita, vel virtualis audiendi Sacrum,<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>ub intentione implendi præceptum.<fo:inline> </fo:inline>p. 23.</fo:block>
<fo:block id="W0043-07-0009-it-07a4" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>39. An qui omnino inuitis cogitur Sacro intere<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e impleat præceptum.<fo:inline> </fo:inline>ibidem</fo:block>
<fo:block id="W0043-07-0009-it-07a5" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>40. An <fo:inline font-weight="normal">s</fo:inline>atisfaciat præcepto audiendi<fo:inline> </fo:inline>Sacrum puer, qui quamuis attente illud audiat non tamen audii<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>et,<fo:inline> </fo:inline>ni<fo:inline font-weight="normal">s</fo:inline>i eum parens, aut Pedagogus traheret. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0009-it-07a6" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>41. An filius, famuli aut pupilli, dum<fo:inline> </fo:inline>Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am actu audiunt, hunc actum<fo:inline> </fo:inline>eliciunt, &amp; hanc intentionem habent: <fo:inline font-style="italic">Non audiemus, ni<fo:inline font-weight="normal">s</fo:inline>i à parente, hero, aut Pedagogo cogeremur.</fo:inline><fo:inline> </fo:inline>Impleant præceptum? <fo:inline> </fo:inline>p. 24</fo:block>
<fo:block id="W0043-07-0009-it-07a7" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>42. An qui vult Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am audire, non tamen intendit præceptum implere, <fo:inline font-weight="normal">s</fo:inline>atisfaciat præcepto. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0009-it-07a8" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>43. An dum Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>æ a<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>i<fo:inline font-weight="normal">s</fo:inline>tis, &amp; per exta<fo:inline font-weight="normal">s</fo:inline>im in diuinorum contemplationem eleuaris: Impleas præceptum.<fo:inline> </fo:inline>pagina 225.</fo:block>
<fo:block id="W0043-07-0009-it-07a9" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>44. An <fo:inline font-weight="normal">s</fo:inline>i dum Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>æ a<fo:inline font-weight="normal">s</fo:inline>si<fo:inline font-weight="normal">s</fo:inline>tis P<fo:inline font-weight="normal">s</fo:inline>almos<fo:inline> </fo:inline>(ex. c.) vel aliquid ad Deum pertinens <fo:inline font-weight="normal">s</fo:inline>cribis, <fo:inline font-weight="normal">s</fo:inline>atisfacias præcepto.<fo:inline> </fo:inline>ibidem.</fo:block>
<fo:block id="W0043-07-0009-it-07aa" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>45. An <fo:inline font-weight="normal">s</fo:inline>i Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>æ a<fo:inline font-weight="normal">s</fo:inline>si<fo:inline font-weight="normal">s</fo:inline>tis ex deuotione animo non implendi præceptum<fo:inline> </fo:inline>tali Mi<fo:inline font-weight="normal">s</fo:inline>sæ auditione, <fo:inline font-weight="normal">s</fo:inline>ed alterius,<fo:inline> </fo:inline>quam po<fo:inline font-weight="normal">s</fo:inline>tmodum intendis audire,<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>i deinde mutas voluntatem <fo:inline font-weight="normal">s</fo:inline>ecundam audiendi: Vt prima, quam ex<fo:inline> </fo:inline>deuotione audi<fo:inline font-weight="normal">s</fo:inline>ti, præcepto <fo:inline font-weight="normal">s</fo:inline>atisfacias, debeas intra obligationis tempus mutare animum, &amp; velle adimplere præceptum per Mi<fo:inline font-weight="normal">s</fo:inline>sam ex deuotione auditam. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0009-it-07ab" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>46. Votum emi<fo:inline font-weight="normal">s</fo:inline>i<fo:inline font-weight="normal">s</fo:inline>ti vnam Mi<fo:inline font-weight="normal">s</fo:inline>sam<fo:inline> </fo:inline>audiendi, quam animo non <fo:inline font-weight="normal">s</fo:inline>atisfaciendi voto exaudis: tenerisne<fo:inline> </fo:inline>aliam audire, ad voti <fo:inline font-weight="normal">s</fo:inline>atisfactionem.<fo:inline> </fo:inline>p. 26.</fo:block></fo:block></fo:block>
<fo:block id="W0043-07-0009-it-0681" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0048-d3-0687" color="#0a0c75"><fo:inline font-style="italic">Cap. 11.</fo:inline> Circa corpoream ad Sacrum<fo:inline> </fo:inline>audiendum a<fo:inline font-weight="normal">s</fo:inline>si<fo:inline font-weight="normal">s</fo:inline>tentiam? ibidem.</fo:basic-link> </fo:inline>
<fo:block id="W0043-07-0009-li-0772">
<fo:block id="W0043-07-0009-it-07ad" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>47. An qui commodè pote<fo:inline font-weight="normal">s</fo:inline>t audire,<fo:inline> </fo:inline>ac videre celebrantem teneatur ad<fo:inline> </fo:inline>vtrumque huius vi præcepti. ibidem.</fo:block>
<fo:block id="W0043-07-0009-it-07ae" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>48. An qui <fo:inline font-weight="normal">s</fo:inline>imul e<fo:inline font-weight="normal">s</fo:inline>t <fo:inline font-weight="normal">s</fo:inline>urdus, mutus, &amp; cœcus, teneatur Mi<fo:inline font-weight="normal">s</fo:inline>sam audire. ibidem.</fo:block>
<fo:block id="W0043-07-0009-it-07af" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>49. Vt quis Mi<fo:inline font-weight="normal">s</fo:inline>sæ audiendæ præceptum<fo:inline> </fo:inline>impleat, teneturne ade<fo:inline font-weight="normal">s</fo:inline>se intra Eccle<fo:inline font-weight="normal">s</fo:inline>iam, in qua celebratur. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0009-it-07b0" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>50. Mi<fo:inline font-weight="normal">s</fo:inline>sam quæ in Templo celebratur,<fo:inline> </fo:inline>quis fene<fo:inline font-weight="normal">s</fo:inline>tra domus extra Templum<fo:inline> </fo:inline>extructæ exaudit: Impletne præceptum. <fo:inline> </fo:inline>p. 27</fo:block>
<fo:block id="W0043-07-0009-it-07b1" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>51. Exi<fo:inline font-weight="normal">s</fo:inline>tens quis in choro <fo:inline font-weight="normal">s</fo:inline>tricto po<fo:inline font-weight="normal">s</fo:inline>t<fo:inline> </fo:inline>Alere Mi<fo:inline font-weight="normal">s</fo:inline>sam audit: impletne præceptum. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0009-it-07b2" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>52. Mi<fo:inline font-weight="normal">s</fo:inline>sam quis audit po<fo:inline font-weight="normal">s</fo:inline>t Eccle<fo:inline font-weight="normal">s</fo:inline>iæ<fo:inline> </fo:inline>parietem exi<fo:inline font-weight="normal">s</fo:inline>tens, <fo:inline font-weight="normal">s</fo:inline>atisfacitne præcepto. <fo:inline> </fo:inline>ibid.</fo:block></fo:block></fo:block>
<fo:block id="W0043-07-0009-it-0688" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0050-d3-068e" color="#0a0c75"><fo:inline font-style="italic">C. 12.</fo:inline> Circa cau<fo:inline font-weight="normal">s</fo:inline>as à præcepto audiendi<fo:inline> </fo:inline>Mi<fo:inline font-weight="normal">s</fo:inline>sam excu<fo:inline font-weight="normal">s</fo:inline>antes. <fo:inline> </fo:inline>p. 28</fo:basic-link> </fo:inline>
<fo:block id="W0043-07-0009-li-0773">
<fo:block id="W0043-07-0009-it-07b4" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>53. Per<fo:inline font-weight="normal">s</fo:inline>onaliter quis e<fo:inline font-weight="normal">s</fo:inline>t interdictus, vel<fo:inline> </fo:inline>excommunicatus, excu<fo:inline font-weight="normal">s</fo:inline>aturne ab audiendæ mi<fo:inline font-weight="normal">s</fo:inline>sæ præcepto. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0009-it-07b5" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>54. Excommunicatus, vel interdictus facile pote<fo:inline font-weight="normal">s</fo:inline>t à cen<fo:inline font-weight="normal">s</fo:inline>ura ab<fo:inline font-weight="normal">s</fo:inline>olutionem<fo:inline> </fo:inline>obtinere, <fo:inline font-weight="normal">s</fo:inline>i eam obtinere non nititur,<fo:inline> </fo:inline>reu<fo:inline font-weight="normal">s</fo:inline>ne e<fo:inline font-weight="normal">s</fo:inline>t violationis Eccle<fo:inline font-weight="normal">s</fo:inline>ia<fo:inline font-weight="normal">s</fo:inline>tici huius præcepti. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0009-it-07b6" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>55. Apud locum interdictum quis commoratur, qui tamen facile pote<fo:inline font-weight="normal">s</fo:inline>t ad<fo:inline> </fo:inline>locum non interdictum pergere: Excu<fo:inline font-weight="normal">s</fo:inline>aturne ab audiendi Sacri præcepto.<fo:inline> </fo:inline>ibidem.</fo:block>
<fo:block id="W0043-07-0010-it-07b7" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline font-style="normal" id="W0043-07-0010-pb-03ef"/><fo:inline role="W0043-07-0010-pb-03ef" font-style="normal" font-weight="bold" font-size="12pt">[[viii]]</fo:inline><fo:inline> </fo:inline>56. Habet quis priuilegium vt tempore<fo:inline> </fo:inline>Interdicti po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>it at dire Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am teneturne illo vti, &amp; præceptum implere.<fo:inline> </fo:inline>p. 29.</fo:block>
<fo:block id="W0043-07-0010-it-07b8" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>57. Exculatur ab audiendæ Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>æ præcepto, qui alium non habet Sacerdotem<fo:inline> </fo:inline>ni<fo:inline font-weight="normal">s</fo:inline>i per<fo:inline font-weight="normal">s</fo:inline>onaliter interdictum. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0010-it-07b9" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>58. Excu<fo:inline font-weight="normal">s</fo:inline>ari<fo:inline font-weight="normal">s</fo:inline>ne Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>æ audiendi præcepto, <fo:inline font-weight="normal">s</fo:inline>i non ad<fo:inline font-weight="normal">s</fo:inline>it, qui celebret ni<fo:inline font-weight="normal">s</fo:inline>i notorius concubinarius. <fo:inline> </fo:inline>p. 30</fo:block>
<fo:block id="W0043-07-0010-it-07ba" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>59. An qui domi per vim, vel ægritudinem, vel loco carceris detinetur, habens inibi Oratorium approbatum:<fo:inline> </fo:inline>teneturne Sacerdotem <fo:inline font-weight="normal">s</fo:inline>tipendio<fo:inline> </fo:inline>perquirere, vt præcepto <fo:inline font-weight="normal">s</fo:inline>atisfaciat.<fo:inline> </fo:inline>ibidem.</fo:block>
<fo:block id="W0043-07-0010-it-07bb" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>60. Qui domi per vim, vel per ægritudinem detinetur Oratorium approbatum habens teneturne Sacerdotem<fo:inline> </fo:inline>adducere <fo:inline font-weight="normal">s</fo:inline>i ab<fo:inline font-weight="normal">s</fo:inline>que <fo:inline font-weight="normal">s</fo:inline>tipendio po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>it.<fo:inline> </fo:inline>ibidem.</fo:block>
<fo:block id="W0043-07-0010-it-07bc" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>61. An di<fo:inline font-weight="normal">s</fo:inline>tantia vnius leucæ, <fo:inline font-weight="normal">s</fo:inline>eu trium<fo:inline> </fo:inline>milliarium <fo:inline font-weight="normal">s</fo:inline>it <fo:inline font-weight="normal">s</fo:inline>ufficiens, vt à Sacro audiendo quis excu<fo:inline font-weight="normal">s</fo:inline>etur, <fo:inline font-weight="normal">s</fo:inline>i pede<fo:inline font-weight="normal">s</fo:inline>tri iter<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>it acturus ince<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ui. <fo:inline> </fo:inline>p. 31</fo:block>
<fo:block id="W0043-07-0010-it-07bd" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>62. An di<fo:inline font-weight="normal">s</fo:inline>tantia vnius leucæ <fo:inline font-weight="normal">s</fo:inline>ufficiat, ad<fo:inline> </fo:inline>excu<fo:inline font-weight="normal">s</fo:inline>andum à præcepti impletione<fo:inline> </fo:inline>eũ qui eques iter e<fo:inline font-weight="normal">s</fo:inline>t peracturus. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0010-it-07be" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>63. Mater, quæ domi manet ad filiarum<fo:inline> </fo:inline>cu<fo:inline font-weight="normal">s</fo:inline>todiam, quas <fo:inline font-weight="normal">s</fo:inline>ine nocumento puritatis <fo:inline font-weight="normal">s</fo:inline>olas relinquere nequit excu<fo:inline font-weight="normal">s</fo:inline>aturne à Sacro exaudiendo. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0010-it-07bf" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>64. Mater aut nutrix non habens, cui dũ<fo:inline> </fo:inline>ad mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am audiendam pergit, po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>it infantulum commendare, excu<fo:inline font-weight="normal">s</fo:inline>etur à<fo:inline> </fo:inline>Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>æ auditione. <fo:inline> </fo:inline>p. 32</fo:block>
<fo:block id="W0043-07-0010-it-07c0" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>65. An excu<fo:inline font-weight="normal">s</fo:inline>etur, à præcepti huius cu<fo:inline font-weight="normal">s</fo:inline>todia vxor, quam maritus ob zelotypiam domo egredi renuit. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0010-it-07c1" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>66. An ab<fo:inline font-weight="normal">s</fo:inline>olute excu<fo:inline font-weight="normal">s</fo:inline>entur famuli, qui<fo:inline> </fo:inline>vt obediant horis aliquid Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>æ tem<fo:inline> </fo:inline>pore imperantibus, eam non exaudiunt. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0010-it-07c2" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>67. Fœminæ, aut viri nobiles carent decenti ve<fo:inline font-weight="normal">s</fo:inline>te, aut comitatu, vt à præcepto audiendi Sacrum excu<fo:inline font-weight="normal">s</fo:inline>entur, debentne prius ve<fo:inline font-weight="normal">s</fo:inline>tem mutuo acceptam, aut comitatum decentem requirere. <fo:inline> </fo:inline>p. 33</fo:block>
<fo:block id="W0043-07-0010-it-07c3" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>68. An Pa<fo:inline font-weight="normal">s</fo:inline>tores ouium ab<fo:inline font-weight="normal">s</fo:inline>olute teneantur, Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am audire. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0010-it-07c4" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>69. Iter quis agit cum <fo:inline font-weight="normal">s</fo:inline>ociis, excu<fo:inline font-weight="normal">s</fo:inline>aturne<fo:inline> </fo:inline>ab audiendo Sacro ea <fo:inline font-weight="normal">s</fo:inline>olum ex cau<fo:inline font-weight="normal">s</fo:inline>a, ne <fo:inline font-weight="normal">s</fo:inline>ociis abeuntibus, <fo:inline font-weight="normal">s</fo:inline>olus pergere<fo:inline> </fo:inline>cogatur. <fo:inline> </fo:inline>ibidem</fo:block>
<fo:block id="W0043-07-0010-it-07c5" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>70. Credit puella, <fo:inline font-weight="normal">s</fo:inline>e ab adole<fo:inline font-weight="normal">s</fo:inline>cente perdite adamandam, <fo:inline font-weight="normal">s</fo:inline>i domo exeat, vt illius peccatum vitet, excu<fo:inline font-weight="normal">s</fo:inline>aturne à Sacro exaudiendo. <fo:inline> </fo:inline>p. 34</fo:block>
<fo:block id="W0043-07-0010-it-07c6" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>71. An ignorantia inuincibilis, obliuio,<fo:inline> </fo:inline>vel incon<fo:inline font-weight="normal">s</fo:inline>ideratio diei fe<fo:inline font-weight="normal">s</fo:inline>ti excu<fo:inline font-weight="normal">s</fo:inline>ent<fo:inline> </fo:inline>ab implendo audiendæ Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>æ præcepto. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0010-it-07c7" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>72. An excu<fo:inline font-weight="normal">s</fo:inline>entur, à præcepti huius <fo:inline font-weight="normal">s</fo:inline>atisfactione viduę, quæ ex recepta<fo:inline> </fo:inline>con<fo:inline font-weight="normal">s</fo:inline>uetudine per <fo:inline font-weight="normal">s</fo:inline>eme<fo:inline font-weight="normal">s</fo:inline>tre, vel annum<fo:inline> </fo:inline>domi <fo:inline font-weight="normal">s</fo:inline>e<fo:inline font-weight="normal">s</fo:inline>e, mortuo marito, continent.<fo:inline> </fo:inline>ibidem.</fo:block>
<fo:block id="W0043-07-0010-it-07c8" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>73. An nobiles puellæ, quæ non <fo:inline font-weight="normal">s</fo:inline>olent<fo:inline> </fo:inline>domo egredi, ad Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am audiendam,<fo:inline> </fo:inline>excu<fo:inline font-weight="normal">s</fo:inline>entur ab huius præcepti impletione, <fo:inline font-weight="normal">s</fo:inline>i ad ludos, comœdias, taurorum agitationem, &amp;c. procedant. pagina 35.</fo:block>
<fo:block id="W0043-07-0010-it-07c9" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>74. An excu<fo:inline font-weight="normal">s</fo:inline>entur, ab auditione Sacri<fo:inline> </fo:inline>fœminæ, quæ men<fo:inline font-weight="normal">s</fo:inline>trua afficiuntur<fo:inline> </fo:inline>ægritudine, vbi viget non accedendi<fo:inline> </fo:inline>ad Templum eo tempore con<fo:inline font-weight="normal">s</fo:inline>uetudo. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0010-it-07ca" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>75. An qui ex pietate agendæ Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionis ob deuotionem detinentur, excu<fo:inline font-weight="normal">s</fo:inline>entur ab<fo:inline font-weight="normal">s</fo:inline>olutè ab audiendi Sacri<fo:inline> </fo:inline>præcepto. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0010-it-07cb" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>76. An qui rationabili ex cau<fo:inline font-weight="normal">s</fo:inline>a ab audiendo Sacro excu<fo:inline font-weight="normal">s</fo:inline>atur, loco illius<fo:inline> </fo:inline>teneatur, aliud pium opus gerere, aut<fo:inline> </fo:inline>orationes profundere. <fo:inline> </fo:inline>ibid.</fo:block></fo:block></fo:block>
</fo:block></fo:block>
</fo:block></fo:block>
<fo:block id="W0043-07-0010-it-044b" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:block id="W0043-07-0010-li-051e">
<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0059-d1-0451" color="#0a0c75">LIBER XLIII.<fo:inline> </fo:inline><fo:inline font-style="italic">Præceptum <fo:inline font-weight="bold">s</fo:inline>ecundum de Confe<fo:inline font-weight="bold">s</fo:inline>sione annua.</fo:inline></fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0043-07-0010-it-0577" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:block id="W0043-07-0010-li-064a">
<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0059-d2-057d" color="#0a0c75">SECTIO I.<fo:inline> </fo:inline><fo:inline font-style="italic">De præcepto annuæ Confe<fo:inline font-weight="bold">s</fo:inline><fo:inline font-weight="bold">s</fo:inline>ionis receptiores<fo:inline> </fo:inline><fo:inline font-weight="bold">s</fo:inline>ine pugna <fo:inline font-weight="bold">s</fo:inline>ententiæ.<fo:inline> </fo:inline>pag. 37.</fo:inline></fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0043-07-0010-it-06a3" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0059-d3-06a9" color="#0a0c75"><fo:inline font-style="italic">Cap. 1.</fo:inline> <fo:inline font-family="serif" font-size="18pt" space-before="0.1mm" space-after="0.1mm">D</fo:inline>E per<fo:inline font-weight="normal">s</fo:inline>onis, quæ Eccle<fo:inline font-weight="normal">s</fo:inline>ia<fo:inline font-weight="normal">s</fo:inline>ticum Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionis præceptum ob<fo:inline font-weight="normal">s</fo:inline>eruare teneantur. <fo:inline> </fo:inline>ibid.</fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0043-07-0010-it-06a4" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0060-d3-06aa" color="#0a0c75"><fo:inline font-style="italic">Cap. 2.</fo:inline> De annuæ Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionis tempore.<fo:inline> </fo:inline>p. 38.</fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0043-07-0010-it-06a5" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0061-d3-06ab" color="#0a0c75"><fo:inline font-style="italic">Cap. 3.</fo:inline> Qua Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ione fiat <fo:inline font-weight="normal">s</fo:inline>atis Præcepto. <fo:inline> </fo:inline>p. 39.</fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0043-07-0010-it-06a6" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0061-d3-06ac" color="#0a0c75"><fo:inline font-style="italic">Cap. 4.</fo:inline> De cau<fo:inline font-weight="normal">s</fo:inline>is excu<fo:inline font-weight="normal">s</fo:inline>antibus ab huius præcepti tran<fo:inline font-weight="normal">s</fo:inline>gre<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ione eiu<fo:inline font-weight="normal">s</fo:inline>que<fo:inline> </fo:inline>pœnarum incur<fo:inline font-weight="normal">s</fo:inline>u. <fo:inline> </fo:inline>ibid.</fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0043-07-0010-it-06a7" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0062-d3-06ae" color="#0a0c75"><fo:inline font-style="italic">Cap. 5.</fo:inline> Circa præcepti huius e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>entiam.<fo:inline> </fo:inline>ibid.</fo:basic-link> </fo:inline>
<fo:block id="W0043-07-0011-li-0776">
<fo:block id="W0043-07-0011-it-07d3" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline font-style="normal" id="W0043-07-0011-pb-03f0"/><fo:inline role="W0043-07-0011-pb-03f0" font-style="normal" font-weight="bold" font-size="12pt">[[ix]]</fo:inline><fo:inline> </fo:inline>Quæ<fo:inline font-weight="normal">s</fo:inline>t. nc. Vtrum annuæ Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionis<fo:inline> </fo:inline>præceptum <fo:inline font-weight="normal">s</fo:inline>ub lethali piaculo obliget. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0011-it-07d4" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>D. 1. An præceptum hoc obliget per <fo:inline font-weight="normal">s</fo:inline>e<fo:inline> </fo:inline>ad Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionem. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0011-it-07d5" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Quæ<fo:inline font-weight="normal">s</fo:inline>t. Inc. Vtrum præceptum hoc quoad <fo:inline font-weight="normal">s</fo:inline>ub<fo:inline font-weight="normal">s</fo:inline>tantiam, &amp; quoad tempus <fo:inline font-weight="normal">s</fo:inline>it<fo:inline> </fo:inline>pure humanum. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0011-it-07d6" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>2. An præceptum hoc confitendi <fo:inline font-weight="normal">s</fo:inline>emel<fo:inline> </fo:inline>in anno <fo:inline font-weight="normal">s</fo:inline>upponat debere non confiteri <fo:inline font-weight="normal">s</fo:inline>tatim po<fo:inline font-weight="normal">s</fo:inline>t commi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>um lethale<fo:inline> </fo:inline>peccatum, <fo:inline font-weight="normal">s</fo:inline>i e<fo:inline font-weight="normal">s</fo:inline>t periculum grauis<fo:inline> </fo:inline>obliuionis. <fo:inline> </fo:inline>p. 41</fo:block></fo:block></fo:block>
<fo:block id="W0043-07-0011-it-06ac" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0063-d3-06b3" color="#0a0c75"><fo:inline font-style="italic">Caput 6.</fo:inline> Circa eos, qui hoc præceptum<fo:inline> </fo:inline>tenentur ob<fo:inline font-weight="normal">s</fo:inline>eruare. <fo:inline> </fo:inline>ibid.</fo:basic-link> </fo:inline>
<fo:block id="W0043-07-0011-li-0777">
<fo:block id="W0043-07-0011-it-07d8" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>3. An Summus Præ<fo:inline font-weight="normal">s</fo:inline>ul obligetur Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionis annuæ præcepto. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0011-it-07d9" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>4. An pueri in quacumque ætate capaces fuerint v<fo:inline font-weight="normal">s</fo:inline>us rationis, <fo:inline font-weight="normal">s</fo:inline>int ad præceptum Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionis annuæ obligati.<fo:inline> </fo:inline>ibidem.</fo:block>
<fo:block id="W0043-07-0011-it-07da" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>5. An hæretici, alijque infideles Sacra vnda diluti, obligentur annuæ Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionis præcepto. <fo:inline> </fo:inline>p. 42</fo:block>
<fo:block id="W0043-07-0011-it-07db" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Quȩ<fo:inline font-weight="normal">s</fo:inline>t. inc. Num octogenarij <fo:inline font-weight="normal">s</fo:inline>enes teneantur annuæ Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionis <fo:inline font-weight="normal">s</fo:inline>eruare<fo:inline> </fo:inline>præceptum. <fo:inline> </fo:inline>p. 43</fo:block>
<fo:block id="W0043-07-0011-it-07dc" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Quæ<fo:inline font-weight="normal">s</fo:inline>t. inc. Num qui <fo:inline font-weight="normal">s</fo:inline>olum internis peccatis <fo:inline font-weight="normal">s</fo:inline>auciantur, teneantur Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionis annuæ prȩceptum implere. ibidem.</fo:block>
<fo:block id="W0043-07-0011-it-07dd" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>6. Quis <fo:inline font-weight="normal">s</fo:inline>olummodo venialibus culpis<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>e comperit reum: Ex vi prȩcepti<fo:inline> </fo:inline>huius teneturne <fo:inline font-weight="normal">s</fo:inline>ub mortali aliqua<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>emel in anno confiteri. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0011-it-07de" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>7. Habet quis lethalia crimina, quæ iu<fo:inline font-weight="normal">s</fo:inline>ta ex cau<fo:inline font-weight="normal">s</fo:inline>a Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ario aperire non<fo:inline> </fo:inline>debet: Tenetur <fo:inline font-weight="normal">s</fo:inline>ub mortali venialia confiteri, vt præceptum hoc impleat. <fo:inline> </fo:inline>p. 44</fo:block>
<fo:block id="W0043-07-0011-it-07df" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>8. Quis lethale non habens, &amp; ideo annuam omittens Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionem, teneturne tamen coram proprio Sacerdote comparere, eique <fo:inline font-weight="normal">s</fo:inline>e con<fo:inline font-weight="normal">s</fo:inline>cientia lethalis piaculi non pungi<fo:inline> </fo:inline>aperire. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0011-it-07e0" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>9. An Eccle<fo:inline font-weight="normal">s</fo:inline>ia po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>it præcipere, <fo:inline font-weight="normal">s</fo:inline>altem<fo:inline> </fo:inline>de aliquibus venialibus Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionem. <fo:inline> </fo:inline>ibid.</fo:block></fo:block></fo:block>
<fo:block id="W0043-07-0011-it-06b6" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0067-d3-06bd" color="#0a0c75"><fo:inline font-style="italic">Caput 7.</fo:inline> Circa Tempus, quo debeat geri<fo:inline> </fo:inline>annua Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>io. <fo:inline> </fo:inline>p. 45</fo:basic-link> </fo:inline>
<fo:block id="W0043-07-0011-li-0778">
<fo:block id="W0043-07-0011-it-07e2" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>10. Quis in anno <fo:inline font-weight="normal">s</fo:inline>emel <fo:inline font-weight="normal">s</fo:inline>altem confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>us<fo:inline> </fo:inline>e<fo:inline font-weight="normal">s</fo:inline>t venialia, <fo:inline font-weight="normal">s</fo:inline>ed ante anni terminum<fo:inline> </fo:inline>mortale committit, teneturne intra<fo:inline> </fo:inline>illum annum, præfatum crimen lethale confiteri. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0011-it-07e3" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>11. Intra annum quis <fo:inline font-weight="normal">s</fo:inline>ua lethalia crimina confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>us fuit, <fo:inline font-weight="normal">s</fo:inline>ed in anni vltimo (verbi gratia) die aliud lethale<fo:inline> </fo:inline>crimen patrauit, teneturne vt prȩcepto <fo:inline font-weight="normal">s</fo:inline>atisfaciat, illud nouum fateri piaculum. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0011-it-07e4" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>12. An præceptum annuæ Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionis<fo:inline> </fo:inline>obliget per <fo:inline font-weight="normal">s</fo:inline>e pro determinato anni<fo:inline> </fo:inline>tempore, verbi gratia, Quadrage<fo:inline font-weight="normal">s</fo:inline>imæ, aut Pa<fo:inline font-weight="normal">s</fo:inline>chatis. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0011-it-07e5" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>13. An ad præcepti huius impletionem<fo:inline> </fo:inline>annus computandus <fo:inline font-weight="normal">s</fo:inline>it à Ianuario in<fo:inline> </fo:inline>Ianuarium. <fo:inline> </fo:inline>p. 46</fo:block>
<fo:block id="W0043-07-0011-it-07e6" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>14. Qui per totum annum Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>us<fo:inline> </fo:inline>non e<fo:inline font-weight="normal">s</fo:inline>t, teneturne quam primum<fo:inline> </fo:inline>anno <fo:inline font-weight="normal">s</fo:inline>equenti confiteri. ibidem</fo:block>
<fo:block id="W0043-07-0011-it-07e7" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>15. Qui, toto anno elap<fo:inline font-weight="normal">s</fo:inline>o ab<fo:inline font-weight="normal">s</fo:inline>que Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ione, po<fo:inline font-weight="normal">s</fo:inline>tea inchoato iam anno<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>equenti confitetur, debetne iterum<fo:inline> </fo:inline>eodem anno confiteri. <fo:inline> </fo:inline>p. 47</fo:block>
<fo:block id="W0043-07-0011-it-07e8" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>16. Qui præuidet, po<fo:inline font-weight="normal">s</fo:inline>tea non <fo:inline font-weight="normal">s</fo:inline>ibi futuram opportunitatem confitendi hoc<fo:inline> </fo:inline>anno, teneturne confe<fo:inline font-weight="normal">s</fo:inline>sionem præuenire, &amp; initio, vel medio anni confiteri. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0011-it-07e9" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>17. An ex vi Clement. 1. <fo:inline font-style="italic">Ne in agro,</fo:inline><fo:inline> </fo:inline>omnes Regulares tam viri, quam<fo:inline> </fo:inline>fœminæ teneantur <fo:inline font-weight="normal">s</fo:inline>emel men<fo:inline font-weight="normal">s</fo:inline>ibus<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>ingulis Confe<fo:inline font-weight="normal">s</fo:inline>sionem inire? pagina 48.</fo:block>
<fo:block id="W0043-07-0011-it-07ea" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>18. An Monahi Benedictini non habentes ni<fo:inline font-weight="normal">s</fo:inline>i venialia, ex vi Clementinæ teneantur <fo:inline font-weight="normal">s</fo:inline>ub lethali, Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionem gerere men<fo:inline font-weight="normal">s</fo:inline>truam. ibidem.</fo:block>
<fo:block id="W0043-07-0011-it-07eb" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>19. An præfati Monachi ex Clementinæ vi teneantur <fo:inline font-weight="normal">s</fo:inline>ub mortali men<fo:inline font-weight="normal">s</fo:inline>truam gerere Confe<fo:inline font-weight="normal">s</fo:inline>sionem <fo:inline font-weight="normal">s</fo:inline>i lethali crimine grauentur. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0011-it-07ec" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>20. An Monachi D. Benedicti, &amp; D. Bernardi <fo:inline font-weight="normal">s</fo:inline>ub mortali obligentur <fo:inline font-weight="normal">s</fo:inline>emel<fo:inline> </fo:inline>in anno <fo:inline font-weight="normal">s</fo:inline>uis Prælatis fateri <fo:inline font-weight="normal">s</fo:inline>ua lethalia piacula, etiam aliis confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionibus ritè ac legitimè expo<fo:inline font-weight="normal">s</fo:inline>ita<fo:inline> </fo:inline>p. 49.</fo:block></fo:block></fo:block>
<fo:block id="W0043-07-0011-it-06c2" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0071-d3-06c9" color="#0a0c75"><fo:inline font-style="italic">Caput 8.</fo:inline> Circa qualitatem Confe<fo:inline font-weight="normal">s</fo:inline>sionis<fo:inline> </fo:inline>per quam huic Præcepto fit <fo:inline font-weight="normal">s</fo:inline>atis<fo:inline> </fo:inline>ibidem.</fo:basic-link> </fo:inline>
<fo:block id="W0043-07-0011-li-0779">
<fo:block id="W0043-07-0011-it-07ee" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>21. An <fo:inline font-weight="normal">s</fo:inline>atisfaciat quis huic præcepte<fo:inline> </fo:inline>per Confe<fo:inline font-weight="normal">s</fo:inline>sionem non integram<fo:inline> </fo:inline>omittendo <fo:inline font-weight="normal">s</fo:inline>cilicet voluntariè aliquot<fo:inline> </fo:inline>externum piaculum. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0011-it-07ef" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>22. An <fo:inline font-weight="normal">s</fo:inline>atisfaciat qui Confe<fo:inline font-weight="normal">s</fo:inline>sioni<fo:inline> </fo:inline>annuæ præcepto, per Confe<fo:inline font-weight="normal">s</fo:inline>sionem<fo:inline> </fo:inline>nullam ex defectu doloris pœnitentis. <fo:inline> </fo:inline>p. 50.</fo:block>
<fo:block id="W0043-07-0011-it-07f0" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>23. An præceptum annuȩ Confe<fo:inline font-weight="normal">s</fo:inline>sioni<fo:inline> </fo:inline>impleatur per Confe<fo:inline font-weight="normal">s</fo:inline>sionem validam<fo:inline> </fo:inline>quidem, <fo:inline font-weight="normal">s</fo:inline>ed informem. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0012-it-07f1" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline font-style="normal" id="W0043-07-0012-pb-03f1"/><fo:inline role="W0043-07-0012-pb-03f1" font-style="normal" font-weight="bold" font-size="12pt">[[x]]</fo:inline><fo:inline> </fo:inline>24. Agit quis integram peccatorum<fo:inline> </fo:inline>Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionem <fo:inline font-weight="normal">s</fo:inline>iue formatam, <fo:inline font-weight="normal">s</fo:inline>iue<fo:inline> </fo:inline>non, <fo:inline font-weight="normal">s</fo:inline>ed ab<fo:inline font-weight="normal">s</fo:inline>olutionem non recipit,<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>atisfacitne Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionis annuæ præcepto. <fo:inline> </fo:inline>p. 51.</fo:block></fo:block></fo:block>
<fo:block id="W0043-07-0012-it-06c7" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0073-d3-06ce" color="#0a0c75"><fo:inline font-style="italic">Caput 9.</fo:inline> Circa eos, qui à Præcepto Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionis annuæ <fo:inline font-weight="normal">s</fo:inline>eruando excu<fo:inline font-weight="normal">s</fo:inline>antur.<fo:inline> </fo:inline>ibidem.</fo:basic-link> </fo:inline>
<fo:block id="W0043-07-0012-li-077a">
<fo:block id="W0043-07-0012-it-07f3" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>25. An excu<fo:inline font-weight="normal">s</fo:inline>etur à Præcepti huius<fo:inline> </fo:inline>impletione, qui nequit aliter quam<fo:inline> </fo:inline>per <fo:inline font-weight="normal">s</fo:inline>cripturam confiteri. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0012-it-07f4" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>26. Ad <fo:inline font-weight="normal">s</fo:inline>atisfaciendum præcepto Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionis Eccle<fo:inline font-weight="normal">s</fo:inline>ia<fo:inline font-weight="normal">s</fo:inline>tico, tenetur quis (<fo:inline font-weight="normal">s</fo:inline>i<fo:inline> </fo:inline>aliter non valeat) per interpretem<fo:inline> </fo:inline>fateri. <fo:inline> </fo:inline>ibid.</fo:block></fo:block></fo:block>
<fo:block id="W0043-07-0012-it-06ca" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0074-d3-06d1" color="#0a0c75"><fo:inline font-style="italic">Caput 10.</fo:inline> Circa Pœnas tran<fo:inline font-weight="normal">s</fo:inline>gre<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>oribus huius Præcepti impo<fo:inline font-weight="normal">s</fo:inline>itas. pagina 52.</fo:basic-link> </fo:inline>
<fo:block id="W0043-07-0012-li-077b">
<fo:block id="W0043-07-0012-it-07f6" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Quæ<fo:inline font-weight="normal">s</fo:inline>t. inc. Num de iure communi<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>it pœna impo<fo:inline font-weight="normal">s</fo:inline>ita præcepti annuæ<fo:inline> </fo:inline>Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionis transgre<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>oribus. ibidem.</fo:block>
<fo:block id="W0043-07-0012-it-07f7" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>27. An qui culpa <fo:inline font-weight="normal">s</fo:inline>ua inualidè confitetur annuæ Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionis in<fo:inline font-weight="normal">s</fo:inline>tantia,<fo:inline> </fo:inline>euadat pœnas à iure, aut à Synodo<fo:inline> </fo:inline>impo<fo:inline font-weight="normal">s</fo:inline>itas. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0012-it-07f8" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>28. An pueri non implentes Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionis annuæ præceptum incurrant<fo:inline> </fo:inline>pœnas tran<fo:inline font-weight="normal">s</fo:inline>gre<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>oribus præ<fo:inline font-weight="normal">s</fo:inline>criptas.<fo:inline> </fo:inline>p. 53.</fo:block>
<fo:block id="W0043-07-0012-it-07f9" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>29. An meretrices præceptum Confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionis annuæ violantes, incurrant<fo:inline> </fo:inline>pœnas à Iure præ<fo:inline font-weight="normal">s</fo:inline>criptas, ac Synodalem excommunicationem. ibidem.</fo:block></fo:block></fo:block>
</fo:block></fo:block>
</fo:block></fo:block>
<fo:block id="W0043-07-0012-it-0479" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:block id="W0043-07-0012-li-0526">
<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0076-d1-0480" color="#0a0c75">LIBER XLIV.<fo:inline> </fo:inline><fo:inline font-style="italic">Præceptum Tertium de Communione annua.</fo:inline></fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0043-07-0012-it-05a5" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:block id="W0043-07-0012-li-0652">
<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0076-d2-05ac" color="#0a0c75">SECTIO I.<fo:inline> </fo:inline><fo:inline font-style="italic">De Præcepto annuæ Communionis receptiores <fo:inline font-weight="bold">s</fo:inline>ine pugna <fo:inline font-weight="bold">s</fo:inline>ententiæ.<fo:inline> </fo:inline>pagina 54.</fo:inline></fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0043-07-0012-it-06d1" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0076-d3-06d8" color="#0a0c75"><fo:inline font-style="italic">Cap. 1.</fo:inline> <fo:inline font-family="serif" font-size="18pt" space-before="0.1mm" space-after="0.1mm">P</fo:inline>Lura generatim circa<fo:inline> </fo:inline>Sacram Communionem præmitto.<fo:inline> </fo:inline>ibidem.</fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0043-07-0012-it-06d2" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0077-d3-06d9" color="#0a0c75"><fo:inline font-style="italic">Caput 2.</fo:inline> De Præcepti Eccle<fo:inline font-weight="normal">s</fo:inline>ia<fo:inline font-weight="normal">s</fo:inline>tici annuæ communionis obligatione. pagina 55.</fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0043-07-0012-it-06d3" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0077-d3-06da" color="#0a0c75"><fo:inline font-style="italic">Caput. 3.</fo:inline> De loco vbi Euchari<fo:inline font-weight="normal">s</fo:inline>tia Pa<fo:inline font-weight="normal">s</fo:inline>chali tempore ad præcepti impletionem, <fo:inline font-weight="normal">s</fo:inline>it accipienda. <fo:inline> </fo:inline>ibid.</fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0043-07-0012-it-06d4" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0078-d3-06db" color="#0a0c75"><fo:inline font-style="italic">Caput. 4.</fo:inline> de aliis ad Præcepti huius impletionem nece<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ario edi<fo:inline font-weight="normal">s</fo:inline>cendis. pagina 56.</fo:basic-link> </fo:inline></fo:block></fo:block></fo:block>
<fo:block id="W0043-07-0012-it-05aa" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:block id="W0043-07-0012-li-0653">
<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0080-d2-05b1" color="#0a0c75">SECTIO II.<fo:inline> </fo:inline><fo:inline font-style="italic">De Præcepto annuæ Communionis Dubia.<fo:inline> </fo:inline>pagina 58.</fo:inline></fo:basic-link> </fo:inline></fo:block>
<fo:block id="W0043-07-0012-it-06d6" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0080-d3-06dd" color="#0a0c75"><fo:inline font-style="italic">Caput 5.</fo:inline> <fo:inline font-family="serif" font-size="18pt" space-before="0.1mm" space-after="0.1mm">C</fo:inline>Irca per<fo:inline font-weight="normal">s</fo:inline>onas, quę ad annuæ Communionis præceptum <fo:inline font-weight="normal">s</fo:inline>eruandum tenentur. ibidem.</fo:basic-link> </fo:inline>
<fo:block id="W0043-07-0012-li-077f">
<fo:block id="W0043-07-0012-it-0802" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Dubium 1. An pueri <fo:inline font-weight="normal">s</fo:inline>tatim ac di<fo:inline font-weight="normal">s</fo:inline>cretionis annos attigerint, obligentur<fo:inline> </fo:inline>annuæ Communionis præcepto. pagina 58.</fo:block>
<fo:block id="W0043-07-0012-it-0803" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>2. An Infantes nunc <fo:inline font-weight="normal">s</fo:inline>int capaces fructus Sacramenti Euchari<fo:inline font-weight="normal">s</fo:inline>tiæ. ibidem.</fo:block>
<fo:block id="W0043-07-0012-it-0804" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>3. An pueris, qui peccare po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>unt, &amp;<fo:inline> </fo:inline>aliunde Euchari<fo:inline font-weight="normal">s</fo:inline>tiam nunquam receperunt, quia ad <fo:inline font-weight="normal">s</fo:inline>pecialem præfatam di<fo:inline font-weight="normal">s</fo:inline>cretionem non peruenere, danda <fo:inline font-weight="normal">s</fo:inline>it pro viatico, <fo:inline font-weight="normal">s</fo:inline>i in mortis<fo:inline> </fo:inline>periculo exi<fo:inline font-weight="normal">s</fo:inline>tant. <fo:inline> </fo:inline>p. 59.</fo:block>
<fo:block id="W0043-07-0012-it-0805" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>4. An po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>it dari vt Viaticum Euchari<fo:inline font-weight="normal">s</fo:inline>tia pueris, quando de eorum capacitate dubitatur. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0012-it-0806" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>5. An Summus Pontifex teneatur<fo:inline> </fo:inline>præceptum Communionis annuæ<fo:inline> </fo:inline>ob<fo:inline font-weight="normal">s</fo:inline>eruare <fo:inline font-weight="normal">s</fo:inline>ub lethali piaculo. pagina 60.</fo:block></fo:block></fo:block>
<fo:block id="W0043-07-0012-it-06dc" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0082-d3-06e3" color="#0a0c75"><fo:inline font-style="italic">Caput 6.</fo:inline> Circa tempus annuæ Communionis ob<fo:inline font-weight="normal">s</fo:inline>eruationi deputatum. ibidem.</fo:basic-link> </fo:inline>
<fo:block id="W0043-07-0012-li-0780">
<fo:block id="W0043-07-0012-it-0808" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Quæ<fo:inline font-weight="normal">s</fo:inline>t. inc. An nomine Pa<fo:inline font-weight="normal">s</fo:inline>chatis <fo:inline font-weight="normal">s</fo:inline>olum<fo:inline> </fo:inline>de iure dies Dominica Re<fo:inline font-weight="normal">s</fo:inline>urrectionis cum duobus <fo:inline font-weight="normal">s</fo:inline>equentibus intelligatur. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0012-it-0809" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Quæ<fo:inline font-weight="normal">s</fo:inline>t inc. Num in Hi<fo:inline font-weight="normal">s</fo:inline>pania nomine Pa<fo:inline font-weight="normal">s</fo:inline>chatis tota Quadrage<fo:inline font-weight="normal">s</fo:inline>ima<fo:inline> </fo:inline>ex con<fo:inline font-weight="normal">s</fo:inline>uetudine intelligatur ad huius præcepti impletionem? pagina 6.</fo:block>
<fo:block id="W0043-07-0012-it-080a" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>6. An præceptum hoc ita <fo:inline font-weight="normal">s</fo:inline>it Pa<fo:inline font-weight="normal">s</fo:inline>chati affixum, vt qui in Pa<fo:inline font-weight="normal">s</fo:inline>chate<fo:inline> </fo:inline>non communicauit, teneatur amplius ad communicandum anno illo.<fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0013-it-080b" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline font-style="normal" id="W0043-07-0013-pb-03f2"/><fo:inline role="W0043-07-0013-pb-03f2" font-style="normal" font-weight="bold" font-size="12pt">[[xi]]</fo:inline><fo:inline> </fo:inline>7. An in eo, qui in Pa<fo:inline font-weight="normal">s</fo:inline>chate non communicauit, ita per<fo:inline font-weight="normal">s</fo:inline>euerat communicandi po<fo:inline font-weight="normal">s</fo:inline>t Pa<fo:inline font-weight="normal">s</fo:inline>cha obligatio, vt ip<fo:inline font-weight="normal">s</fo:inline>a vlterior dilatio <fo:inline font-weight="normal">s</fo:inline>emper afferat nouam<fo:inline> </fo:inline>culpam? <fo:inline> </fo:inline>p. 62.</fo:block>
<fo:block id="W0043-07-0013-it-080c" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>An qui præuidet <fo:inline font-weight="normal">s</fo:inline>ibi futurum impedimentum in Pa<fo:inline font-weight="normal">s</fo:inline>chate teneatur, tempus ab Eccle<fo:inline font-weight="normal">s</fo:inline>ia a<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ignatum præuenire. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0013-it-080d" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>9. An qui propter futurum impedimentum in Pa<fo:inline font-weight="normal">s</fo:inline>chate præui<fo:inline font-weight="normal">s</fo:inline>um Communionem anticipauit: teneatur po<fo:inline font-weight="normal">s</fo:inline>tea<fo:inline> </fo:inline>ablato, vel non <fo:inline font-weight="normal">s</fo:inline>ecuto impedimento, in Pa<fo:inline font-weight="normal">s</fo:inline>chate rur<fo:inline font-weight="normal">s</fo:inline>um communicare. <fo:inline> </fo:inline>p. 63</fo:block>
<fo:block id="W0043-07-0013-it-080e" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>An qui <fo:inline font-weight="normal">s</fo:inline>cienter, vel ignoranter communicauit in Pa<fo:inline font-weight="normal">s</fo:inline>chate in <fo:inline font-weight="normal">s</fo:inline>tatu peccati, <fo:inline font-weight="normal">s</fo:inline>atisfaciat Eccle<fo:inline font-weight="normal">s</fo:inline>iæ præcepto.<fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0013-it-080f" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>11. An Eccle<fo:inline font-weight="normal">s</fo:inline>ia, quæ fideles <fo:inline font-weight="normal">s</fo:inline>emel<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>altem in anno communicare iubet,<fo:inline> </fo:inline>innuat quotidianum Euchari<fo:inline font-weight="normal">s</fo:inline>tiæ<fo:inline> </fo:inline>v<fo:inline font-weight="normal">s</fo:inline>um con<fo:inline font-weight="normal">s</fo:inline>ulendum omnibus e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e?<fo:inline> </fo:inline>p. 64.</fo:block></fo:block></fo:block>
<fo:block id="W0043-07-0013-it-06e5" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0087-d3-06ec" color="#0a0c75"><fo:inline font-style="italic">Caput</fo:inline> Circa Eccle<fo:inline font-weight="normal">s</fo:inline>iam, in qua ad<fo:inline> </fo:inline>Pa<fo:inline font-weight="normal">s</fo:inline>chatis Communionem recipienda <fo:inline font-weight="normal">s</fo:inline>it Euchari<fo:inline font-weight="normal">s</fo:inline>tia. <fo:inline> </fo:inline>p. 65</fo:basic-link> </fo:inline>
<fo:block id="W0043-07-0013-li-0781">
<fo:block id="W0043-07-0013-it-0811" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>12. An Sufficiat ad præcepti huius impletionem Euchari<fo:inline font-weight="normal">s</fo:inline>tiam in Cathedrali Eccle<fo:inline font-weight="normal">s</fo:inline>ia <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>cipere. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0013-it-0812" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>13. An Aduenæ, ac peregrini impleant<fo:inline> </fo:inline>præceptum annuæ Communionis<fo:inline> </fo:inline>recipientes in Medicantium Eccle<fo:inline font-weight="normal">s</fo:inline>iis<fo:inline> </fo:inline>Euchari<fo:inline font-weight="normal">s</fo:inline>tiam. <fo:inline> </fo:inline>p. 66</fo:block>
<fo:block id="W0043-07-0013-it-0813" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>14. An mendicantes, po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>int, in <fo:inline font-weight="normal">s</fo:inline>uis Eccle<fo:inline font-weight="normal">s</fo:inline>iis Euchari<fo:inline font-weight="normal">s</fo:inline>tiam <fo:inline font-weight="normal">s</fo:inline>æcularibus cunctis in Pa<fo:inline font-weight="normal">s</fo:inline>chate, ad præceptum implendum, mini<fo:inline font-weight="normal">s</fo:inline>trare. <fo:inline> </fo:inline>ibid.</fo:block>
<fo:block id="W0043-07-0013-it-0814" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>15. An <fo:inline font-weight="normal">s</fo:inline>æcularibus, qui iam præceptum<fo:inline> </fo:inline>annuæ Communionis impleuere,<fo:inline> </fo:inline>vel animum illud implendi habent,<fo:inline> </fo:inline>nondum elap<fo:inline font-weight="normal">s</fo:inline>o tempore præ<fo:inline font-weight="normal">s</fo:inline>cripto: po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>int Mendicantes, in die Re<fo:inline font-weight="normal">s</fo:inline>urrectionis ex deuotione accipiendum mini<fo:inline font-weight="normal">s</fo:inline>trare Euchari<fo:inline font-weight="normal">s</fo:inline>tiam. ibidem.</fo:block></fo:block></fo:block>
<fo:block id="W0043-07-0013-it-06ea" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0043-07-0089-d3-06f1" color="#0a0c75"><fo:inline font-style="italic">Caput 8.</fo:inline> Circa mini<fo:inline font-weight="normal">s</fo:inline>trum Euchari<fo:inline font-weight="normal">s</fo:inline>tiæ<fo:inline> </fo:inline>ad implendum annuæ Communionis præceptum. <fo:inline> </fo:inline>p. 67</fo:basic-link> </fo:inline>
<fo:block id="W0043-07-0013-li-0782">
<fo:block id="W0043-07-0013-it-0816" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Quæ<fo:inline font-weight="normal">s</fo:inline>t. Nùm vi Cruciatæ po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>it quis<fo:inline> </fo:inline>hoc pręceptum implere in qualibet Eccle<fo:inline font-weight="normal">s</fo:inline>ia communicando è cuiu<fo:inline font-weight="normal">s</fo:inline>uis manu Sacerdotis, modo<fo:inline> </fo:inline>in die ip<fo:inline font-weight="normal">s</fo:inline>o Pa<fo:inline font-weight="normal">s</fo:inline>chatis non fiat?<fo:inline> </fo:inline>ibidem.</fo:block>
<fo:block id="W0043-07-0013-it-0817" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>16. An Parocho deficiente vel nolente Euchari<fo:inline font-weight="normal">s</fo:inline>tiam <fo:inline font-weight="normal">s</fo:inline>ubditis mini<fo:inline font-weight="normal">s</fo:inline>trare ad implendum annuæ Cnofe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionis præceptum: Religio<fo:inline font-weight="normal">s</fo:inline>i po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>int eam <fo:inline font-weight="normal">s</fo:inline>æcularibus impertire? p.<fo:inline> </fo:inline>58.</fo:block>
<fo:block id="W0043-07-0013-it-0818" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>17. An po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>int Religio<fo:inline font-weight="normal">s</fo:inline>i in Pa<fo:inline font-weight="normal">s</fo:inline>chate<fo:inline> </fo:inline>Euchari<fo:inline font-weight="normal">s</fo:inline>tiam mini<fo:inline font-weight="normal">s</fo:inline>trare familiaribus actualiter Religio<fo:inline font-weight="normal">s</fo:inline>is in<fo:inline font-weight="normal">s</fo:inline>eruientibus? <fo:inline> </fo:inline>ibid.</fo:block></fo:block></fo:block>
</fo:block></fo:block></fo:block></fo:block>
<fo:block id="W0043-07-0013-it-0498" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:block id="W0043-07-0013-li-052d">
