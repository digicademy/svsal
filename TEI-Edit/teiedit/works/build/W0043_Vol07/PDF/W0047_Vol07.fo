<fo:block id="W0043-07-0203-it-0a86" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline font-family="serif" font-size="18pt" space-before="0.1mm" space-after="0.1mm">Q</fo:inline>Vadrage<fo:inline font-weight="normal">s</fo:inline>imæ feriis vi præcepti teneturne quis Sacrum exaudire. pagina 8.<fo:inline> </fo:inline>numero 54</fo:block>
<fo:block id="W0043-07-0203-it-0a87" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Quadrage<fo:inline font-weight="normal">s</fo:inline>imæ Dominicis <fo:inline font-weight="normal">s</fo:inline>untne oua, &amp;<fo:inline> </fo:inline>lacticinia vetita. pagina 90. numero 184</fo:block>
<fo:block id="W0043-07-0203-it-0a88" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Quadrage<fo:inline font-weight="normal">s</fo:inline>ima, vide v. <fo:inline font-style="italic">Ieiunium.</fo:inline></fo:block></fo:block></fo:block></fo:block></fo:block>
