fo:inline font-style="italic">d. 5. dub. 5. n. 50.</fo:inline> Nauar. <fo:inline font-style="italic"><fo:inline font-weight="normal">s</fo:inline>um. c. 21.<fo:inline> </fo:inline>n. 33.</fo:inline> Henriq. <fo:inline font-style="italic">l. 4. c. 5. n. 2.</fo:inline> Fagund, <fo:inline font-style="italic">de præc. 2. d. 1.<fo:inline> </fo:inline>c. 3. n. 12.</fo:inline> Va<fo:inline font-weight="normal">s</fo:inline>q. <fo:inline font-style="italic">q. 90. a. 2. dub. 4.</fo:inline> Valent. <fo:inline font-style="italic">to. 4. d. 7.<fo:inline> </fo:inline>q. 9. punct. 4.</fo:inline></fo:block>
