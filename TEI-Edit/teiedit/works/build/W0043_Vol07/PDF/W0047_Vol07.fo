ck id="W0043-07-0027-nm-040f" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-07-0027-nm-040f">39 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Et qui ab<fo:inline> </fo:inline>inimico grauem timet<fo:inline> </fo:inline>iniuriam.</fo:inline></fo:inline></fo:block><fo:block id="W0043-07-0027-nm-0410" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-07-0027-nm-0410">40 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Et qui bonorum temporalium iacturam timet.</fo:inline></fo:inline></fo:block><fo:block id="W0043-07-0027-nm-0411" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-07-0027-nm-0411">41 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Et gregum<fo:inline> </fo:inline>cu<fo:inline font-weight="normal">s</fo:inline>todes, &amp;<fo:inline> </fo:inline>mercatoris<fo:inline> </fo:inline>aga<fo:inline font-weight="normal">s</fo:inline>ani armentorũ, &amp;c.</fo:inline></fo:inline></fo:block><fo:block id="W0043-07-0027-nm-0412" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-07-0027-nm-0412">42 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Et molitores, &amp; quilibet alius,<fo:inline> </fo:inline>cui in fe<fo:inline font-weight="normal">s</fo:inline>to<fo:inline> </fo:inline>laborare<fo:inline> </fo:inline>permittitur<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>i ob Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>æ<fo:inline> </fo:inline>auditionem<fo:inline> </fo:inline>opus debeat<fo:inline> </fo:inline>interrumpere.</fo:inline></fo:inline></fo:block><fo:block id="W0043-07-0028-nm-0413" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-07-0028-nm-0413">43 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Quinta<fo:inline> </fo:inline>cau<fo:inline font-weight="normal">s</fo:inline>a, officium, vel<fo:inline> </fo:inline>iu<fo:inline font-weight="normal">s</fo:inline>ta obedientia.</fo:inline></fo:inline></fo:block><fo:block id="W0043-07-0028-nm-0414" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-07-0028-nm-0414">44 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Quando nã<fo:inline> </fo:inline>famuli excu<fo:inline font-weight="normal">s</fo:inline>entur?</fo:inline></fo:inline></fo:block><fo:block id="W0043-07-0028-nm-0415" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-destination="#W0043-07-0028-nm-0415">45 </fo:basic-link><fo:inline font-size="12pt" font-weight="normal" text-align="justify"><fo:inline> </fo:inline><fo:inline font-style="italic">Quando<fo:inline> </fo:inline>domini delinquant?</fo:inline></fo:inline></fo:block><fo:block id="W0043-07-0028-nm-0416" space-before="2mm" space-after="2mm" text-align="justify"><fo:basic-link font-weight="bold" font-size="12pt" color="#0a0c75" internal-de