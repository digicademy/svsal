<fo:block id="W0043-07-0201-it-0a06" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline>Pote<fo:inline font-weight="normal">s</fo:inline>tne Epi<fo:inline font-weight="normal">s</fo:inline>copus <fo:inline font-weight="normal">s</fo:inline>ub cen<fo:inline font-weight="normal">s</fo:inline>uris præcipere, vt<fo:inline> </fo:inline>Mi<fo:inline font-weight="normal">s</fo:inline>sã <fo:inline font-weight="normal">s</fo:inline>ubditi in propriis Parochiis exaudiãt.<fo:inline> </fo:inline>11. 82</fo:block>
