        <delete file="${xml.dir}/W0043_Vol07_007.xml"/>
    </target>
<!-- create lists before doing this step ! -->
    <target name="xslt-008" depends="xslt-007"> <!-- -->
        <echo>Tagged unmarked hyphenations (la).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0043_Vol07_008.xml" out="${xml.dir}/W0043_Vol07_009.xml" style="${xsl.dir}/W0043_Vol07_008.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/lists/W0043_Vol07-la_supposed-hyphenations-from-text.html,../corrlist/lists/W0043_Vol07-marg-la_supposed-hyphenations-from-text.html" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0043_Vol07_008.xml"/>
    </target>
    <target name="xslt-009" depends="xslt-008">
        <echo>Expanded abbreviations (la) main text.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0043_Vol07_009.xml" out="${xml.dir}/W0043_Vol07_010.xml" style="${xsl.dir}/W0043_Vol07_009.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="main" type="STRING"/>
            <param name="startAtLineBeginning" expression="TRUE" type="BOOLEAN"/>
            <param name="changeId" expression="W0043_Vol07_change_015" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0043_Vol07_009.xml"/>
    </target>
    <target name="xslt-010" depends="xslt-009">
        <echo>Expanded abbreviations (la) marginal text.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0043_Vol07_010.xml" out="${xml.dir}/W0043_Vol07_011.xml" style="${xsl.dir}/W0043_Vol07_009.xsl" classpath="${xslt.processor}">
