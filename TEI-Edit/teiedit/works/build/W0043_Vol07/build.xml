<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0043_Vol07" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/textloop/W0043-G/W0043-G.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0043_Vol07.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0043_Vol07_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0043_Vol07_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0043_Vol07_000.xml" tofile="${xml.dir}/W0043_Vol07_v1-0.xml"/>
        <echo>Checkpoint: W0043_Vol07_v1-0.xml (W0043_Vol07_000.xml).</echo>
        <delete file="${xml.dir}/W0043_Vol07_000.xml"/>
    </target>
    
    <target name="patch-000"> <!-- depends="cp-000" -->
        <echo>Structural annotation.</echo>
        <patch originalfile="${xml.dir}/W0043_Vol07_v1-0.xml" destfile="${xml.dir}/W0043_Vol07_001.xml" patchfile="${diff.dir}/W0043_Vol07_000.diff"/>
   <echo>Unclear resolution CB.</echo>
        <patch originalfile="${xml.dir}/W0043_Vol07_001.xml" destfile="${xml.dir}/W0043_Vol07_001_unclear.xml" patchfile="${diff.dir}/W0043_Vol04_000.diff"/>
        <delete file="${xml.dir}/W0043_Vol04_000.xml"/>
        <delete file="${xml.dir}/W0043_Vol07_000.xml"/>
    </target>
    <target name="xslt-001"> <!--depends="patch-000"-->
        <echo>Tagged @n, @type, @xml:id(s) in div(s), list(s) and @target in TOC.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0043_Vol07_001_unclear.xml" out="${xml.dir}/W0043_Vol07_002.xml" style="${xsl.dir}/W0043_Vol07_001.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="xslt-002" depends="xslt-001"> 
        <echo>Added (la) abbreviations depending on word structure with regex.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0043_Vol07_002.xml" out="${xml.dir}/W0043_Vol07_003a.xml" style="${xsl.dir}/W0043_Vol07_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <echo>Repeated (la) abbreviations depending on word structure with regex.</echo>
        <xslt force="true" in="${xml.dir}/W0043_Vol07_003a.xml" out="${xml.dir}/W0043_Vol07_003.xml" style="${xsl.dir}/W0043_Vol07_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0043_Vol07_002.xml"/>
        <delete file="${xml.dir}/W0043_Vol07_003a.xml"/>
    </target>
    <target name="xslt-003" depends="xslt-002"> 
        <echo>Transformation TEI-tite to TEI-All.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0043_Vol07_003.xml" out="${xml.dir}/W0043_Vol07_004.xml" style="${xsl.dir}/W0043_Vol07_003.xsl" classpath="${xslt.processor}">
