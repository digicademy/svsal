        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0043_Vol07_003.xml"/>
    </target>
    <target name="xslt-004" depends="xslt-003"> 
        <echo>Tagged special characters.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0043_Vol07_004.xml" out="${xml.dir}/W0043_Vol07_005.xml" style="${xsl.dir}/W0043_Vol07_004.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0043_Vol07_004.xml"/>
    </target>
    <target name="xslt-005" depends="xslt-004">
