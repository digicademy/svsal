<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0096_Vol01" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/textloop/W0096-A/W0096-A.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0096_Vol01.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0096_Vol01_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0096_Vol01_000.xml" lenient="true"/>
    </target>
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0096_Vol01_000.xml" tofile="${xml.dir}/W0096_Vol01_v1-0.xml"/>
        <echo>Checkpoint: W0096_Vol01_v1-0.xml (W0096_Vol01_000.xml).</echo>
    </target>
    <target name="patch-000" depends="cp-000">
        <patch originalfile="${xml.dir}/W0096_Vol01_000.xml" destfile="${xml.dir}/W0096_Vol01_001.xml" patchfile="${diff.dir}/W0096_Vol01_000.diff"/>
        <echo>Structural Annotation, table of contents, transcription of missing pages (518, 519 - facsimiles 0552, 0553), 
              added \n before each lb (not: lb type=nb") for better readability</echo>
        <delete file="${xml.dir}/W0096_Vol01_000.xml"/>
    </target>
    <target name="xslt-001"> 
        <echo>Add @xml:id and @unit ='section' to milestone.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0096_Vol01_001.xml" out="${xml.dir}/W0096_Vol01_002.xml" style="${xsl.dir}/W0096_Vol01_001.xsl" classpath="${xslt.processor}" >
