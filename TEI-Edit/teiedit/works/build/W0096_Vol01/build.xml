        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0096_Vol01_004.xml" out="${xml.dir}/W0096_Vol01_005.xml" style="${xsl.dir}/W0096_Vol01_004.xsl" classpath="${xslt.processor}" >
