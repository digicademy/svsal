<fo:inline> </fo:inline>o<fo:inline font-weight="normal">s</fo:inline>ten<fo:inline font-weight="normal">s</fo:inline>um e<fo:inline font-weight="normal">s</fo:inline>t, ille cæpit mala fide po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>idere; eo
