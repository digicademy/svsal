<fo:inline> </fo:inline>nomine caueri po<fo:inline font-weight="normal">s</fo:inline>tulat, mitteretur, iuxta ea quæ
<fo:inline> </fo:inline>dicenda <fo:inline font-weight="normal">s</fo:inline>unt, <fo:inline font-weight="normal">s</fo:inline>i ip<fo:inline font-weight="normal">s</fo:inline>e e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>et, qui <fo:inline font-weight="normal">s</fo:inline>ibi cauere po<fo:inline font-weight="normal">s</fo:inline>tularet, i<fo:inline font-weight="normal">s</fo:inline>que, cuius e<fo:inline font-weight="normal">s</fo:inline>t res, vnde damnum timetur,
