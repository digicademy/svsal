<fo:block id="W0008-04-0199-it-06b8" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline font-style="italic"><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0008-04-0199-mi-0627" color="#0a0c75">1</fo:basic-link> </fo:inline>. <fo:inline font-family="serif" font-size="18pt" space-before="0.1mm" space-after="0.1mm">Q</fo:inline>Vi a<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>erant damnum, <fo:inline font-weight="normal">ab<fo:inline font-weight="normal">s</fo:inline>que</fo:inline> lata culpa iuridica datum, non e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e re<fo:inline font-weight="normal">s</fo:inline>tituendum in
