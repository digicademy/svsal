<fo:inline> </fo:inline>te<fo:inline font-weight="normal">s</fo:inline>tatur</fo:inline>, communi praxi e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e receptum, quando furtum dome<fo:inline font-weight="normal">s</fo:inline>ticorum non e<fo:inline font-weight="normal">s</fo:inline>t modicum,
