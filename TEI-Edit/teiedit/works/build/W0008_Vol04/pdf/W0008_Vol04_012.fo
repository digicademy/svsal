<fo:inline> </fo:inline>adhibendi competentem diligentiam ad <fo:inline font-weight="normal">s</fo:inline>ciendum, cuius e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>et, dominoq́ue illam re<fo:inline font-weight="normal">s</fo:inline>tituendi,
<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>i comperiretur, cuius e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>et, tunc<fo:inline font-weight="normal">s</fo:inline>olùm teneretur ad re<fo:inline font-weight="normal">s</fo:inline>titutionem rei, &amp; fructuum, quos,
<fo:inline> </fo:inline>adhibita competenti diligentia, ex illa percepi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>et: atque, <fo:inline font-weight="normal">s</fo:inline>i aliquid horum <fo:inline font-weight="normal">s</fo:inline>ine <fo:inline font-weight="normal">s</fo:inline>ua culpa
<fo:inline> </fo:inline>perii<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>et, non teneretur illud re<fo:inline font-weight="normal">s</fo:inline>tituere, ni<fo:inline font-weight="normal">s</fo:inline>i
