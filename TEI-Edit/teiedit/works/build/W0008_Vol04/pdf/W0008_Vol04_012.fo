<fo:inline> </fo:inline>dedit, po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e optimè id efficere: quoniam domino, qui damnum ex eo animali e<fo:inline font-weight="normal">s</fo:inline>t pa<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>us, <fo:inline font-weight="normal">s</fo:inline>ufficienter <fo:inline font-weight="normal">s</fo:inline>atisfacit, vel <fo:inline font-weight="normal">s</fo:inline>oluendo illi <fo:inline font-weight="normal">s</fo:inline>uum integrum damnum, vel cedendo illi actionem aduer<fo:inline font-weight="normal">s</fo:inline>us culpabiliter interfectorem animalis,
<fo:inline> </fo:inline>quod damnum dedit, loco animalis, vt maluerit
