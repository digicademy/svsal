<fo:inline> </fo:inline>illam duxerit, quia tunc non cen<fo:inline font-weight="normal">s</fo:inline>etur e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e in
