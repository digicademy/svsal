<fo:inline> </fo:inline>locum ducendæ, vt <fo:inline font-weight="normal">s</fo:inline>eruitus teneat, validaq́ue
<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>it conce<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>io, <fo:inline font-weight="normal">s</fo:inline>ed nece<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e e<fo:inline font-weight="normal">s</fo:inline>t accedat con<fo:inline font-weight="normal">s</fo:inline>en<fo:inline font-weight="normal">s</fo:inline>us
<fo:inline> </fo:inline>omnium: tamet<fo:inline font-weight="normal">s</fo:inline>i, quando aliquis aut aliqui
