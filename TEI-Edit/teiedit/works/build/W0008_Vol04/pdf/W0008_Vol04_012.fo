<fo:inline> </fo:inline>indirecta, qui ex officio, <fo:inline font-weight="normal">s</fo:inline>eu <fo:inline font-weight="normal">s</fo:inline>peciali obligatione, <fo:inline font-weight="normal">atque</fo:inline> adeò ex iu<fo:inline font-weight="normal">s</fo:inline>titia, illud impedire tenetur:
<fo:inline> </fo:inline>quales <fo:inline font-weight="normal">s</fo:inline>unt publicę pote<fo:inline font-weight="normal">s</fo:inline>tates, mini<fo:inline font-weight="normal">s</fo:inline>tríve publici, &amp; vniuer<fo:inline font-weight="normal">s</fo:inline>im, qui ad id <fo:inline font-weight="normal">s</fo:inline>e a<fo:inline font-weight="normal">s</fo:inline>trinxerunt, <fo:inline font-weight="normal">s</fo:inline>iue ea
<fo:inline> </fo:inline>ratione <fo:inline font-weight="normal">s</fo:inline>tipendium accipiant, <fo:inline font-weight="normal">s</fo:inline>iue non, vt <fo:inline font-weight="normal">s</fo:inline>unt
<fo:inline> </fo:inline>cu<fo:inline font-weight="normal">s</fo:inline>todes, eorum comparatione, quæ ex officio
