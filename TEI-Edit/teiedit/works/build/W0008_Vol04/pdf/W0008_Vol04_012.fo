<fo:inline> </fo:inline>prædio, in cuius po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ione nos <fo:inline font-weight="normal">s</fo:inline>umus, aut <fo:inline font-weight="normal">s</fo:inline>i lignum mittatur in parietem domus, in cuius po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ione nos <fo:inline font-weight="normal">s</fo:inline>umus, vtiliùs nunciari opus nouum aliquo ex duobus po<fo:inline font-weight="normal">s</fo:inline>terioribus modis,
