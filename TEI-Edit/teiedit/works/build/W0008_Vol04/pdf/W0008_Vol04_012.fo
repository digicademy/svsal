<fo:block id="W0008-04-0255-it-0738" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline font-style="italic"><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0008-04-0255-mi-06a5" color="#0a0c75">1</fo:basic-link> </fo:inline>. <fo:inline font-family="serif" font-size="18pt" space-before="0.1mm" space-after="0.1mm">R</fo:inline>E<fo:inline font-weight="normal">s</fo:inline>tituere ex concau<fo:inline font-weight="normal">s</fo:inline>is damni iniu<fo:inline font-weight="normal">s</fo:inline>ti qui ante quos teneatur, &amp; qualiter quidam contribuere teneantur, &amp; re<fo:inline font-weight="normal">s</fo:inline>titui debeat ei, qui loco
<fo:inline> </fo:inline>aliorum re<fo:inline font-weight="normal">s</fo:inline>tituit.</fo:inline></fo:block>
<fo:block id="W0008-04-0255-it-0739" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline font-style="italic"><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0008-04-0255-mi-06a6" color="#0a0c75">2</fo:basic-link> </fo:inline>. Habens aut con<fo:inline font-weight="normal">s</fo:inline>umens rem iniu<fo:inline font-weight="normal">s</fo:inline>tè detentam, re<fo:inline font-weight="normal">s</fo:inline>tituere ante alios illam tenetur.</fo:inline></fo:block>
<fo:block id="W0008-04-0255-it-073a" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline font-style="italic"><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0008-04-0255-mi-06a7" color="#0a0c75">3</fo:basic-link> </fo:inline>. Mandans quou<fo:inline font-weight="normal">s</fo:inline>que ante alios re<fo:inline font-weight="normal">s</fo:inline>tituere teneætur.</fo:inline></fo:block>
<fo:block id="W0008-04-0255-it-073b" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline font-style="italic"><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0008-04-0255-mi-06a8" color="#0a0c75">4</fo:basic-link> </fo:inline>. Exequutor <fo:inline font-weight="normal">quou<fo:inline font-weight="normal">s</fo:inline>que</fo:inline> ante alios re<fo:inline font-weight="normal">s</fo:inline>tituere teneatur.</fo:inline></fo:block>
<fo:block id="W0008-04-0255-it-073c" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline font-style="italic"><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0008-04-0256-mi-06a9" color="#0a0c75">5</fo:basic-link> </fo:inline>. Vniuer<fo:inline font-weight="normal">s</fo:inline>im quando aliquis re<fo:inline font-weight="normal">s</fo:inline>tituit, quod alius re<fo:inline font-weight="normal">s</fo:inline>tituere tenebatur, qui ita tenebatur, re<fo:inline font-weight="normal">s</fo:inline>tituere
<fo:inline> </fo:inline>eitenetur, quod loco ip<fo:inline font-weight="normal">s</fo:inline>ius re<fo:inline font-weight="normal">s</fo:inline>tituit.</fo:inline></fo:block>
<fo:block id="W0008-04-0255-it-073d" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline font-style="italic"><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0008-04-0256-mi-06aa" color="#0a0c75">6</fo:basic-link> </fo:inline>. Re<fo:inline font-weight="normal">s</fo:inline>tituere <fo:inline font-weight="normal">s</fo:inline>i tenerentur tres contribuendo partes
<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>uas, &amp; vnus re<fo:inline font-weight="normal">s</fo:inline>tituat loco aliorum, <fo:inline font-weight="normal">s</fo:inline>ecundus, qui
