<fo:inline> </fo:inline>eos etiam po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>umus, quibus cura incumbit cu<fo:inline font-style="normal" id="W0008-04-0250-pb-04e1">-</fo:inline><fo:inline role="W0008-04-0250-pb-04e1" font-style="normal" font-weight="bold" font-size="12pt">[[242]]</fo:inline><fo:inline font-weight="normal">s</fo:inline>t odiendi aliqua, ne nocumẽtum aliis inferant.
<fo:inline> </fo:inline>Vt vnu<fo:inline font-weight="normal">s</fo:inline>qui<fo:inline font-weight="normal">s</fo:inline>que tenetur curare, ne <fo:inline font-weight="normal">s</fo:inline>ua pecora,
<fo:inline> </fo:inline>armenta, aut quoduis aliud <fo:inline font-weight="normal">s</fo:inline>uum, nocumentum
