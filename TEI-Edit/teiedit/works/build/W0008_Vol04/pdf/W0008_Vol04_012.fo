<fo:inline> </fo:inline>aut vineæ dominus, compareret, ingre<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>i <fo:inline font-weight="normal">s</fo:inline>unt,
