<fo:inline> </fo:inline>C. de noxialib. act.</fo:inline> <fo:inline font-weight="normal">s</fo:inline>ed <fo:inline font-weight="normal">intentandum</fo:inline> e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e aduer<fo:inline font-weight="normal">s</fo:inline>us
