<fo:inline> </fo:inline>tanquam po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>io illius, vt <fo:inline font-weight="normal">s</fo:inline>unt v<fo:inline font-weight="normal">s</fo:inline>urpatio vxoris
