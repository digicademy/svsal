<fo:inline> </fo:inline>§. vlt.</fo:inline> Ob<fo:inline font-weight="normal">s</fo:inline>erua tamen, <fo:inline font-weight="normal">s</fo:inline>i dominus animalis fui<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>et in mora illud tradendi po<fo:inline font-weight="normal">s</fo:inline>t litem aduer<fo:inline font-weight="normal">s</fo:inline>us
