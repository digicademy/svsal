<fo:inline> </fo:inline>præcipiendi <fo:inline font-weight="normal">s</fo:inline>int re<fo:inline font-weight="normal">s</fo:inline>tituere, <fo:inline font-weight="normal">s</fo:inline>ed vnu<fo:inline font-weight="normal">s</fo:inline>qui<fo:inline font-weight="normal">s</fo:inline>que moderate prudentis arbitrio.</fo:inline></fo:block>
