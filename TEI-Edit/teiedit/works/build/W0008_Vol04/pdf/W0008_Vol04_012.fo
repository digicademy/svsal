<fo:inline> </fo:inline>nulli in particulari debeantur, re<fo:inline font-weight="normal">s</fo:inline>tituenda <fo:inline font-weight="normal">s</fo:inline>unt
<fo:inline> </fo:inline>pauperibus, aut <fo:inline font-weight="normal">in<fo:inline font-weight="normal">s</fo:inline>umenda</fo:inline> <fo:inline font-weight="normal">s</fo:inline>unt in aliis operibus
