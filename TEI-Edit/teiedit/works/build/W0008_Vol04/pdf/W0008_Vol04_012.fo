<fo:inline> </fo:inline>furium, ac raptorum, dictum e<fo:inline font-weight="normal">s</fo:inline>t, <fo:inline font-weight="normal">s</fo:inline>ermo etiam e<fo:inline font-weight="normal">s</fo:inline>t
