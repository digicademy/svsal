<fo:inline> </fo:inline>pæna: vel <fo:inline font-weight="normal">quando</fo:inline> <fo:inline font-weight="normal">illum</fo:inline> ita priuare re <fo:inline font-weight="normal">s</fo:inline>ua po<fo:inline font-weight="normal">s</fo:inline>tularet
