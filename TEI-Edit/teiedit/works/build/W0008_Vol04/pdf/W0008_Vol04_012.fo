<fo:inline> </fo:inline>modo, <fo:inline font-weight="normal">s</fo:inline>altem quoad po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionem, aut quoad legitimam tentionem: vnde nece<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e non e<fo:inline font-weight="normal">s</fo:inline>t exprimere, quod acceptio, <fo:inline font-weight="normal">s</fo:inline>eu contrectatio, <fo:inline font-weight="normal">s</fo:inline>it rei, vel
