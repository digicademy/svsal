<fo:inline> </fo:inline>e<fo:inline font-weight="normal">s</fo:inline>to, qui furatus e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>et, vxor e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>et, aut filius. <fo:inline font-style="italic">Ita
<fo:inline> </fo:inline>Sotus vbi <fo:inline font-weight="normal">s</fo:inline>uprà, Sylue<fo:inline font-weight="normal">s</fo:inline>t. verb. furtum. q. 11.</fo:inline>
</fo:block>
