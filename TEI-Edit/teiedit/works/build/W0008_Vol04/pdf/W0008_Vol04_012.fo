<fo:inline> </fo:inline>e<fo:inline font-weight="normal">s</fo:inline>t con<fo:inline font-weight="normal">s</fo:inline>equentia. <fo:inline font-weight="normal">Tum</fo:inline> quia tran<fo:inline font-weight="normal">s</fo:inline>gre<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ores legis nõ
