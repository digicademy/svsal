<fo:inline> </fo:inline>cau<fo:inline font-weight="normal">s</fo:inline>alitate, tunc, nihil impediente, quòd partialitate <fo:inline font-weight="normal">s</fo:inline>olùm cau<fo:inline font-weight="normal">s</fo:inline>ę fuerit illius cau<fo:inline font-weight="normal">s</fo:inline>a, quia <fo:inline font-weight="normal">s</fo:inline>cilicet
