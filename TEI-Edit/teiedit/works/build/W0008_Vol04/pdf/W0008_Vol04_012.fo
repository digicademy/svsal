<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>olum cen<fo:inline font-weight="normal">s</fo:inline>eri cau<fo:inline font-weight="normal">s</fo:inline>am indirectam damni proximo iniu<fo:inline font-weight="normal">s</fo:inline>tè illati, ac proinde teneri id ei re<fo:inline font-weight="normal">s</fo:inline>tituere, qui ex officio, aut ex <fo:inline font-weight="normal">s</fo:inline>peciali alia obligatione,
