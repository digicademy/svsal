<fo:inline> </fo:inline>idcirco, quòd alius iniu<fo:inline font-weight="normal">s</fo:inline>tè formaliter, aut materialiter, fuerit in aliquo defraudatus aut læ<fo:inline font-weight="normal">s</fo:inline>us; vt
<fo:inline> </fo:inline>comprehenderem, tum <fo:inline font-weight="normal">eam</fo:inline> re<fo:inline font-weight="normal">s</fo:inline>titutionem, cuius

