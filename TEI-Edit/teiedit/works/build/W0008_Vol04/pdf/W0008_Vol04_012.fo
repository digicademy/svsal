<fo:inline> </fo:inline>E<fo:inline font-weight="normal">s</fo:inline>t acceptio iniu<fo:inline font-weight="normal">s</fo:inline>ta boni externi, ab<fo:inline font-weight="normal">s</fo:inline>que vi, &amp;
