<fo:inline> </fo:inline>quo minus valet, <fo:inline font-weight="normal">s</fo:inline>uf<fo:inline font-weight="normal">s</fo:inline>icienter re<fo:inline font-weight="normal">s</fo:inline>tituitur tempore,
<fo:inline> </fo:inline>quo minus valet, alia eiu<fo:inline font-weight="normal">s</fo:inline>dem bonitatis, lucrum́ illud incrementi illius valoris pertinet ad iniu<fo:inline font-weight="normal">s</fo:inline>tum detentorem, tanquam fructus <fo:inline font-weight="normal">s</fo:inline>uæ indu<fo:inline font-weight="normal">s</fo:inline>triæ.</fo:inline></fo:block>
