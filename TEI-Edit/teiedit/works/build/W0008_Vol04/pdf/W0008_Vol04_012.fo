<fo:inline> </fo:inline>e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e, in primis in contractibus cum alio celebratis nomine ip<fo:inline font-weight="normal">s</fo:inline>ius: eo enim ip<fo:inline font-weight="normal">s</fo:inline>o, quòd nomine
<fo:inline> </fo:inline>ip<fo:inline font-weight="normal">s</fo:inline>ius celebrati <fo:inline font-weight="normal">s</fo:inline>unt, &amp; id ip<fo:inline font-weight="normal">s</fo:inline>e ratum po<fo:inline font-weight="normal">s</fo:inline>tea habet, ip<fo:inline font-weight="normal">s</fo:inline>ius nomine ge<fo:inline font-weight="normal">s</fo:inline>tum celebratumve e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e,
