<fo:block id="W0008-04-0263-pa-0844" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline> </fo:inline>No<fo:inline font-weight="normal">s</fo:inline>tra verò <fo:inline font-weight="normal">s</fo:inline>exta conclu<fo:inline font-weight="normal">s</fo:inline>io e<fo:inline font-weight="normal">s</fo:inline>t. Neque cu<fo:inline font-weight="normal">s</fo:inline>to<fo:inline baseline-shift="super" font-size="9pt" font-weight="bold" id="#W0008-04-0263-nm-0452"><fo:basic-link color="#0a0c75" internal-destination="W0008-04-0263-nm-0452">106</fo:basic-link></fo:inline>des tenentur <fo:inline font-weight="normal">s</fo:inline>e manife<fo:inline font-weight="normal">s</fo:inline>tare iis, quos leges tran<fo:inline font-weight="normal">s</fo:inline>gre<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>uros e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>picantur, ni<fo:inline font-weight="normal">s</fo:inline>i <fo:inline font-weight="normal">s</fo:inline>e illis manife<fo:inline font-weight="normal">s</fo:inline>tẽt;<fo:inline id="W0008-04-0263-mi-06b5" font-style="normal" font-weight="bold" font-size="10pt"> [sect.
