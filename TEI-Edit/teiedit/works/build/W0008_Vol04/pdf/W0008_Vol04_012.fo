<fo:inline> </fo:inline>po<fo:inline font-weight="normal">s</fo:inline>t aditam hæreditatem, tunc, cùm à puncto
<fo:inline> </fo:inline>hæreditatis aditæ, dominium <fo:inline font-weight="normal">s</fo:inline>erui illius tran<fo:inline font-weight="normal">s</fo:inline>ii<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e cen<fo:inline font-weight="normal">s</fo:inline>eatur in legatarium à tempore mortis
