<fo:inline> </fo:inline>con<fo:inline font-weight="normal">s</fo:inline>equens profectò e<fo:inline font-weight="normal">s</fo:inline>t, vt <fo:inline font-weight="normal">non</fo:inline> <fo:inline font-weight="normal"><fo:inline font-weight="normal">s</fo:inline>olum</fo:inline> ante conditas leges pænales, quibus decernatur pæna, <fo:inline font-weight="normal">s</fo:inline>ed
