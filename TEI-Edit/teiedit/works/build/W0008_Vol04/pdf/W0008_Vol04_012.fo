<fo:inline> </fo:inline>fas e<fo:inline font-weight="normal">s</fo:inline>t cu<fo:inline font-weight="normal">s</fo:inline>todibus <fo:inline font-weight="normal">s</fo:inline>e ab<fo:inline font-weight="normal">s</fo:inline>condere, permittereq́ue
<fo:inline> </fo:inline>aliquas tran<fo:inline font-weight="normal">s</fo:inline>gre<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>iones inchoari, vt tam in eis
<fo:inline> </fo:inline>comprehen<fo:inline font-weight="normal">s</fo:inline>i, quàm alii, <fo:inline font-weight="normal">s</fo:inline>imilia in <fo:inline font-weight="normal">po<fo:inline font-weight="normal">s</fo:inline>terum</fo:inline> non
