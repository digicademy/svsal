<fo:inline> </fo:inline>in eo euentu in po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionem eius rei, impediretur ex eo, quòd is, cuius e<fo:inline font-weight="normal">s</fo:inline>t ea res, opponeret, <fo:inline font-weight="normal">s</fo:inline>eu
