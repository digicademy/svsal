<fo:inline> </fo:inline>re<fo:inline font-weight="normal">s</fo:inline>tituant, tunc, cùm intentio qua<fo:inline font-weight="normal">s</fo:inline>i habitualis ferentis excommunicationem <fo:inline font-weight="normal">s</fo:inline>it, vt non
