<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>uam, in cuius po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ione ip<fo:inline font-weight="normal">s</fo:inline>e e<fo:inline font-weight="normal">s</fo:inline>t, aduer<fo:inline font-weight="normal">s</fo:inline>us <fo:inline font-weight="normal">s</fo:inline>eruitutem nobis in ea debitam, ne altiùs tollatur,
