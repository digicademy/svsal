<fo:inline> </fo:inline>Intelligenda deinde e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e, quoad incurrendum<fo:inline id="W0008-04-0242-mi-0685" font-style="normal" font-weight="bold" font-size="10pt"> [sect.
				4] </fo:inline>
<fo:inline> </fo:inline>pęnas ob delictum nomine ip<fo:inline font-weight="normal">s</fo:inline>ius ge<fo:inline font-weight="normal">s</fo:inline>tum, etiam
