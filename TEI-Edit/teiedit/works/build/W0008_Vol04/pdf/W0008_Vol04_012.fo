<fo:block id="W0008-04-0047-it-04d6" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline font-style="italic"><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0008-04-0047-mi-044e" color="#0a0c75">1</fo:basic-link> </fo:inline>. <fo:inline font-family="serif" font-size="18pt" space-before="0.1mm" space-after="0.1mm">F</fo:inline>Vrtum <fo:inline font-weight="normal">s</fo:inline>acrilegum <fo:inline font-weight="normal">s</fo:inline>i <fo:inline font-weight="normal">s</fo:inline>it cum effractione loci <fo:inline font-weight="normal">s</fo:inline>acri, incurritur pro illo excommunicatio.</fo:inline></fo:block>
