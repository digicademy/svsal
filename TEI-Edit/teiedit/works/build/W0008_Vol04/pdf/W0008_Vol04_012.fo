<fo:inline> </fo:inline>locatione illius erant percipienda, <fo:inline font-weight="normal">s</fo:inline>ed <fo:inline font-weight="normal">s</fo:inline>atis e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e,
<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>i re<fo:inline font-weight="normal">s</fo:inline>tituat eum domus, aut equi, valorem,
<fo:inline> </fo:inline>quem tempore damni in eis dati habebant:
