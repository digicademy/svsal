<fo:inline> </fo:inline>damn. dat. Ea autem lex, iuxta glo<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>am ibi, &amp;
<fo:inline> </fo:inline>doctores communiter, <fo:inline font-weight="normal">s</fo:inline>olùm habet locum,
