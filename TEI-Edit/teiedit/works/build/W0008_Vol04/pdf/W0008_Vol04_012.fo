<fo:inline> </fo:inline>debita diligentia, deprehendere non po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>et quí<fo:inline font-weight="normal">s</fo:inline>nam ille e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>et, ad nullam aliam teneretur re<fo:inline font-weight="normal">s</fo:inline>titutionem: quoniam, <fo:inline font-weight="normal">s</fo:inline>i tunc alicui e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>et facienda,
