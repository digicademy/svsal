<fo:inline> </fo:inline>acceptione à re<fo:inline font-weight="normal">s</fo:inline>titutione pre<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>i<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>imè <fo:inline font-weight="normal">s</fo:inline>umpta di<fo:inline font-weight="normal">s</fo:inline>t inguatur, &amp; comprehendatur <fo:inline font-weight="normal">s</fo:inline>ub re<fo:inline font-weight="normal">s</fo:inline>titutione preßè.</fo:inline></fo:block>
