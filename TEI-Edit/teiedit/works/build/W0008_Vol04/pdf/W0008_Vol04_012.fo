<fo:inline> </fo:inline>affirmanter re<fo:inline font-weight="normal">s</fo:inline>pondent, quando duo illa <fo:inline font-weight="normal">s</fo:inline>imul concurrunt, datum <fo:inline font-weight="normal">s</fo:inline>cilicet damnum e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e
