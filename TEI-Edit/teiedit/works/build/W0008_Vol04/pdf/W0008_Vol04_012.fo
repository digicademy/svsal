<fo:inline> </fo:inline>domini illius con<fo:inline font-weight="normal">s</fo:inline>en<fo:inline font-weight="normal">s</fo:inline>u, <fo:inline font-weight="normal">s</fo:inline>altem debito: <fo:inline font-weight="normal">s</fo:inline>ed, cùm vnu<fo:inline font-weight="normal">s</fo:inline>qui<fo:inline font-weight="normal">s</fo:inline>q; pro <fo:inline font-weight="normal">s</fo:inline>alute <fo:inline font-weight="normal">s</fo:inline>pirituali proximi teneatur
