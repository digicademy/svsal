<fo:block id="W0008-04-0051-it-04de" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline font-style="italic"><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0008-04-0052-mi-0456" color="#0a0c75">1</fo:basic-link> </fo:inline>. <fo:inline font-family="serif" font-size="18pt" space-before="0.1mm" space-after="0.1mm">F</fo:inline>Vrem interficere <fo:inline font-weight="normal">cum</fo:inline> quinta decalogi præcepto
