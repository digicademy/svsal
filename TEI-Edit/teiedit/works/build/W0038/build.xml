<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0038" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/grepect/W0038/W0038.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0038.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0038_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0038_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0038_000.xml" tofile="${xml.dir}/W0038_v1-0.xml"/>
        <echo>Checkpoint: W00 65_v1-0.xml (W0038_000.xml).</echo>
        <delete file="${xml.dir}/W0038_000.xml"/>
    </target>
    
    <target name="patch-000"> <!-- depends="cp-000" -->
        <echo>Structural annotation.</echo>
        <patch originalfile="${xml.dir}/W0038_v1-0.xml" destfile="${xml.dir}/W0038_001.xml" patchfile="${diff.dir}/W0038_000.diff"/>
        <delete file="${xml.dir}/W0038_000.xml"/>
        <!-- TODO: create diff between W0038_v1-0.xml and W0038_edit-000.xml (=W0038_001.xml) -->
    </target>
    <target name="xslt-001"> 
        <echo>Structural annotation in 4 rounds.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0038_001.xml" out="${xml.dir}/W0038_002.xml" style="${xsl.dir}/W0038_001.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>

 <target name="xslt-002" depends="xslt-001"> 
        <echo>Refs and milestones. </echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0038_002.xml" out="${xml.dir}/W0038_003.xml" style="${xsl.dir}/W0038_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>

    <target name="xslt-003" depends="xslt-002"> 
        <echo>Added abbreviations depending on word endings with regex (la)</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0038_003.xml" out="${xml.dir}/W0038_004a.xml" style="${xsl.dir}/W0038_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
 <echo>Added (again) abbreviations depending on word endings with regex (la)</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0038_004a.xml" out="${xml.dir}/W0038_004.xml" style="${xsl.dir}/W0038_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
       <delete file="${xml.dir}/W0038_004a.xml"/>
    </target>

    <target name="xslt-004" depends="xslt-003"> 
        <echo>Added abbreviations depending on word endings with regex (es)</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0038_004.xml" out="${xml.dir}/W0038_005a.xml" style="${xsl.dir}/W0038_004.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
 <echo>Added (again) abbreviations depending on word endings with regex (es)</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
