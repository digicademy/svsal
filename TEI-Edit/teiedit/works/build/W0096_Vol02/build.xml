<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0096_Vol02" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/textloop/W0096-B/W0096-B.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0096_Vol02.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0096_Vol02_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0096_Vol02_000.xml" lenient="true"/>
    </target>
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0096_Vol02_000.xml" tofile="${xml.dir}/W0096_Vol02_v1-0.xml"/>
        <echo>Checkpoint: W0096_Vol02_v1-0.xml (W0096_Vol02_000.xml).</echo>
    </target>
    <target name="patch-000" depends="cp-000">
        <patch originalfile="${xml.dir}/W0096_Vol02_000.xml" destfile="${xml.dir}/W0096_Vol02_001_CR.xml" patchfile="${diff.dir}/W0096_Vol02_000.diff"/>
        <echo>Structural Annotation, table of contents, added \n before each lb (not: lb type=nb") for better readability</echo>
        <delete file="${xml.dir}/W0096_Vol02_000.xml"/>
    </target>
    <target name="patch-001"> <!-- depends="patch-000" -->
        <echo>Resolution remaining unclear marks (CB) and manual foreign annotations.</echo>
        <patch originalfile="${xml.dir}/W0096_Vol02_001_CR.xml" destfile="${xml.dir}/W0096_Vol02_001_unclear.xml" patchfile="${diff.dir}/W0096_Vol02_001.diff"/>
    </target>
    <target name="xslt-001a"> 
        <echo>Added automatic foreign ES.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0096_Vol02_001_unclear.xml" out="${xml.dir}/W0096_Vol02_002a.xml" style="${xsl.dir}/W0096_Vol02_000.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <echo>-------------------------</echo>
        <echo>Added (la) abbreviations depending on word structure with regex.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0096_Vol02_002a.xml" out="${xml.dir}/W0096_Vol02_002b.xml" style="${xsl.dir}/W0096_Vol02_001a.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <echo>-------------------------</echo>
        <echo>Repeated (la) abbreviations depending on word structure with regex.</echo>
        <xslt force="true" in="${xml.dir}/W0096_Vol02_002b.xml" out="${xml.dir}/W0096_Vol02_002c.xml" style="${xsl.dir}/W0096_Vol02_001a.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <echo>-------------------------</echo>
        <echo>Added (es) abbreviations depending on word structure with regex.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0096_Vol02_002c.xml" out="${xml.dir}/W0096_Vol02_002d.xml" style="${xsl.dir}/W0096_Vol02_001b.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <echo>-------------------------</echo>
        <echo>Repeated (es) abbreviations depending on word structure with regex.</echo>
        <xslt force="true" in="${xml.dir}/W0096_Vol02_002d.xml" out="${xml.dir}/W0096_Vol02_002e.xml" style="${xsl.dir}/W0096_Vol02_001b.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <delete file="${xml.dir}/W0096_Vol02_002a.xml"/>
        <delete file="${xml.dir}/W0096_Vol02_002b.xml"/>
        <delete file="${xml.dir}/W0096_Vol02_002c.xml"/>
        <delete file="${xml.dir}/W0096_Vol02_002d.xml"/>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="xslt-001"  depends="xslt-001a"> 
        <echo>Add @xml:id, @unit to milestone and @n to div2.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0096_Vol02_002e.xml" out="${xml.dir}/W0096_Vol02_002.xml" style="${xsl.dir}/W0096_Vol02_001.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <delete file="${xml.dir}/W0096_Vol02_002e.xml"/>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="xslt-002" depends="xslt-001">
        <echo>Summaries, add @target to ref using @xml:id in milestone</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0096_Vol02_002.xml" out="${xml.dir}/W0096_Vol02_003.xml" style="${xsl.dir}/W0096_Vol02_002.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0096_Vol02_002.xml"/>
    </target>
    <target name="xslt-003" depends="xslt-002">
        <echo>Transformation from Tite to TEI.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0096_Vol02_003.xml" out="${xml.dir}/W0096_Vol02_004.xml" style="${xsl.dir}/W0096_Vol02_003.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0096_Vol02_003.xml"/>
    </target>
    <target name="xslt-004" depends="xslt-003"> 
        <echo>Annotated hyphenated breaks.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0096_Vol02_004.xml" out="${xml.dir}/W0096_Vol02_005.xml" style="${xsl.dir}/W0096_Vol02_004.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0096_Vol02_004.xml"/>
    </target>
    <target name="xslt-005" depends="xslt-004"> 
        <echo>Special characters tagging.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0096_Vol02_005.xml" out="${xml.dir}/W0096_Vol02_006.xml" style="${xsl.dir}/W0096_Vol02_005.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0096_Vol02_005.xml"/>
    </target>
    <target name="xslt-006" depends="xslt-005"> 
        <echo>Line numbering.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0096_Vol02_006.xml" out="${xml.dir}/W0096_Vol02_007.xml" style="${xsl.dir}/W0096_Vol02_006.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0096_Vol02_006.xml"/>
    </target>
    <target name="xslt-007" depends="xslt-006">
        <echo>Tagged @xml:id(s).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0096_Vol02_007.xml" out="${xml.dir}/W0096_Vol02_008.xml" style="${xsl.dir}/W0096_Vol02_007.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0096_Vol02_007.xml"/>
    </target>
    <target name="xslt-008" depends="xslt-007">
        <echo>Tagged unmarked breaks.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0096_Vol02_008.xml" out="${xml.dir}/W0096_Vol02_009.xml" style="${xsl.dir}/W0096_Vol02_008.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/lists/W0096_Vol02-la_supposed-hyphenations-from-text.html"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0096_Vol02_008.xml"/>
    </target>
    <target name="xslt-009" depends="xslt-008">
        <echo>Expanded abbreviations in main text (ES).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0096_Vol02_009.xml" out="${xml.dir}/W0096_Vol02_010.xml" style="${xsl.dir}/W0096_Vol02_009.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
            <param name="lang" expression="es" type="STRING"/>
            <param name="mode" expression="main" type="STRING"/>
            <param name="changeId" expression="W0096_Vol02_change_0015" type="STRING"/>
            <param name="startAtLineBeginning" expression="FALSE" type="BOOLEAN"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0096_Vol02_009.xml"/>
    </target>
    <target name="xslt-010" depends="xslt-009">
        <echo>Expanded abbreviations in main text (LA).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0096_Vol02_010.xml" out="${xml.dir}/W0096_Vol02_011.xml" style="${xsl.dir}/W0096_Vol02_009.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="main" type="STRING"/>
            <param name="changeId" expression="W0096_Vol02_change_0016" type="STRING"/>
            <param name="startAtLineBeginning" expression="FALSE" type="BOOLEAN"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0096_Vol02_010.xml"/>
    </target>
    <target name="py-011"> <!-- depends="xslt-010" - input W0096_Vol02_011.xml and output W0096_Vol02_012.xml files in python script -->
    <!--Run and edit directly from Python. ANT causes encoding/decoding problems.-->
        <echo>Expanded abbreviations with breaks using python.</echo>
        <record name="${py.log}" action="start" loglevel="verbose"/>
        <exec executable="${executable-full-path}">
            <arg file="${py.dir}/W0096_Vol02_011.py"/>
        </exec>
        <record name="${py.log}" action="stop"/>
    </target>
    <target name="xslt-012"><!--depends="xslt-010"-->
        <echo>teiHeader update for online publication.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0096_Vol02_012.xml" out="${xml.dir}/W0096_Vol02_013.xml" style="${xsl.dir}/W0096_Vol02_012.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0096_Vol02_011.xml"/>
    </target>
    <target name="finalize" depends="xslt-012">
        <echo>Reached end of pipeline.</echo>
    </target>
</project>
