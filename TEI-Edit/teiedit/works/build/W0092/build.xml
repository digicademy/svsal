<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0092" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../../../tustep/svsal/v1/teitite/W0092/W0092_v1.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0092.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0092_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0092_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0092_000.xml" tofile="${xml.dir}/W0092_v1-0.xml"/>
        <echo>Checkpoint: W0092_v1-0.xml (W0092_000.xml).</echo>
        <delete file="${xml.dir}/W0092_000.xml"/>
    </target>
    <target name="patch-000"> <!-- depends="cp-000" -->
        <echo>Structural annotation.</echo>
        <patch originalfile="${xml.dir}/W0092_v1-0.xml" destfile="${xml.dir}/W0092_001.xml" patchfile="${diff.dir}/W0092_000.diff"/>
        <delete file="${xml.dir}/W0092_000.xml"/>
    </target>
    <target name="patch-001"> <!-- patch-000 -->
        <echo>Resolution remaining 40 unclear marks (CB).</echo>
        <patch originalfile="${xml.dir}/W0092_001.xml" destfile="${xml.dir}/W0092_001_unclear.xml" patchfile="${diff.dir}/W0092_001.diff"/>
    </target>
    <target name="xslt-001"> 
        <echo>Added @n, @type, @xml:id to div(s), and @target to ref.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0092_001_unclear.xml" out="${xml.dir}/W0092_002.xml" style="${xsl.dir}/W0092_001.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="xslt-002" depends="xslt-001"> 
        <echo>Added missing pagination (pb/@n).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0092_002.xml" out="${xml.dir}/W0092_003.xml" style="${xsl.dir}/W0092_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0092_002.xml"/>
    </target>
    <target name="xslt-003" depends="xslt-002"> 
        <echo>Changed notes with only digits into milestone, and added @unit.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0092_003.xml" out="${xml.dir}/W0092_004.xml" style="${xsl.dir}/W0092_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0092_003.xml"/>
    </target>
    <target name="xslt-004" depends="xslt-003"> 
        <echo>Added (la) abbreviations depending on word structure with regex.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0092_004.xml" out="${xml.dir}/W0092_005.xml" style="${xsl.dir}/W0092_004.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0092_004.xml"/>
    </target>
    <target name="xslt-005" depends="xslt-004">
        <echo>Transformation from TEI-tite to TEI-All.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0092_005.xml" out="${xml.dir}/W0092_006.xml" style="${xsl.dir}/W0092_005.xsl" classpath="${xslt.processor}">
