        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0092_007.xml" out="${xml.dir}/W0092_008.xml" style="${xsl.dir}/W0092_007.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0092_007.xml"/>
    </target>
    <target name="xslt-008" depends="xslt-007">
