        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0092_008.xml" out="${xml.dir}/W0092_009.xml" style="${xsl.dir}/W0092_008.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0092_008.xml"/>
    </target>
    <target name="xslt-009" depends="xslt-008">
        <echo>Line numbering.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0092_009.xml" out="${xml.dir}/W0092_010.xml" style="${xsl.dir}/W0092_009.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0092_009.xml"/>
    </target>
    <target name="xslt-010" depends="xslt-009"> <!-- -->
        <echo>Added @xml:ids.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0092_010.xml" out="${xml.dir}/W0092_011.xml" style="${xsl.dir}/W0092_010.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0092_010.xml"/>
    </target>
    <target name="xslt-011" ><!--depends="xslt-010"-->
        <echo>Tagged unmarked Hyphenation.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0092_011.xml" out="${xml.dir}/W0092_012.xml" style="${xsl.dir}/W0092_011.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/lists/W0092-la_supposed-hyphenations-from-text.html,../corrlist/lists/W0092-marg-la_supposed-hyphenations-from-text.html"/>
            <param name="lang" expression="la" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <!--<delete file="${xml.dir}/W0092_011.xml"/>-->
    </target>
    <target name="xslt-012" depends="xslt-011">
        <echo>Choice correct breaks.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0092_012.xml" out="${xml.dir}/W0092_013.xml" style="${xsl.dir}/W0092_012.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0092_012.xml"/>
    </target>
    <target name="xslt-013" depends="xslt-012">
        <echo>Expanded abbreviations in main text (la).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0092_013.xml" out="${xml.dir}/W0092_014.xml" style="${xsl.dir}/W0092_013.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="main" type="STRING"/>
            <param name="startAtLineBeginning" expression="True" type="BOOLEAN"/>
            <param name="changeId" expression="W0092_change_020" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0092_013.xml"/>
    </target>
    <target name="xslt-014"> <!--depends="xslt-013"-->
        <echo>Expanded abbreviations in marginal text (la).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0092_014.xml" out="${xml.dir}/W0092_015.xml" style="${xsl.dir}/W0092_013.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="marginal" type="STRING"/>
            <param name="startAtLineBeginning" expression="True" type="BOOLEAN"/>
            <param name="changeId" expression="W0092_change_021" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <!--<delete file="${xml.dir}/W0092_014.xml"/>-->
    </target>
    <target name="py-015"> <!-- depends="xslt-014" - input W0092_015.xml and output W0092_016.xml files in python script -->
    <!--Run and edit directly from Python. ANT causes encoding/decoding problems.-->
        <echo>Expanded abbreviations with breaks.</echo>
        <record name="${py.log}" action="start" loglevel="verbose"/>
        <exec executable="${executable-full-path}">
            <arg file="${py.dir}/W0092_011.py"/>
        </exec>
        <record name="${py.log}" action="stop"/>
    </target>
    <target name="xslt-016" ><!--depends="py-015"-->
        <echo>teiHeader update for online publication.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0092_016.xml" out="${xml.dir}/W0092_017.xml" style="${xsl.dir}/W0092_016.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <!--<delete file="${xml.dir}/W0092_016.xml"/>-->
    </target>
    <target name="finalize" depends="xslt-016">
        <echo>Reached end of pipeline.</echo>
    </target>

