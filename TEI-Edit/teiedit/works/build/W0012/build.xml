<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0012" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../../../tustep/svsal/v1/teitite/W0012/W0012_v1.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0012.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0012_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0012_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0012_000.xml" tofile="${xml.dir}/W0012_v1-0.xml"/>
        <echo>Checkpoint: W0012_v1-0.xml (W0012_000.xml).</echo>
        <delete file="${xml.dir}/W0012_000.xml"/>
    </target>
    <target name="patch-000"> <!-- depends="cp-000" -->
        <echo>Structural annotation and unclear first round CR/MAH.</echo>
        <patch originalfile="${xml.dir}/W0012_v1-0.xml" destfile="${xml.dir}/W0012_001.xml" patchfile="${diff.dir}/W0012_000.diff"/>
        <delete file="${xml.dir}/W0012_000.xml"/>
    </target>
    <target name="xslt-001"> <!-- depends="patch-000" -->
        <echo>Tagged milestone(s).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0012_001.xml" out="${xml.dir}/W0012_002.xml" style="${xsl.dir}/W0012_001.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="xslt-002" depends="xslt-001"> 
        <echo>Added missing pagination (pb/@n).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0012_002.xml" out="${xml.dir}/W0012_003.xml" style="${xsl.dir}/W0012_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0012_002.xml"/>
    </target>
    <target name="xslt-003" depends="xslt-002"> 
        <echo>Added @type to div2 and div3.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0012_003.xml" out="${xml.dir}/W0012_004.xml" style="${xsl.dir}/W0012_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0012_003.xml"/>
    </target>
    <target name="xslt-004" depends="xslt-003"> 
        <echo>Added @target(s) in tables of contents.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0012_004.xml" out="${xml.dir}/W0012_005.xml" style="${xsl.dir}/W0012_004.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0012_004.xml"/>
    </target>
    <target name="xslt-005" depends="xslt-004">
        <echo>Added nested lists and @type in Index.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0012_005.xml" out="${xml.dir}/W0012_006.xml" style="${xsl.dir}/W0012_005.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0012_005.xml"/>
    </target>
    <target name="xslt-006" depends="xslt-005">
        <echo>Added (la) abbreviations depending on word structure with regex.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0012_006.xml" out="${xml.dir}/W0012_007a.xml" style="${xsl.dir}/W0012_006.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <echo>Repeated (la) abbreviations depending on word structure with regex.</echo>
        <xslt force="true" in="${xml.dir}/W0012_007a.xml" out="${xml.dir}/W0012_007.xml" style="${xsl.dir}/W0012_006.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <delete file="${xml.dir}/W0012_007a.xml"/>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0012_006.xml"/>
    </target>
    <target name="xslt-007" depends="xslt-006">
        <echo>Transformation TEI tite to TEI P5.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0012_007.xml" out="${xml.dir}/W0012_008.xml" style="${xsl.dir}/W0012_007.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0012_007.xml"/>
    </target>
    <target name="xslt-008" depends="xslt-007">
        <echo>Annotated hyphenated breaks.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0012_008.xml" out="${xml.dir}/W0012_009.xml" style="${xsl.dir}/W0012_008.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0012_008.xml"/>
    </target>
    <target name="xslt-009" depends="xslt-008">
        <echo>Tagged special characters.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0012_009.xml" out="${xml.dir}/W0012_010.xml" style="${xsl.dir}/W0012_009.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0012_009.xml"/>
    </target>
    <target name="xslt-010" depends="xslt-009">
        <echo>Line numbering.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0012_010.xml" out="${xml.dir}/W0012_011.xml" style="${xsl.dir}/W0012_010.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0012_010.xml"/>
    </target>
    <target name="xslt-011" depends="xslt-010">  
        <echo>Added @xml:ids.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0012_011.xml" out="${xml.dir}/W0012_012.xml" style="${xsl.dir}/W0012_011.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0012_011.xml"/>
    </target>
    <target name="xslt-012"><!-- depends="xslt-011"-->
        <echo>Tagged unmarked Hyphenation.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0012_012.xml" out="${xml.dir}/W0012_013.xml" style="${xsl.dir}/W0012_012.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/lists/W0012-la_supposed-hyphenations-from-text.html, ../corrlist/lists/W0012-marg-la_supposed-hyphenations-from-text.html"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <!--<delete file="${xml.dir}/W0012_012.xml"/>-->
    </target>

    <target name="xslt-013"> <!-- depends="xslt-012"-->
        <echo>Expanded abbreviations in main text (la).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0012_013.xml" out="${xml.dir}/W0012_014a.xml" style="${xsl.dir}/W0012_013.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="main" type="STRING"/>
            <param name="startAtLineBeginning" expression="TRUE" type="BOOLEAN"/>
            <param name="changeId" expression="W0012_change_030" type="STRING"/>
        </xslt>
        <echo>########################################################</echo>
        <record name="${xslt.log}" action="stop"/>
        <echo>Expanded abbreviations in marginal notes.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0012_014a.xml" out="${xml.dir}/W0012_014.xml" style="${xsl.dir}/W0012_013.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="marginal" type="STRING"/>
            <param name="startAtLineBeginning" expression="TRUE" type="BOOLEAN"/>
            <param name="changeId" expression="W0012_change_031" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0012_014a.xml"/>
        <!--<delete file="${xml.dir}/W0012_013.xml"/>-->
    </target>
    <target name="py-014"> <!-- depends="xslt-013" - input W0012_014.xml and output W0012_015.xml files in python script -->
        <!--Run and edit directly from Python. ANT causes encoding/decoding problems.-->
        <echo>Automatically expanded abbreviations with lb/@break using python.</echo>
        <record name="${py.log}" action="start" loglevel="verbose"/>
        <exec executable="${executable-full-path}">
            <arg file="${py.dir}/W0012_014.py"/>
        </exec>
        <record name="${py.log}" action="stop"/>
    </target>
    <target name="xslt-015" ><!--depends="py-014"-->
        <echo>teiHeader update for online publication.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0012_015.xml" out="${xml.dir}/W0012_016.xml" style="${xsl.dir}/W0012_015.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="finalize" depends="xslt-015">
        <echo>Reached end of pipeline.</echo>
    </target>
    
