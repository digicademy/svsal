            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/proc/W0030-la_supposed-hyphenations-from-text.html" type="STRING"/>
            <param name="lang" expression="la" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0030_008.xml"/>
    </target>
    
    <!-- CORRECTIONS -->
    
