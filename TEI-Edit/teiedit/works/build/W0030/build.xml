<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0030" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/grepect/W0030/adw_mainz_Die Schule von Salamanca_W0030.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0030.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0030_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0030_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0030_000.xml" tofile="${xml.dir}/W0030_v1-0.xml"/>
        <echo>Checkpoint: W0030_v1-0.xml (W0030_000.xml).</echo>
        <delete file="${xml.dir}/W0030_000.xml"/>
    </target>
    
    <target name="patch-000"> <!-- depends="cp-000" -->
        <echo>Structural annotation.</echo>
        <patch originalfile="${xml.dir}/W0030_v1-0.xml" destfile="${xml.dir}/W0030_001.xml" patchfile="${diff.dir}/W0030_000.diff"/>
        <delete file="${xml.dir}/W0030_000.xml"/>
        <!-- TODO: create diff between W0030_v1-0.xml and W0030_edit-000.xml (=W0030_001.xml) -->
    </target>
    <target name="xslt-001"> <!--depends="patch-000"-->
        <echo>Transformation TEI tite to TEI P5.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0030_001.xml" out="${xml.dir}/W0030_002.xml" style="${xsl.dir}/W0030_001.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    
    <target name="xslt-002" depends="xslt-001"> 
        <echo>Changed lb attributes.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0030_002.xml" out="${xml.dir}/W0030_003.xml" style="${xsl.dir}/W0030_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0030_002.xml"/>
    </target>
    
    <target name="xslt-003" depends="xslt-002"> 
        <echo>Changed pb, cb dependion on lb attributes.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0030_003.xml" out="${xml.dir}/W0030_004.xml" style="${xsl.dir}/W0030_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0030_003.xml"/>
    </target>
    
    <target name="xslt-004" depends="xslt-003"> 
        <echo>Tagged special characters.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0030_004.xml" out="${xml.dir}/W0030_005.xml" style="${xsl.dir}/W0030_004.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0030_004.xml"/>
    </target>
    <target name="xslt-005" depends="xslt-004">
        <echo>Numbered lines.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0030_005.xml" out="${xml.dir}/W0030_006.xml" style="${xsl.dir}/W0030_005.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0030_005.xml"/>
    </target>
    <target name="xslt-006" depends="xslt-005">
        <echo>Added @xml:ids.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0030_006.xml" out="${xml.dir}/W0030_007.xml" style="${xsl.dir}/W0030_006.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0030_006.xml"/>
    </target>
    <target name="xslt-007" depends="xslt-006">
        <echo>Expanded abbreviations.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0030_007.xml" out="${xml.dir}/W0030_008.xml" style="${xsl.dir}/W0030_007.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="main" type="STRING"/>
            <param name="startAtLineBeginning" expression="True" type="BOOLEAN"/>
            <param name="changeId" expression="W0030_change_008" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0030_007.xml"/>
    </target>
    
    <!-- corrListPaths -->
    <target name="xslt-008" depends="xslt-007">
