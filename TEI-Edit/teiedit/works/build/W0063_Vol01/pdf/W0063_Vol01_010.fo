e, vel<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>pendere ꝗa<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>i tenet̃ alios<fo:inline> </fo:inline>defẽdere mul<fo:inline> </fo:inline>to magis <fo:inline font-weight="normal">s</fo:inline>e ip<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>um. h.d.</fo:inline></fo:block>
