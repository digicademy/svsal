o:inline>menta, vbi ꝗs<fo:inline> </fo:inline>liberè venatur<fo:inline> </fo:inline>vel pi<fo:inline font-weight="normal">s</fo:inline>catur:<fo:inline> </fo:inline>quia <fo:inline font-weight="normal">s</fo:inline>i inde<fo:inline> </fo:inline>daretur precium, vel pars<fo:inline> </fo:inline>de tali precio,<fo:inline> </fo:inline>vel parte danda e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>et decima eccle<fo:inline font-weight="normal">s</fo:inline>iæ,<fo:inline> </fo:inline>bapti<fo:inline font-weight="normal">s</fo:inline>mali, in<fo:inline> </fo:inline>qua e<fo:inline font-weight="normal">s</fo:inline>t prædium.</fo:block>
