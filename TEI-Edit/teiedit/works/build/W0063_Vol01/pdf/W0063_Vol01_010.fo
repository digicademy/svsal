<fo:block id="W0063-01-0053-pa-0809" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline> </fo:inline><fo:inline font-weight="bold" font-size="12pt" space-before="0.2cm" space-after="0.2cm" id="W0063-01-0053-re-1110"><fo:basic-link internal-destination="W0063-01-0053-re-05aa" color="#0a0c75">b</fo:basic-link> </fo:inline> ¶ <fo:inline font-style="italic">Dixo a la fija.</fo:inline><fo:inline> </fo:inline>Lucę ibidem.<fo:inline> </fo:inline>Math. 9.</fo:block>
