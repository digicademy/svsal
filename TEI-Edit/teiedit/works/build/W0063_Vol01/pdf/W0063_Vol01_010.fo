<fo:block id="W0063-01-0106-pa-0ac9" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline> </fo:inline><fo:inline font-weight="bold" font-size="12pt" space-before="0.2cm" space-after="0.2cm" id="W0063-01-0106-re-1370"><fo:basic-link internal-destination="W0063-01-0106-re-080a" color="#0a0c75">o</fo:basic-link> </fo:inline> ¶ <fo:inline font-style="italic">Quando gelo tollere.</fo:inline> adde ca. ad hæc. §. <fo:inline font-weight="normal">s</fo:inline>ub<fo:inline font-weight="normal">s</fo:inline>equentes. eod. titu. &amp; vide<fo:inline> </fo:inline>quod habetur infrà. eo. l. 8.</fo:block>
