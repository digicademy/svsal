>s</fo:inline>uã regulã <fo:inline font-weight="normal">s</fo:inline>eruãdo, quod &amp; e<fo:inline font-weight="normal">s</fo:inline>t cau<fo:inline font-weight="normal">s</fo:inline>a cõuertendi eccle<fo:inline font-weight="normal">s</fo:inline>iã regu<fo:inline> </fo:inline>larem, in <fo:inline font-weight="normal">s</fo:inline>ecularem quando regulares ibi poni non po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>unt. h.d.</fo:inline></fo:block>
