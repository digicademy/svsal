<fo:block id="W0063-01-0241-pa-10ce" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline> </fo:inline><fo:inline font-weight="bold" font-size="12pt" space-before="0.2cm" space-after="0.2cm" id="W0063-01-0241-re-18a0"><fo:basic-link internal-destination="W0063-01-0241-re-0d3a" color="#0a0c75">a</fo:basic-link> </fo:inline> ¶ <fo:inline font-style="italic">Como pre<fo:inline font-weight="normal">s</fo:inline>tamo.</fo:inline> Id e<fo:inline font-weight="normal">s</fo:inline>t in commendam. vt in capitul. qui plures. 21.<fo:inline> </fo:inline>quæ<fo:inline font-weight="normal">s</fo:inline>tione prima. glo<fo:inline font-weight="normal">s</fo:inline>. in capitul. <fo:inline font-weight="normal">s</fo:inline>anctorum. 70. di<fo:inline font-weight="normal">s</fo:inline>tinct. &amp; quæ dicantur propriè præ<fo:inline font-weight="normal">s</fo:inline>timonia, &amp; quot <fo:inline font-weight="normal">s</fo:inline>int beneficia eccle<fo:inline font-weight="normal">s</fo:inline>ia<fo:inline font-weight="normal">s</fo:inline>tica. vi.<fo:inline> </fo:inline>per Oldral. con<fo:inline font-weight="normal">s</fo:inline>i. 81. &amp; con<fo:inline font-weight="normal">s</fo:inline>i. 141.</fo:block>
