><fo:inline font-weight="normal">s</fo:inline>us<fo:inline> </fo:inline>poterit exercere officium <fo:inline font-weight="normal">s</fo:inline>uum extra eam, &amp; ab his tantum e<fo:inline font-weight="normal">s</fo:inline>t interdictus, quæ alias quám in eccle<fo:inline font-weight="normal">s</fo:inline>ia fieri non po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>unt. h.d.</fo:inline></fo:block>
