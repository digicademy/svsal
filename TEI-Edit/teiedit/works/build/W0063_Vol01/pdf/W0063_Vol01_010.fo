<fo:block id="W0063-01-0297-pa-133a" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline> </fo:inline><fo:inline font-weight="bold" font-size="12pt" space-before="0.2cm" space-after="0.2cm" id="W0063-01-0297-re-1a96"><fo:basic-link internal-destination="W0063-01-0297-re-0f2e" color="#0a0c75">a</fo:basic-link> </fo:inline> ¶ <fo:inline font-style="italic">Carne en tal dia.</fo:inline> Die <fo:inline font-weight="normal">s</fo:inline>abbati, <fo:inline font-weight="normal">s</fo:inline>i quis <fo:inline font-weight="normal">s</fo:inline>e participem Chri<fo:inline font-weight="normal">s</fo:inline>tianæ religio<fo:inline> </fo:inline>nis e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e de<fo:inline font-weight="normal">s</fo:inline>yderat, ni<fo:inline font-weight="normal">s</fo:inline>i infirmitas vel fe<fo:inline font-weight="normal">s</fo:inline>tiuitas impediat, e<fo:inline font-weight="normal">s</fo:inline>t ab e<fo:inline font-weight="normal">s</fo:inline>u carnium ab<fo:inline font-weight="normal">s</fo:inline>tinendum. c. quia dies. de con<fo:inline font-weight="normal">s</fo:inline>e. di<fo:inline font-weight="normal">s</fo:inline>t. 5. &amp; intellige excepta fe<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>tiuitate Natalis Domini, vt in. c. fina. de ob<fo:inline font-weight="normal">s</fo:inline>erua. ieiu.</fo:block>
