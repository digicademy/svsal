amp;<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>i non veniat,<fo:inline> </fo:inline>priuabitur: &amp;<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>i non <fo:inline font-weight="normal">s</fo:inline>ciatur<fo:inline> </fo:inline>vbi <fo:inline font-weight="normal">s</fo:inline>it, citetur<fo:inline> </fo:inline>ter in <fo:inline font-weight="normal">s</fo:inline>ua eccle<fo:inline font-weight="normal">s</fo:inline>ia, &amp; po<fo:inline font-weight="normal">s</fo:inline>tea e<fo:inline font-weight="normal">s</fo:inline>t expectãdus per <fo:inline font-weight="normal">s</fo:inline>ex<fo:inline> </fo:inline>nien<fo:inline font-weight="normal">s</fo:inline>es: &amp; <fo:inline font-weight="normal">s</fo:inline>i<fo:inline> </fo:inline>nõ venerit, po<fo:inline> </fo:inline>te<fo:inline font-weight="normal">s</fo:inline>t beneficio<fo:inline> </fo:inline>priuari: vel <fo:inline font-weight="normal">s</fo:inline>i<fo:inline> </fo:inline>prælato videbitur (ꝗa fortè e<fo:inline font-weight="normal">s</fo:inline>t clericus<fo:inline> </fo:inline>vtilis eccle<fo:inline font-weight="normal">s</fo:inline>ię)<fo:inline> </fo:inline>eum compellere ad re<fo:inline font-weight="normal">s</fo:inline>idẽtiam. h.d.</fo:inline></fo:block>
