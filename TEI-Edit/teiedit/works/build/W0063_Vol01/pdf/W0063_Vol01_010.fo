<fo:block id="W0063-01-0226-pa-103c" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline> </fo:inline><fo:inline font-weight="bold" font-size="12pt" space-before="0.2cm" space-after="0.2cm" id="W0063-01-0226-re-1820"><fo:basic-link internal-destination="W0063-01-0226-re-0cba" color="#0a0c75">f</fo:basic-link> </fo:inline> ¶ <fo:inline font-style="italic">El precio.</fo:inline> Vide <fo:inline font-weight="normal">s</fo:inline>uprà. eo. l.<fo:inline> </fo:inline>proxima. in<fo:inline> </fo:inline>glo<fo:inline font-weight="normal">s</fo:inline> antepenultima. &amp; <fo:inline font-weight="normal">s</fo:inline>i<fo:inline> </fo:inline>e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>et emptor<fo:inline> </fo:inline>bonæ fidei, &amp;<fo:inline> </fo:inline>alienator non<fo:inline> </fo:inline>e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>et <fo:inline font-weight="normal">s</fo:inline>oluẽdo<fo:inline> </fo:inline>po<fo:inline font-weight="normal">s</fo:inline>set agere<fo:inline> </fo:inline>contra Eccle<fo:inline font-weight="normal">s</fo:inline>iam, quatenus ex, illo p̃cio facta e<fo:inline font-weight="normal">s</fo:inline>t lo<fo:inline> </fo:inline>cupletior. Ab<fo:inline> </fo:inline>bas in dict. ca<fo:inline> </fo:inline>pitu <fo:inline font-weight="normal">s</fo:inline>i quis<fo:inline> </fo:inline>presbyterorũ.<fo:inline> </fo:inline>in fi.</fo:block>
<fo:block id="W0063-01-0226-pa-103d" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline> </fo:inline><fo:inline font-weight="bold" font-size="12pt" space-before="0.2cm" space-after="0.2cm" id="W0063-01-0226-re-1821"><fo:basic-link internal-destination="W0063-01-0226-re-0cbb" color="#0a0c75">g</fo:basic-link> </fo:inline> ¶ <fo:inline font-style="italic">Mejoria.</fo:inline> Inlige quando<fo:inline> </fo:inline>e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>et emptor<fo:inline> </fo:inline>bonæ fidei: nã<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>i e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>et malæ<fo:inline> </fo:inline>fidei, tantùm<fo:inline> </fo:inline>po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>et ab alienante con<fo:inline font-weight="normal">s</fo:inline>equi precium,<fo:inline> </fo:inline>non aliud intere<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e. vt dixi <fo:inline font-weight="normal">s</fo:inline>uprà. l. pro<fo:inline> </fo:inline>xima. &amp; vide<fo:inline> </fo:inline>quod habetur in. l. 41. &amp;<fo:inline> </fo:inline>43. titul. 28. 3.<fo:inline> </fo:inline>parti.</fo:block>
