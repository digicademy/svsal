<fo:block id="W0063-01-0206-pa-0f5a" text-align="justify" font-size="12pt" text-indent="0em"><fo:inline> </fo:inline><fo:inline font-weight="bold" font-size="12pt" space-before="0.2cm" space-after="0.2cm" id="W0063-01-0206-re-175c"><fo:basic-link internal-destination="W0063-01-0206-re-0bf6" color="#0a0c75">d</fo:basic-link> </fo:inline> ¶ <fo:inline font-style="italic">Al Papa.</fo:inline> ad<fo:inline> </fo:inline>de. c. cum tempore. de arbi.<fo:inline> </fo:inline>cum glo. ibi.</fo:block>
