<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0051_Vol01" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/grepect/W0051_Vol01/W0051_Vol01.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0051_Vol01.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0051_Vol01_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0051_Vol01_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0051_Vol01_000.xml" tofile="${xml.dir}/W0051_Vol01_v1-0.xml"/>
        <echo>Checkpoint: W0051_Vol01_v1-0.xml (W0051_Vol01_000.xml).</echo>
        <delete file="${xml.dir}/W0051_Vol01_000.xml"/>
    </target>
    
    <target name="patch-000"> <!-- depends="cp-000" -->
        <echo>Structural annotation.</echo>
        <patch originalfile="${xml.dir}/W0051_Vol01_v1-0.xml" destfile="${xml.dir}/W0051_Vol01_001.xml" patchfile="${diff.dir}/W0051_Vol01_000.diff"/>
        <delete file="${xml.dir}/W0051_Vol01_000.xml"/>
        <!-- TODO: create diff between W0051_Vol01_v1-0.xml and W0051_Vol01_edit-000.xml (=W0051_Vol01_001.xml) -->
    </target>
    <target name="xslt-001"> 
        <echo>Structural annotation. </echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol01_001.xml" out="${xml.dir}/W0051_Vol01_002.xml" style="${xsl.dir}/W0051_Vol01_001.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>

    <target name="xslt-002" depends="xslt-001"> 
        <echo>Added abbreviations depending on word endings with regex (la)</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol01_002.xml" out="${xml.dir}/W0051_Vol01_003a.xml" style="${xsl.dir}/W0051_Vol01_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
 <echo>Added (again) abbreviations depending on word endings with regex (la)</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol01_003a.xml" out="${xml.dir}/W0051_Vol01_003.xml" style="${xsl.dir}/W0051_Vol01_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
       <delete file="${xml.dir}/W0051_Vol01_003a.xml"/>
    </target> 


<target name="xslt-003" depends="xslt-002"> 
        <echo>Transformation TEI tite to TEI P5.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol01_003.xml" out="${xml.dir}/W0051_Vol01_004.xml" style="${xsl.dir}/W0051_Vol01_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
 
    </target> 
 <target name="xslt-004" depends="xslt-003"> 
        <echo>Tagged special characters.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol01_004.xml" out="${xml.dir}/W0051_Vol01_005.xml" style="${xsl.dir}/W0051_Vol01_004.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>

    
    </target>
    <!--Reminder: hx for the titles and signed if names. add annotateHyphenBreaksHiNote as a new target here. Check the rest of the errors, dann test with rng. --> 
<target name="xslt-005" depends="xslt-004">
        <echo>Tagged Hyphenation.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol01_005.xml" out="${xml.dir}/W0051_Vol01_006.xml" style="${xsl.dir}/W0051_Vol01_005.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>

    </target>
   <target name="xslt-006" depends="xslt-005">
        <echo>Annotated hyphenated breaks interrupted by hi and note.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol01_006.xml" out="${xml.dir}/W0051_Vol01_007.xml" style="${xsl.dir}/W0051_Vol01_006.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>

    </target> 

  <target name="xslt-007" depends="xslt-006"> <!---->
        <echo>Numbered lines.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol01_007.xml" out="${xml.dir}/W0051_Vol01_008.xml" style="${xsl.dir}/W0051_Vol01_007.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
     
    </target>

   <target name="xslt-008" depends="xslt-007" ><!-- -->
        <echo>Added @xml:ids.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol01_008.xml" out="${xml.dir}/W0051_Vol01_009.xml" style="${xsl.dir}/W0051_Vol01_008.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
   
    </target>
  <target name="xslt-009" depends="xslt-008"> <!--   -->
        <echo>Tagged unmarked hyphenations.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol01_009.xml" out="${xml.dir}/W0051_Vol01_010.xml" style="${xsl.dir}/W0051_Vol01_009.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/W0051_Vol01-la_supposed-hyphenations-from-text.html" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
 
    </target>
 <target name="xslt-010" depends="xslt-009"> 
        <echo>Tagged unmarked hyphenations in marginals.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol01_010.xml" out="${xml.dir}/W0051_Vol01_011.xml" style="${xsl.dir}/W0051_Vol01_009b.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/marginals/W0051_Vol01-marg-la_supposed-hyphenations-from-text.html" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
 
    </target>

<target name="xslt-011" depends="xslt-010">
        <echo>Expanded abbreviations (la) main text.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol01_011.xml" out="${xml.dir}/W0051_Vol01_012.xml" style="${xsl.dir}/W0051_Vol01_0010.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="main" type="STRING"/>
            <param name="startAtLineBeginning" expression="TRUE" type="BOOLEAN"/>
            <param name="changeId" expression="W0051_Vol01_change_012" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
      
    </target>
<target name="xslt-012" depends="xslt-011">
        <echo>Expanded abbreviations (la) marginal text.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol01_012.xml" out="${xml.dir}/W0051_Vol01_013.xml" style="${xsl.dir}/W0051_Vol01_0010.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="marginals" type="STRING"/>
            <param name="startAtLineBeginning" expression="TRUE" type="BOOLEAN"/>
            <param name="changeId" expression="W0051_Vol01_change_013" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
      
    </target>
  <!--<target name="py-013" input file W0051_Vol01_013.xml output W0051_Vol01_014.xml > 
        <echo>Expanded abbreviations with breaks.</echo>
        <record name="${py.log}" action="start" loglevel="verbose"/>
        <exec executable="${executable-full-path}">
            <arg file="${py.dir}/W0051_Vol01_011.py"/>
        </exec>
        <record name="${py.log}" action="stop"/>
    </target> -->

<target name="xslt-014"><!--  depends="py-013"-->
        <echo>teiHeader update.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol01_014.xml" out="${xml.dir}/W0051_Vol01_015.xml" style="${xsl.dir}/W0051_Vol01_0012.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="finalize" depends="xslt-001">
        <echo>Reached end of pipeline.</echo>
    </target>
</project>
