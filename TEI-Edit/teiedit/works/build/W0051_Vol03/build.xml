<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0051_Vol03" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/grepect/W0051-C/W0051-C.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0051_Vol03.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0051_Vol03_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0051_Vol03_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0051_Vol03_000.xml" tofile="${xml.dir}/W0051_Vol03_v1-0.xml"/>
        <echo>Checkpoint: W0051_Vol03_v1-0.xml (W0051_Vol03_000.xml).</echo>
        <delete file="${xml.dir}/W0051_Vol03_000.xml"/>
    </target>
    
    <target name="patch-000"> <!-- depends="cp-000" -->
        <echo>Structural annotation.</echo>
        <patch originalfile="${xml.dir}/W0051_Vol03_v1-0.xml" destfile="${xml.dir}/W0051_Vol03_001.xml" patchfile="${diff.dir}/W0051_Vol03_000.diff"/>
        <delete file="${xml.dir}/W0051_Vol03_000.xml"/>
        <!-- TODO: create diff between W0051_Vol03_v1-0.xml and W0051_Vol03_edit-000.xml (=W0051_Vol03_001.xml) -->
    </target>
    <target name="xslt-001"> 
        <echo>Automatic structural annotation: added @type, @n in div(s) and list(s).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol03_001.xml" out="${xml.dir}/W0051_Vol03_002.xml" style="${xsl.dir}/W0051_Vol03_001.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="py-002"> <!-- depends="xslt-001" - input W0051_Vol03_002.xml and output W0051_Vol03_003.xml files in python script -->
        <!--Run and edit directly from Python. ANT causes encoding/decoding problems.-->
        <echo>Automatically expanded abbreviations - dictionary from manually corrected texts using python.</echo>
        <record name="${py.log}" action="start" loglevel="verbose"/>
        <exec executable="${executable-full-path}">
            <arg file="${py.dir}/W0051_Vol03_002.py"/>
        </exec>
        <record name="${py.log}" action="stop"/>
    </target>
    <target name="xslt-003"> <!-- depends="py-002"-->
        <echo>Added abbreviations depending on word endings with regex (la)</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol03_003.xml" out="${xml.dir}/W0051_Vol03_004a.xml" style="${xsl.dir}/W0051_Vol03_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <echo>Repeated abbreviations depending on word endings with regex (la)</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol03_004a.xml" out="${xml.dir}/W0051_Vol03_004.xml" style="${xsl.dir}/W0051_Vol03_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
       <delete file="${xml.dir}/W0051_Vol03_004a.xml"/>
    </target> 
    <target name="xslt-004" depends="xslt-003"><!-- -->

<!--depends="xslt-003" - Attention: input W0051_Vol03_002.xml before tagging abbr in targets py-002 and xslt-003
    Afterwards, it would be updated to W0051_Vol03_004.xml.
-->
        <echo>Transformation TEI tite to TEI P5.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol03_004.xml" out="${xml.dir}/W0051_Vol03_005.xml" style="${xsl.dir}/W0051_Vol03_004.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0051_Vol03_004.xml"/>
    </target> 
    <target name="xslt-005" depends="xslt-004"> 
        <echo>Tagged special characters.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol03_005.xml" out="${xml.dir}/W0051_Vol03_006.xml" style="${xsl.dir}/W0051_Vol03_005.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0051_Vol03_005.xml"/>
    </target>
    <target name="xslt-006" depends="xslt-005">
        <echo>Tagged Hyphenation.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol03_006.xml" out="${xml.dir}/W0051_Vol03_007.xml" style="${xsl.dir}/W0051_Vol03_006.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0051_Vol03_006.xml"/>
    </target>
    <target name="xslt-007" depends="xslt-006">
        <echo>Numbered lines.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol03_007.xml" out="${xml.dir}/W0051_Vol03_008.xml" style="${xsl.dir}/W0051_Vol03_007.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0051_Vol03_007.xml"/>
    </target>
    <target name="xslt-008" depends="xslt-007" >
        <echo>Added @xml:ids.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol03_008.xml" out="${xml.dir}/W0051_Vol03_009.xml" style="${xsl.dir}/W0051_Vol03_008.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0051_Vol03_008.xml"/>
    </target>
    <target name="xslt-009" ><!--depends="xslt-008"-->
        <echo>Tagged unmarked hyphenations.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol03_009.xml" out="${xml.dir}/W0051_Vol03_010.xml" style="${xsl.dir}/W0051_Vol03_009.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/lists/W0051_Vol03-la_supposed-hyphenations-from-text.html,../corrlist/lists/W0051_Vol03-marg-la_supposed-hyphenations-from-text.html" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="xslt-010" depends="xslt-009"> 
        <echo>Expanded abbreviations (la) main text.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol03_010.xml" out="${xml.dir}/W0051_Vol03_011a.xml" style="${xsl.dir}/W0051_Vol03_010.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="main" type="STRING"/>
            <param name="startAtLineBeginning" expression="TRUE" type="BOOLEAN"/>
            <param name="changeId" expression="W0051_Vol03_change_013" type="STRING"/>
        </xslt>
        <echo>**********************</echo>
        <echo>Expanded abbreviations (la) marginal text.</echo>        
        <xslt force="true" in="${xml.dir}/W0051_Vol03_011a.xml" out="${xml.dir}/W0051_Vol03_011.xml" style="${xsl.dir}/W0051_Vol03_010.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="marginal" type="STRING"/>
            <param name="startAtLineBeginning" expression="TRUE" type="BOOLEAN"/>
            <param name="changeId" expression="W0051_Vol03_change_014" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0051_Vol03_010.xml"/>
        <delete file="${xml.dir}/W0051_Vol03_011a.xml"/>
    </target>
    <target name="py-011"> <!-- depends="xslt-010" - input W0051_Vol03_011.xml and output W0051_Vol03_012.xml files in python script -->
        <!--Run and edit directly from Python. ANT causes encoding/decoding problems.-->
        <echo>Automatically expanded abbreviations with lb/@break using python.</echo>
        <record name="${py.log}" action="start" loglevel="verbose"/>
        <exec executable="${executable-full-path}">
            <arg file="${py.dir}/W0051_Vol03_011.py"/>
        </exec>
        <record name="${py.log}" action="stop"/>
    </target>
    <target name="xslt-012" ><!--depends="py-011"-->
        <echo>teiHeader update.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0051_Vol03_012.xml" out="${xml.dir}/W0051_Vol03_013.xml" style="${xsl.dir}/W0051_Vol03_012.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="finalize" depends="xslt-012">
        <echo>Reached end of pipeline.</echo>
    </target>
</project>
