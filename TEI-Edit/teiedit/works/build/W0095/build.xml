<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0095" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/grepect/W0095/095.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0095.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0095_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0095_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0095_000.xml" tofile="${xml.dir}/W0095_v1-0.xml"/>
        <echo>Checkpoint: W0095_v1-0.xml (W0095_000.xml).</echo>
        <delete file="${xml.dir}/W0095_000.xml"/>
    </target>
    
    <target name="patch-000"> <!-- depends="cp-000" -->
        <echo>Structural annotation.</echo>
        <patch originalfile="${xml.dir}/W0095_v1-0.xml" destfile="${xml.dir}/W0095_001.xml" patchfile="${diff.dir}/W0095_000.diff"/>
        <delete file="${xml.dir}/W0095_000.xml"/>
    </target>
    
    <target name="xslt-001"> <!--depends="patch-000"-->
        <echo>Transformation TEI tite to TEI P5.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0095_001.xml" out="${xml.dir}/W0095_002.xml" style="${xsl.dir}/W0095_001.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="xslt-002" depends="xslt-001"> 
        <echo>Tagged special characters.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0095_002.xml" out="${xml.dir}/W0095_003.xml" style="${xsl.dir}/W0095_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0095_002.xml"/>
    </target>
    <target name="xslt-003" depends="xslt-002"> 
        <echo>Annotated hyphenated breaks.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0095_003.xml" out="${xml.dir}/W0095_004.xml" style="${xsl.dir}/W0095_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0095_003.xml"/>
    </target>
    <target name="xslt-004" depends="xslt-003"> 
        <echo>Numbered lines.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0095_004.xml" out="${xml.dir}/W0095_005.xml" style="${xsl.dir}/W0095_004.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0095_004.xml"/>
    </target>
    <target name="xslt-005" depends="xslt-004">
        <echo>Added @xml:ids.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0095_005.xml" out="${xml.dir}/W0095_006.xml" style="${xsl.dir}/W0095_005.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0095_005.xml"/>
    </target>
    <target name="xslt-006" depends="xslt-005">
        <echo>Expanded abbreviations.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0095_006.xml" out="${xml.dir}/W0095_007.xml" style="${xsl.dir}/W0095_006.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="main" type="STRING"/>
            <param name="startAtLineBeginning" expression="True" type="BOOLEAN"/>
            <param name="changeId" expression="W0095_change_009" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0095_006.xml"/>
    </target>
    <target name="xslt-007" depends="xslt-006">
        <echo>Tagged unmarked hyphenations.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0095_007.xml" out="${xml.dir}/W0095_008.xml" style="${xsl.dir}/W0095_007.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/lists/W0095-la_supposed-hyphenations-from-text.html" type="STRING"/>
            <param name="lang" expression="la" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0095_007.xml"/>
    </target>
    
    <!-- CORRECTIONS -->
    
    <target name="patch-008" > <!--depends="xslt-007"-->
        <echo>First round of corrections (CB) 27.01.20.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <patch originalfile="${xml.dir}/W0095_008.xml" destfile="${xml.dir}/W0095_009.xml" patchfile="${diff.dir}/W0095_008.diff"/>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="patch-009">  <!--depends="patch-008" -->
        <echo>Second round of corrections and postcorrections (CB).</echo>
        <patch originalfile="${xml.dir}/W0095_009.xml" destfile="${xml.dir}/W0095_010.xml" patchfile="${diff.dir}/W0095_009.diff"/>
        <delete file="${xml.dir}/W0095_010.xml"/>
    </target>
    <target name="xslt-010" ><!--depends="patch-009"-->
        <echo>Post correction.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0095_010.xml" out="${xml.dir}/W0095_011.xml" style="${xsl.dir}/W0095_010.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="xslt-011" depends="xslt-010">
        <echo>Correct breaks</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0095_011.xml" out="${xml.dir}/W0095_012.xml" style="${xsl.dir}/W0095_011.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0095_011.xml"/>
    </target>
    <target name="xslt-012" depends="xslt-011">
        <echo>Choice correct breaks.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0095_012.xml" out="${xml.dir}/W0095_013.xml" style="${xsl.dir}/W0095_012.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0095_012.xml"/>
    </target>
    <target name="xslt-013" depends="xslt-012">
        <echo>Special characters.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0095_013.xml" out="${xml.dir}/W0095_014.xml" style="${xsl.dir}/W0095_013.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0095_013.xml"/>
    </target>
    <target name="xslt-014" depends="xslt-013">
        <echo>Number lines.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0095_014.xml" out="${xml.dir}/W0095_015.xml" style="${xsl.dir}/W0095_014.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0095_014.xml"/>
    </target>
    <target name="xslt-015" depends="xslt-014">
        <echo>Added @xml:ids.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0095_015.xml" out="${xml.dir}/W0095_016.xml" style="${xsl.dir}/W0095_015.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0095_015.xml"/>
    </target>
    <target name="xslt-016" depends="xslt-015">
        <echo>teiHeader update.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0095_016.xml" out="${xml.dir}/W0095_017.xml" style="${xsl.dir}/W0095_016.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0095_016.xml"/>
    </target>
    <target name="patch-017">  <!--depends="xslt-016" -->
        <echo>Manual corrections CR 02.04.24: Placed empty elements inside the nearest mixed-content element.</echo>
        <patch originalfile="${xml.dir}/W0095_009.xml" destfile="${xml.dir}/W0095_010.xml" patchfile="${diff.dir}/W0095_009.diff"/>
        <delete file="${xml.dir}/W0095_010.xml"/>
    </target>
    <target name="finalize" depends="patch-017">
        <echo>Reached end of pipeline.</echo>
    </target>
  
</project>
