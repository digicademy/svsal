				[542]] </fo:inline><fo:inline> </fo:inline>Prorogare iuri<fo:inline font-weight="normal">s</fo:inline>dictionem non <fo:inline font-weight="normal">s</fo:inline>ui<fo:inline> </fo:inline>indicis pote<fo:inline font-weight="normal">s</fo:inline>t laicus in habentem con<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>imilẽ iuri<fo:inline font-weight="normal">s</fo:inline>dictionẽ. Panor. in. c. cùm<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>it. de fo. comp. nu. 12. cõmunem dicit.</fo:block>
