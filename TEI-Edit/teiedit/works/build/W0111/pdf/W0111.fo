				197] </fo:inline><fo:inline> </fo:inline>Stipulatio interpo<fo:inline font-weight="normal">s</fo:inline>ita, <fo:inline font-weight="normal">s</fo:inline>emper intelligitur <fo:inline font-weight="normal">s</fo:inline>ecundum materiam actus<fo:inline font-style="normal" id="W0111-00-0455-pb-05ad"/><fo:inline role="W0111-00-0455-pb-05ad" font-style="normal" font-weight="bold" font-size="12pt">[Fol.[169]v]</fo:inline><fo:inline> </fo:inline>de quo agitur. Ia<fo:inline font-weight="normal">s</fo:inline>. in. l. cum motu.<fo:inline> </fo:inline>nu. 10. C. de tran<fo:inline font-weight="normal">s</fo:inline>a. communem dicit.</fo:block>
