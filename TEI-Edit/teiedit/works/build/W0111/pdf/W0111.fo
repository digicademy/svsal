<fo:block id="W0111-00-0083-it-074b" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0084-mi-064f" color="#0a0c75">2</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Legatarius <fo:inline font-weight="normal">s</fo:inline>i hæreditate iacente apprehendat po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ionem rei legatæ propria authoritate, quòd perdat<fo:inline> </fo:inline>legatum.</fo:inline></fo:block>
