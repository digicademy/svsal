				[448]] </fo:inline><fo:inline> </fo:inline>Po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e<fo:inline font-weight="normal">s</fo:inline>sio transfert onus probandi<fo:inline> </fo:inline>in aduer<fo:inline font-weight="normal">s</fo:inline>arium, <fo:inline font-weight="normal">s</fo:inline>i non <fo:inline font-weight="normal">s</fo:inline>it prę<fo:inline font-weight="normal">s</fo:inline>umptio<fo:inline> </fo:inline>iuris contra po<fo:inline font-weight="normal">s</fo:inline>sidentem. Cur. Iuni.<fo:inline> </fo:inline>con<fo:inline font-weight="normal">s</fo:inline>. 90. nu. 3. communem dicit.</fo:block>
