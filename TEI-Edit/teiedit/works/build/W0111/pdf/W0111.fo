<fo:block id="W0111-00-0076-it-072d" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0079-mi-0613" color="#0a0c75">13</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Inqui<fo:inline font-weight="normal">s</fo:inline>itio generalis quòd <fo:inline font-weight="normal">s</fo:inline>ine mandato regis non pro<fo:inline> </fo:inline>cedat.</fo:inline></fo:block>
<fo:block id="W0111-00-0076-it-072e" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0079-mi-0615" color="#0a0c75">14</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Inqui<fo:inline font-weight="normal">s</fo:inline>itio ex priuato delicto quòd de iure regio procedat eo quòd ex delicto duplex actio, parti &amp; fi<fo:inline font-weight="normal">s</fo:inline>co vel reipublicæ na<fo:inline font-weight="normal">s</fo:inline>catur.</fo:inline></fo:block>
<fo:block id="W0111-00-0076-it-072f" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0079-mi-0617" color="#0a0c75">15</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Instrumentum <fo:inline font-weight="normal">s</fo:inline>i negetur à notario confectum e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e,<fo:inline> </fo:inline>qualiter probari debeat e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e verum, o<fo:inline font-weight="normal">s</fo:inline>tenditur. Et<fo:inline> </fo:inline>quando quis dicatur haberi pro notario publico.</fo:inline></fo:block>
<fo:block id="W0111-00-0076-it-0730" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0079-mi-0619" color="#0a0c75">16</fo:basic-link> </fo:inline> <fo:inline font-style="italic">In<fo:inline font-weight="normal">s</fo:inline>trumẽto, ac notario quòd plus credatur quàm te<fo:inline font-weight="normal">s</fo:inline>ti<fo:inline> </fo:inline>bus, cum notarius e<fo:inline font-weight="normal">s</fo:inline>t viuus &amp; bonæfamæ.</fo:inline></fo:block>
<fo:block id="W0111-00-0076-it-0731" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0079-mi-061b" color="#0a0c75">17</fo:basic-link> </fo:inline> <fo:inline font-style="italic">In<fo:inline font-weight="normal">s</fo:inline>trumẽtum debiti <fo:inline font-weight="normal">s</fo:inline>i inueniatur penes debitorem<fo:inline> </fo:inline>an &amp; quando probet debiti remißionẽ, vel <fo:inline font-weight="normal">s</fo:inline>olutionem.</fo:inline></fo:block>
<fo:block id="W0111-00-0076-it-0732" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0080-mi-061d" color="#0a0c75">18</fo:basic-link> </fo:inline> <fo:inline font-style="italic">In<fo:inline font-weight="normal">s</fo:inline>trumenti ad reprobationem quot testes <fo:inline font-weight="normal">s</fo:inline>ufficiant. &amp;c.</fo:inline></fo:block>
<fo:block id="W0111-00-0076-it-0733" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0080-mi-061f" color="#0a0c75">19</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Instrumentum ad hoc vt Valeat, quot te<fo:inline font-weight="normal">s</fo:inline>tes requiran<fo:inline> </fo:inline>tur, o<fo:inline font-weight="normal">s</fo:inline>tenditur.</fo:inline></fo:block>
<fo:block id="W0111-00-0076-it-0734" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0080-mi-0621" color="#0a0c75">20</fo:basic-link> </fo:inline> <fo:inline font-style="italic">In<fo:inline font-weight="normal">s</fo:inline>trumentum an habeat executionem paratam.</fo:inline></fo:block>
