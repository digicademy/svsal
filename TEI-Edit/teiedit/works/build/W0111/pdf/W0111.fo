				[551]] </fo:inline><fo:inline> </fo:inline>Prote<fo:inline font-weight="normal">s</fo:inline>tatio non e<fo:inline font-weight="normal">s</fo:inline>t nece<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>aria <fo:inline font-weight="normal">s</fo:inline>ed<fo:inline> </fo:inline>vtilis metum pa<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>o. Hiero. Cagno. in<fo:inline> </fo:inline>l. in omnibus. num. 13. ff. de regul. iur.<fo:inline> </fo:inline>communem dicit.</fo:block>
