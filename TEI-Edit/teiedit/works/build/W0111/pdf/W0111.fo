				27] </fo:inline><fo:inline> </fo:inline>Notarius <fo:inline font-weight="normal">s</fo:inline>i omi<fo:inline font-weight="normal">s</fo:inline>it aliquas clau<fo:inline font-weight="normal">s</fo:inline>ulas<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>olitas apponi, habentur pro appo<fo:inline font-weight="normal">s</fo:inline>itis. Soci. in dict. §. credendum. in fi. cõ<fo:inline> </fo:inline>munem dicit.</fo:block>
