				116] </fo:inline><fo:inline> </fo:inline>In<fo:inline font-weight="normal">s</fo:inline>trumentum dotis probat, quando maritus præ<fo:inline font-weight="normal">s</fo:inline>titit alimenta vxori,<fo:inline> </fo:inline>&amp; <fo:inline font-weight="normal">s</fo:inline>i <fo:inline font-weight="normal">s</fo:inline>it confe<fo:inline font-weight="normal">s</fo:inline>sionatum. Goza. con<fo:inline font-weight="normal">s</fo:inline>il.<fo:inline> </fo:inline>42. nu. 13. communem dicit.</fo:block>
