				] </fo:inline><fo:inline> </fo:inline>regio, <fo:inline font-weight="normal">s</fo:inline>i res aliena ematur, pote<fo:inline font-weight="normal">s</fo:inline>t dñs<fo:inline> </fo:inline>ratificare emptionem, <fo:inline font-weight="normal">s</fo:inline>i res pereat cũ<fo:inline> </fo:inline>damno emptoris. l. 54. tit. 5. par. 5.</fo:block>
