<fo:block id="W0111-00-0113-d2-052c">
<fo:block text-align="center" font-size="20pt" font-weight="normal" space-before="5mm"><fo:block id="W0111-00-0113-li-040d" text-align="justify" font-size="12pt" text-indent="0em">
<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline> </fo:inline><fo:inline font-style="italic">SVMMARIVM.</fo:inline></fo:block>
<fo:block id="W0111-00-0113-it-0809" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0113-mi-07c0" color="#0a0c75">1</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Va<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>allus quòd non teneatur iuuare dominum, contra quem iu<fo:inline font-weight="normal">s</fo:inline>tè bellatur.</fo:inline></fo:block>
<fo:block id="W0111-00-0113-it-080a" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0114-mi-07c2" color="#0a0c75">2</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Venditio an, &amp; quando <fo:inline font-weight="normal">s</fo:inline>it perfecta etiã <fo:inline font-weight="normal">s</fo:inline>i de ea <fo:inline font-weight="normal">s</fo:inline>criptura non fiat.</fo:inline></fo:block>
<fo:block id="W0111-00-0113-it-080b" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0114-mi-07c4" color="#0a0c75">3</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Venditio <fo:inline font-weight="normal">s</fo:inline>i fiat de re tributaria, vel a<fo:inline font-weight="normal">s</fo:inline>tricta <fo:inline font-weight="normal">s</fo:inline>eruituti<fo:inline> </fo:inline>non facta mentione de tributo, vel <fo:inline font-weight="normal">s</fo:inline>eruitute, quòd<fo:inline> </fo:inline>emptor à venditione, <fo:inline font-weight="normal">s</fo:inline>i velit, recedere po<fo:inline font-weight="normal">s</fo:inline>sit, vel petere intere<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e.</fo:inline></fo:block>
<fo:block id="W0111-00-0113-it-080c" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0114-mi-07c6" color="#0a0c75">4</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Venditio <fo:inline font-weight="normal">s</fo:inline>i re<fo:inline font-weight="normal">s</fo:inline>oluatur ex cau<fo:inline font-weight="normal">s</fo:inline>a voluntaria, quæ erat<fo:inline> </fo:inline>in pote<fo:inline font-weight="normal">s</fo:inline>tate emptoris non re<fo:inline font-weight="normal">s</fo:inline>oluere, <fo:inline font-weight="normal">s</fo:inline>i interim emptor pignori dederit, quòd non valeat pignus, &amp;<fo:inline> </fo:inline>ab habente pignus reuocari poßit.</fo:inline></fo:block>
<fo:block id="W0111-00-0113-it-080d" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0114-mi-07c8" color="#0a0c75">5</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Venditio <fo:inline font-weight="normal">s</fo:inline>i fiat de animali vitio<fo:inline font-weight="normal">s</fo:inline>o, <fo:inline font-weight="normal">s</fo:inline>i venditor ne<fo:inline font-weight="normal">s</fo:inline>cit<fo:inline> </fo:inline>vitium, qua actione teneatur.</fo:inline></fo:block>
<fo:block id="W0111-00-0113-it-080e" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0114-mi-07ca" color="#0a0c75">6</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Remedium. l. 2. C. de re<fo:inline font-weight="normal">s</fo:inline>cind. vendi, quòd nec emptori nec venditorire perempta non competat.</fo:inline></fo:block>
<fo:block id="W0111-00-0113-it-080f" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0114-mi-07cc" color="#0a0c75">7</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Remedium. l. 2. C. de re<fo:inline font-weight="normal">s</fo:inline>cind. vẽdi intra quod tempus<fo:inline> </fo:inline>intentari debeat, tam ab eccle<fo:inline font-weight="normal">s</fo:inline>ia, fi<fo:inline font-weight="normal">s</fo:inline>co vel minori,<fo:inline> </fo:inline>quàm ab alijs, tam de iure ciuili, quà n regio.</fo:inline></fo:block>
<fo:block id="W0111-00-0113-it-0810" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0115-mi-07ce" color="#0a0c75">8</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Venditor, qui in venditione arrham recepit, <fo:inline font-weight="normal">s</fo:inline>i a vendi<fo:inline> </fo:inline>tione vult di<fo:inline font-weight="normal">s</fo:inline>ceaere, ad quid teneatur.</fo:inline></fo:block>
<fo:block id="W0111-00-0113-it-0811" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0115-mi-07d0" color="#0a0c75">9</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Venditor, <fo:inline font-weight="normal">s</fo:inline>i emptor tempore emptionis <fo:inline font-weight="normal">s</fo:inline>ciuit rem alienam, quòd nec ad pretium, nec ad damna vel in<fo:inline> </fo:inline>tere<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e teneatur.</fo:inline></fo:block>
<fo:block id="W0111-00-0113-it-0812" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0115-mi-07d2" color="#0a0c75">10</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Vendes gregem viginti ouiũ, <fo:inline font-weight="normal">s</fo:inline>i vna vel plures cuincantur, <fo:inline font-weight="normal">s</fo:inline>i remaneant decem, quæ faciunt gregem,<fo:inline> </fo:inline>an teneatur de euictione.</fo:inline></fo:block>
<fo:block id="W0111-00-0113-it-0813" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0115-mi-07d4" color="#0a0c75">11</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Venditam rem, quòd con<fo:inline font-weight="normal">s</fo:inline>anguineus retrahere &amp;<fo:inline> </fo:inline>euincere poßit ab emptore.</fo:inline></fo:block>
<fo:block id="W0111-00-0113-it-0814" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0115-mi-07d6" color="#0a0c75">12</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Venditio rei, quòd a<fo:inline font-weight="normal">s</fo:inline>ocio retrahi poßit.</fo:inline></fo:block>
<fo:block id="W0111-00-0113-it-0815" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0115-mi-07d7" color="#0a0c75">13</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Vidua luxurio<fo:inline font-weight="normal">s</fo:inline>è viuens, quòd <fo:inline font-weight="normal">s</fo:inline>olum lucra durante<fo:inline> </fo:inline>matrimonio acqui<fo:inline font-weight="normal">s</fo:inline>ita perdat.</fo:inline></fo:block>
<fo:block id="W0111-00-0113-it-0816" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0115-mi-07d9" color="#0a0c75">14</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Vxor quòd <fo:inline font-weight="normal">s</fo:inline>ine licentia viri in iudicio eße non poßit.</fo:inline></fo:block>
