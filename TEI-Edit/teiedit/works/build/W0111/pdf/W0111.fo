				[173]] </fo:inline><fo:inline> </fo:inline>Litis conte<fo:inline font-weight="normal">s</fo:inline>tatio requiritur in omni<fo:inline> </fo:inline>bus iudicijs po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>orijs. Ia<fo:inline font-weight="normal">s</fo:inline>. in. l. naturaliter. §. nihil commune. nu. 165. ff. de<fo:inline> </fo:inline>acqui. po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e. communem dicit.</fo:block>
