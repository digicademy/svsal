				[490]] </fo:inline><fo:inline> </fo:inline>Procurator <fo:inline font-weight="normal">s</fo:inline>i <fo:inline font-weight="normal">s</fo:inline>it cõ<fo:inline font-weight="normal">s</fo:inline>titutus ad talem<fo:inline font-style="normal" id="W0111-00-0418-pb-0588"/><fo:inline role="W0111-00-0418-pb-0588" font-style="normal" font-weight="bold" font-size="12pt">[Fol.151r]</fo:inline><fo:inline> </fo:inline>vel talem actum, &amp; po<fo:inline font-weight="normal">s</fo:inline>tea <fo:inline font-weight="normal">s</fo:inline>equatur<fo:inline> </fo:inline>clau<fo:inline font-weight="normal">s</fo:inline>ula per quam procuratorem cõ<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>tituens promittit habere ratum omnia ge<fo:inline font-weight="normal">s</fo:inline>ta per procuratorem, illa verba ponuntur ex <fo:inline font-weight="normal">s</fo:inline>uper abundanti. Ia<fo:inline font-weight="normal">s</fo:inline>.<fo:inline> </fo:inline>in. l. quæacta. nu. 21. ff. de offi. procu.<fo:inline> </fo:inline>Cę<fo:inline font-weight="normal">s</fo:inline>a. communem dicit.</fo:block>
