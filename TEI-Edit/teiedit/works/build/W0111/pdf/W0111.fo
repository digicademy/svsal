<fo:block id="W0111-00-0095-it-07c4" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0101-mi-073b" color="#0a0c75">44</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Plures <fo:inline font-weight="normal">s</fo:inline>i ab<fo:inline font-weight="normal">s</fo:inline>que propo<fo:inline font-weight="normal">s</fo:inline>ito interfecerũt aliquem, &amp;<fo:inline> </fo:inline>ignoratur de homicida, quod omnes teneãtur.</fo:inline></fo:block>
