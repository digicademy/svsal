				63] </fo:inline><fo:inline> </fo:inline>Vniuer<fo:inline font-weight="normal">s</fo:inline>itas, vel corpus fictum repre<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>entans viuum, acquirit po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e<fo:inline font-weight="normal">s</fo:inline>sionẽ.<fo:inline> </fo:inline>Ia<fo:inline font-weight="normal">s</fo:inline>. in. l. po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e<fo:inline font-weight="normal">s</fo:inline>sio appellata. §. municipes. nu. 9. ff. de acqui. po<fo:inline font-weight="normal">s</fo:inline>. cõem dicit.</fo:block>
