<fo:block id="W0111-00-0062-d2-0520">
<fo:block text-align="center" font-size="20pt" font-weight="normal" space-before="5mm"><fo:block id="W0111-00-0062-li-0401" text-align="justify" font-size="12pt" text-indent="0em">
<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline> </fo:inline><fo:inline font-style="italic">SVMMARIVM.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06ca" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0063-mi-0552" color="#0a0c75">1</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fal<fo:inline font-weight="normal">s</fo:inline>i pœna quæ <fo:inline font-weight="normal">s</fo:inline>it, o<fo:inline font-weight="normal">s</fo:inline>tenditur.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06cb" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0063-mi-0554" color="#0a0c75">2</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fal<fo:inline font-weight="normal">s</fo:inline>ificãs monetam, an perdat omnia bona.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06cc" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0063-mi-0556" color="#0a0c75">3</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fal<fo:inline font-weight="normal">s</fo:inline>um vt deponant te<fo:inline font-weight="normal">s</fo:inline>tes <fo:inline font-weight="normal">s</fo:inline>i quis in<fo:inline font-weight="normal">s</fo:inline>truere tẽtet, <fo:inline font-weight="normal">s</fo:inline>i nõ<fo:inline> </fo:inline>dixerint fal<fo:inline font-weight="normal">s</fo:inline>um, qua pœna puniatur. Et quid <fo:inline font-weight="normal">s</fo:inline>ifal<fo:inline font-weight="normal">s</fo:inline>arius <fo:inline font-weight="normal">s</fo:inline>it homo liber. &amp; c.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06cd" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0064-mi-0558" color="#0a0c75">4</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fal<fo:inline font-weight="normal">s</fo:inline>o <fo:inline font-weight="normal">s</fo:inline>e <fo:inline font-weight="normal">s</fo:inline>upponens partui alterius, qualiter puniatur,</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06ce" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0064-mi-055a" color="#0a0c75">5</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Famo<fo:inline font-weight="normal">s</fo:inline>um carmen <fo:inline font-weight="normal">s</fo:inline>eu libellum <fo:inline font-weight="normal">s</fo:inline>i quis in alicuius iniu<fo:inline> </fo:inline>riam faciat, &amp; <fo:inline font-weight="normal">s</fo:inline>i vera probet e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e in carmine contenta, quòd puniri debeat.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06cf" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0064-mi-055c" color="#0a0c75">6</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Feudum qui concedere po<fo:inline font-weight="normal">s</fo:inline>sint, o<fo:inline font-weight="normal">s</fo:inline>tenditur.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06d0" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0064-mi-055e" color="#0a0c75">7</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Feudum &amp; <fo:inline font-weight="normal">s</fo:inline>i <fo:inline font-weight="normal">s</fo:inline>implicter concedatur, quòd non tran<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>cendat nepotes.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06d1" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0064-mi-0560" color="#0a0c75">8</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Feudum vt perdatur, quidrequiratur, o<fo:inline font-weight="normal">s</fo:inline>tenditur.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06d2" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0064-mi-0562" color="#0a0c75">9</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Feudum an amittat va<fo:inline font-weight="normal">s</fo:inline>allus, <fo:inline font-weight="normal">s</fo:inline>i fratrem domini occidat, etiam proditoriè.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06d3" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0064-mi-0564" color="#0a0c75">10</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fideiu<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>or <fo:inline font-weight="normal">s</fo:inline>i in plus <fo:inline font-weight="normal">s</fo:inline>e obligauit quam principalis, an<fo:inline> </fo:inline>in aliquo teneatur.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06d4" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0064-mi-0566" color="#0a0c75">11</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fideiu<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>or <fo:inline font-weight="normal">s</fo:inline>i diu <fo:inline font-weight="normal">s</fo:inline>terit in obligatione fideiußionis, quòd<fo:inline> </fo:inline>po<fo:inline font-weight="normal">s</fo:inline>t annum petere poßit, vt a fideiußioneliberetur.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06d5" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0065-mi-0568" color="#0a0c75">12</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fideiu<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>or prominori quatuordecim annorum an obli<fo:inline> </fo:inline>getur.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06d6" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0065-mi-056a" color="#0a0c75">13</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fideiu<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ores plures in<fo:inline font-weight="normal">s</fo:inline>olidum, quòd beneficio diui<fo:inline font-weight="normal">s</fo:inline>ionis<fo:inline> </fo:inline>vtinõ poßint. Et quid <fo:inline font-weight="normal">s</fo:inline>i <fo:inline font-weight="normal">s</fo:inline>impliciter <fo:inline font-weight="normal">s</fo:inline>int obligati.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06d7" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0065-mi-056c" color="#0a0c75">14</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fideiu<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>oribus pluribus an beneficium diui<fo:inline font-weight="normal">s</fo:inline>ionis &amp;<fo:inline> </fo:inline>epi<fo:inline font-weight="normal">s</fo:inline>tolæ diui Adriani concedatur.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06d8" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0065-mi-056d" color="#0a0c75">15</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fideiu<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ores <fo:inline font-weight="normal">s</fo:inline>i <fo:inline font-weight="normal">s</fo:inline>int plures dati in<fo:inline font-weight="normal">s</fo:inline>olidum, &amp; vnus <fo:inline font-weight="normal">s</fo:inline>oluerit totum debitum, quòd in continenti vt <fo:inline font-weight="normal">s</fo:inline>ibi<fo:inline> </fo:inline>actiones cedentur contra alios confideiu<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ores pete<fo:inline> </fo:inline>re debeat, aliàs quòd alios confideiu<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ores conuenire<fo:inline> </fo:inline>non poßit.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06d9" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0065-mi-056f" color="#0a0c75">16</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Filius natur alis quis dicatur.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06da" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0065-mi-0571" color="#0a0c75">17</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Filius naturalis, quòd in bonis matris ab inte<fo:inline font-weight="normal">s</fo:inline>tato &amp;<fo:inline> </fo:inline>te<fo:inline font-weight="normal">s</fo:inline>tamento <fo:inline font-weight="normal">s</fo:inline>it legitimius hæres, &amp; exeludat a<fo:inline font-weight="normal">s</fo:inline>cendentes, in bonisverò patris <fo:inline font-weight="normal">s</fo:inline>olùm ex te<fo:inline font-weight="normal">s</fo:inline>tamento.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06db" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0065-mi-0573" color="#0a0c75">18</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Filijs natis ex damnato coitu quid tam per matrem<fo:inline> </fo:inline>quam per patrem relinqui poßit, o<fo:inline font-weight="normal">s</fo:inline>tenditur. Et quis<fo:inline> </fo:inline>dicatur coitus damnabilis.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06dc" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0066-mi-0575" color="#0a0c75">19</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Filij naturales<fo:inline font-weight="normal">s</fo:inline>i <fo:inline font-weight="normal">s</fo:inline>int alij legitimi, quòd non <fo:inline font-weight="normal">s</fo:inline>uccedãt.<fo:inline> </fo:inline>Et quòd etiam <fo:inline font-weight="normal">s</fo:inline>i mater <fo:inline font-weight="normal">s</fo:inline>it illu<fo:inline font-weight="normal">s</fo:inline>tris, filij naturales<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>uccedant; non <fo:inline font-weight="normal">s</fo:inline>tantibus legitimis, o<fo:inline font-weight="normal">s</fo:inline>tenditur.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06dd" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0066-mi-0577" color="#0a0c75">20</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Coitus damnabilis quis dicatur.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06de" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0066-mi-0579" color="#0a0c75">21</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Coitus inter coniugatum &amp; <fo:inline font-weight="normal">s</fo:inline>olutam an<fo:inline font-weight="normal">s</fo:inline>it damnabilis. Et quis filius dicatur ex damnabili coitu pro<fo:inline> </fo:inline>creatus.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06df" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0066-mi-057b" color="#0a0c75">22</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Coitus inter <fo:inline font-weight="normal">s</fo:inline>acerdotem &amp; <fo:inline font-weight="normal">s</fo:inline>olutam quòd <fo:inline font-weight="normal">s</fo:inline>it daninabilis.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06e0" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0066-mi-057d" color="#0a0c75">23</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Nepos ex filio clerici, quod ab. auo in<fo:inline font-weight="normal">s</fo:inline>titui nonpo<fo:inline font-weight="normal">s</fo:inline>sit.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06e1" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0066-mi-057f" color="#0a0c75">24</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Nepos filij ince<fo:inline font-weight="normal">s</fo:inline>tuo<fo:inline font-weight="normal">s</fo:inline>i an, &amp; quando ab auo in<fo:inline font-weight="normal">s</fo:inline>titui<fo:inline> </fo:inline>poßit.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06e2" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0067-mi-0581" color="#0a0c75">25</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Donatio filio Spurio contra di<fo:inline font-weight="normal">s</fo:inline>po<fo:inline font-weight="normal">s</fo:inline>itionem legisfacta<fo:inline> </fo:inline>po<fo:inline font-weight="normal">s</fo:inline>t hæredem <fo:inline font-weight="normal">s</fo:inline>criptum cuipertinet.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06e3" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0067-mi-0583" color="#0a0c75">26</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Vxor quòd non impediat, quinfilius naturalis <fo:inline font-weight="normal">s</fo:inline>uccedat patri ab int <fo:inline font-weight="normal">s</fo:inline>tato in duabus vncijs.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06e4" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0067-mi-0585" color="#0a0c75">27</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Filius quòd per contractium matrimonij à patria pote<fo:inline font-weight="normal">s</fo:inline>tate liberetur.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06e5" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0067-mi-0587" color="#0a0c75">28</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Filia cùm per contractum matrimonij liberetur à pa<fo:inline> </fo:inline>tria pote<fo:inline font-weight="normal">s</fo:inline>tate, quòd ip<fo:inline font-weight="normal">s</fo:inline>i &amp; non patriactio dotis<fo:inline font-weight="normal">s</fo:inline>olu<fo:inline> </fo:inline>to matrimonio competat, nec pater v<fo:inline font-weight="normal">s</fo:inline>ufructum ha<fo:inline> </fo:inline>bebit.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06e6" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0067-mi-0589" color="#0a0c75">29</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Nepote defuncto, quod pater tam in V<fo:inline font-weight="normal">s</fo:inline>ufructu quàm<fo:inline> </fo:inline>in proprietate bonorum filij fuccedat.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06e7" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0067-mi-058b" color="#0a0c75">30</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Pater &amp; filius defuncti <fo:inline font-weight="normal">s</fo:inline>i concurrant, quòd filius in<fo:inline> </fo:inline>V<fo:inline font-weight="normal">s</fo:inline>ufructu <fo:inline font-weight="normal">s</fo:inline>uccedat, &amp; non pater.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06e8" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0067-mi-058d" color="#0a0c75">31</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Filia maritata quod de <fo:inline font-weight="normal">s</fo:inline>ua dote. te<fo:inline font-weight="normal">s</fo:inline>tari poßit.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06e9" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0067-mi-058f" color="#0a0c75">32</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Filius cùm per contractũ matrimonij à patria pote<fo:inline font-weight="normal">s</fo:inline>ta<fo:inline> </fo:inline>te <fo:inline font-weight="normal">s</fo:inline>it <fo:inline font-weight="normal">s</fo:inline>olutus, quod <fo:inline font-weight="normal">s</fo:inline>ocer iniuriam nurui factam accu<fo:inline font-weight="normal">s</fo:inline>are non poßit.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06ea" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0067-mi-0591" color="#0a0c75">33</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Nepos quod aui originem non retineat, &amp; quare.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06eb" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0068-mi-0593" color="#0a0c75">34</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Filiu familias quòd libere te<fo:inline font-weight="normal">s</fo:inline>tari poßit, o<fo:inline font-weight="normal">s</fo:inline>tenditur.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06ec" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0068-mi-0595" color="#0a0c75">35</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Filia familias cũ <fo:inline font-weight="normal">s</fo:inline>it per matrimonium liberata à patria pote<fo:inline font-weight="normal">s</fo:inline>tate, quòd de dote te<fo:inline font-weight="normal">s</fo:inline>tari poßit.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06ed" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0068-mi-0597" color="#0a0c75">36</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Filius familias, an <fo:inline font-weight="normal">s</fo:inline>ine con<fo:inline font-weight="normal">s</fo:inline>en<fo:inline font-weight="normal">s</fo:inline>u patris, donare poßit in<fo:inline> </fo:inline>donatione cau<fo:inline font-weight="normal">s</fo:inline>a mortis.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06ee" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0068-mi-0599" color="#0a0c75">37</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Filio inte<fo:inline font-weight="normal">s</fo:inline>tato, quod pater &amp; mater, æqualiter <fo:inline font-weight="normal">s</fo:inline>uccedant.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06ef" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0068-mi-059b" color="#0a0c75">38</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fundus datus filiæ spuriæ pro dote vel alimentis, quod<fo:inline> </fo:inline>po<fo:inline font-weight="normal">s</fo:inline>t eius mortem non <fo:inline font-weight="normal">s</fo:inline>olùm quo ad fructum, <fo:inline font-weight="normal">s</fo:inline>ed<fo:inline> </fo:inline>etiam quo ad proprietatem ad. filium spurium<fo:inline> </fo:inline>tran<fo:inline font-weight="normal">s</fo:inline>eat.</fo:inline></fo:block>
<fo:block id="W0111-00-0062-it-06f0" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0068-mi-059d" color="#0a0c75">39</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Filius <fo:inline font-weight="normal">s</fo:inline>ecũdo genitus, an in <fo:inline font-weight="normal">s</fo:inline>ucceßione maioratus nepo<fo:inline> </fo:inline>tem filium primogeniti excludat.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-06f1" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline font-style="normal" id="W0111-00-0063-pb-0425"/><fo:inline role="W0111-00-0063-pb-0425" font-style="normal" font-weight="bold" font-size="12pt">[Fol.[19]v]</fo:inline><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0068-mi-059f" color="#0a0c75">40</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Filius <fo:inline font-weight="normal">s</fo:inline>i pater ingrediatur mona<fo:inline font-weight="normal">s</fo:inline>terum; an <fo:inline font-weight="normal">s</fo:inline>t. tim<fo:inline> </fo:inline>legitimam con<fo:inline font-weight="normal">s</fo:inline>equi po<fo:inline font-weight="normal">s</fo:inline>sit, vel vtrum eius mortem<fo:inline> </fo:inline>expectare debeat?</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-06f2" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0068-mi-05a0" color="#0a0c75">41</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Filius legitimatus per re<fo:inline font-weight="normal">s</fo:inline>criptũ principis, an &amp; quã<fo:inline> </fo:inline>do <fo:inline font-weight="normal">s</fo:inline>uccedat cum fratribus legitimis.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-06f3" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0068-mi-05a2" color="#0a0c75">42</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Legitimatio filiorum <fo:inline font-weight="normal">s</fo:inline>puriorum, quod quoad <fo:inline font-weight="normal">s</fo:inline>ucceßio<fo:inline> </fo:inline>nem parentum, &amp; non quoad alia reuocetur.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-06f4" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0069-mi-05a5" color="#0a0c75">43</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Filius adoptiuus, an abinte<fo:inline font-weight="normal">s</fo:inline>tato patrem patris adoptã<fo:inline> </fo:inline>tis excludat.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-06f5" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0069-mi-05a7" color="#0a0c75">44</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Filius adoptiuus quòd ab inte<fo:inline font-weight="normal">s</fo:inline>tato cum alijs filijs legitimis in aliquo <fo:inline font-weight="normal">s</fo:inline>uccedat.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-06f6" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0069-mi-05a9" color="#0a0c75">45</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Filij nati antequam pater committat. crimen læ<fo:inline font-weight="normal">s</fo:inline>æ<fo:inline> </fo:inline>maic<fo:inline font-weight="normal">s</fo:inline>tatis, an infames &amp; in<fo:inline font-weight="normal">s</fo:inline>ucceßibiles efficiantur.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-06f7" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0069-mi-05ab" color="#0a0c75">46</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Filius quod libros <fo:inline font-weight="normal">s</fo:inline>ibi cau<fo:inline font-weight="normal">s</fo:inline>a <fo:inline font-weight="normal">s</fo:inline>tudij a patre donatos, <fo:inline font-weight="normal">s</fo:inline>iue<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>tudium compleuerit, <fo:inline font-weight="normal">s</fo:inline>iue non, conferre teneatur.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-06f8" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0069-mi-05ad" color="#0a0c75">47</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Filia, an omnia bona <fo:inline font-weight="normal">s</fo:inline>ibi à patre in dotẽ data conferre tencatur. Et plura ibi de dote inofficio<fo:inline font-weight="normal">s</fo:inline>a. &amp; c.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-06f9" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0070-mi-05af" color="#0a0c75">48</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Furio<fo:inline font-weight="normal">s</fo:inline>us per diluoda interualla quód iudex e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e non<fo:inline> </fo:inline>poßit.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-06fa" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0070-mi-05b1" color="#0a0c75">49</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fi<fo:inline font-weight="normal">s</fo:inline>cus an exclu<fo:inline font-weight="normal">s</fo:inline>is agnatis, &amp; cognatis, &amp; matre, in<fo:inline> </fo:inline>bonis hæretici <fo:inline font-weight="normal">s</fo:inline>uccedat, &amp; quid in hoc, ob<fo:inline font-weight="normal">s</fo:inline>eruetur.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-06fb" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0070-mi-05b3" color="#0a0c75">50</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fugiens ad eccle<fo:inline font-weight="normal">s</fo:inline>iam pro debito, an ab eccle<fo:inline font-weight="normal">s</fo:inline>ia extra<fo:inline> </fo:inline>hi debeat.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-06fc" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0070-mi-05b5" color="#0a0c75">51</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fugiens à carcere cum fractione carceris, qua pœna<fo:inline> </fo:inline>puniatur.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-06fd" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0071-mi-05b7" color="#0a0c75">52</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Cu<fo:inline font-weight="normal">s</fo:inline>tos carceri, <fo:inline font-weight="normal">s</fo:inline>icum carcerato a fugiat, quãpœnã<fo:inline> </fo:inline>pati debeat. Et an eadẽ pœna <fo:inline font-weight="normal">s</fo:inline>it affuiendus. cu<fo:inline font-weight="normal">s</fo:inline>tos<fo:inline> </fo:inline>carceris, qua carceratus <fo:inline font-weight="normal">s</fo:inline>i eius negligẽtia aufugiat.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-06fe" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0071-mi-05b9" color="#0a0c75">53</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Frater quod cum matre ad <fo:inline font-weight="normal">s</fo:inline>ucceßionem fratris ab inte<fo:inline font-weight="normal">s</fo:inline>tato, nec ex te<fo:inline font-weight="normal">s</fo:inline>tamento non admittatur.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-06ff" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0071-mi-05bb" color="#0a0c75">54</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fratris in tutela an frater cum matre coniurrat.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-0700" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0071-mi-05bc" color="#0a0c75">55</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Mater, an in bonis filio quæ<fo:inline font-weight="normal">s</fo:inline>itis per, lineã maternam<fo:inline> </fo:inline>patri præferatur. Et quid in auo materno.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-0701" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0071-mi-05be" color="#0a0c75">56</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fratres, quod <fo:inline font-weight="normal">s</fo:inline>tantibus a<fo:inline font-weight="normal">s</fo:inline>cendentibus à <fo:inline font-weight="normal">s</fo:inline>ucceßione re<fo:inline> </fo:inline>pellantur.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-0702" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0071-mi-05bf" color="#0a0c75">57</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fratrum filij an <fo:inline font-weight="normal">s</fo:inline>uccedant patruo in stirpem, an verom cupita.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-0703" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0071-mi-05c1" color="#0a0c75">58</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fratres an <fo:inline font-weight="normal">s</fo:inline>int in <fo:inline font-weight="normal">s</fo:inline>ecundo gradu con<fo:inline font-weight="normal">s</fo:inline>anguinitatis.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-0704" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0072-mi-05c3" color="#0a0c75">59</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Frater, <fo:inline font-weight="normal">s</fo:inline>i alius non <fo:inline font-weight="normal">s</fo:inline>it qui accu<fo:inline font-weight="normal">s</fo:inline>et, quod de morte domini <fo:inline font-weight="normal">s</fo:inline>ui fratrem accu<fo:inline font-weight="normal">s</fo:inline>are poßit.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-0705" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0072-mi-05c5" color="#0a0c75">60</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fructus tam bonorum maritiquam vxoris quod <fo:inline font-weight="normal">s</fo:inline>int<fo:inline> </fo:inline>communes.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-0706" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0072-mi-05c7" color="#0a0c75">61</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fructus cùm <fo:inline font-weight="normal">s</fo:inline>int communes, quod lucra inter maritum &amp; vxorem communicentur.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-0707" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0072-mi-05c9" color="#0a0c75">62</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fructus dotis per <fo:inline font-weight="normal">s</fo:inline>pon<fo:inline font-weight="normal">s</fo:inline>um percepti, quod dotem non<fo:inline> </fo:inline>augeant, <fo:inline font-weight="normal">s</fo:inline>i <fo:inline font-weight="normal">s</fo:inline>pon<fo:inline font-weight="normal">s</fo:inline>us onera matrimonij <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>tinuit.</fo:inline></fo:block>
<fo:block id="W0111-00-0063-it-0708" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0072-mi-05cb" color="#0a0c75">63</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Fructus arboris in alieno fundo pendentis, per quot<fo:inline> </fo:inline>dies colligere permittatur.</fo:inline></fo:block>
