<fo:block text-align="center" font-size="30pt" font-weight="bold" space-before="10mm"><fo:inline> </fo:inline><fo:inline font-style="italic">AD ILLUSTRISSIMUM D. D. DIDAcum Spino<fo:inline font-weight="bold">s</fo:inline>am. S. R. E. Cardinalem, Epi<fo:inline font-weight="bold">s</fo:inline>copum́ Siguntinum,<fo:inline> </fo:inline>Supremi <fo:inline font-weight="bold">s</fo:inline>enatus regij præ<fo:inline font-weight="bold">s</fo:inline>idem, <fo:inline font-weight="bold">s</fo:inline>ummum́<fo:inline> </fo:inline>fidei cen<fo:inline font-weight="bold">s</fo:inline>orem.</fo:inline></fo:block>

<fo:block text-align="center" font-size="20pt" font-weight="normal" space-before="5mm"><fo:inline> </fo:inline>SALMANTICAE<fo:inline> </fo:inline>Excudebat Alexander à Canoua.<fo:inline> </fo:inline><fo:block>M. D. LXIX.</fo:block>
<fo:inline> </fo:inline><fo:inline font-style="italic">E<fo:inline font-weight="normal">s</fo:inline>ta ta<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ado en tre<fo:inline font-weight="normal">s</fo:inline>cientos marauedis.</fo:inline><fo:inline> </fo:inline>COLL. SOC. IESV SALM. EX DONO REGVM.</fo:block>
<fo:inline font-style="normal" id="W0111-00-0003-pb-03e9"/><fo:inline role="W0111-00-0003-pb-03e9" font-style="normal" font-weight="bold" font-size="12pt">[[i]v]</fo:inline>
