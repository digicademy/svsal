				[427]] </fo:inline><fo:inline> </fo:inline>Fama duobus te<fo:inline font-weight="normal">s</fo:inline>tibus probatur.<fo:inline> </fo:inline>Deci. con<fo:inline font-weight="normal">s</fo:inline>. 272. nu. 4. communem dicit ex glo. in. l. 3. §. eiu<fo:inline font-weight="normal">s</fo:inline>dem. ver<fo:inline font-weight="normal">s</fo:inline>. confir<fo:inline> </fo:inline>mat. ff. de te<fo:inline font-weight="normal">s</fo:inline>ti.</fo:block>
