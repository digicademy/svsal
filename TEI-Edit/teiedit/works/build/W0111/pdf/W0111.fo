<fo:block id="W0111-00-0077-it-0740" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline font-style="normal" id="W0111-00-0077-pb-0433"/><fo:inline role="W0111-00-0077-pb-0433" font-style="normal" font-weight="bold" font-size="12pt">[Fol.[26]v]</fo:inline><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0082-mi-0639" color="#0a0c75">32</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Iudex ad hoc quòd teneatur de neglectu, quid reuira<fo:inline> </fo:inline>tur.</fo:inline></fo:block>
<fo:block id="W0111-00-0077-it-0741" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0082-mi-063b" color="#0a0c75">33</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Iudex quòd eadem die condemnationem expẽ<fo:inline font-weight="normal">s</fo:inline>arum<fo:inline> </fo:inline>Vel fructuum moderare, vel alterare poßit.</fo:inline></fo:block>
<fo:block id="W0111-00-0077-it-0742" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0082-mi-063d" color="#0a0c75">34</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Index, an adulterium <fo:inline font-weight="normal">s</fo:inline>ine con<fo:inline font-weight="normal">s</fo:inline>en<fo:inline font-weight="normal">s</fo:inline>u mariti punire <fo:inline font-weight="normal">s</fo:inline>eu<fo:inline> </fo:inline>accu<fo:inline font-weight="normal">s</fo:inline>are poßit.</fo:inline></fo:block>
<fo:block id="W0111-00-0077-it-0743" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0082-mi-063f" color="#0a0c75">35</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Iudex <fo:inline font-weight="normal">s</fo:inline>i po<fo:inline font-weight="normal">s</fo:inline>t officium completum <fo:inline font-weight="normal">s</fo:inline>tetit per annũ vnũ<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>ine eo, quod aliquid ei petatur, quôd illo exacto<fo:inline> </fo:inline>non poßit <fo:inline font-weight="normal">s</fo:inline>yndicari, o<fo:inline font-weight="normal">s</fo:inline>tenditur.</fo:inline></fo:block>
