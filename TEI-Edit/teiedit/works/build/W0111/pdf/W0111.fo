				] </fo:inline><fo:inline> </fo:inline>re <fo:inline font-weight="normal">s</fo:inline>it aliqua per<fo:inline font-weight="normal">s</fo:inline>ona, approbata opi.<fo:inline> </fo:inline>Ho<fo:inline font-weight="normal">s</fo:inline>tien. in <fo:inline font-weight="normal">s</fo:inline>umma eo. ti. in. §. cùm <fo:inline font-weight="normal">s</fo:inline>it.<fo:inline> </fo:inline>per dict. l. 1. in fi.</fo:block>
