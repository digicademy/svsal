				[172]] </fo:inline><fo:inline> </fo:inline>Nota, quòd po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e<fo:inline font-weight="normal">s</fo:inline>sio litigio<fo:inline font-weight="normal">s</fo:inline>a reddit<fo:inline> </fo:inline>po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e<fo:inline font-weight="normal">s</fo:inline>sionem litigio<fo:inline font-weight="normal">s</fo:inline>am. Cur. Iuni.<fo:inline> </fo:inline>con 165. communem dicit. vi. in verb.<fo:inline> </fo:inline>Po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e<fo:inline font-weight="normal">s</fo:inline>sio. num. 276.</fo:block>
