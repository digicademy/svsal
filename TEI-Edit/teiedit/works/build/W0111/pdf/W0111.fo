				125] </fo:inline><fo:inline> </fo:inline>Cardinali deponenti <fo:inline font-weight="normal">s</fo:inline>uper aliquo<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>peciali in præiudicium tertij <fo:inline font-weight="normal">s</fo:inline>ibi e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e<fo:inline> </fo:inline>commi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>um vel habere pote<fo:inline font-weight="normal">s</fo:inline>tatem<fo:inline> </fo:inline>non creditur. Cur. in. l. admonẽdi. nu.<fo:inline> </fo:inline>207. ff. de iureiuran. communẽ dicit.</fo:block>
