				[184]] </fo:inline><fo:inline> </fo:inline>Locatio prima <fo:inline font-weight="normal">s</fo:inline>i <fo:inline font-weight="normal">s</fo:inline>it facta in <fo:inline font-weight="normal">s</fo:inline>criptis,<fo:inline> </fo:inline>hoc acto, vt non valeret <fo:inline font-weight="normal">s</fo:inline>ine <fo:inline font-weight="normal">s</fo:inline>criptura, licèt conductor tran<fo:inline font-weight="normal">s</fo:inline>acto tempore remaneat in re conducta, non videtur reconduxi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e. glo<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>. in. l. 20. titu.<fo:inline> </fo:inline>8. part. 5. communem dicit in verbo.<fo:inline> </fo:inline>Entiende<fo:inline font-weight="normal">s</fo:inline>e.</fo:block>
