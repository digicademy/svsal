				126] </fo:inline><fo:inline> </fo:inline>Fallit quando <fo:inline font-weight="normal">s</fo:inline>ingularis <fo:inline font-weight="normal">s</fo:inline>ucce<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>or<fo:inline> </fo:inline>po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>edit cum titulo &amp; bona fide. Ri.<fo:inline> </fo:inline>pa in. c. 8. de donationi. in fi. communem dicit. quod intelligit <fo:inline font-weight="normal">s</fo:inline>i po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>or<fo:inline> </fo:inline>bonæ fidei <fo:inline font-weight="normal">s</fo:inline>ucce<fo:inline font-weight="normal">s</fo:inline>sit bonæ fidei po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ori, aliàs non, vt ibi per eum.</fo:block>
