				[185]] </fo:inline><fo:inline> </fo:inline>Secus, tamen <fo:inline font-weight="normal">s</fo:inline>i facta e<fo:inline font-weight="normal">s</fo:inline>t <fo:inline font-weight="normal">s</fo:inline>ine <fo:inline font-weight="normal">s</fo:inline>criptura, <fo:inline font-weight="normal">s</fo:inline>i tempore tran<fo:inline font-weight="normal">s</fo:inline>acto remaneat in<fo:inline> </fo:inline>re conducta, videtur recondu xi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e <fo:inline font-weight="normal">s</fo:inline>ine <fo:inline font-weight="normal">s</fo:inline>criptis. glo<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>. ibi. communem dicit. &amp; vi. <fo:inline font-weight="normal">s</fo:inline>upra in verbo, Inquilinus,<fo:inline> </fo:inline>numer. 63.</fo:block>
