<fo:block id="W0111-00-0044-it-0670" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0046-mi-04a6" color="#0a0c75">6</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Compen<fo:inline font-weight="normal">s</fo:inline>atio n depo<fo:inline font-weight="normal">s</fo:inline>ito de expen<fo:inline font-weight="normal">s</fo:inline>is factam ip<fo:inline font-weight="normal">s</fo:inline>o depo<fo:inline font-weight="normal">s</fo:inline>ito an admittatur.</fo:inline></fo:block>
<fo:block id="W0111-00-0044-it-0671" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0046-mi-04a8" color="#0a0c75">7</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Compen<fo:inline font-weight="normal">s</fo:inline>atio an ad ittatur in alio contractu præter<fo:inline> </fo:inline>depo<fo:inline font-weight="normal">s</fo:inline>itum, <fo:inline font-weight="normal">s</fo:inline>i defacili liquidari po<fo:inline font-weight="normal">s</fo:inline>sit.</fo:inline></fo:block>
<fo:block id="W0111-00-0044-it-0672" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0046-mi-04aa" color="#0a0c75">8</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Compen<fo:inline font-weight="normal">s</fo:inline>atio iquiaanda intra decem dies quòd admittatur, o<fo:inline font-weight="normal">s</fo:inline>tenditur.</fo:inline></fo:block>
<fo:block id="W0111-00-0044-it-0673" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0047-mi-04ac" color="#0a0c75">9</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Commodãs rem alicui, <fo:inline font-weight="normal">s</fo:inline>i furata <fo:inline font-weight="normal">s</fo:inline>it res, quid agere debeat, o<fo:inline font-weight="normal">s</fo:inline>tenditur.</fo:inline></fo:block>
<fo:block id="W0111-00-0044-it-0674" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0047-mi-04ae" color="#0a0c75">10</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Cognati v<fo:inline font-weight="normal">s</fo:inline>que ad quem gradum pro con<fo:inline font-weight="normal">s</fo:inline>anguineo in<fo:inline> </fo:inline>iudicio admittantur.</fo:inline></fo:block>
<fo:block id="W0111-00-0045-it-0675" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline font-style="normal" id="W0111-00-0045-pb-0413"/><fo:inline role="W0111-00-0045-pb-0413" font-style="normal" font-weight="bold" font-size="12pt">[Fol.[10]v]</fo:inline><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0047-mi-04b0" color="#0a0c75">11</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Concubina quæ dicatur, o<fo:inline font-weight="normal">s</fo:inline>tenditur.</fo:inline></fo:block>
<fo:block id="W0111-00-0045-it-0676" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0047-mi-04b2" color="#0a0c75">12</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Condemnatus ad mortem, an <fo:inline font-weight="normal">s</fo:inline>eruus efficiatur.</fo:inline></fo:block>
