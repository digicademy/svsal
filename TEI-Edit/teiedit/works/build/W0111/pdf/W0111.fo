				] </fo:inline><fo:inline> </fo:inline>intra decem dies tenetur reclamare,<fo:inline> </fo:inline>aliàs <fo:inline font-weight="normal">s</fo:inline>ententia arbitri tran<fo:inline font-weight="normal">s</fo:inline>it in rem<fo:inline> </fo:inline>iudicatam.</fo:block>
