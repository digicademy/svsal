<fo:block id="W0111-00-0083-it-0751" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0085-mi-065b" color="#0a0c75">8</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Legis. 2. de ve<fo:inline font-weight="normal">s</fo:inline>eind. venditione, remedium quòd in re<fo:inline> </fo:inline>perempta nec emptori nec venditori competat.</fo:inline></fo:block>
<fo:block id="W0111-00-0083-it-0752" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0085-mi-065d" color="#0a0c75">9</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Eccle<fo:inline font-weight="normal">s</fo:inline>ia enormißimè læ<fo:inline font-weight="normal">s</fo:inline>a intra quod tempus remedium. l. 2. de re<fo:inline font-weight="normal">s</fo:inline>cind. vend. intentare poßit.</fo:inline></fo:block>
<fo:block id="W0111-00-0083-it-0753" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0085-mi-065f" color="#0a0c75">10</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Libellus incertus incertitudine, quæ non cau<fo:inline font-weight="normal">s</fo:inline>atur ex<fo:inline> </fo:inline>facto rei, quod admittatur, dummodo certificetur<fo:inline> </fo:inline>ex actis.</fo:inline></fo:block>
