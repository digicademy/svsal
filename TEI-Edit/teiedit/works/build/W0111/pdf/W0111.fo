				] </fo:inline><fo:inline> </fo:inline>l. fi. tit. 4. part. 5. dicentis donationem<fo:inline> </fo:inline>timore mortis vel periculi factã po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e<fo:inline> </fo:inline>reuocari, quę debet intelligi, expre<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>o<fo:inline> </fo:inline>timore mortis, vel periculi.</fo:block>
