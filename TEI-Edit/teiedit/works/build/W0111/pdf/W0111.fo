				61] </fo:inline><fo:inline> </fo:inline>Fideicommi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>o relicto <fo:inline font-weight="normal">s</fo:inline>i <fo:inline font-weight="normal">s</fo:inline>ine filijs<fo:inline> </fo:inline>dece<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>erit patre ac filijs naufragio per<fo:inline> </fo:inline>euntibus locum habet fideicommi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>o, <fo:inline font-weight="normal">s</fo:inline>i dubitetur quis prior perierit, nec<fo:inline> </fo:inline>onus probationis ineumbit fideicom<fo:inline> </fo:inline>mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ario, quia præ<fo:inline font-weight="normal">s</fo:inline>umitur pater priùs<fo:inline> </fo:inline>dece<fo:inline font-weight="normal">s</fo:inline>si<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e. Alci. in tra. de præ<fo:inline font-weight="normal">s</fo:inline>um. reg.<fo:inline> </fo:inline>1. prę<fo:inline font-weight="normal">s</fo:inline>um. 49. nu. 6. communem dicit.</fo:block>
