				[449]] </fo:inline><fo:inline> </fo:inline>Vel ni<fo:inline font-weight="normal">s</fo:inline>i ius commune re<fo:inline font-weight="normal">s</fo:inline>i<fo:inline font-weight="normal">s</fo:inline>tat. Idẽ<fo:inline> </fo:inline>ibi communem dict.</fo:block>
