				227] </fo:inline><fo:inline> </fo:inline>Confitens <fo:inline font-weight="normal">s</fo:inline>ua peccata, tenetur pa<fo:inline> </fo:inline>tefacere confe<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>ori etiam notoria, &amp;<fo:inline> </fo:inline>nota ip<fo:inline font-weight="normal">s</fo:inline>i <fo:inline font-weight="normal">s</fo:inline>acerdoti. Naua. in cap. 1. ver.<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>tatus aut officium. num. 61. de pœni.<fo:inline> </fo:inline>di<fo:inline font-weight="normal">s</fo:inline>tin. 5. communem dicit.</fo:block>
