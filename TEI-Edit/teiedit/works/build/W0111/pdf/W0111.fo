				39] </fo:inline><fo:inline> </fo:inline>Amplia etiam <fo:inline font-weight="normal">s</fo:inline>i non <fo:inline font-weight="normal">s</fo:inline>it agnita iure<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>uitatis. Deci. con<fo:inline font-weight="normal">s</fo:inline>i. 331. &amp; con<fo:inline font-weight="normal">s</fo:inline>i. 245. &amp;<fo:inline> </fo:inline>Ia<fo:inline font-weight="normal">s</fo:inline>. con<fo:inline font-weight="normal">s</fo:inline>. 130. vo. 1. communem dicũt.</fo:block>
