<fo:block text-align="center" font-size="20pt" font-weight="normal" space-before="5mm"><fo:block id="W0111-00-0086-li-0406" text-align="justify" font-size="12pt" text-indent="0em">
<fo:block text-align="justify" font-size="16pt" font-weight="bold" space-before="20pt" text-indent="0em" keep-with-next="always"><fo:inline> </fo:inline><fo:inline font-style="italic">SVMMARIVM.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-075e" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0087-mi-0675" color="#0a0c75">1</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Mandatum ad agendum &amp; defendẽdum pro ab<fo:inline font-weight="normal">s</fo:inline>en<fo:inline> </fo:inline>te quibus concedatur de iure regio, o<fo:inline font-weight="normal">s</fo:inline>tenditur.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-075f" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0087-mi-0677" color="#0a0c75">2</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Maritus quòd ad <fo:inline font-weight="normal">s</fo:inline>u<fo:inline font-weight="normal">s</fo:inline>tentanda onera matrimonij quo<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>cunque fructus in di<fo:inline font-weight="normal">s</fo:inline>tinctè habeat, etiam rei vxoris, &amp; quod quæ <fo:inline font-weight="normal">s</fo:inline>uper<fo:inline font-weight="normal">s</fo:inline>unt <fo:inline font-weight="normal">s</fo:inline>int communes.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-0760" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0087-mi-0679" color="#0a0c75">3</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Maritus retinens vxorem deprehen<fo:inline font-weight="normal">s</fo:inline>am in adulterio,<fo:inline> </fo:inline>an &amp; quando lenocinium committat.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-0761" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0087-mi-067d" color="#0a0c75">5</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Maritus quod quencũque etiam nobilem cum<fo:inline font-weight="normal">s</fo:inline>ua vxo<fo:inline> </fo:inline>re in flaganti delicto inuentum occidere poßit.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-0762" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0087-mi-067d" color="#0a0c75">5</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Maritus quod in<fo:inline font-weight="normal">s</fo:inline>imul adulterum &amp; adulteram ac<fo:inline> </fo:inline>cu<fo:inline font-weight="normal">s</fo:inline>are poßit.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-0763" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0087-mi-067f" color="#0a0c75">6</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Maritus quod de adulterio accu<fo:inline font-weight="normal">s</fo:inline>ari poßit, licèt pœna<fo:inline> </fo:inline>adulterij puniri non debeat.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-0764" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0088-mi-0681" color="#0a0c75">7</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Mater <fo:inline font-weight="normal">s</fo:inline>i <fo:inline font-weight="normal">s</fo:inline>it tutrix filiorũ ex te<fo:inline font-weight="normal">s</fo:inline>tamento patris, quod<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>ecundas nuptias renuntiare teneatur.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-0765" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0088-mi-0683" color="#0a0c75">8</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Mater tutrix ex te<fo:inline font-weight="normal">s</fo:inline>tamento, <fo:inline font-weight="normal">s</fo:inline>i <fo:inline font-weight="normal">s</fo:inline>ecundo nubat, quod<fo:inline> </fo:inline>repellatur à tutela.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-0766" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0088-mi-0684" color="#0a0c75">9</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Matris tutela quod non vitietur, etiam <fo:inline font-weight="normal">s</fo:inline>i per eam au<fo:inline> </fo:inline>xilij omnium legum renuntiatio non fiat.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-0767" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0088-mi-0686" color="#0a0c75">10</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Mater <fo:inline font-weight="normal">s</fo:inline>i tran<fo:inline font-weight="normal">s</fo:inline>eat ad <fo:inline font-weight="normal">s</fo:inline>ecunda Vota, quod opus <fo:inline font-weight="normal">s</fo:inline>it legitimo &amp; non datiuo tutore.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-0768" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0088-mi-0688" color="#0a0c75">11</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Matrimonium prohibitum contrahẽ, quod nõ omnia<fo:inline> </fo:inline>bona, <fo:inline font-weight="normal">s</fo:inline>ed <fo:inline font-weight="normal">s</fo:inline>olum medietatem bonorum amittat.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-0769" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0088-mi-068a" color="#0a0c75">12</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Matrimonio durãte <fo:inline font-weight="normal">s</fo:inline>i quid maritus <fo:inline font-weight="normal">s</fo:inline>uo nomine emat,<fo:inline> </fo:inline>quod <fo:inline font-weight="normal">s</fo:inline>it mariti &amp; Vxoris.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-076a" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0088-mi-068c" color="#0a0c75">13</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Melioratio tertij &amp; quinti facta à patre filio, quod<fo:inline> </fo:inline>per hæredem <fo:inline font-weight="normal">s</fo:inline>olui non poßit in æ<fo:inline font-weight="normal">s</fo:inline>timationem, <fo:inline font-weight="normal">s</fo:inline>ed<fo:inline> </fo:inline>res ip<fo:inline font-weight="normal">s</fo:inline>a tradenda <fo:inline font-weight="normal">s</fo:inline>it.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-076b" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0088-mi-068e" color="#0a0c75">14</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Metus, qui cadere poßit invirum con<fo:inline font-weight="normal">s</fo:inline>tantem; qualis<fo:inline> </fo:inline>e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e dicatur, &amp; quommodo iudicis arbitrio non relinquatur.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-076c" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0088-mi-0690" color="#0a0c75">15</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Minor decem &amp; <fo:inline font-weight="normal">s</fo:inline>eptem annorum, quod pœna ordinaria non puniatur. Et quid <fo:inline font-weight="normal">s</fo:inline>i decimum <fo:inline font-weight="normal">s</fo:inline>eptimum<fo:inline> </fo:inline>excedat annum.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-076d" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0089-mi-0692" color="#0a0c75">16</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Minor vt poßit e<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e legitimus te<fo:inline font-weight="normal">s</fo:inline>tis in cau<fo:inline font-weight="normal">s</fo:inline>a criminali<fo:inline> </fo:inline>quod ætas vigintiquinque annorum requiratur.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-076e" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0089-mi-0694" color="#0a0c75">17</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Minor vt poßit accu<fo:inline font-weight="normal">s</fo:inline>are, quæ ætas requiratur, o<fo:inline font-weight="normal">s</fo:inline>tenditur.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-076f" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0089-mi-0696" color="#0a0c75">18</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Minor, quod in retractu bonorum maiorũ aduer<fo:inline font-weight="normal">s</fo:inline>um<fo:inline> </fo:inline>temporis cur<fo:inline font-weight="normal">s</fo:inline>um non re<fo:inline font-weight="normal">s</fo:inline>tetuatur.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-0770" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0089-mi-0698" color="#0a0c75">19</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Mißio in po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>eßionem ex contumacia rei non comparetis, quod per <fo:inline font-weight="normal">s</fo:inline>olum iuramentũ partis de iure<fo:inline font-weight="normal">s</fo:inline>uo,<fo:inline> </fo:inline>ficripoßit.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-0771" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0089-mi-069a" color="#0a0c75">20</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>us in po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>eßionem ex contumacia rei po<fo:inline font-weight="normal">s</fo:inline>t litẽ con<fo:inline> </fo:inline>te<fo:inline font-weight="normal">s</fo:inline>ta am, <fo:inline font-weight="normal">s</fo:inline>i reus intrà annum comparet, quod reuo<fo:inline> </fo:inline>cet po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>eßionem.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-0772" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0089-mi-069c" color="#0a0c75">21</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Mi<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>us in po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>eßionem ex primo decreto, quòd non fa<fo:inline> </fo:inline>ciat fructus <fo:inline font-weight="normal">s</fo:inline>uos.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-0773" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0089-mi-069e" color="#0a0c75">22</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Mora, quòd non <fo:inline font-weight="normal">s</fo:inline>olùm ante litem conte<fo:inline font-weight="normal">s</fo:inline>tatam purgetur, <fo:inline font-weight="normal">s</fo:inline>ed etiam ab intere<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>e liberet.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-0774" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0089-mi-06a0" color="#0a0c75">23</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Moræ purgatio, etiam <fo:inline font-weight="normal">s</fo:inline>i ius e<fo:inline font-weight="normal">s</fo:inline>t factũ deterius, quod ad<fo:inline> </fo:inline>arbitrium iudicis admit tatur, licèt ius actori remaneat, vt poßit petere principale.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-0775" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0090-mi-06a2" color="#0a0c75">24</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Mortuus de quibus crimmibus accu<fo:inline font-weight="normal">s</fo:inline>ari poßit, o<fo:inline font-weight="normal">s</fo:inline>tendi<fo:inline> </fo:inline>tur.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-0776" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0090-mi-06a4" color="#0a0c75">25</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Mulier quòd ab<fo:inline font-weight="normal">s</fo:inline>pue aliqua nota infamiæ <fo:inline font-weight="normal">s</fo:inline>tatim etiã<fo:inline> </fo:inline>intra annum luctus contrahere poßit.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-0777" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0090-mi-06a6" color="#0a0c75">26</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Mulier, quod lucra acqui<fo:inline font-weight="normal">s</fo:inline>ita durante matrimonio ple<fo:inline> </fo:inline>no iure <fo:inline font-weight="normal">s</fo:inline>int <fo:inline font-weight="normal">s</fo:inline>ua, nec tenetur filijs primi matrimonij proprietatem re<fo:inline font-weight="normal">s</fo:inline>eruare.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-0778" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0090-mi-06a8" color="#0a0c75">27</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Mulier licèt pro. debito incarcerari non poßit, quod<fo:inline> </fo:inline>tamen pro debito ex delicto de<fo:inline font-weight="normal">s</fo:inline>cendeti detineri poßit</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-0779" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0090-mi-06aa" color="#0a0c75">28</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Mulier quod pro debito pro admini<fo:inline font-weight="normal">s</fo:inline>tratione tutelæ<fo:inline> </fo:inline>proueniente incarcerari non poßit.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-077a" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0090-mi-06ac" color="#0a0c75">29</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Mulieres, an, &amp; in quibus ca<fo:inline font-weight="normal">s</fo:inline>ibus <fo:inline font-weight="normal">s</fo:inline>int idonei te<fo:inline font-weight="normal">s</fo:inline>tes.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-077b" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0090-mi-06ae" color="#0a0c75">30</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Mulier an durante matrimonio dotem perdere po<fo:inline font-weight="normal">s</fo:inline><fo:inline font-weight="normal">s</fo:inline>it.</fo:inline></fo:block>
<fo:block id="W0111-00-0086-it-077c" text-align="justify" start-indent="16pt" space-before="0.2cm" space-after="0.2cm"><fo:inline> </fo:inline><fo:inline space-before="0.2cm" space-after="0.2cm"><fo:basic-link internal-destination="W0111-00-0090-mi-06b0" color="#0a0c75">31</fo:basic-link> </fo:inline> <fo:inline font-style="italic">Nutuum factum <fo:inline font-weight="normal">s</fo:inline>cholari, an à patre repeti poßit.</fo:inline></fo:block>
</fo:block>
</fo:block>
