				] </fo:inline><fo:inline> </fo:inline>dos in officiofa, e<fo:inline font-weight="normal">s</fo:inline>t in arbitrio recipiẽtis dotem con<fo:inline font-weight="normal">s</fo:inline>iderare <fo:inline font-weight="normal">s</fo:inline>ub<fo:inline font-weight="normal">s</fo:inline>tãtiam patris, vel rempore dotis con<fo:inline font-weight="normal">s</fo:inline>titutæ, vel<fo:inline> </fo:inline>patris mortis. per. l. 29. in deci. Tau.</fo:block>
