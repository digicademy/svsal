				75] </fo:inline><fo:inline> </fo:inline>Pecuniam <fo:inline font-weight="normal">s</fo:inline>olus princeps mutat <fo:inline font-weight="normal">s</fo:inline>ine con<fo:inline font-weight="normal">s</fo:inline>en<fo:inline font-weight="normal">s</fo:inline>u populi. Boe. Deci<fo:inline font-weight="normal">s</fo:inline>. 227.<fo:inline> </fo:inline>nu. 7. communem dicit.</fo:block>
