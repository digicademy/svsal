				[417]] </fo:inline><fo:inline> </fo:inline>Item negatiuam incumbit neganti, <fo:inline font-weight="normal">s</fo:inline>iue <fo:inline font-weight="normal">s</fo:inline>it res, <fo:inline font-weight="normal">s</fo:inline>iue actor probare, fiue<fo:inline> </fo:inline><fo:inline font-weight="normal">s</fo:inline>it facti, <fo:inline font-weight="normal">s</fo:inline>iue iuris Ia<fo:inline font-weight="normal">s</fo:inline>. in. l. in illa. nu. 14.<fo:inline> </fo:inline>f<fo:inline font-weight="normal">s</fo:inline>. de verbo. oblig. communem dicit.<fo:inline> </fo:inline>&amp; magis communem in l. 4. §. condẽ<fo:inline> </fo:inline>nandum. nu. 7. ff de re iudi.</fo:block>
