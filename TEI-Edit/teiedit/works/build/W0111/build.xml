<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0111" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/textloop/W0111/W0111.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0111.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0111_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0111_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0111_000.xml" tofile="${xml.dir}/W0111_v1-0.xml"/>
        <echo>Checkpoint: W0111_v1-0.xml (W0111_000.xml).</echo>
        <delete file="${xml.dir}/W0111_000.xml"/>
    </target>
    
    <target name="patch-000" depends="cp-000"><!--, W0111_edit.xml renamed W0111-001.xml, do not delete: W0111-001.xml--> 
        <patch originalfile="${xml.dir}/W0111_v1-0.xml" destfile="${xml.dir}/W0111_001.xml" patchfile="${diff.dir}/W0111_000.diff"/>
        <echo>Structural Annotation</echo>
        <delete file="${xml.dir}/W0111_000.xml"/>
    </target>
    <target name="xslt-001"> 
        <echo>Adding @xml:id and @unit to milestone.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0111_001.xml" out="${xml.dir}/W0111_002.xml" style="${xsl.dir}/W0111_001.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="xslt-002" depends="xslt-001">
        <echo>Adding @target to ref in summaries.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0111_002.xml" out="${xml.dir}/W0111_003.xml" style="${xsl.dir}/W0111_002.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0111_002.xml"/>
    </target>
    <target name="xslt-003" depends="xslt-002">
        <echo>Transformation from TEI Tite to TEI P5.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0111_003.xml" out="${xml.dir}/W0111_004.xml" style="${xsl.dir}/W0111_003.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0111_003.xml"/>
    </target>
    <target name="xslt-004" depends="xslt-003">
        <echo>Annotated Hyphenation.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0111_004.xml" out="${xml.dir}/W0111_005.xml" style="${xsl.dir}/W0111_004.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0111_004.xml"/>
    </target>
    <target name="xslt-005" depends="xslt-004">
        <echo>Special characters tagging. </echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0111_005.xml" out="${xml.dir}/W0111_006.xml" style="${xsl.dir}/W0111_005.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0111_005.xml"/>
    </target>
    <target name="xslt-006" depends="xslt-005">
        <echo>Line numbering.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0111_006.xml" out="${xml.dir}/W0111_007.xml" style="${xsl.dir}/W0111_006.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0111_006.xml"/>
    </target>
    <target name="xslt-007" depends="xslt-006">
        <echo>Generated @xml:id.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt in="${xml.dir}/W0111_007.xml" out="${xml.dir}/W0111_008.xml" style="${xsl.dir}/W0111_007.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0111_007.xml"/>
    </target>
    <target name="xslt-008" depends="xslt-007">
        <echo>Tagged unmarked breaks. Adde manually fragmentationDepth.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0111_008.xml" out="${xml.dir}/W0111_009.xml" style="${xsl.dir}/W0111_008.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>            
            <param name="corrListPaths" expression="../corrlist/lists/W0111-la_supposed-hyphenations-from-text.html"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0111_008.xml"/>
    </target>
    <target name="xslt-009">  <!--depends="xslt-019"-->
        <echo>teiHeader update.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0111_009.xml" out="${xml.dir}/W0111_010.xml" style="${xsl.dir}/W0111_009.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <!--<delete file="${xml.dir}/W0111_009.xml"/>-->
    </target>
    <target name="patch-010"><!-- depends="xslt-009"--> 
        <patch originalfile="${xml.dir}/W0111_010.xml" destfile="${xml.dir}/W0111_011.xml" patchfile="${diff.dir}/W0111_010.diff"/>
        <echo>AW Version W0111.xml until 10.05.24. used for the website. CR: Updated too short p: W0111-00-0436-lb-1008.</echo>
    </target>
    <target name="xslt-011">  <!--depends="patch-010"-->
        <echo>Changed milestone[not(@n)]/unit to unit="other".</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0111_011.xml" out="${xml.dir}/W0111_012.xml" style="${xsl.dir}/W0111_011.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="finalize" depends="xslt-011">
        <echo>Reached end of pipeline.</echo>
    </target>
</project>    
