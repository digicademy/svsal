        <record name="${xslt.log}" action="stop"/>
       <!-- <delete file="${xml.dir}/W0065_009.xml"/> -->
    </target>

<!-- create lists !! -->
   <target name="xslt-011" depends="xslt-010">  <!--depends="xslt-010" -->
        <echo>Tagged unmarked hyphenations. in main</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0065_010.xml" out="${xml.dir}/W0065_011.xml" style="${xsl.dir}/W0065_012.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/W0065-la_supposed-hyphenations-from-text.html" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
  <!--      <delete file="${xml.dir}/W0065_010.xml"/> -->
    </target>
<target name="xslt-012" depends="xslt-011"> 
        <echo>Tagged unmarked hyphenations. in marginals.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0065_011.xml" out="${xml.dir}/W0065_012.xml" style="${xsl.dir}/W0065_013.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/marginals/W0065-marg-la_supposed-hyphenations-from-text.html" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
  <!--      <delete file="${xml.dir}/W0065_010.xml"/> -->
    </target>
<target name="xslt-013" depends="xslt-012"> <!-- depends="xslt-012" -->
        <echo>Expanded abbreviations (la) main text.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0065_012.xml" out="${xml.dir}/W0065_013.xml" style="${xsl.dir}/W0065_011.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="main" type="STRING"/>
            <param name="startAtLineBeginning" expression="TRUE" type="BOOLEAN"/>
            <param name="changeId" expression="W0065_change_014" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
      
    </target>
<target name="xslt-014" depends="xslt-013"> 
        <echo>Expanded abbreviations in marginal text.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0065_013.xml" out="${xml.dir}/W0065_014.xml" style="${xsl.dir}/W0065_011.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="marginal" type="STRING"/>
            <param name="changeId" expression="W0065_change_015" type="STRING"/>
            <param name="startAtLineBeginning" expression="TRUE" type="BOOLEAN"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
      <!--  <delete file="${xml.dir}/W0016_Vol01_012.xml"/> -->
    </target>
