        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0065_006.xml" out="${xml.dir}/W0065_007.xml" style="${xsl.dir}/W0065_006.xsl" classpath="${xslt.processor}">
