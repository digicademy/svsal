   <target name="xslt-010" depends="xslt-009">
        <echo>Added @xml:ids.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0065_009.xml" out="${xml.dir}/W0065_010.xml" style="${xsl.dir}/W0065_010.xsl" classpath="${xslt.processor}">
