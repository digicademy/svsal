        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0065_008.xml" out="${xml.dir}/W0065_009.xml" style="${xsl.dir}/W0065_008.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
       <!-- <delete file="${xml.dir}/W0065_008.xml"/> -->
