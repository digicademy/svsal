<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0065" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/grepect/W0065/W0065.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0065.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0065_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0065_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0065_000.xml" tofile="${xml.dir}/W0065_v1-0.xml"/>
        <echo>Checkpoint: W00 65_v1-0.xml (W0065_000.xml).</echo>
        <delete file="${xml.dir}/W0065_000.xml"/>
    </target>
    
    <target name="patch-000"> <!-- depends="cp-000" -->
        <echo>Structural annotation.</echo>
        <patch originalfile="${xml.dir}/W0065_v1-0.xml" destfile="${xml.dir}/W0065_001.xml" patchfile="${diff.dir}/W0065_000.diff"/>
        <delete file="${xml.dir}/W0065_000.xml"/>
        <!-- TODO: create diff between W0065_v1-0.xml and W0065_edit-000.xml (=W0065_001.xml) -->
    </target>
    <target name="xslt-001"> 
        <echo>Added @type to list, @unit and @xml:ids to milestone.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0065_001.xml" out="${xml.dir}/W0065_002.xml" style="${xsl.dir}/W0065_001.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="xslt-002" depends="xslt-001"> 
        <echo>Summaries, adding @target to ref using @xml:id in milestones.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0065_002.xml" out="${xml.dir}/W0065_003.xml" style="${xsl.dir}/W0065_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <!--<delete file="${xml.dir}/W0065_002.xml"/> -->
    </target>

    <target name="xslt-003" depends="xslt-002"> 
        <echo>Added abbreviations depending on word endings with regex (la)</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0065_003.xml" out="${xml.dir}/W0065_004a.xml" style="${xsl.dir}/W0065_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
 <echo>Added (again) abbreviations depending on word endings with regex (la)</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0065_004a.xml" out="${xml.dir}/W0065_004.xml" style="${xsl.dir}/W0065_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
       <delete file="${xml.dir}/W0065_004a.xml"/>
    </target>

<!-- control all the # before this step !-->
<target name="xslt-004" depends="xslt-003"> 
        <echo>Transformation TEI tite to TEI P5.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0065_004.xml" out="${xml.dir}/W0065_005.xml" style="${xsl.dir}/W0065_004.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>

        <record name="${xslt.log}" action="stop"/>
       <delete file="${xml.dir}/W0065_005a.xml"/>  
    </target>
 <target name="xslt-005" depends="xslt-004"> 
        <echo>Tagged special characters.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0065_005.xml" out="${xml.dir}/W0065_006.xml" style="${xsl.dir}/W0065_005.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
<!-- <delete file="${xml.dir}/W0065_005.xml"/> -->
