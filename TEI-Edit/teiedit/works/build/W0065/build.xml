<target name="xslt-016"><!--  depends="py-012"-->
        <echo>teiHeader update.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0065_015.xml" out="${xml.dir}/W0065_016.xml" style="${xsl.dir}/W0065_014.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="finalize" depends="xslt-016">
        <echo>Reached end of pipeline.</echo>
    </target>
</project>
