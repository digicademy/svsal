        <delete file="${xml.dir}/W0037_Vol02_006.xml"/>
    </target>
    <target name="xslt-007" depends="xslt-006">
        <echo>Annotated Hyphenation.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt in="${xml.dir}/W0037_Vol02_007.xml" out="${xml.dir}/W0037_Vol02_008.xml" style="${xsl.dir}/W0037_Vol02_007.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0037_Vol02_007.xml"/>
    </target>    
