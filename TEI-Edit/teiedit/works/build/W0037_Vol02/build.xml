        <delete file="${xml.dir}/W0037_Vol02_000.xml"/>
    </target>
    
    <target name="patch-000" depends="cp-000"><!--, W0037_Vol02_edit.xml renamed W0037_Vol02-001.xml, --> 
        <patch originalfile="${xml.dir}/W0037_Vol02_v1-0.xml" destfile="${xml.dir}/W0037_Vol02_001.xml" patchfile="${diff.dir}/W0037_Vol02_000.diff"/>
        <echo>Structural Annotation</echo>
        <delete file="${xml.dir}/W0037_Vol02_000.xml"/>
    </target>
    <target name="xslt-001"> 
        <echo>Added @n, @type, @xml:id to div2(s), lists and @target(s) to ref in toc.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0037_Vol02_001.xml" out="${xml.dir}/W0037_Vol02_002.xml" style="${xsl.dir}/W0037_Vol02_001.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="xslt-002" depends="xslt-001">
        <echo>Adding @xml:id and @unit to milestone.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0037_Vol02_002.xml" out="${xml.dir}/W0037_Vol02_003.xml" style="${xsl.dir}/W0037_Vol02_002.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0037_Vol02_002.xml"/>
    </target>
    <target name="xslt-003" depends="xslt-002">
        <echo>Summaries, adding @target to ref using @xml:id in milestones.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0037_Vol02_003.xml" out="${xml.dir}/W0037_Vol02_004.xml" style="${xsl.dir}/W0037_Vol02_003.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0037_Vol02_003.xml"/>
    </target>
    <target name="xslt-004" depends="xslt-003">
        <echo>Added (la) abbreviations depending on word structure with regex.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0037_Vol02_004.xml" out="${xml.dir}/W0037_Vol02_005.xml" style="${xsl.dir}/W0037_Vol02_004.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0037_Vol02_004.xml"/>
    </target>
    <target name="xslt-005" depends="xslt-004">
        <echo>Transformation from TEI Tite to TEI P5.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0037_Vol02_005.xml" out="${xml.dir}/W0037_Vol02_006.xml" style="${xsl.dir}/W0037_Vol02_005.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0037_Vol02_005.xml"/>
