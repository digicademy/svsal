        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0037_Vol02_016.xml" out="${xml.dir}/W0037_Vol02_017.xml" style="${xsl.dir}/W0037_Vol02_016.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0037_Vol02_016.xml"/>
