        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0037_Vol02_020.xml"/>
    </target>
    <target name="xslt-021" depends="xslt-020">
        <echo>Generated xml:id(s) after manual corrections.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0037_Vol02_021.xml" out="${xml.dir}/W0037_Vol02_022.xml" style="${xsl.dir}/W0037_Vol02_021.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
