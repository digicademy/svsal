        <delete file="${xml.dir}/W0037_Vol02_008.xml"/>
    </target>
    <target name="xslt-009" depends="xslt-008"> 
        <echo>Tagged @xml:id(s).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0037_Vol02_009.xml" out="${xml.dir}/W0037_Vol02_010.xml" style="${xsl.dir}/W0037_Vol02_009.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0037_Vol02_009.xml"/>
    </target>
    <target name="xslt-010" depends="xslt-009"> 
        <echo>Expanded abbreviations in main text.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0037_Vol02_010.xml" out="${xml.dir}/W0037_Vol02_011.xml" style="${xsl.dir}/W0037_Vol02_010.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="main" type="STRING"/>
            <param name="changeId" expression="W0037_Vol02_change_013" type="STRING"/>
            <param name="startAtLineBeginning" expression="TRUE" type="BOOLEAN"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0037_Vol02_010.xml"/>
    </target>
    <target name="xslt-011" depends="xslt-010">
