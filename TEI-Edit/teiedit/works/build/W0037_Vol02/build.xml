        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0037_Vol02_018.xml" out="${xml.dir}/W0037_Vol02_019.xml" style="${xsl.dir}/W0037_Vol02_018.xsl" classpath="${xslt.processor}">
