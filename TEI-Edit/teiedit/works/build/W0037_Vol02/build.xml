        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0037_Vol02_011.xml" out="${xml.dir}/W0037_Vol02_012.xml" style="${xsl.dir}/W0037_Vol02_011.xsl" classpath="${xslt.processor}">
