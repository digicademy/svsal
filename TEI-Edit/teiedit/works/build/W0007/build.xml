<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0007" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/digicademy/W0007/w0007_v1.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0007.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0007_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0007_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0007_000.xml" tofile="${xml.dir}/W0007_v1-0.xml"/>
        <echo>Checkpoint: W0007_v1-0.xml (W0007_000.xml).</echo>
        <delete file="${xml.dir}/W0007_000.xml"/>
    </target>
    
    <target name="patch-000"> <!-- depends="cp-000" -->
        <echo>Basic structural editing.</echo>
        <patch originalfile="${xml.dir}/W0007_v1-0.xml" destfile="${xml.dir}/W0007_001.xml" patchfile="${diff.dir}/W0007_000.diff"/>
        <xmlvalidate file="${xml.dir}/W0007_001.xml" lenient="true"/>
        <delete file="${xml.dir}/W0007_000.xml"/>
    </target>
    
    <target name="xslt-001" depends="patch-000">
        <echo>Revise pagination (pb/@n) and small structural changes.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt in="${xml.dir}/W0007_001.xml" out="${xml.dir}/W0007_002.xml" style="${xsl.dir}/W0007_001.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0007_001.xml"/>
    </target>
    
    <target name="xslt-002" depends="xslt-001"> 
        <echo>General transformation from TEI Tite to SalTEI.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt in="${xml.dir}/W0007_002.xml" out="${xml.dir}/W0007_003.xml" style="${xsl.dir}/W0007_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0007_002.xml"/>
    </target>
    
    <target name="xslt-003" depends="xslt-002"> 
        <echo>Add cross-references to index.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt in="${xml.dir}/W0007_003.xml" out="${xml.dir}/W0007_004.xml" style="${xsl.dir}/W0007_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0007_003.xml"/>
    </target>
    
    <target name="xslt-004" depends="xslt-003"> 
        <echo>Resolved hyphenations.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt in="${xml.dir}/W0007_004.xml" out="${xml.dir}/W0007_005.xml" style="${xsl.dir}/W0007_004.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0007_004.xml"/>
    </target>
    
    <target name="xslt-005" depends="xslt-004"> 
        <echo>Tag special characters.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt in="${xml.dir}/W0007_005.xml" out="${xml.dir}/W0007_006.xml" style="${xsl.dir}/W0007_005.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0007_005.xml"/>
    </target>
    
    <target name="xslt-006" depends="xslt-005"> 
        <echo>Generate xml:id.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt in="${xml.dir}/W0007_006.xml" out="${xml.dir}/W0007_007.xml" style="${xsl.dir}/W0007_006.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0007_006.xml"/>
    </target>
    
    <target name="xslt-007" depends="xslt-006">
        <echo>Restructure teiHeader.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt in="${xml.dir}/W0007_007.xml" out="${xml.dir}/W0007_008.xml" style="${xsl.dir}/W0007_007.xsl" classpath="${xslt.processor}">
            <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0007_007.xml"/>
    </target>
    
    <!-- CORRECTION -->
    
    <target name="patch-008"> <!-- depends="xslt-007" -->
        <echo>Corrections/editings (JLE) and manual post-correction fixes (DG).</echo>
        <patch originalfile="${xml.dir}/W0007_008.xml" destfile="${xml.dir}/W0007_009.xml" patchfile="${diff.dir}/W0007_008.diff"/>
        <xmlvalidate file="${xml.dir}/W0007_009.xml" lenient="true"/>
<!--        <delete file="${xml.dir}/W0007_008.xml"/>-->
    </target>
    
    <target name="xslt-009"> <!-- depends="patch-008" -->
        <echo>Automatic post-corr. fixes.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0007_009.xml" out="${xml.dir}/W0007_010.xml" style="${xsl.dir}/W0007_009.xsl" classpath="${xslt.processor}">
            <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
<!--        <delete file="${xml.dir}/W0007_009.xml"/>-->
    </target>
    
    <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    
    <target name="xslt-010" depends="xslt-009">
        <echo>Fix order of break elements.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt in="${xml.dir}/W0007_010.xml" out="${xml.dir}/W0007_011.xml" style="${xsl.dir}/W0007_010.xsl" classpath="${xslt.processor}">
            <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0007_010.xml"/>
    </target>
    
    <target name="xslt-011" depends="xslt-010">
        <echo>tei:choice break pairings.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt in="${xml.dir}/W0007_011.xml" out="${xml.dir}/W0007_012.xml" style="${xsl.dir}/W0007_011.xsl" classpath="${xslt.processor}">
            <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0007_011.xml"/>
    </target>
    
    <target name="xslt-012" depends="xslt-011">
        <echo>Tagged special chars.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt in="${xml.dir}/W0007_012.xml" out="${xml.dir}/W0007_013.xml" style="${xsl.dir}/W0007_012.xsl" classpath="${xslt.processor}">
            <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0007_012.xml"/>
    </target>
    
    <target name="xslt-013" depends="xslt-012">
        <echo>Line numbering.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt in="${xml.dir}/W0007_013.xml" out="${xml.dir}/W0007_014.xml" style="${xsl.dir}/W0007_013.xsl" classpath="${xslt.processor}">
            <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0007_013.xml"/>
    </target>
    
    <target name="xslt-014" depends="xslt-013">
        <echo>New xml:id.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt in="${xml.dir}/W0007_014.xml" out="${xml.dir}/W0007_015.xml" style="${xsl.dir}/W0007_014.xsl" classpath="${xslt.processor}">
            <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0007_014.xml"/>
    </target>
    
    <target name="xslt-015" depends="xslt-014">
        <echo>New teiHeader and status update.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt in="${xml.dir}/W0007_015.xml" out="${xml.dir}/W0007_016.xml" style="${xsl.dir}/W0007_015.xsl" classpath="${xslt.processor}">
            <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0007_015.xml"/>
    </target>
    
    <target name="xslt-016" depends="xslt-015">
        <echo>Extend tei:ref to full tei:item.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt in="${xml.dir}/W0007_016.xml" out="${xml.dir}/W0007_017.xml" style="${xsl.dir}/W0007_016.xsl" classpath="${xslt.processor}">
            <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0007_016.xml"/>
    </target>
    
    <target name="xslt-017" > <!--depends="xslt-016"-->
        <echo>Revised teiHeader, update @role in editor.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt in="${xml.dir}/W0007_017.xml" out="${xml.dir}/W0007_018.xml" style="${xsl.dir}/W0007_017.xsl" classpath="${xslt.processor}">
            <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <!--<delete file="${xml.dir}/W0007_017.xml"/>-->
    </target>

    <target name="finalize" depends="xslt-017">
        <echo>Reached end of pipeline.</echo>
    </target>
    
  
</project>