<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0063_Vol10" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/textloop/W0063-J/W0063-J.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0063_Vol10.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0063_Vol10_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0063_Vol10_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0063_Vol10_000.xml" tofile="${xml.dir}/W0063_Vol10_v1-0.xml"/>
        <echo>Checkpoint: W0063_Vol10_v1-0.xml (W0063_Vol10_000.xml).</echo>
        <delete file="${xml.dir}/W0063_Vol10_000.xml"/>
    </target>
    <target name="patch-000"> <!-- depends="cp-000" Do not delete W0063_Vol10_001.xml-->
        <echo>Structural annotation.</echo>
        <patch originalfile="${xml.dir}/W0063_Vol10_v1-0.xml" destfile="${xml.dir}/W0063_Vol10_001.xml" patchfile="${diff.dir}/W0063_Vol10_000.diff"/>
    </target>
    
    <target name="xslt-001"> <!--depends="patch-000"-->
        <echo>Transformation TEI tite to TEI P5.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0063_Vol10_001.xml" out="${xml.dir}/W0063_Vol10_002.xml" style="${xsl.dir}/W0063_Vol10_001.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="xslt-002" depends="xslt-001"> 
        <echo>Annotated hyphenated breaks.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0063_Vol10_002.xml" out="${xml.dir}/W0063_Vol10_003.xml" style="${xsl.dir}/W0063_Vol10_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0063_Vol10_002.xml"/>
    </target>
    <target name="xslt-003" depends="xslt-002"> 
        <echo>Tagged special characters.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0063_Vol10_003.xml" out="${xml.dir}/W0063_Vol10_004.xml" style="${xsl.dir}/W0063_Vol10_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0063_Vol10_003.xml"/>
    </target>
    <target name="xslt-004" depends="xslt-003"> 
        <echo>Numbered lines.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0063_Vol10_004.xml" out="${xml.dir}/W0063_Vol10_005.xml" style="${xsl.dir}/W0063_Vol10_004.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0063_Vol10_004.xml"/>
    </target>
    <target name="xslt-005" depends="xslt-004">
        <echo>Added @xml:ids.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0063_Vol10_005.xml" out="${xml.dir}/W0063_Vol10_006.xml" style="${xsl.dir}/W0063_Vol10_005.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0063_Vol10_005.xml"/>
    </target>
    <target name="xslt-006" depends="xslt-005">
        <echo>Tagged unmarked hyphenations (la).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0063_Vol10_006.xml" out="${xml.dir}/W0063_Vol10_007.xml" style="${xsl.dir}/W0063_Vol10_006.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/lists/W0063_Vol10-la_supposed-hyphenations-from-text.html" type="STRING"/>
            <param name="lang" expression="la" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0063_Vol10_006.xml"/>
    </target>
    <target name="finalize" depends="xslt-006">
        <echo>Reached end of pipeline.</echo>
    </target>
</project>
    
