<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0005_Vol02" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../../../tustep/svsal/v1/teitite/W0005B/W0005B_v1.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0005_Vol02.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0005_Vol02_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0005_Vol02_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0005_Vol02_000.xml" tofile="${xml.dir}/W0005_Vol02_v1-0.xml"/>
        <echo>Checkpoint: W0005_Vol02_v1-0.xml (W0005_Vol02_000.xml).</echo>
        <delete file="${xml.dir}/W0005_Vol02_000.xml"/>
    </target>
    
    <target name="patch-000"> <!-- depends="cp-000" -->
        <echo>Structural annotation.</echo>
        <patch originalfile="${xml.dir}/W0005_Vol02_v1-0.xml" destfile="${xml.dir}/W0005_Vol02_001.xml" patchfile="${diff.dir}/W0005_Vol02_000.diff"/>
        <delete file="${xml.dir}/W0005_Vol02_000.xml"/>
    </target>
    <target name="xslt-001"> <!-- depends="patch-000" -->
        <echo>Added @targets in toc, @type/@xml:id in list(s), div(s), @n, @unit, @xml:id milestone.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0005_Vol02_001.xml" out="${xml.dir}/W0005_Vol02_002.xml" style="${xsl.dir}/W0005_Vol02_001.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="xslt-002" depends="xslt-001"> 
        <echo>Added missing pagination (pb/@n).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0005_Vol02_002.xml" out="${xml.dir}/W0005_Vol02_003.xml" style="${xsl.dir}/W0005_Vol02_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0005_Vol02_002.xml"/>
    </target>
    <target name="xslt-003" depends="xslt-002"> 
        <echo>Added anchore @n in marginal notes.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0005_Vol02_003.xml" out="${xml.dir}/W0005_Vol02_004.xml" style="${xsl.dir}/W0005_Vol02_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0005_Vol02_003.xml"/>
    </target>
    <target name="xslt-004" depends="xslt-003"> 
        <echo>Added crossed references between list (summaries) / milestone(s) and delete unnecessary daggers.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0005_Vol02_004.xml" out="${xml.dir}/W0005_Vol02_005.xml" style="${xsl.dir}/W0005_Vol02_004.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0005_Vol02_004.xml"/>
    </target>
    <target name="xslt-005" depends="xslt-004">
        <echo>Added pb-cb/@sameAs in note(s).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0005_Vol02_005.xml" out="${xml.dir}/W0005_Vol02_006.xml" style="${xsl.dir}/W0005_Vol02_005.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0005_Vol02_005.xml"/>
    </target>
    <target name="xslt-006" depends="xslt-005">
        <echo>Added (es) abbreviations depending on word structure with regex.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0005_Vol02_006.xml" out="${xml.dir}/W0005_Vol02_007a.xml" style="${xsl.dir}/W0005_Vol02_006.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <echo>Repeated (es) abbreviations depending on word structure with regex.</echo>
        <xslt force="true" in="${xml.dir}/W0005_Vol02_007a.xml" out="${xml.dir}/W0005_Vol02_007.xml" style="${xsl.dir}/W0005_Vol02_006.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0005_Vol02_006.xml"/>
        <delete file="${xml.dir}/W0005_Vol02_007a.xml"/>
    </target>
    <target name="xslt-007" depends="xslt-006"> 
        <echo>Added (la) abbreviations depending on word structure with regex.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0005_Vol02_007.xml" out="${xml.dir}/W0005_Vol02_008a.xml" style="${xsl.dir}/W0005_Vol02_007.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <echo>Repeated (la) abbreviations depending on word structure with regex.</echo>
        <xslt force="true" in="${xml.dir}/W0005_Vol02_008a.xml" out="${xml.dir}/W0005_Vol02_008.xml" style="${xsl.dir}/W0005_Vol02_007.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0005_Vol02_007.xml"/>
        <delete file="${xml.dir}/W0005_Vol02_008a.xml"/>
    </target>
    <target name="xslt-008" depends="xslt-007">
        <echo>Transformation TEI-tite to TEI-All.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0005_Vol02_008.xml" out="${xml.dir}/W0005_Vol02_009.xml" style="${xsl.dir}/W0005_Vol02_008.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0005_Vol02_008.xml"/>
    </target>
    <target name="xslt-009" depends="xslt-008">
        <echo>Annotated hyphenated breaks.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0005_Vol02_009.xml" out="${xml.dir}/W0005_Vol02_010.xml" style="${xsl.dir}/W0005_Vol02_009.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0005_Vol02_009.xml"/>
    </target>
    <target name="xslt-010" depends="xslt-009"><!-- -->
        <echo>Tagged special characters.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0005_Vol02_010.xml" out="${xml.dir}/W0005_Vol02_011.xml" style="${xsl.dir}/W0005_Vol02_010.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
