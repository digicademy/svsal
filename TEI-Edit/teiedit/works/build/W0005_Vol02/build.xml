        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0005_Vol02_011.xml" out="${xml.dir}/W0005_Vol02_012.xml" style="${xsl.dir}/W0005_Vol02_011.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0005_Vol02_011.xml"/>
    </target>
    <target name="xslt-012" depends="xslt-011">  
        <echo>Added @xml:ids.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0005_Vol02_012.xml" out="${xml.dir}/W0005_Vol02_013.xml" style="${xsl.dir}/W0005_Vol02_012.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0005_Vol02_012.xml"/>
    </target>
    <target name="xslt-013"><!-- depends="xslt-012"-->
        <echo>Tagged unmarked Hyphenation main text (es).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0005_Vol02_013.xml" out="${xml.dir}/W0005_Vol02_014a.xml" style="${xsl.dir}/W0005_Vol02_013.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="es" type="STRING"/>
            <param name="changeId" expression="W0005_Vol02_change_020" type="STRING"/>
            <param name="corrListPaths" expression="../corrlist/lists/W0005_Vol02-es_supposed-hyphenations-from-text.html" type="STRING"/>
        </xslt>
        <echo>******************************************</echo>
        <echo>Tagged unmarked Hyphenation marginal (la).</echo>
        <xslt force="true" in="${xml.dir}/W0005_Vol02_014a.xml" out="${xml.dir}/W0005_Vol02_014.xml" style="${xsl.dir}/W0005_Vol02_013.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="changeId" expression="W0005_Vol02_change_021" type="STRING"/>
            <param name="corrListPaths" expression="../corrlist/lists/W0005_Vol02-marg-la_supposed-hyphenations-from-text.html" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0005_Vol02_014a.xml"/>
        <!--<delete file="${xml.dir}/W0005_Vol02_013.xml"/>-->
    </target>
    <target name="xslt-014" depends="xslt-013">  
        <echo>Expanded abbreviations in main text (es).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0005_Vol02_014.xml" out="${xml.dir}/W0005_Vol02_015a.xml" style="${xsl.dir}/W0005_Vol02_014.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="es" type="STRING"/>
            <param name="mode" expression="main" type="STRING"/>
            <param name="startAtLineBeginning" expression="True" type="BOOLEAN"/>
            <param name="changeId" expression="W0005_Vol02_change_022" type="STRING"/>
        </xslt>
        <echo>Expanded abbreviations in marginal notes (la).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0005_Vol02_015a.xml" out="${xml.dir}/W0005_Vol02_015.xml" style="${xsl.dir}/W0005_Vol02_014.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="margin" type="STRING"/>
            <param name="startAtLineBeginning" expression="True" type="BOOLEAN"/>
            <param name="changeId" expression="W0005_Vol02_change_023" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0005_Vol02_014.xml"/>
        <delete file="${xml.dir}/W0005_Vol02_015a.xml"/>
    </target>
    <target name="py-015"> <!-- depends="xslt-016" - input W0005_Vol02_015.xml and output W0005_Vol02_016.xml files in python script -->
        <!--Run and edit directly from Python. ANT causes encoding/decoding problems.-->
        <echo>Automatically expanded abbreviations with lb/@break using python.</echo>
        <record name="${py.log}" action="start" loglevel="verbose"/>
        <exec executable="${executable-full-path}">
            <arg file="${py.dir}/W0005_Vol02_015.py"/>
        </exec>
        <record name="${py.log}" action="stop"/>
    </target>
    <target name="xslt-016"><!-- depends="py-015"-->
        <echo>teiHeader update.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0005_Vol02_016.xml" out="${xml.dir}/W0005_Vol02_017.xml" style="${xsl.dir}/W0005_Vol02_016.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    
    <target name="finalize" depends="xslt-016">
        <echo>Reached end of pipeline.</echo>
    </target>
</project>

