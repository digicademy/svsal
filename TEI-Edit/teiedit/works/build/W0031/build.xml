<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0031" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/grepect/W0031/W0031.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0031.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0031_001.xml"/>
        <xmlvalidate file="${xml.dir}/W0031_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0031_000.xml" tofile="${xml.dir}/W0031-v1.0.xml"/>
        <echo>Checkpoint: W0031_v1-0.xml (W0031_000.xml).</echo>
        <delete file="${xml.dir}/W0031_000.xml"/>
    </target>
    
    <target name="patch-000"> <!-- depends="cp-000" -->
        <echo>Structural annotation.</echo>
        <patch originalfile="${xml.dir}/W0031_v1-0.xml" destfile="${xml.dir}/W0031_001.xml" patchfile="${diff.dir}/W0031_000.diff"/>
        <delete file="${xml.dir}/W0031_000.xml"/>
      
    </target>
    <target name="xslt-001"> 
        <echo>Added @type to list, @unit and @xml:ids to milestone.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0031_001.xml" out="${xml.dir}/W0031_002.xml" style="${xsl.dir}/W0031_001.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>

    <target name="xslt-002" depends="xslt-001"> 
        <echo>Added abbreviations depending on word endings with regex (la)</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0031_002.xml" out="${xml.dir}/W0031_003a.xml" style="${xsl.dir}/W0031_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
<echo>Added (again) abbreviations depending on word endings with regex (la)</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0031_003a.xml" out="${xml.dir}/W0031_003.xml" style="${xsl.dir}/W0031_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt> 

        <record name="${xslt.log}" action="stop"/>
       <delete file="${xml.dir}/W0031_003a.xml"/>
   
    </target>

  

<target name="xslt-003" depends="xslt-002"> 
        <echo>Transformation TEI tite to TEI P5.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0031_003.xml" out="${xml.dir}/W0031_004.xml" style="${xsl.dir}/W0031_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
       
    </target>

<target name="xslt-004" depends="xslt-003"> 
        <echo>Tagged special characters.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0031_004.xml" out="${xml.dir}/W0031_005.xml" style="${xsl.dir}/W0031_004.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>

       <!-- Reminder: hx for the titles and signed if names. add annotateHyphenBreaksHiNote as a new target here. Check the rest of the errors, dann test with rng. -->
    </target>
  
   <target name="xslt-005" depends="xslt-004">
        <echo>Tagged Hyphenation.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0031_005.xml" out="${xml.dir}/W0031_006.xml" style="${xsl.dir}/W0031_005.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
  
    </target>

 
  <target name="xslt-006" depends="xslt-005">
        <echo>Numbered lines.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0031_006.xml" out="${xml.dir}/W0031_007.xml" style="${xsl.dir}/W0031_006.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    
    </target>

   <target name="xslt-007" depends="xslt-006">
        <echo>Added @xml:ids.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0031_007.xml" out="${xml.dir}/W0031_008.xml" style="${xsl.dir}/W0031_007.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>

    </target>
<!-- lists ! -->

   <target name="xslt-008" depends="xslt-007">
        <echo>Tagged unmarked hyphenations.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0031_008.xml" out="${xml.dir}/W0031_009.xml" style="${xsl.dir}/W0031_008.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/W0031-la_supposed-hyphenations-from-text.html" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
  
    </target>

<target name="xslt-009" depends="xslt-008">
        <echo>Expanded abbreviations (la) main text.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0031_009.xml" out="${xml.dir}/W0031_010.xml" style="${xsl.dir}/W0031_009.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="main" type="STRING"/>
            <param name="startAtLineBeginning" expression="TRUE" type="BOOLEAN"/>
            <param name="changeId" expression="W0031_change_009" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
      
    </target> 
  <!--<target name="py-010" input file W0031_010.xml output W0031_011.xml > 
        <echo>Expanded abbreviations with breaks.</echo>
        <record name="${py.log}" action="start" loglevel="verbose"/>
        <exec executable="${executable-full-path}">
            <arg file="${py.dir}/W0031_010.py"/>
        </exec>
        <record name="${py.log}" action="stop"/>
    </target> -->

<target name="xslt-011">
        <echo>teiHeader update.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0031_011.xml" out="${xml.dir}/W0031_012.xml" style="${xsl.dir}/W0031_010.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target> 
    <target name="finalize" depends="xslt-011">
        <echo>Reached end of pipeline.</echo>
    </target>
</project>
