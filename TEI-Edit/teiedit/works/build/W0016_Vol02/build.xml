<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0016_Vol02" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/textloop/W0016-B/W0016-B.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0016_Vol02.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0016_Vol02_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0016_Vol02_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0016_Vol02_000.xml" tofile="${xml.dir}/W0016_Vol02_v1-0.xml"/>
        <echo>Checkpoint: W0016_Vol02_v1-0.xml (W0016_Vol02_000.xml).</echo>
        <delete file="${xml.dir}/W0016_Vol02_000.xml"/>
    </target>
    
    <target name="patch-000" depends="cp-000"><!--, W0016_Vol02_edit.xml renamed W0016_Vol02-001.xml, --> 
        <patch originalfile="${xml.dir}/W0016_Vol02_v1-0.xml" destfile="${xml.dir}/W0016_Vol02_001.xml" patchfile="${diff.dir}/W0016_Vol02_000.diff"/>
        <echo>Structural Annotation</echo>
        <delete file="${xml.dir}/W0016_Vol02_000.xml"/>
    </target>
    <target name="xslt-001"> 
        <echo>Added @n, @type and @xml:id to div2(s), div3(s), lists and @target(s) to ref in toc.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol02_001.xml" out="${xml.dir}/W0016_Vol02_002.xml" style="${xsl.dir}/W0016_Vol02_001.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    
  <target name="xslt-002" depends="xslt-001"> 
        <echo>Added abbreviations depending on word endings with regex (la)</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol02_002.xml" out="${xml.dir}/W0016_Vol02_003a.xml" style="${xsl.dir}/W0016_Vol02_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
 <echo>Added (again) abbreviations depending on word endings with regex (la)</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol02_003a.xml" out="${xml.dir}/W0016_Vol02_003.xml" style="${xsl.dir}/W0016_Vol02_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
       <delete file="${xml.dir}/W0016_Vol02_003a.xml"/>
    </target>
    <target name="xslt-003" depends="xslt-002">
        <echo>Transformation from TEI Tite to TEI P5.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol02_003.xml" out="${xml.dir}/W0016_Vol02_004.xml" style="${xsl.dir}/W0016_Vol02_003.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
       
    </target>
  <target name="xslt-004" depends="xslt-003">
        <echo>Special characters tagging.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol02_004.xml" out="${xml.dir}/W0016_Vol02_005.xml" style="${xsl.dir}/W0016_Vol02_004.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
      
    </target>
    <target name="xslt-005" depends="xslt-004">
        <echo>Annotated Hyphenation.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt in="${xml.dir}/W0016_Vol02_005.xml" out="${xml.dir}/W0016_Vol02_006.xml" style="${xsl.dir}/W0016_Vol02_005.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0016_Vol02_007.xml"/>
    </target>
    
    <target name="xslt-006" depends="xslt-005"> 
        <echo>Line numbering.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol02_006.xml" out="${xml.dir}/W0016_Vol02_007.xml" style="${xsl.dir}/W0016_Vol02_006.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        
    </target>
     <target name="xslt-007" depends="xslt-006"> 
        <echo>Generated @xml:id.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol02_007.xml" out="${xml.dir}/W0016_Vol02_008.xml" style="${xsl.dir}/W0016_Vol02_007.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
       
    </target>
   <!--  
        make lists.  -->
<target name="xslt-008" depends="xslt-007"> 
        <echo>Tagged unmarked breaks.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol02_008.xml" out="${xml.dir}/W0016_Vol02_009.xml" style="${xsl.dir}/W0016_Vol02_008.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/W0016_Vol02-la_supposed-hyphenations-from-text.html" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
       
    </target>
   <target name="xslt-009" depends="xslt-008"> 
        <echo>Tagged unmarked breaks (marginals).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol02_009.xml" out="${xml.dir}/W0016_Vol02_010.xml" style="${xsl.dir}/W0016_Vol02_009.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/marginals/W0016_Vol02-marg-la_supposed-hyphenations-from-text.html" type="STRING"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    
    </target>
 <target name="xslt-010" depends="xslt-009">
        <echo>Expanded abbreviations in main text.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol02_010.xml" out="${xml.dir}/W0016_Vol02_011.xml" style="${xsl.dir}/W0016_Vol02_010.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="main" type="STRING"/>
            <param name="changeId" expression="W0016_Vol02_change_010" type="STRING"/>
            <param name="startAtLineBeginning" expression="TRUE" type="BOOLEAN"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
      
    </target>
    <target name="xslt-011" depends="xslt-010"> 
        <echo>Expanded abbreviations in marginal text.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol02_011.xml" out="${xml.dir}/W0016_Vol02_012.xml" style="${xsl.dir}/W0016_Vol02_010.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
            <param name="lang" expression="la" type="STRING"/>
            <param name="mode" expression="marginal" type="STRING"/>
            <param name="changeId" expression="W0016_Vol02_change_011" type="STRING"/>
            <param name="startAtLineBeginning" expression="TRUE" type="BOOLEAN"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
     
    </target>

<!--<target name="py-012" input file W0016_Vol02_012.xml output W0016_Vol02_013.xml > 
        <echo>Expanded abbreviations with breaks.</echo>
        <record name="${py.log}" action="start" loglevel="verbose"/>
        <exec executable="${executable-full-path}">
            <arg file="${py.dir}/W0016_Vol02_012.py"/>
        </exec>
        <record name="${py.log}" action="stop"/>
    </target> -->

    <target name="xslt-013">
        <echo>teiHeader update.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0016_Vol02_013.xml" out="${xml.dir}/W0016_Vol02_014.xml" style="${xsl.dir}/W0016_Vol02_013.xsl" classpath="${xslt.processor}" >
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
      
    </target> 
   
    <target name="finalize" depends="xslt-013">
        <echo>Reached end of pipeline.</echo>
    </target>
    
