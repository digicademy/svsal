<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="W0063_Vol02" default="finalize">
    
    <property name="diff.dir" value="diff"/>
    <property name="log.dir" value="log"/>
    <property name="xml.dir" value="xml"/>
    <property name="xsl.dir" value="xsl"/>
    <property name="xslt.log" value="${log.dir}/${ant.project.name}_xslt.log"/>
    <property name="xslt.processor" value="../../../lib/xsltproc/Saxon-HE-9.8.0-12.jar"/>
    <property name="xslt.class" value="net.sf.saxon.TransformerFactoryImpl"/>
    
    <property name="orig.file" value="../../orig/textloop/W0063-B/W0063-B.xml"/>
    
    <target name="initialize">
        <echo>Initializing W0063_Vol02.</echo>
        <mkdir dir="${xml.dir}"/>
        <mkdir dir="${log.dir}"/>
        <copy file="${orig.file}" tofile="${xml.dir}/W0063_Vol02_000.xml"/>
        <xmlvalidate file="${xml.dir}/W0063_Vol02_000.xml" lenient="true"/>
    </target>
    
    <target name="cp-000" depends="initialize">
        <copy file="${xml.dir}/W0063_Vol02_000.xml" tofile="${xml.dir}/W0063_Vol02_v1-0.xml"/>
        <echo>Checkpoint: W0063_Vol02_v1-0.xml (W0063_Vol02_000.xml).</echo>
        <delete file="${xml.dir}/W0063_Vol02_000.xml"/>
    </target>
    <target name="patch-000"> <!-- depends="cp-000" Do not delete W0063_Vol02_001.xml-->
        <echo>Structural annotation.</echo>
        <patch originalfile="${xml.dir}/W0063_Vol02_v1-0.xml" destfile="${xml.dir}/W0063_Vol02_001.xml" patchfile="${diff.dir}/W0063_Vol02_000.diff"/>
    </target>
    
    <target name="xslt-001"> <!--depends="patch-000"-->
        <echo>Tagged @n, @type, @xml:id(s) in div(s) and @target in TOC.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0063_Vol02_001.xml" out="${xml.dir}/W0063_Vol02_002.xml" style="${xsl.dir}/W0063_Vol02_001.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
    </target>
    <target name="xslt-002" depends="xslt-001"> <!--Taken from W0063_Vol01_002b.xsl, which was adapted for Siete Partidas.-->
        <echo>Transformation TEI tite to TEI P5.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0063_Vol02_002.xml" out="${xml.dir}/W0063_Vol02_003.xml" style="${xsl.dir}/W0063_Vol02_002.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0063_Vol02_002.xml"/>
    </target>
    <target name="xslt-003" depends="xslt-002"> 
        <echo>Annotated hyphenated breaks.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0063_Vol02_003.xml" out="${xml.dir}/W0063_Vol02_004.xml" style="${xsl.dir}/W0063_Vol02_003.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0063_Vol02_003.xml"/>
    </target>
    <target name="xslt-004" depends="xslt-003"> 
        <echo>Tagged special characters.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0063_Vol02_004.xml" out="${xml.dir}/W0063_Vol02_005.xml" style="${xsl.dir}/W0063_Vol02_004.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0063_Vol02_004.xml"/>
    </target>
    <target name="xslt-005" depends="xslt-004">
        <echo>Numbered lines.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0063_Vol02_005.xml" out="${xml.dir}/W0063_Vol02_006.xml" style="${xsl.dir}/W0063_Vol02_005.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0063_Vol02_005.xml"/>
    </target>
    <target name="xslt-006" depends="xslt-005"><!--Taken from W0063_Vol01_006.xsl, which was adapted for Siete Partidas.-->
        <echo>Added @xml:ids.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0063_Vol02_006.xml" out="${xml.dir}/W0063_Vol02_007.xml" style="${xsl.dir}/W0063_Vol02_006.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0063_Vol02_006.xml"/>
    </target>
    <target name="xslt-007" depends="xslt-006"> <!---->
        <echo>Rearranged pb/@sameAs and lb/xml:id(s) in gloss.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0063_Vol02_007.xml" out="${xml.dir}/W0063_Vol02_008.xml" style="${xsl.dir}/W0063_Vol02_007.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>            
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0063_Vol02_007.xml"/>
    </target>
    <target name="xslt-008" depends="xslt-007"><!-- -->
        <echo>Tagged unmarked hyphenations (la).</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0063_Vol02_008.xml" out="${xml.dir}/W0063_Vol02_009.xml" style="${xsl.dir}/W0063_Vol02_008.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/lists/W0063_Vol02-la_supposed-hyphenations-from-text.html" type="STRING"/>
            <param name="lang" expression="la" type="STRING"/>            
        </xslt>
        <echo>Tagged unmarked hyphenations (es).</echo>
        <xslt force="true" in="${xml.dir}/W0063_Vol02_009.xml" out="${xml.dir}/W0063_Vol02_010.xml" style="${xsl.dir}/W0063_Vol02_008.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>
            <param name="corrListPaths" expression="../corrlist/lists/W0063_Vol02-es_supposed-hyphenations-from-text.html" type="STRING"/>
            <param name="lang" expression="es" type="STRING"/>
            <param name="changeId" expression="W0063_Vol02_change_013" type="STRING"/>       
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0063_Vol02_008.xml"/>
        <delete file="${xml.dir}/W0063_Vol02_009.xml"/>
    </target>
    <target name="xslt-009" depends="xslt-008">
        <echo>teiHeader update for online publication.</echo>
        <record name="${xslt.log}" action="start" loglevel="verbose"/>
        <xslt force="true" in="${xml.dir}/W0063_Vol02_010.xml" out="${xml.dir}/W0063_Vol02_011.xml" style="${xsl.dir}/W0063_Vol02_009.xsl" classpath="${xslt.processor}">
            <factory name="${xslt.class}"/>            
        </xslt>
        <record name="${xslt.log}" action="stop"/>
        <delete file="${xml.dir}/W0063_Vol02_010.xml"/>
    </target>
    <target name="finalize" depends="xslt-009">
        <echo>Reached end of pipeline.</echo>
    </target>
</project>
    
