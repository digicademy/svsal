# Environment variables for the Salamanca Docker setup
MODE=prod

CADDY_BIND_HTTP=0.0.0.0:80
CADDY_BIND_HTTPS=0.0.0.0:443
CADDY_CERTS_MOUNT=/var/data/caddy/certs:/root/certs:Z,ro

SPHINX_SKIP_INDEX=0

CADDY_VERSION=2.11.8-1
EXISTDB_VERSION=3.1
SPHINX_VERSION=2.2.11-4
ANY23_VERSION=2.3rc2
ANUBIS_VERSION=latest
