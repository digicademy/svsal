[Unit]
Description=SvSal Any23 RDF Extraction Container
After=local-fs.target


[Container]
ContainerName=any23
Image=ghcr.io/digicademy/svsal/svsal-any23:2.3rc2

# AutoUpdate is commented out by default for manual updates.
# Uncomment the line below to enable automatic updates:
# AutoUpdate=registry

# Port mappings are handled at the pod level (svsal.pod)

Pod=svsal.pod


[Install]
WantedBy=default.target


[Service]
Restart=always

# Extend Timeout to allow time to pull the image
TimeoutStartSec=300
RestartSec=30

ExecStop=/bin/sh -c "podman stop any23"
ExecStop=/bin/sh -c "podman rm any23"

KillMode=control-group
