# any23.container

[Unit]
Description=SvSal Any23 RDF Extraction
After=local-fs.target

[Container]
ContainerName=any23
Image=ghcr.io/digicademy/svsal/svsal-any23:2.3rc2
# AutoUpdate is commented out by default for manual updates.
# Uncomment the line below to enable automatic updates:
# AutoUpdate=registry
Network=salamanca-internal.network

[Service]
Restart=always
# Extend Timeout to allow time to pull the image
TimeoutStartSec=300
RestartSec=30

[Install]
WantedBy=default.target
