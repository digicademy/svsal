#!/sbin/openrc-run

start() {
  # If the configuration files are not already present because the directory has
  # been bind mounted to an empty directory, copy them from /tmp/...

  chown -R sphinx:sphinx /var/lib/sphinx

  echo "   - Copying configuration files to /etc/sphinx ..."
  for file in /tmp/sphinx/*; do
    # test -f /etc/sphinx/$(basename $file)  || cp -R /tmp/sphinx/$(basename $file) /etc/sphinx/
    [ -e "/etc/sphinx/$(basename "$file")" ] || cp -a "$file" /etc/sphinx/
  done
  echo "       Done."

  echo "   - Copying configuration files to /opt/opensphinxsearch ..."
  for file in /tmp/opensphinxsearch/*; do
    # test -f /opt/opensphinxsearch/$(basename $file)  || cp -R /tmp/opensphinxsearch/$(basename $file) /opt/opensphinxsearch/
    [ -e "/opt/opensphinxsearch/$(basename "$file")" ] || cp -a "$file" /opt/opensphinxsearch/
  done
  echo "       Done."

  echo "   - Copying dummy xml file(s) to /var/data/existdb/data/export ..."
  for file in /tmp/salamancadata/*; do
    # test -f /var/data/existdb/data/export/$(basename $file) || cp -R /tmp/salamancadata/$(basename $file) /var/data/existdb/data/export/
    [ -e "/var/data/existdb/data/export/$(basename "$file")" ] || cp -a "$file" /var/data/existdb/data/export/
  done
  echo "       Done."

  echo "   - Checking sphinx index state ..."
  NEWEST_SPA=$(ls -t /var/lib/sphinx/data/*.spa 2>/dev/null | head -1)

  case "${SPHINX_SKIP_INDEX:-0}" in
      1|y|Y|yes|Yes|YES|true|True|TRUE|on|On|ON)
          echo "   - SPHINX_SKIP_INDEX is set; skipping index population."
          ;;
      *)
          if [ -z "$NEWEST_SPA" ] || [ ! -s "$NEWEST_SPA" ]; then
              echo "   - First boot or empty index: populating index ..."

              echo "     - [1/2] preparing XML data ..."
              if ! /usr/bin/prepare-xml.sh 2>&1 >> /var/log/sphinx/prepare-xml.log; then
                  echo "ERROR: XML preparation failed. See /var/log/sphinx/prepare-xml.log" >&2
              fi

              echo "     - [2/2] running 'indexer --all' ..."
              if ! indexer --all --quiet >> /var/log/sphinx/indexer.log 2>&1; then
                  echo "ERROR: initial indexer failed; searchd will start with an empty index. See /var/log/sphinx/indexer.log" >&2
              fi
          else
              echo "   - Index present; skipping boot-time indexer (cron handles updates)."
          fi
          ;;
  esac  echo "       Done."
}
